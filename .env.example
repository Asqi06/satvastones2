# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# === WhatsApp Automation (WAHA + n8n) ===
# N8N_WEBHOOK_URL: The n8n webhook endpoint that receives order notifications.
# n8n will then call WAHA API to send WhatsApp messages to customer + admin.
# Example: https://your-n8n.example.com/webhook/satvastones-order
N8N_WEBHOOK_URL=""

# WAHA_API_URL: The URL of your WAHA (WhatsApp HTTP API) instance.
# WAHA runs as a Docker container and exposes a REST API for WhatsApp.
# Example: http://localhost:3001 or https://waha.your-domain.com
WAHA_API_URL=""

# WAHA_API_KEY: Optional API key if WAHA is configured with authentication.
WAHA_API_KEY=""

# WHATSAPP_ADMIN_NUMBER: The admin/store owner's WhatsApp number (with country code, no +).
# Used by n8n workflows to send admin notifications (new orders, etc.)
# Example: 919876543210 (for India)
WHATSAPP_ADMIN_NUMBER=""
