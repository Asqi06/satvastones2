# === Database (PostgreSQL via Prisma) ===
# Connection string for the PostgreSQL database.
# Example: postgresql://user:password@host:5432/satvastones
DATABASE_URL=""

# === Cloudinary (product images & uploads) ===
# Cloudinary credentials from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# === NextAuth (login with Google / credentials) ===
# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret used to sign NextAuth JWT sessions.
# Generate a random string: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Canonical URL of the deployed app (used by NextAuth and canonicals).
# Example: https://satvastones.in
NEXTAUTH_URL=""
NEXT_PUBLIC_APP_URL=""

# === Razorpay (payments) ===
# Razorpay API keys from the Razorpay dashboard.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is exposed to the browser for checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# === SendGrid (transactional email) ===
# Used for order confirmations and password resets.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
