{
  "name": "Satvastones — Order WhatsApp Notification",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "path": "satvastones-order",
        "options": {
          "responseMode": "onReceived",
          "responseData": "{\"received\": true}"
        }
      },
      "webhookId": "satvastones-order"
    },
    {
      "id": "http-request-customer",
      "name": "Send WhatsApp to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 200],
      "parameters": {
        "url": "={{ $env.WAHA_API_URL }}/api/sendText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "nodeCredential": "waha-api-key",
        "sendQuery": true,
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chatId",
              "value": "={{ $json.body.phone }}@c.us"
            },
            {
              "name": "text",
              "value": "=🧾 *Order Confirmed — Satvastones*\n\nHi {{ $json.body.customer.name }},\n\nYour order *{{ $json.body.orderNumber }}* has been placed successfully!\n\n📦 *Items:*\n{{ $json.body.items.map(item => '• ' + item.title + ' x' + item.qty + ' — ₹' + item.price).join('\\n') }}\n\n💰 *Total: ₹{{ $json.body.amount }}*\n💳 *Payment:* {{ $json.body.paymentMethod }}\n\nWe'll notify you once your order is dispatched.\n\n💎 *Satvastones*\nAnti-tarnish • Waterproof • Premium Quality"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "http-request-admin",
      "name": "Send WhatsApp to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 500],
      "parameters": {
        "url": "={{ $env.WAHA_API_URL }}/api/sendText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "nodeCredential": "waha-api-key",
        "sendQuery": true,
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chatId",
              "value": "={{ $env.WHATSAPP_ADMIN_NUMBER }}@c.us"
            },
            {
              "name": "text",
              "value": "=🆕 *New Order Received!*\n\nOrder: *{{ $json.body.orderNumber }}*\nCustomer: {{ $json.body.customer.name }}\nPhone: {{ $json.body.phone }}\nAmount: *₹{{ $json.body.amount }}*\nPayment: {{ $json.body.paymentMethod }}\nItems: {{ $json.body.items.length }}\n\n{{ $json.body.items.map(item => '• ' + item.title + ' x' + item.qty).join('\\n') }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "continueOnFail": true
    },
    {
      "id": "if-has-phone",
      "name": "Customer has phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.phone }}",
              "operation": "notEmpty",
              "value2": ""
            }
          ]
        }
      }
    },
    {
      "id": "noop-end",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [740, 200]
    }
  ],
  "connections": {
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "if-has-phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "if-has-phone": {
      "main": [
        [
          {
            "node": "http-request-customer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "http-request-admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "http-request-customer": {
      "main": [
        [
          {
            "node": "http-request-admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "http-request-admin": {
      "main": [
        [
          {
            "node": "noop-end",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "satvastones-order-whatsapp-v1",
  "tags": ["satvastones", "whatsapp", "order"]
}
