/*
  # Indian E-Commerce IT Act 2000 & DPDP Act 2023 Compliant Security Headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://widget.cloudinary.com https://upload-widget.cloudinary.com https://*.cloudinary.com https://www.googletagmanager.com https://accounts.google.com; frame-src 'self' https://upload-widget.cloudinary.com https://widget.cloudinary.com https://*.cloudinary.com https://api.razorpay.com https://checkout.razorpay.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://*.cloudinary.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://*.cloudinary.com https://res.cloudinary.com; media-src 'self' blob: https: https://*.cloudinary.com https://res.cloudinary.com; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com https://api.cloudinary.com https://upload-widget.cloudinary.com https://widget.cloudinary.com https://*.cloudinary.com https://res.cloudinary.com https://*.supabase.co https://www.google-analytics.com https://accounts.google.com; child-src 'self' blob: https://upload-widget.cloudinary.com https://widget.cloudinary.com https://*.cloudinary.com;

# Content-hashed Astro JS/CSS bundles — 1 year immutable cache (Core Web Vitals boost)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static brand media & fonts — 30 day cache
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/models/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

# Private / transactional pages — never cache
/admin/*
  Cache-Control: private, no-store, no-cache, must-revalidate

/checkout/*
  Cache-Control: private, no-store, no-cache, must-revalidate

/account/*
  Cache-Control: private, no-store, no-cache, must-revalidate
