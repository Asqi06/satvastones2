---
// WhyUs.astro - The Four Pillars of Satvastones Craftsmanship (Tanishq Inspired)
const pillars = [
  {
    step: 'I',
    title: 'The PVD Vacuum Standard',
    description: 'Unlike ordinary cosmetic flash-plating that peels away in weeks, 18-karat gold is vaporized inside a vacuum chamber and molecularly bonded to the steel, providing 10x greater wear resistance.'
  },
  {
    step: 'II',
    title: '316L Surgical Core',
    description: 'We exclusively use biocompatible 316L medical-grade stainless steel containing molybdenum. It never rusts, is 100% hypoallergenic, and eliminates green skin stains.'
  },
  {
    step: 'III',
    title: 'Hand-Inspected Vapi Dispatch',
    description: 'Every necklace, ring, and earring undergoes stringent optical and clasp inspection at our Vapi store before being sealed in tamper-proof mailers within 24–48 hours.'
  },
  {
    step: 'IV',
    title: 'Honest Direct Value',
    description: 'No retail middlemen markups. We state all metal compositions and dimensions transparently, pairing high-end craftsmanship with accessible, direct pricing.'
  }
];
---

<section class="py-24 lg:py-28 bg-[#FFFDF9] border-t border-[#E5D8C3]">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-16">
      <span class="text-xs uppercase tracking-[0.25em] text-[#8C6D37] font-semibold">
        Unwavering Standards
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#2A1810] font-normal">
        Why Satvastones Stays Lustrous
      </h2>
      <div class="ornamental-divider">
        <span class="w-2 h-2 rotate-45 border border-[#C5A869] inline-block"></span>
      </div>
      <p class="text-xs sm:text-sm text-[#6B5E55] leading-relaxed font-light">
        We purposefully engineered our jewellery to solve the heartbreak of tarnished metals, irritated ears, and green fingers in Indian climates.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {pillars.map((item) => (
        <div class="bg-[#FAF6EF]/60 p-7 sm:p-8 rounded-sm border border-[#E5D8C3] hover:border-[#C5A869] hover:bg-white transition-all duration-300 flex flex-col justify-between space-y-5 shadow-xs group">
          <div class="flex items-center justify-between border-b border-[#E5D8C3]/60 pb-3">
            <span class="font-serif text-2xl text-[#8C6D37] font-normal group-hover:text-[#C5A869] transition-colors">{item.step}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#C5A869]"></span>
          </div>
          <div class="space-y-2.5">
            <h3 class="font-serif text-lg text-[#2A1810] font-medium leading-snug">{item.title}</h3>
            <p class="text-xs text-[#6B5E55] leading-relaxed font-light">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
