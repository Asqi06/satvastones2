---
// WhyUs.astro - The four pillars of Satvastones craftsmanship
const pillars = [
  {
    step: 'I',
    title: 'The PVD vacuum standard',
    description:
      'Cosmetic flash-plating peels within weeks. We vaporise 18-karat gold inside a vacuum chamber and bond it molecularly to the steel, for roughly ten times the wear resistance.'
  },
  {
    step: 'II',
    title: '316L surgical core',
    description:
      'Biocompatible 316L medical-grade stainless steel with molybdenum. It never rusts, stays hypoallergenic, and eliminates green skin marks.'
  },
  {
    step: 'III',
    title: 'Hand-inspected in Vapi',
    description:
      'Every necklace, ring and earring passes optical and clasp inspection at our Vapi atelier before it is sealed into a tamper-evident mailer.'
  },
  {
    step: 'IV',
    title: 'Honest direct value',
    description:
      'No retail middlemen markups. Metal compositions, dimensions and coating methods are stated plainly, at direct pricing.'
  }
];
---

<section class="relative overflow-hidden border-t border-[#2a2624] bg-[#14110f] text-[#f6f1e8]">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.16]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1440px] px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow text-[#c5a059]">Unwavering standards</p>
        <h2 class="font-display mt-2 text-[2.3rem] leading-[1.02] sm:text-[3.2rem]">
          Why Satvastones<br class="hidden sm:block" /> stays lustrous.
        </h2>
      </div>
      <p class="max-w-sm text-[12.5px] leading-relaxed text-[#b9b1a7] lg:col-span-5">
        Engineered to solve the three failures of everyday jewellery in India — tarnished metal,
        irritated ears, and green fingers.
      </p>
    </div>

    <ol class="mt-12 grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((item) => (
        <li class="flex flex-col bg-[#14110f] px-5 py-7 sm:px-6">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <span class="font-display text-[1.4rem] leading-none text-[#c5a059]">{item.step}</span>
            <span class="h-1 w-1 bg-[#c5a059]" aria-hidden="true"></span>
          </div>
          <h3 class="font-display mt-4 text-[1.2rem] leading-snug text-[#f6f1e8]">{item.title}</h3>
          <p class="mt-2 text-[11.5px] leading-relaxed text-[#b9b1a7]">{item.description}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
      <span>316L surgical steel</span>
      <span class="text-[#c5a059]" aria-hidden="true">✦</span>
      <span>18K gold PVD</span>
      <span class="text-[#c5a059]" aria-hidden="true">✦</span>
      <a href="/materials" class="text-[#f6f1e8] underline decoration-[#c5a059] underline-offset-4">
        Read the metallurgy
      </a>
    </div>
  </div>
</section>
