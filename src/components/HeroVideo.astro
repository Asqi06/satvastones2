---
// HeroVideo.astro — full-bleed editorial video hero.
// The video is eager (above the fold), muted, looped and poster-backed so the
// section still reads beautifully before /videos/hero.mp4 is supplied.
const poster =
  'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1920&q=80&fm=webp';
---

<section
  class="hero relative isolate flex h-[100svh] min-h-[620px] w-full flex-col overflow-hidden bg-[#171310] text-[#f6f1e8]"
  aria-label="Satvastones fine jewellery"
>
  <!-- Background film -->
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    src="/videos/hero.mp4"
    poster={poster}
    width="1920"
    height="1080"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    data-autoplay
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <!-- Warm cinematic grade + legibility scrims -->
  <div class="absolute inset-0 bg-[#2a1a0d]/25" aria-hidden="true"></div>
  <div class="absolute inset-x-0 top-0 h-52 bg-gradient-to-b from-black/60 via-black/20 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-80 bg-gradient-to-t from-black/70 via-black/25 to-transparent" aria-hidden="true"></div>
  <div class="grain absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-1 flex-col px-5 pb-20 pt-24 sm:px-8 sm:pt-28 lg:px-10 lg:pb-10">
    <!-- Top meta line -->
    <div class="hero-fade flex items-center justify-between gap-4 text-[9px] uppercase tracking-[0.24em] text-white/65 sm:text-[10px]">
      <span>Fine jewellery · Vapi, India</span>
      <span class="hidden sm:block">Anti-tarnish · Waterproof · Everyday</span>
    </div>

    <!-- Wordmark -->
    <div class="flex flex-1 flex-col items-center justify-center text-center">
      <h1 class="hero-wordmark font-display">
        <span class="hero-wordmark-inner" aria-hidden="true">satvastones</span>
        <span class="sr-only">Anti-tarnish, waterproof fine jewellery for every day</span>
      </h1>
      <p class="hero-fade hero-fade--delay mt-7 text-[9px] uppercase tracking-[0.34em] text-white/75 sm:mt-9 sm:text-[10px]">
        Fine jewellery for every day
      </p>
    </div>

    <!-- Actions -->
    <div class="hero-fade hero-fade--late flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          href="/shop"
          class="group inline-flex items-center gap-3 bg-[#f6f1e8] px-6 py-3.5 text-[10px] uppercase tracking-[0.2em] text-[#171310] transition-colors duration-300 hover:bg-[#e3c98d] sm:px-7"
        >
          <span>Shop the collection</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="/collections/bestsellers" class="link-line text-[10px] uppercase tracking-[0.2em] text-white/85 hover:text-white">
          Bestsellers
        </a>
      </div>

      <div class="flex items-center gap-5 self-start sm:self-auto">
        <button
          id="hero-video-toggle"
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-white/25 bg-black/15 text-white/85 backdrop-blur-sm transition-colors hover:border-white/60 hover:text-white cursor-pointer"
          aria-label="Pause background video"
          aria-pressed="false"
          title="Pause background video"
        >
          <svg class="hero-icon-pause h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="5" width="4" height="14" rx="1" />
            <rect x="14" y="5" width="4" height="14" rx="1" />
          </svg>
          <svg class="hero-icon-play hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14Z" />
          </svg>
        </button>

        <a href="#story" class="hidden flex-col items-center gap-2 text-[9px] uppercase tracking-[0.24em] text-white/60 transition-colors hover:text-white sm:flex">
          <span>Scroll</span>
          <svg class="scroll-cue h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l-6-6m6 6l6-6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wordmark-inner {
    display: inline-block;
    animation: hero-wordmark-rise 1.5s cubic-bezier(0.16, 1, 0.3, 1) both 0.15s;
  }

  .hero-fade {
    animation: hero-fade-in 1.1s ease both 0.85s;
  }

  .hero-fade--delay {
    animation-delay: 1s;
  }

  .hero-fade--late {
    animation-delay: 1.15s;
  }

  @keyframes hero-wordmark-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 42px, 0);
      filter: blur(16px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wordmark-inner,
    .hero-fade {
      animation: none;
    }
  }
</style>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggle = document.getElementById('hero-video-toggle') as HTMLButtonElement | null;
  const pauseIcon = toggle?.querySelector('.hero-icon-pause') as SVGElement | null;
  const playIcon = toggle?.querySelector('.hero-icon-play') as SVGElement | null;

  const syncToggle = () => {
    if (!video || !toggle) return;
    const isPaused = video.paused || video.ended;
    toggle.setAttribute('aria-pressed', String(isPaused));
    toggle.setAttribute('aria-label', isPaused ? 'Play background video' : 'Pause background video');
    toggle.setAttribute('title', isPaused ? 'Play background video' : 'Pause background video');
    pauseIcon?.classList.toggle('hidden', isPaused);
    playIcon?.classList.toggle('hidden', !isPaused);
  };

  if (video && toggle) {
    // If the file has not been supplied yet, keep the poster and drop the control.
    video.addEventListener('error', () => {
      toggle.hidden = true;
    });

    toggle.addEventListener('click', () => {
      if (video.paused) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
      syncToggle();
    });

    video.addEventListener('play', syncToggle);
    video.addEventListener('pause', syncToggle);
    syncToggle();
  }
</script>
