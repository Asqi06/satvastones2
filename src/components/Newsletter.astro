---
// Newsletter.astro — editorial signup band.
---

<section class="border-t border-[#e3dcd1] bg-[#f4efe7]">
  <div class="mx-auto grid max-w-[1440px] items-end gap-10 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:gap-16 lg:px-10">
    <div data-reveal>
      <p class="eyebrow text-[#8b837a]">The Satvastones Circle</p>
      <h2 class="mt-4 max-w-md font-display text-[2.6rem] leading-[0.98] text-[#14110f] sm:text-6xl">
        ₹200 toward your first piece.
      </h2>
    </div>

    <div class="max-w-md lg:justify-self-end" data-reveal style="--reveal-delay: 100ms">
      <p class="text-sm leading-relaxed text-[#5a524a]">
        Early access to capsule drops, atelier stories and quiet offers. One thoughtful email at a time — never spam.
      </p>

      <form id="newsletter-form" class="mt-7">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <div class="flex items-center border-b border-[#14110f]/30 transition-colors focus-within:border-[#14110f]">
          <input
            id="newsletter-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Your email address"
            required
            class="w-full bg-transparent py-3 text-sm text-[#14110f] placeholder:text-[#9c9389] focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 cursor-pointer py-3 pl-5 text-[10px] uppercase tracking-[0.2em] text-[#14110f] transition-opacity hover:opacity-60"
          >
            Join
          </button>
        </div>
        <p class="mt-3 text-[10px] uppercase tracking-[0.14em] text-[#9c9389]">
          Use code FIRSTBUY · Unsubscribe anytime
        </p>
        <p id="newsletter-status" class="mt-3 text-xs text-[#1b6d48]" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.getElementById('newsletter-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (form.querySelector('input[type="email"]') as HTMLInputElement | null)?.value.trim();

    if (!email) return;

    try {
      localStorage.setItem('satvastones_newsletter', JSON.stringify({ email, joinedAt: new Date().toISOString() }));
    } catch {
      // Storage can be unavailable in private browsing — the welcome message still matters.
    }

    if (status) {
      status.textContent = 'You are in. Use FIRSTBUY for ₹200 off your first order.';
    }
    form.reset();
  });
</script>
