---
// CraftScene.astro — lazy three.js diamond ring (real GLB) with room-light
// reflections. three.js, GLTFLoader and the meshopt decoder are code-split and
// only fetched once the section approaches the viewport. Rendering pauses
// offscreen and is replaced by a single static frame for reduced-motion
// visitors. A lightweight procedural band is shown until the model arrives.
---

<section class="relative overflow-hidden bg-[#12100e] text-[#f4efe7]" aria-labelledby="craft-heading">
  <div class="dot-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="absolute -right-40 top-1/2 h-[38rem] w-[38rem] -translate-y-1/2 rounded-full bg-[#c5a059]/10 blur-[130px]" aria-hidden="true"></div>
  <div class="absolute -left-40 bottom-0 h-[24rem] w-[24rem] rounded-full bg-[#c5a059]/10 blur-[120px]" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-[1440px] items-center gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:gap-10 lg:px-10 lg:py-32">
    <div class="order-2 lg:order-1" data-reveal>
      <p class="eyebrow text-[#c5a059]">Craft, considered</p>
      <h2 id="craft-heading" class="mt-5 max-w-lg font-display text-4xl leading-[1.02] sm:text-6xl lg:text-7xl" data-split>
        Gold that keeps its word.
      </h2>
      <p class="mt-6 max-w-md text-sm leading-relaxed text-white/55">
        A ring begins as 316L surgical steel, then receives a molecular 18K gold PVD bond — measured in microns, made for years of showers, commutes and celebrations.
      </p>

      <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-white/10 pt-6">
        <div>
          <dt class="text-[9px] uppercase tracking-[0.2em] text-white/35">Finish</dt>
          <dd class="mt-1.5 font-serif text-lg text-[#e3c98d]">18K PVD</dd>
        </div>
        <div>
          <dt class="text-[9px] uppercase tracking-[0.2em] text-white/35">Core</dt>
          <dd class="mt-1.5 font-serif text-lg text-[#e3c98d]">316L</dd>
        </div>
        <div>
          <dt class="text-[9px] uppercase tracking-[0.2em] text-white/35">Dispatch</dt>
          <dd class="mt-1.5 font-serif text-lg text-[#e3c98d]">24–48h</dd>
        </div>
      </dl>

      <a href="/materials" class="link-line mt-10 text-[10px] uppercase tracking-[0.2em] text-white/70 transition-colors hover:text-white">
        Explore the materials
      </a>
    </div>

    <div class="order-1 lg:order-2" data-reveal style="--reveal-delay: 140ms">
      <div data-craft-stage class="relative mx-auto aspect-square w-full max-w-[32rem]">
        <div class="absolute inset-8 rounded-full border border-white/5" aria-hidden="true"></div>
        <div class="absolute inset-20 rounded-full border border-[#c5a059]/10" aria-hidden="true"></div>
        <canvas
          id="craft-canvas"
          class="relative block h-full w-full"
          role="img"
          aria-label="An 18K gold PVD diamond ring swaying slowly in studio light"
        ></canvas>
      </div>
      <p class="mt-2 text-center text-[8px] uppercase tracking-[0.24em] text-white/30">
        Move to explore · 18K gold PVD
      </p>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('craft-canvas') as HTMLCanvasElement | null;
  const stage = document.querySelector<HTMLElement>('[data-craft-stage]');

  if (canvas && stage) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let initialized = false;
    let visible = false;
    let cleanup: (() => void) | null = null;
    let startLoop: (() => void) | null = null;
    let stopLoop: (() => void) | null = null;

    const boot = async () => {
      if (initialized) return;
      initialized = true;

      try {
        const THREE = await import('three');
        const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');
        const { MeshoptDecoder } = await import('three/addons/libs/meshopt_decoder.module.js');

        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: 'high-performance'
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.16;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
        camera.position.set(0, 0.1, 6.6);

        const pmrem = new THREE.PMREMGenerator(renderer);

        // A hand-built studio environment: near-black room, three hard softbox
        // strips. A gem only reads as a gem when its facets mirror bright shapes
        // against black — a uniform white room turns every stone into enamel.
        const envCanvas = document.createElement('canvas');
        envCanvas.width = 1024;
        envCanvas.height = 512;
        const eg = envCanvas.getContext('2d');
        if (eg) {
          const backdrop = eg.createLinearGradient(0, 0, 0, 512);
          backdrop.addColorStop(0, '#171310');
          backdrop.addColorStop(0.52, '#0a0908');
          backdrop.addColorStop(1, '#040404');
          eg.fillStyle = backdrop;
          eg.fillRect(0, 0, 1024, 512);

          const softbox = (x: number, y: number, w: number, h: number, colour: string, strength: number) => {
            const cx = x + w / 2;
            const cy = y + h / 2;
            const radius = Math.max(w, h) / 2;
            const grad = eg.createRadialGradient(cx, cy, 0, cx, cy, radius);
            grad.addColorStop(0, colour);
            grad.addColorStop(0.55, colour);
            grad.addColorStop(1, 'rgba(0,0,0,0)');
            eg.save();
            eg.globalAlpha = strength;
            eg.translate(cx, cy);
            eg.scale(w / (2 * radius), h / (2 * radius));
            eg.translate(-cx, -cy);
            eg.fillStyle = grad;
            eg.beginPath();
            eg.arc(cx, cy, radius, 0, Math.PI * 2);
            eg.fill();
            eg.restore();
          };

          // Broad overhead scrim — gives metal body instead of mirror-black.
          const scrim = eg.createLinearGradient(0, 0, 0, 300);
          scrim.addColorStop(0, 'rgba(255,246,232,0.62)');
          scrim.addColorStop(0.55, 'rgba(255,238,214,0.24)');
          scrim.addColorStop(1, 'rgba(255,238,214,0)');
          eg.fillStyle = scrim;
          eg.fillRect(0, 0, 1024, 300);

          // Warm floor bounce so the band's lower edge never goes dead black.
          const bounce = eg.createLinearGradient(0, 330, 0, 440);
          bounce.addColorStop(0, 'rgba(120,96,64,0)');
          bounce.addColorStop(0.5, 'rgba(140,110,74,0.5)');
          bounce.addColorStop(1, 'rgba(120,96,64,0)');
          eg.fillStyle = bounce;
          eg.fillRect(0, 330, 1024, 110);

          // Hard sources sit on top of the scrim so reflections stay crisp.
          softbox(60, 30, 520, 210, 'rgba(255,250,240,1)', 0.85);
          softbox(150, 40, 260, 150, 'rgba(255,252,245,1)', 1);
          softbox(600, 70, 190, 190, 'rgba(255,226,180,1)', 0.95);
          softbox(878, 0, 46, 330, 'rgba(255,255,255,1)', 1);

          eg.globalAlpha = 1;
        }
        const envTexture = new THREE.CanvasTexture(envCanvas);
        envTexture.mapping = THREE.EquirectangularReflectionMapping;
        envTexture.colorSpace = THREE.SRGBColorSpace;
        const envTarget = pmrem.fromEquirectangular(envTexture);
        scene.environment = envTarget.texture;
        scene.environmentIntensity = 1.25;
        envTexture.dispose();

        // Shared materials — the GLB's white gold is re-tinted to the 18K PVD tone.
        const gold = new THREE.MeshPhysicalMaterial({
          color: 0xe8c37c,
          metalness: 1,
          roughness: 0.17,
          clearcoat: 0.35,
          clearcoatRoughness: 0.25,
          envMapIntensity: 3.1
        });

        // Diamonds: a near-mirror dielectric lit by small point sources. Each
        // flat facet catches its own pinpoint highlight, which is what the eye
        // reads as a cut stone — a broad white env just makes enamel.
        const diamond = new THREE.MeshPhysicalMaterial({
          color: 0xffffff,
          metalness: 0,
          roughness: 0.04,
          flatShading: true,
          ior: 2.42,
          clearcoat: 1,
          clearcoatRoughness: 0.02,
          iridescence: 0.28,
          iridescenceIOR: 2,
          iridescenceThicknessRange: [140, 380],
          envMapIntensity: 1.25
        });

        // Warm cream pearl used by the procedural fallback only.
        const pearlMaterial = new THREE.MeshPhysicalMaterial({
          color: 0xe9dcc6,
          metalness: 0,
          roughness: 0.3,
          clearcoat: 0.6,
          clearcoatRoughness: 0.2,
          sheen: 1,
          sheenColor: 0xffe2bd,
          sheenRoughness: 0.6,
          envMapIntensity: 1.1,
          iridescence: 0.18,
          iridescenceIOR: 1.35
        });

        // The turntable pivot. Base pose shows the face of the ring, then the
        // band turns into profile as it spins.
        const group = new THREE.Group();
        group.rotation.set(0.3, 0, 0);
        scene.add(group);

        // Fallback: a simple gold band and pearl, replaced once the GLB loads.
        const fallback = new THREE.Group();
        const band = new THREE.Mesh(new THREE.TorusGeometry(1.5, 0.28, 96, 220), gold);
        fallback.add(band);
        const pearl = new THREE.Mesh(new THREE.SphereGeometry(0.3, 64, 64), pearlMaterial);
        pearl.position.set(0, 1.9, 0);
        fallback.add(pearl);
        group.add(fallback);

        const sparkleGeometry = new THREE.BufferGeometry();
        const sparkleCount = 170;
        const positions = new Float32Array(sparkleCount * 3);
        for (let i = 0; i < sparkleCount; i += 1) {
          const radius = 2.6 + Math.random() * 2.8;
          const theta = Math.random() * Math.PI * 2;
          const phi = Math.acos(2 * Math.random() - 1);
          positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
          positions[i * 3 + 1] = radius * Math.cos(phi) * 0.75;
          positions[i * 3 + 2] = radius * Math.sin(phi) * Math.sin(theta);
        }
        sparkleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

        const sparkleMaterial = new THREE.PointsMaterial({
          color: 0xe3c98d,
          size: 0.022,
          transparent: true,
          opacity: 0.55,
          depthWrite: false,
          sizeAttenuation: true
        });
        const sparkles = new THREE.Points(sparkleGeometry, sparkleMaterial);
        scene.add(sparkles);

        const ambient = new THREE.AmbientLight(0xfff4e2, 0.18);
        scene.add(ambient);

        const key = new THREE.DirectionalLight(0xfff1d6, 1.2);
        key.position.set(4, 6, 6);
        scene.add(key);

        // Small hard sources: these are what put a separate pinpoint on each
        // stone facet instead of one soft wash.
        const glintA = new THREE.PointLight(0xfff6e6, 42, 24, 2);
        glintA.position.set(2.8, 3.6, 4.4);
        scene.add(glintA);

        const glintB = new THREE.PointLight(0xffe9c8, 30, 22, 2);
        glintB.position.set(-3.6, 1.8, 3.2);
        scene.add(glintB);

        const glintC = new THREE.PointLight(0xf2f6ff, 24, 20, 2);
        glintC.position.set(0.4, -2.6, 4.2);
        scene.add(glintC);

        const rim = new THREE.PointLight(0xc5a059, 18, 20, 2);
        rim.position.set(-4, 2, -3);
        scene.add(rim);

        // Pointer-led tilt (fine pointers only).
        const target = { x: 0, y: 0 };
        const current = { x: 0, y: 0 };
        const onPointerMove = (event: PointerEvent) => {
          const rect = stage.getBoundingClientRect();
          target.x = ((event.clientY - rect.top) / rect.height - 0.5) * 0.26;
          target.y = ((event.clientX - rect.left) / rect.width - 0.5) * 0.4;
        };
        const supportsHover = window.matchMedia('(pointer: fine)').matches;
        if (supportsHover) stage.addEventListener('pointermove', onPointerMove, { passive: true });

        const resize = () => {
          const width = stage.clientWidth;
          const height = stage.clientHeight;
          if (!width || !height) return;
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        resize();
        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(stage);

        const clock = new THREE.Clock();
        let modelRoot: any = null;

        const renderFrame = (delta: number, time: number) => {
          current.x += (target.x - current.x) * 0.06;
          current.y += (target.y - current.y) * 0.06;
          const drift = Math.sin(time * 0.28) * 0.05;
          // A slow sway around the hero pose rather than a full turntable: the
          // setting stays visible and the empty basket never faces the viewer.
          const sway = Math.sin(time * 0.24) * 0.38;
          group.rotation.x = 0.3 + drift + current.x;
          group.rotation.y = 0 + sway + current.y;
          sparkles.rotation.y = time * 0.035;
          renderer.render(scene, camera);
        };

        // Load the real ring. The model already faces +Z with the setting at
        // 12 o'clock; it only needs centring and a fixed display size.
        const loader = new GLTFLoader();
        loader.setMeshoptDecoder(MeshoptDecoder);
        loader.load(
          '/models/ring.glb',
          (gltf) => {
            const model = gltf.scene;
            model.traverse((child: any) => {
              if (!child.isMesh) return;
              const materialName = child.material?.name ?? '';
              if (/white gold 2/i.test(materialName)) return;
              // Rim shells ship without a material, so anything unnamed is gold.
              if (!materialName || /white gold/i.test(materialName)) {
                child.material = gold;
                return;
              }
              child.material.envMapIntensity = 1.15;
              child.material.needsUpdate = true;
            });

            const holder = new THREE.Group();
            holder.add(model);
            // The Doji ring is modelled flat, face up (+Y), setting at 6 o'clock;
            // stand it up and roll the setting to 12 o'clock.
            holder.quaternion
              .setFromAxisAngle(new THREE.Vector3(0, 0, 1), Math.PI)
              .multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), Math.PI / 2));
            holder.updateMatrixWorld(true);

            const bounds = new THREE.Box3().setFromObject(holder);
            const centre = bounds.getCenter(new THREE.Vector3());
            const size = bounds.getSize(new THREE.Vector3());
            const scale = 2.9 / Math.max(size.x, size.y, size.z);
            holder.scale.setScalar(scale);
            holder.position.copy(centre).multiplyScalar(-scale);

            modelRoot = holder;
            group.add(holder);
            fallback.visible = false;

            if (reduceMotion) renderFrame(0.016, 0);
          },
          undefined,
          () => {
            // Network or decode failure: the procedural band stays on screen.
          }
        );

        renderer.setAnimationLoop(() => {
          const delta = Math.min(clock.getDelta(), 0.05);
          renderFrame(delta, clock.elapsedTime);
        });
        startLoop = () => {
          clock.getDelta();
          renderer.setAnimationLoop(() => {
            const delta = Math.min(clock.getDelta(), 0.05);
            renderFrame(delta, clock.elapsedTime);
          });
        };
        stopLoop = () => {
          renderer.setAnimationLoop(null);
        };

        if (reduceMotion) {
          renderer.setAnimationLoop(null);
          renderFrame(0.016, 0);
        }

        cleanup = () => {
          resizeObserver.disconnect();
          if (supportsHover) stage.removeEventListener('pointermove', onPointerMove);
          renderer.setAnimationLoop(null);
          band.geometry.dispose();
          pearl.geometry.dispose();
          pearlMaterial.dispose();
          gold.dispose();
          diamond.dispose();
          modelRoot?.traverse((child: any) => {
            if (child.isMesh) child.geometry.dispose();
          });
          sparkleGeometry.dispose();
          sparkleMaterial.dispose();
          envTarget.dispose();
          pmrem.dispose();
          renderer.dispose();
        };

        // Respect the current visibility state after async boot.
        if (reduceMotion) {
          stopLoop = null;
          startLoop = null;
        } else if (!visible) {
          stopLoop?.();
        }
      } catch (error) {
        console.warn('CraftScene: WebGL scene unavailable.', error);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) {
            void boot();
            startLoop?.();
          } else {
            stopLoop?.();
          }
        });
      },
      { rootMargin: '240px 0px', threshold: 0.05 }
    );

    observer.observe(stage);
    window.addEventListener('pagehide', () => {
      observer.disconnect();
      cleanup?.();
    }, { once: true });
  }
</script>
