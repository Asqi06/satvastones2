---
import type { Product } from '../types/ecommerce';
import { formatPrice } from '../data/products';

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function getOptimizedImageUrl(url: string, width = 450): string {
  if (!url) return url;
  if (url.includes('images.unsplash.com')) {
    let clean = url.replace(/w=\d+/, `w=${width}`).replace(/&q=\d+/, '&q=80');
    if (!clean.includes('fm=')) clean += '&fm=webp';
    return clean;
  }
  return url;
}

const rawPrimaryImage = product.images[0]?.url || 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=450&q=80&fm=webp';
const rawSecondaryImage = product.images[1]?.url || rawPrimaryImage;

const primaryImage = getOptimizedImageUrl(rawPrimaryImage, 450);
const secondaryImage = getOptimizedImageUrl(rawSecondaryImage, 450);

const discountPercent = product.compareAtPricePaise
  ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
  : 0;
---

<div class="product-card group relative flex flex-col bg-white border border-[#eae4dc] rounded-[18px] overflow-hidden transition-all duration-300 hover:shadow-[0_12px_28px_rgba(23,21,19,0.06)] hover:border-[#c5a059]/40">
  
  <!-- Image Container (Jewelsmars 3:4 Aspect Ratio with Squircle Curves) -->
  <a href={`/products/${product.slug}`} class="relative block aspect-[3/4] overflow-hidden bg-[#faf8f5] rounded-t-[18px]" aria-label={product.name}>
    
    <!-- Top-Left Badges (Jewelsmars Signature Mauve #a1505a) -->
    <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1">
      {product.isBestseller && (
        <span class="bg-[#9f4553] text-white text-[9px] font-semibold uppercase tracking-[0.08em] px-2.5 py-0.5 rounded-full shadow-2xs">
          Hot Selling
        </span>
      )}
      {discountPercent > 0 && (
        <span class="bg-[#171513] text-[#fbf8f5] text-[9px] font-bold px-2 py-0.5 rounded-full shadow-2xs">
          -{discountPercent}%
        </span>
      )}
      {product.isNewArrival && !product.isBestseller && (
        <span class="bg-[#c5a059] text-white text-[9px] font-bold uppercase tracking-[0.08em] px-2 py-0.5 rounded-full shadow-2xs">
          New
        </span>
      )}
    </div>

    <!-- Floating Circular Wishlist Heart Button (Bottom-Right of Image) -->
    <button
      type="button"
      data-wishlist-id={product.id}
      data-wishlist-name={product.name}
      data-wishlist-slug={product.slug}
      data-wishlist-price={product.pricePaise}
      data-wishlist-image={primaryImage}
      class="card-wishlist-btn absolute bottom-2.5 right-2.5 z-10 w-8 h-8 rounded-full bg-white/95 hover:bg-white text-[#171513] hover:text-[#9f4553] border border-[#eae4dc] flex items-center justify-center transition-all shadow-xs hover:shadow-md cursor-pointer hover:scale-105 active:scale-95"
      title="Save to wishlist"
      aria-label={`Save ${product.name} to wishlist`}
    >
      <svg class="w-4 h-4 stroke-[1.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path strokeLinecap="round" strokeLinejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
    </button>

    <!-- Primary Image with Responsive srcset -->
    <img
      src={primaryImage}
      srcset={`${getOptimizedImageUrl(rawPrimaryImage, 300)} 300w, ${getOptimizedImageUrl(rawPrimaryImage, 450)} 450w, ${getOptimizedImageUrl(rawPrimaryImage, 600)} 600w`}
      sizes="(max-width: 640px) 48vw, (max-width: 1024px) 30vw, 320px"
      alt={product.images[0]?.alt || `${product.name} - Waterproof Anti Tarnish Jewellery India`}
      width="400"
      height="533"
      loading="lazy"
      decoding="async"
      class="product-card-image absolute inset-0 w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-0"
    />

    <!-- Secondary Hover Image -->
    <img
      src={secondaryImage}
      srcset={`${getOptimizedImageUrl(rawSecondaryImage, 300)} 300w, ${getOptimizedImageUrl(rawSecondaryImage, 450)} 450w, ${getOptimizedImageUrl(rawSecondaryImage, 600)} 600w`}
      sizes="(max-width: 640px) 48vw, (max-width: 1024px) 30vw, 320px"
      alt={product.images[1]?.alt || `${product.name} view - 18K Gold PVD Satvastones`}
      width="400"
      height="533"
      loading="lazy"
      decoding="async"
      class="product-card-image absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    />
  </a>

  <!-- Content & Details (Jewelsmars Mobile-First Clean Hierarchy) -->
  <div class="p-3.5 sm:p-4 flex flex-col flex-1 justify-between space-y-2.5 bg-white">
    <div class="space-y-1">
      <!-- Ratings & Reviews -->
      <div class="flex items-center gap-1.5 text-[11px]">
        <div class="flex items-center text-[#f2707f] gap-0.5">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg class={`w-3 h-3 ${i < Math.round(product.rating) ? 'fill-current' : 'text-gray-200 fill-current'}`} viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="font-bold text-[#111111] text-[11px]">{product.rating}</span>
        <span class="text-[#888888] text-[10px]">({product.reviewCount})</span>
      </div>

      <!-- Title (2-line clamp) -->
      <h3 class="text-[13px] sm:text-[14px] font-medium text-[#171513] leading-snug line-clamp-2 hover:text-[#9f4553] transition-colors">
        <a href={`/products/${product.slug}`}>
          {product.name}
        </a>
      </h3>

      <p class="text-[11px] text-[#666666] line-clamp-1">
        {product.material}
      </p>
    </div>

    <!-- Pricing & Full-Width Jewelsmars "ADD TO CART" Button -->
    <div class="space-y-2.5 pt-1">
      <div class="flex items-baseline gap-2">
        <span class="font-bold text-base sm:text-lg text-[#171513]">
          {formatPrice(product.pricePaise)}
        </span>
        {product.compareAtPricePaise && (
          <span class="text-xs text-[#99918b] line-through font-normal">
            {formatPrice(product.compareAtPricePaise)}
          </span>
        )}
      </div>

      <!-- Full-Width Jewelsmars Pink Add to Cart CTA -->
      <button
        type="button"
        data-product-id={product.id}
        data-product-name={product.name}
        data-product-slug={product.slug}
        data-product-price={product.pricePaise}
        data-product-image={primaryImage}
        aria-label={`Add ${product.name} to cart`}
        class="quick-add-btn w-full bg-[#171513] hover:bg-[#9f4553] text-white py-2.5 rounded-[10px] text-[11px] font-bold uppercase tracking-[0.08em] transition-all duration-200 shadow-2xs hover:shadow-md cursor-pointer flex items-center justify-center gap-1.5 active:scale-[0.99]"
      >
        <span>ADD TO CART</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { addToCart } from '../stores/cartStore';
  import { toggleWishlist, isInWishlist } from '../stores/wishlistStore';

  document.querySelectorAll('.card-wishlist-btn').forEach((btn) => {
    const el = btn as HTMLElement;
    const id = el.dataset.wishlistId || '';
    if (id && isInWishlist(id)) {
      el.classList.add('text-[#9f4553]', 'bg-[#faf4f2]', 'border-[#9f4553]');
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isSaved = toggleWishlist({
        id: el.dataset.wishlistId || '',
        name: el.dataset.wishlistName || '',
        slug: el.dataset.wishlistSlug || '',
        sku: '',
        category: '',
        headline: '',
        description: '',
        material: '',
        finish: '',
        careInstructions: [],
        warranty: '',
        pricePaise: parseInt(el.dataset.wishlistPrice || '0', 10),
        rating: 5,
        reviewCount: 0,
        images: [{ url: el.dataset.wishlistImage || '', alt: el.dataset.wishlistName || '' }],
        inStock: true
      });
      if (isSaved) {
        el.classList.add('text-[#9f4553]', 'bg-[#faf4f2]', 'border-[#9f4553]');
      } else {
        el.classList.remove('text-[#9f4553]', 'bg-[#faf4f2]', 'border-[#9f4553]');
      }
    });
  });

  document.querySelectorAll('.quick-add-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const el = e.currentTarget as HTMLElement;
      addToCart({
        productId: el.dataset.productId || '',
        name: el.dataset.productName || '',
        slug: el.dataset.productSlug || '',
        pricePaise: parseInt(el.dataset.productPrice || '0', 10),
        image: el.dataset.productImage || '',
        quantity: 1
      });
    });
  });
</script>
