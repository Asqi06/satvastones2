---
import type { Product } from '../types/ecommerce';
import { formatPrice } from '../data/products';

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function getOptimizedImageUrl(url: string, width = 450): string {
  if (!url) return url;
  if (url.includes('res.cloudinary.com') && url.includes('/image/upload/')) {
    const parts = url.split('/image/upload/');
    if (parts.length === 2) {
      const rest = parts[1].replace(/^(?:[^/]*,)?w_\d+[^/]*\//, '');
      return `${parts[0]}/image/upload/f_auto,q_auto,w_${width},c_limit/${rest}`;
    }
  }
  if (url.includes('images.unsplash.com')) {
    let clean = url.replace(/w=\d+/, `w=${width}`).replace(/&q=\d+/, '&q=80');
    if (!clean.includes('fm=')) clean += '&fm=webp';
    return clean;
  }
  return url;
}

const rawPrimaryImage = product.images[0]?.url || 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=450&q=80&fm=webp';
const rawSecondaryImage = product.images[1]?.url || rawPrimaryImage;

const primaryImage = getOptimizedImageUrl(rawPrimaryImage, 450);
const secondaryImage = getOptimizedImageUrl(rawSecondaryImage, 450);

const discountPercent = product.compareAtPricePaise
  ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
  : 0;
---

<div class="product-card group relative flex flex-col" data-product-card>
  <!-- Image -->
  <a
    href={`/products/${product.slug}`}
    class="relative block aspect-[3/4] overflow-hidden bg-[#f1ece3]"
    aria-label={product.name}
  >
    <div class="absolute left-3 top-3 z-10 flex flex-col items-start gap-1.5">
      {product.isBestseller && (
        <span class="bg-[#14110f] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#f6f1e8]">
          Bestseller
        </span>
      )}
      {discountPercent > 0 && (
        <span class="bg-[#c5a059] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-white">
          −{discountPercent}%
        </span>
      )}
      {product.isNewArrival && !product.isBestseller && (
        <span class="bg-[#f6f1e8] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#14110f]">
          New
        </span>
      )}
    </div>

    <button
      type="button"
      data-wishlist-id={product.id}
      data-wishlist-name={product.name}
      data-wishlist-slug={product.slug}
      data-wishlist-price={product.pricePaise}
      data-wishlist-image={primaryImage}
      class="card-wishlist-btn absolute bottom-3 right-3 z-10 flex h-8 w-8 items-center justify-center border border-[#14110f]/15 bg-white/85 text-[#14110f] backdrop-blur-sm transition-all hover:border-[#14110f] hover:bg-white hover:text-[#8d3f3d] cursor-pointer"
      title="Save to wishlist"
      aria-label={`Save ${product.name} to wishlist`}
      aria-pressed="false"
    >
      <svg class="h-4 w-4 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path strokeLinecap="round" strokeLinejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
    </button>

    <img
      src={primaryImage}
      srcset={`${getOptimizedImageUrl(rawPrimaryImage, 300)} 300w, ${getOptimizedImageUrl(rawPrimaryImage, 450)} 450w, ${getOptimizedImageUrl(rawPrimaryImage, 600)} 600w`}
      sizes="(max-width: 640px) 48vw, (max-width: 1024px) 30vw, 320px"
      alt={product.images[0]?.alt || `${product.name} — waterproof anti-tarnish jewellery India`}
      width="400"
      height="533"
      loading="lazy"
      decoding="async"
      class="product-card-image absolute inset-0 h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-0"
    />

    <img
      src={secondaryImage}
      srcset={`${getOptimizedImageUrl(rawSecondaryImage, 300)} 300w, ${getOptimizedImageUrl(rawSecondaryImage, 450)} 450w, ${getOptimizedImageUrl(rawSecondaryImage, 600)} 600w`}
      sizes="(max-width: 640px) 48vw, (max-width: 1024px) 30vw, 320px"
      alt={product.images[1]?.alt || `${product.name} alternate view — 18K gold PVD`}
      width="400"
      height="533"
      loading="lazy"
      decoding="async"
      class="product-card-image absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    />
  </a>

  <!-- Details -->
  <div class="flex flex-1 flex-col gap-2.5 pt-3.5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="font-serif text-[15px] leading-snug text-[#14110f] transition-colors hover:text-[#8d3f3d] sm:text-base">
          <a href={`/products/${product.slug}`}>{product.name}</a>
        </h3>
        <p class="mt-1 line-clamp-1 text-[9px] uppercase tracking-[0.14em] text-[#8b837a]">
          {product.material}
        </p>
      </div>

      <div class="mt-0.5 flex shrink-0 items-center gap-1 text-[10px] text-[#8b837a]">
        <svg class="h-2.5 w-2.5 fill-[#c5a059]" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>{product.rating}</span>
        <span class="text-[#b3aaa1]">({product.reviewCount})</span>
      </div>
    </div>

    <div class="mt-auto space-y-2.5">
      <div class="flex items-baseline gap-2">
        <span class="text-sm font-medium text-[#14110f] sm:text-[15px]">
          {formatPrice(product.pricePaise)}
        </span>
        {product.compareAtPricePaise && (
          <span class="text-[11px] font-normal text-[#a39a91] line-through">
            {formatPrice(product.compareAtPricePaise)}
          </span>
        )}
      </div>

      <button
        type="button"
        data-product-id={product.id}
        data-product-name={product.name}
        data-product-slug={product.slug}
        data-product-price={product.pricePaise}
        data-product-image={primaryImage}
        aria-label={`Add ${product.name} to bag`}
        class="quick-add-btn w-full border border-[#14110f]/25 py-2.5 text-[9px] font-medium uppercase tracking-[0.2em] text-[#14110f] transition-colors duration-300 hover:border-[#14110f] hover:bg-[#14110f] hover:text-[#f6f1e8] cursor-pointer active:scale-[0.99]"
      >
        Add to bag
      </button>
    </div>
  </div>
</div>

<script>
  import { addToCart } from '../stores/cartStore';
  import { toggleWishlist, isInWishlist } from '../stores/wishlistStore';

  const savedClasses = ['text-[#8d3f3d]', 'bg-[#f4efe7]', 'border-[#8d3f3d]'];

  document.querySelectorAll<HTMLElement>('.product-card[data-product-card]').forEach((card) => {
    if (card.dataset.bound === 'true') return;
    card.dataset.bound = 'true';

    const wishlistBtn = card.querySelector<HTMLElement>('.card-wishlist-btn');
    const addBtn = card.querySelector<HTMLElement>('.quick-add-btn');

    if (wishlistBtn) {
      const id = wishlistBtn.dataset.wishlistId || '';
      if (id && isInWishlist(id)) {
        wishlistBtn.classList.add(...savedClasses);
        wishlistBtn.setAttribute('aria-pressed', 'true');
      }

      wishlistBtn.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const isSaved = toggleWishlist({
          id: wishlistBtn.dataset.wishlistId || '',
          name: wishlistBtn.dataset.wishlistName || '',
          slug: wishlistBtn.dataset.wishlistSlug || '',
          sku: '',
          category: '',
          headline: '',
          description: '',
          material: '',
          finish: '',
          careInstructions: [],
          warranty: '',
          pricePaise: parseInt(wishlistBtn.dataset.wishlistPrice || '0', 10),
          rating: 5,
          reviewCount: 0,
          images: [{ url: wishlistBtn.dataset.wishlistImage || '', alt: wishlistBtn.dataset.wishlistName || '' }],
          inStock: true
        });

        wishlistBtn.classList.toggle('text-[#8d3f3d]', isSaved);
        wishlistBtn.classList.toggle('bg-[#f4efe7]', isSaved);
        wishlistBtn.classList.toggle('border-[#8d3f3d]', isSaved);
        wishlistBtn.setAttribute('aria-pressed', String(isSaved));
      });
    }

    if (addBtn) {
      addBtn.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        addToCart({
          productId: addBtn.dataset.productId || '',
          name: addBtn.dataset.productName || '',
          slug: addBtn.dataset.productSlug || '',
          pricePaise: parseInt(addBtn.dataset.productPrice || '0', 10),
          image: addBtn.dataset.productImage || '',
          quantity: 1
        });
      });
    }
  });
</script>
