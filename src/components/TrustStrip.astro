---
// TrustStrip.astro - The Satvastones Royal Promise (Refined Luxury SVG Icons)
const promises = [
  {
    type: 'gold',
    title: '18K Gold PVD Coating',
    subtitle: 'Vacuum-atomic bonding on surgical 316L steel for extraordinary durability and water resistance.'
  },
  {
    type: 'hypo',
    title: 'Hypoallergenic & Zero Green Skin',
    subtitle: '100% nickel-free & lead-free. Safe for daily showers, sensitive ears, and humid Indian weather.'
  },
  {
    type: 'vapi',
    title: 'Dispatched from Vapi in 24–48 Hrs',
    subtitle: 'Hand-inspected and sealed from our Vapi (Gujarat) store location with tamper-proof packaging.'
  },
  {
    type: 'shipping',
    title: 'Free Pan-India Delivery Above ₹499',
    subtitle: 'Express delivery with live SMS & WhatsApp tracking via BlueDart, Delhivery, and DTDC.'
  }
];
---

<section class="border-y border-[#E5D8C3] bg-[#FAF6EF]/80 py-10 relative overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {promises.map((item) => (
        <div class="flex items-start gap-4 p-4 rounded-xl border border-[#E5D8C3]/50 bg-[#FFFDF9]/60 hover:bg-[#FFFDF9] transition-all duration-300">
          <div class="w-10 h-10 rounded-full bg-[#FAF6EF] border border-[#C5A869]/40 flex items-center justify-center text-[#8C6D37] shrink-0 shadow-xs">
            {item.type === 'gold' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
            )}
            {item.type === 'hypo' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            )}
            {item.type === 'vapi' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            )}
            {item.type === 'shipping' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375" />
              </svg>
            )}
          </div>
          <div class="space-y-1">
            <h4 class="font-serif text-sm font-semibold text-[#2A1810] tracking-wide">
              {item.title}
            </h4>
            <p class="text-xs text-[#6B5E55] leading-relaxed font-light">
              {item.subtitle}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
