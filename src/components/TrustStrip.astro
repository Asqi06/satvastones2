---
// TrustStrip.astro - The Satvastones promise
const promises = [
  {
    type: 'gold',
    title: '18K gold PVD',
    subtitle: 'Vacuum-atomic bonding onto surgical 316L steel — not flash plating.'
  },
  {
    type: 'hypo',
    title: 'Zero green skin',
    subtitle: 'Nickel-free and lead-free. Safe for showers, workouts and sensitive ears.'
  },
  {
    type: 'vapi',
    title: 'Dispatched in 24–48h',
    subtitle: 'Hand-inspected and sealed at the Vapi atelier in tamper-evident packaging.'
  },
  {
    type: 'shipping',
    title: 'Free delivery over ₹499',
    subtitle: 'Pan-India express with live SMS and WhatsApp tracking.'
  }
];
---

<section class="border-y border-[#e5ded3] bg-[#f4efe7]" aria-label="The Satvastones promise">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
    <ul class="grid grid-cols-1 gap-px bg-[#ded5c7] sm:grid-cols-2 lg:grid-cols-4">
      {promises.map((item, i) => (
        <li class="flex items-start gap-3.5 bg-[#f4efe7] px-5 py-6 sm:px-6">
          <span
            class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center border border-[#d8c3a6] text-[#8d3f3d]"
            aria-hidden="true"
          >
            {item.type === 'gold' && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
                />
              </svg>
            )}
            {item.type === 'hypo' && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                />
              </svg>
            )}
            {item.type === 'vapi' && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                />
              </svg>
            )}
            {item.type === 'shipping' && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375"
                />
              </svg>
            )}
          </span>

          <div>
            <p class="text-[8.5px] uppercase tracking-[0.2em] text-[#c5a059]">
              {String(i + 1).padStart(2, '0')}
            </p>
            <p class="mt-1 text-[12.5px] font-medium leading-snug text-[#14110f]">{item.title}</p>
            <p class="mt-1 text-[11px] leading-relaxed text-[#6f675f]">{item.subtitle}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
