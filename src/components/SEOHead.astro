---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'product' | 'article';
  schema?: Record<string, any> | Array<Record<string, any>>;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const {
  title = 'Satvastones – Anti Tarnish & Waterproof Everyday Jewellery in India',
  description = 'Shop luxury everyday anti tarnish jewellery in India. 18K gold vacuum PVD & 316L surgical steel necklaces, rings, bracelets & sets. Free express shipping above ₹499.',
  canonicalUrl = Astro.url.href.replace('satvastonesjewellery.in', 'www.satvastones.in').split('?')[0],
  ogImage = 'https://www.satvastones.in/og-image.jpg',
  type = 'website',
  schema,
  breadcrumbs,
  noindex = false
} = Astro.props;

const siteUrl = 'https://www.satvastones.in';

// Enhanced Google-compliant Organization / JewelryStore Schema with Local SEO for Vapi, Gujarat
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['JewelryStore', 'Organization'],
  '@id': `${siteUrl}/#store`,
  'name': 'Satvastones Jewellery',
  'alternateName': ['SatvaStones', 'Satvastones Anti Tarnish Jewellery', 'Satvastones India', 'satvastones.in'],
  'legalName': 'Satvastones Jewellery (Proprietor: Anirudh A Verma)',
  'taxID': '24DDAPV4074H1ZF',
  'url': siteUrl,
  'sameAs': [
    'https://satvastones.in',
    'https://www.satvastones.in'
  ],
  'logo': `${siteUrl}/satvastones-logo.png`,
  'image': `${siteUrl}/og-image.jpg`,
  'description': 'India’s premier anti-tarnish jewellery atelier offering waterproof, sweat-resistant 18K gold vacuum PVD and 316L surgical stainless steel jewellery. Dispatched within 24-48 hours from Chala, Vapi, Gujarat.',
  'telephone': '+91 90167 03180',
  'email': 'support@satvastones.in',
  'contactPoint': [
    {
      '@type': 'ContactPoint',
      'telephone': '+91 90167 03180',
      'contactType': 'customer service',
      'email': 'support@satvastones.in',
      'areaServed': 'IN',
      'availableLanguage': ['en', 'hi']
    }
  ],
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': 'Chala',
    'addressLocality': 'Vapi',
    'addressRegion': 'Gujarat',
    'postalCode': '396191',
    'addressCountry': 'IN'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 20.3721,
    'longitude': 72.9106
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      'opens': '10:00',
      'closes': '19:00'
    }
  ],
  'currenciesAccepted': 'INR',
  'paymentAccepted': 'UPI, Google Pay, PhonePe, Paytm, RuPay, Visa, Mastercard, NetBanking, Razorpay',
  'priceRange': '₹₹',
  'areaServed': {
    '@type': 'Country',
    'name': 'India'
  },
  'hasMerchantReturnPolicy': {
    '@type': 'MerchantReturnPolicy',
    'applicableCountry': 'IN',
    'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
    'merchantReturnDays': 7,
    'returnMethod': 'https://schema.org/ReturnByMail',
    'returnFees': 'https://schema.org/FreeReturn',
    'customerRemorseReturnFees': 'https://schema.org/ReturnFeesCustomerResponsibility'
  }
};

// WebSite Schema with Sitelinks Searchbox
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  'url': siteUrl,
  'name': 'Satvastones Jewellery',
  'description': 'Anti-Tarnish and Waterproof Jewellery in India',
  'publisher': {
    '@id': `${siteUrl}/#store`
  },
  'potentialAction': {
    '@type': 'SearchAction',
    'target': {
      '@type': 'EntryPoint',
      'urlTemplate': `${siteUrl}/shop?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

// BreadcrumbList Schema (if breadcrumbs prop provided)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': crumb.name,
    'item': crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url}`
  }))
} : null;

// Normalize custom schemas into an array
const customSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content={noindex ? "noindex, nofollow, noarchive" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Anirudh A Verma, Satvastones Jewellery" />
<meta name="geo.region" content="IN-GJ" />
<meta name="geo.placename" content="Chala, Vapi, Gujarat, India" />
<meta name="geo.position" content="20.3721;72.9106" />
<meta name="ICBM" content="20.3721, 72.9106" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Satvastones" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Fonts Preconnect: Cormorant Garamond & DM Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
  rel="stylesheet"
/>

<!-- Core Structured Data: Organization & Website -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- Breadcrumbs Structured Data -->
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

<!-- Custom Page Schemas (e.g. Product, FAQPage, ItemList) -->
{customSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
