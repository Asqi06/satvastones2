---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'product' | 'article';
  schema?: Record<string, any> | Array<Record<string, any>>;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const rawCanonical = Astro.props.canonicalUrl || Astro.url.href
  .replace('://satvastones.in', '://www.satvastones.in')
  .replace('://satvastonesjewellery.in', '://www.satvastones.in')
  .replace('://www.satvastonesjewellery.in', '://www.satvastones.in')
  .split('?')[0];
const canonicalUrl =
  rawCanonical.endsWith('/') && rawCanonical !== 'https://www.satvastones.in/'
    ? rawCanonical.slice(0, -1)
    : rawCanonical;

const {
  title = 'Satvastones – Affordable Anti-Tarnish & Waterproof Jewellery for Women in India',
  description = 'Shop affordable, waterproof & non-tarnish 18K gold plated jewellery for women in India. 316L surgical steel rings, bracelets, necklaces & earrings that never lose color. Dispatched from Vapi, Gujarat — free shipping above ₹499.',
  ogImage = 'https://www.satvastones.in/satvastones-logo-clean.png',
  type = 'website',
  schema,
  breadcrumbs,
  noindex = false
} = Astro.props;

const siteUrl = 'https://www.satvastones.in';

// Enhanced Google-compliant Organization / JewelryStore Schema with Local SEO (Vapi, Gujarat) & Pan-India GEO
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['JewelryStore', 'Organization'],
  '@id': `${siteUrl}/#store`,
  'name': 'Satvastones Jewellery',
  'alternateName': [
    'SatvaStones',
    'Satvastones Anti Tarnish Jewellery',
    'Satvastones India',
    'Satvastones Vapi',
    'satvastones.in'
  ],
  'legalName': 'Satvastones Jewellery (Proprietor: Anirudh A Verma)',
  'taxID': '24DDAPV4074H1ZF',
  'url': siteUrl,
  'sameAs': [
    'https://satvastones.in',
    'https://www.satvastones.in'
  ],
  'logo': `${siteUrl}/satvastones-logo.png`,
  'image': `${siteUrl}/satvastones-logo-clean.png`,
  'description': 'Affordable anti-tarnish, waterproof, and non-tarnish jewellery brand in India offering 18K gold PVD plated rings, bracelets, necklaces, earrings, and bangles on 316L surgical stainless steel that never lose color. Based in Chala, Vapi, Gujarat with 24–48 hour express delivery across India.',
  'telephone': '+91 90167 03180',
  'email': 'support@satvastones.in',
  'contactPoint': [
    {
      '@type': 'ContactPoint',
      'telephone': '+91 90167 03180',
      'contactType': 'customer service',
      'email': 'support@satvastones.in',
      'areaServed': 'IN',
      'availableLanguage': ['en', 'hi', 'gu']
    }
  ],
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': 'Chala',
    'addressLocality': 'Vapi',
    'addressRegion': 'Gujarat',
    'postalCode': '396191',
    'addressCountry': 'IN'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 20.3721,
    'longitude': 72.9106
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      'opens': '10:00',
      'closes': '19:00'
    }
  ],
  'currenciesAccepted': 'INR',
  'paymentAccepted': 'UPI, Google Pay, PhonePe, Paytm, RuPay, Visa, Mastercard, NetBanking, Razorpay, Cash on Delivery',
  'priceRange': '₹179 – ₹2,499',
  'areaServed': [
    { '@type': 'City', 'name': 'Vapi' },
    { '@type': 'City', 'name': 'Daman' },
    { '@type': 'City', 'name': 'Silvassa' },
    { '@type': 'City', 'name': 'Valsad' },
    { '@type': 'City', 'name': 'Surat' },
    { '@type': 'State', 'name': 'Gujarat' },
    { '@type': 'Country', 'name': 'India' }
  ],
  'knowsAbout': [
    'Anti-tarnish jewellery for women',
    'Waterproof jewellery in India',
    'Affordable non-tarnish jewellery under ₹500',
    'Minimal 18K gold PVD plated rings and waterproof bracelets',
    'Nickel-free hypoallergenic Korean crystal earrings for sensitive ears',
    'Jewellery gifts for girlfriend under ₹500 in India',
    'Mystery jewellery jar India',
    '316L surgical stainless steel jewellery',
    'Anti-tarnish jewellery shop in Vapi, Gujarat'
  ],
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Satvastones Anti-Tarnish & Waterproof Jewellery Catalog',
    'itemListElement': [
      { '@type': 'OfferCatalog', 'name': '18K Gold Plated Anti-Tarnish Rings', 'url': `${siteUrl}/collections/rings` },
      { '@type': 'OfferCatalog', 'name': 'Waterproof Anti-Tarnish Bracelets', 'url': `${siteUrl}/collections/bracelets` },
      { '@type': 'OfferCatalog', 'name': 'Waterproof Anti-Tarnish Necklaces', 'url': `${siteUrl}/collections/necklaces` },
      { '@type': 'OfferCatalog', 'name': 'Hypoallergenic Anti-Tarnish Earrings', 'url': `${siteUrl}/collections/earrings` },
      { '@type': 'OfferCatalog', 'name': 'Anti-Tarnish Kada Bangles', 'url': `${siteUrl}/collections/bangles` },
      { '@type': 'OfferCatalog', 'name': 'Anti-Tarnish Jewellery Sets', 'url': `${siteUrl}/collections/jewellery-set` }
    ]
  },
  'hasMerchantReturnPolicy': {
    '@type': 'MerchantReturnPolicy',
    'applicableCountry': 'IN',
    'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
    'merchantReturnDays': 7,
    'returnMethod': 'https://schema.org/ReturnByMail',
    'returnFees': 'https://schema.org/FreeReturn',
    'customerRemorseReturnFees': 'https://schema.org/ReturnFeesCustomerResponsibility'
  }
};

// WebSite Schema with Sitelinks Searchbox
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  'url': siteUrl,
  'name': 'Satvastones Jewellery',
  'description': 'Anti-Tarnish and Waterproof Jewellery in India',
  'publisher': {
    '@id': `${siteUrl}/#store`
  },
  'potentialAction': {
    '@type': 'SearchAction',
    'target': {
      '@type': 'EntryPoint',
      'urlTemplate': `${siteUrl}/shop?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

// BreadcrumbList Schema (if breadcrumbs prop provided)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': crumb.name,
    'item': crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url}`
  }))
} : null;

// Normalize custom schemas into an array
const customSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content={noindex ? "noindex, nofollow, noarchive" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Anirudh A Verma, Satvastones Jewellery" />
<meta name="geo.region" content="IN-GJ" />
<meta name="geo.placename" content="Chala, Vapi, Gujarat, India" />
<meta name="geo.position" content="20.3721;72.9106" />
<meta name="ICBM" content="20.3721, 72.9106" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Satvastones" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Zero-Render-Blocking Google Fonts (Instrument Serif & Instrument Sans) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap"
  />
</noscript>

<!-- Core Structured Data: Organization & Website -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- Breadcrumbs Structured Data -->
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

<!-- Custom Page Schemas (e.g. Product, FAQPage, ItemList) -->
{customSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
