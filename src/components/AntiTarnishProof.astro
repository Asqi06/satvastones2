  <div class="bg-gradient-to-br from-[#faf8f5] via-white to-[#f6f2ec] border border-[#eae4dc] rounded-[28px] p-6 sm:p-12 shadow-xs">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-2 mb-10">
