---
// Footer.astro — dark editorial closing chapter.
---

<footer class="relative overflow-hidden bg-[#12100e] pb-24 text-[#f4efe7] lg:pb-0">
  <div class="mx-auto max-w-[1440px] px-5 pt-16 sm:px-8 sm:pt-20 lg:px-10">
    <div class="grid gap-12 border-b border-white/10 pb-14 lg:grid-cols-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-block" aria-label="Satvastones Fine Jewellery Homepage">
          <img
            src="/satvastones-logo-white.png"
            alt="Satvastones Fine Jewellery"
            width="168"
            height="52"
            class="h-9 w-auto object-contain sm:h-11"
          />
        </a>

        <p class="mt-6 max-w-sm text-sm leading-relaxed text-white/50">
          Everyday anti-tarnish jewellery in 316L surgical steel and 18K gold PVD. Waterproof, nickel-free and hand-inspected in Vapi, Gujarat.
        </p>

        <ul class="mt-7 space-y-2.5 text-[10px] uppercase tracking-[0.16em] text-white/40">
          <li class="flex items-center gap-3">
            <span class="h-1 w-1 rounded-full bg-[#c5a059]"></span>
            <span>Dispatched in 24–48 hours</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-1 w-1 rounded-full bg-[#c5a059]"></span>
            <span>Free express shipping above ₹499</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-1 w-1 rounded-full bg-[#c5a059]"></span>
            <span>7-day size exchange</span>
          </li>
        </ul>

        <a
          href="https://wa.me/919016703180"
          target="_blank"
          rel="noopener noreferrer"
          class="link-line mt-8 text-[11px] uppercase tracking-[0.16em] text-[#e3c98d]"
        >
          +91 90167 03180
        </a>
      </div>

      <!-- Link columns -->
      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8 lg:gap-8">
        <div>
          <h4 class="text-[9px] uppercase tracking-[0.22em] text-white/35">Shop</h4>
          <ul class="mt-5 space-y-2.5 text-[13px] text-white/65">
            <li><a href="/shop" class="transition-colors hover:text-[#e3c98d]">All jewellery</a></li>
            <li><a href="/collections/new-arrivals" class="transition-colors hover:text-[#e3c98d]">New in</a></li>
            <li><a href="/collections/rings" class="transition-colors hover:text-[#e3c98d]">Rings</a></li>
            <li><a href="/collections/necklaces" class="transition-colors hover:text-[#e3c98d]">Necklaces</a></li>
            <li><a href="/collections/bracelets" class="transition-colors hover:text-[#e3c98d]">Bracelets</a></li>
            <li><a href="/collections/earrings" class="transition-colors hover:text-[#e3c98d]">Earrings</a></li>
            <li><a href="/collections/bangles" class="transition-colors hover:text-[#e3c98d]">Bangles</a></li>
            <li><a href="/collections/gift-sets" class="transition-colors hover:text-[#e3c98d]">Gift sets</a></li>
            <li>
              <a href="/stack-builder" class="flex items-center gap-2 font-medium text-white transition-colors hover:text-[#e3c98d]">
                Stack Studio
                <span class="border border-[#c5a059]/40 bg-[#c5a059]/10 px-1.5 py-0.5 text-[8px] font-medium uppercase tracking-[0.14em] text-[#e3c98d]">15% off</span>
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-[9px] uppercase tracking-[0.22em] text-white/35">Concierge</h4>
          <ul class="mt-5 space-y-2.5 text-[13px] text-white/65">
            <li><a href="/track-order" class="transition-colors hover:text-[#e3c98d]">Track order</a></li>
            <li><button type="button" class="footer-ring-sizer-trigger cursor-pointer text-left transition-colors hover:text-[#e3c98d]">Ring sizer</button></li>
            <li><a href="/faqs" class="transition-colors hover:text-[#e3c98d]">FAQs</a></li>
            <li><a href="/jewellery-care" class="transition-colors hover:text-[#e3c98d]">Care guide</a></li>
            <li><a href="/materials" class="transition-colors hover:text-[#e3c98d]">Materials</a></li>
            <li><a href="/shipping-policy" class="transition-colors hover:text-[#e3c98d]">Shipping</a></li>
            <li><a href="/refund-policy" class="transition-colors hover:text-[#e3c98d]">Returns &amp; exchanges</a></li>
            <li><a href="/policies/warranty" class="transition-colors hover:text-[#e3c98d]">Quality standards</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[9px] uppercase tracking-[0.22em] text-white/35">The fine print</h4>
          <ul class="mt-5 space-y-2.5 text-[13px] text-white/65">
            <li><a href="/journal" class="transition-colors hover:text-[#e3c98d]">Journal &amp; guides</a></li>
            <li><a href="/affordable-anti-tarnish-jewellery-india" class="transition-colors hover:text-[#e3c98d]">Affordable anti-tarnish India</a></li>
            <li><a href="/anti-tarnish-jewellery-vapi" class="transition-colors hover:text-[#e3c98d]">Vapi jewellery atelier</a></li>
            <li><a href="/about" class="transition-colors hover:text-[#e3c98d]">Our story</a></li>
            <li><a href="/contact" class="transition-colors hover:text-[#e3c98d]">Contact</a></li>
            <li><a href="/privacy-policy" class="transition-colors hover:text-[#e3c98d]">Privacy (DPDP)</a></li>
            <li><a href="/terms-and-conditions" class="transition-colors hover:text-[#e3c98d]">Terms</a></li>
            <li><a href="/grievance-redressal" class="transition-colors hover:text-[#e3c98d]">Grievance redressal</a></li>
            <li><a href="/privacy-rights" class="transition-colors hover:text-[#e3c98d]">Privacy rights</a></li>
            <li>
              <button
                type="button"
                id="footer-cookie-pref-btn"
                class="flex cursor-pointer items-center gap-2 text-left transition-colors hover:text-[#e3c98d]"
              >
                <span>Cookie preferences</span>
                <span class="border border-white/15 px-1 py-0.5 font-mono text-[8px] text-white/40">DPDP</span>
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Legal -->
    <div class="flex flex-col gap-5 py-8 text-[10px] leading-relaxed text-white/35 md:flex-row md:items-start md:justify-between">
      <div class="max-w-2xl space-y-1">
        <p>© 2026 Satvastones Fine Jewellery. All rights reserved.</p>
        <p>
          Operated as a registered Indian sole proprietorship under the legal name of
          <strong class="font-medium text-white/55">Anirudh A Verma</strong>
          (GSTIN: <strong class="font-medium text-white/55">24DDAPV4074H1ZF</strong>).
          Fulfilment from Chala, Vapi, Gujarat — 396191, India.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="text-[9px] uppercase tracking-[0.16em] text-white/30">Secured via Razorpay</span>
        <div class="flex items-center gap-2 border border-white/10 px-3 py-1.5 text-[10px] font-medium text-white/60">
          <span>UPI</span>
          <span class="text-white/20">·</span>
          <span>Cards</span>
          <span class="text-white/20">·</span>
          <span>NetBanking</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Closing wordmark -->
  <div class="pointer-events-none select-none overflow-hidden px-4" aria-hidden="true">
    <p class="font-display -mb-[0.16em] text-center text-[19vw] leading-none tracking-[-0.055em] text-white/[0.055]">
      satvastones
    </p>
  </div>
</footer>

<script>
  const ringSizerTriggers = document.querySelectorAll('.footer-ring-sizer-trigger');
  ringSizerTriggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('satvastones:open_ring_sizer'));
    });
  });

  const cookiePrefBtn = document.getElementById('footer-cookie-pref-btn');
  cookiePrefBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('satvastones:open_cookie_preferences'));
  });
</script>
