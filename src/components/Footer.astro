---
// Footer.astro - Jewelsmars Clean Modern Footer with Authentic Satvastones White Script Logo
---

<footer class="bg-[#171513] text-[#faf6f0] pt-14 pb-20 lg:pb-12 border-t border-[#262220]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 pb-12 border-b border-[#262220]">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="block" aria-label="Satvastones Fine Jewellery Homepage">
          <img
            src="/satvastones-logo-white.png"
            alt="Satvastones Fine Jewellery"
            width="168"
            height="52"
            class="h-9 sm:h-11 w-auto object-contain mb-2"
          />
        </a>
        <p class="text-xs text-white/70 leading-relaxed max-w-sm">
          Satvastones crafts everyday anti-tarnish fine jewellery using hypoallergenic 316L surgical stainless steel and 18K vacuum gold PVD. 100% waterproof, sweat-resistant, and hand-inspected at our Vapi atelier in Gujarat.
        </p>
        <div class="pt-2 text-xs text-[#c5a059] font-medium space-y-1.5">
          <p class="flex items-center gap-2">
            <span class="text-[9px]">✦</span>
            <span class="text-white/85">Dispatched from Vapi Atelier in 24–48 Hours</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[9px]">✦</span>
            <span class="text-white/85">Complimentary Express Shipping on orders &gt; ₹499</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[9px]">✦</span>
            <span class="text-white/85">Zero Green Skin Guarantee • 316L Surgical Steel</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[9px]">✦</span>
            <span class="text-white/85">Concierge: support@satvastones.in</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
            <span>Call & WhatsApp: <a href="https://wa.me/919016703180" class="hover:underline text-white font-bold">+91 90167 03180</a></span>
          </p>
        </div>
      </div>

      <!-- Quick Collections -->
      <div>
        <h4 class="text-xs uppercase tracking-widest font-semibold text-white mb-4">Shop Collections</h4>
        <ul class="space-y-2 text-xs text-white/70">
          <li><a href="/shop" class="hover:text-[#c5a059] transition-colors">All Jewellery</a></li>
          <li><a href="/collections/rings" class="hover:text-[#c5a059] transition-colors">Anti-Tarnish Rings</a></li>
          <li><a href="/collections/bracelets" class="hover:text-[#c5a059] transition-colors">Chains & Bracelets</a></li>
          <li><a href="/collections/necklaces" class="hover:text-[#c5a059] transition-colors">Pendants & Necklaces</a></li>
          <li><a href="/collections/earrings" class="hover:text-[#c5a059] transition-colors">Waterproof Earrings</a></li>
          <li><a href="/stack-builder" class="hover:text-[#c5a059] transition-colors text-white font-medium flex items-center gap-1.5">
            <span>Stack Studio</span>
            <span class="text-[9px] bg-[#9f4553] text-white px-1.5 py-0.2 rounded-full font-bold">15% OFF</span>
          </a></li>
          <li><a href="/collections/bestsellers" class="hover:text-[#c5a059] transition-colors">Bestsellers</a></li>
          <li><a href="/collections/new-arrivals" class="hover:text-[#c5a059] transition-colors">New Drops</a></li>
        </ul>
      </div>

      <!-- Customer Support & Tools -->
      <div>
        <h4 class="text-xs uppercase tracking-widest font-semibold text-white mb-4">Customer Care & Tools</h4>
        <ul class="space-y-2 text-xs text-white/70">
          <li><a href="/track-order" class="hover:text-[#c5a059] transition-colors text-[#c5a059] font-medium">Track Vapi Shipment</a></li>
          <li><button type="button" class="footer-ring-sizer-trigger hover:text-[#c5a059] transition-colors cursor-pointer text-left">Interactive Ring Sizer</button></li>
          <li><a href="/faqs" class="hover:text-[#c5a059] transition-colors">FAQs & Help Desk</a></li>
          <li><a href="/jewellery-care" class="hover:text-[#c5a059] transition-colors">Anti-Tarnish Care Guide</a></li>
          <li><a href="/shipping-policy" class="hover:text-[#c5a059] transition-colors">Shipping & Delivery Policy</a></li>
          <li><a href="/refund-policy" class="hover:text-[#c5a059] transition-colors">Cancellation & Returns (48h)</a></li>
          <li><a href="/policies/warranty" class="hover:text-[#c5a059] transition-colors">Quality Standards</a></li>
        </ul>
      </div>

      <!-- Legal, DPDP & Disclosures -->
      <div>
        <h4 class="text-xs uppercase tracking-widest font-semibold text-white mb-4">Legal & DPDP Compliance</h4>
        <ul class="space-y-2 text-xs text-white/70">
          <li><a href="/privacy-policy" class="hover:text-[#c5a059] transition-colors">Privacy Policy (DPDP Act)</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-[#c5a059] transition-colors">Terms & Conditions</a></li>
          <li><a href="/grievance-redressal" class="hover:text-[#c5a059] transition-colors text-[#e0a8b2] font-semibold">Grievance Redressal (48h)</a></li>
          <li><a href="/privacy-rights" class="hover:text-[#c5a059] transition-colors">Exercise Privacy Rights</a></li>
          <li>
            <button
              type="button"
              id="footer-cookie-pref-btn"
              class="hover:text-[#c5a059] transition-colors cursor-pointer text-left flex items-center gap-1.5"
            >
              <span>Cookie Preferences</span>
              <span class="text-[9px] bg-white/10 text-white/70 px-1.5 py-0.2 rounded font-mono">DPDP</span>
            </button>
          </li>
          <li><a href="/about" class="hover:text-[#c5a059] transition-colors">Our Vapi Story</a></li>
          <li><a href="/contact" class="hover:text-[#c5a059] transition-colors">Contact Support</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar with Legal Entity & Vapi Provenance -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-[11px] text-white/60 gap-4">
      <div class="space-y-1 text-center md:text-left">
        <p>© 2026 Satvastones Fine Jewellery. All rights reserved.</p>
        <p class="text-white/50">
          Operated as a registered Indian Sole Proprietorship under the legal name of <strong>Anirudh A Verma</strong> (GSTIN: <strong>24DDAPV4074H1ZF</strong>). Primary fulfillment from Chala, Vapi, Gujarat - 396191, India.
        </p>
      </div>

      <!-- Payment Badges (Razorpay, UPI, Cards) -->
      <div class="flex items-center gap-3">
        <span class="text-[10px] text-white/50 uppercase tracking-wider">Secured via Razorpay:</span>
        <div class="flex items-center gap-1.5 bg-[#221f1d] px-3 py-1.5 rounded-lg border border-[#36322e] text-white font-bold text-xs">
          <span>UPI</span>
          <span class="text-white/40">•</span>
          <span>Cards</span>
          <span class="text-white/40">•</span>
          <span>NetBanking</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const ringSizerTriggers = document.querySelectorAll('.footer-ring-sizer-trigger');
  ringSizerTriggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('satvastones:open_ring_sizer'));
    });
  });

  const cookiePrefBtn = document.getElementById('footer-cookie-pref-btn');
  cookiePrefBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('satvastones:open_cookie_preferences'));
  });
</script>
