---
// Reviews.astro - Authentic Verified Customer Testimonials Synced with Cloudflare D1
---

<section id="home-reviews-section" class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4 border-b border-[#e5ded3] pb-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-[0.16em] text-[#8d3f3d] flex items-center gap-1.5">
        <span class="text-[#c5a059]">✦</span>
        <span>AUTHENTIC PATRON EXPERIENCES</span>
      </span>
      <h2 class="font-serif text-2xl sm:text-4xl font-normal text-[#171513] tracking-tight mt-1">
        Loved By Modern Indian Women
      </h2>
      <p class="text-xs sm:text-sm text-[#6e6863] mt-0.5">
        Real customer experiences from verified purchases across Mumbai, Surat, Bengaluru, and Delhi NCR.
      </p>
    </div>

    <div class="flex items-center gap-3 bg-[#faf8f5] border border-[#e5ded3] px-4 py-2 self-start sm:self-auto">
      <div class="flex text-[#c5a059] gap-0.5">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <span class="text-xs font-bold text-[#171513]">Verified Reviews</span>
      <span class="text-[10px] text-[#6e6863]">• 100% Real Buyers</span>
    </div>
  </div>

  <div id="home-reviews-grid" class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
    <div class="col-span-full bg-white border border-[#e5ded3] rounded-[22px] p-8 text-center space-y-2">
      <p class="font-serif text-base text-[#171513]">Authentic Patron Reviews</p>
      <p class="text-xs text-[#6e6863]">Verified purchase reviews submitted by patrons will appear here automatically.</p>
    </div>
  </div>
</section>

<script>
  import { getStoredReviews, syncReviewsFromCloudflare, type CustomerReview } from '../stores/reviewStore';

  function renderDynamicHomeReviews(all?: CustomerReview[]) {
    const grid = document.getElementById('home-reviews-grid');
    if (!grid) return;

    const reviews = all || getStoredReviews();
    if (!reviews || reviews.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full bg-white border border-[#e5ded3] rounded-[22px] p-8 text-center space-y-2">
          <p class="font-serif text-base text-[#171513]">Authentic Patron Reviews</p>
          <p class="text-xs text-[#6e6863]">Verified purchase reviews submitted by patrons will appear here automatically.</p>
        </div>
      `;
      return;
    }

    const topReviews = reviews.slice(0, 3);
    grid.innerHTML = topReviews
      .map((r) => {
        const initials = (r.authorName || 'VP')
          .split(' ')
          .map((n) => n[0])
          .join('')
          .toUpperCase()
          .slice(0, 2);

        return `
        <div class="bg-white border border-[#e5ded3] p-6 rounded-[22px] hover:shadow-[0_12px_28px_rgba(23,21,19,0.06)] hover:border-[#c5a059]/50 transition-all flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex text-[#c5a059] gap-0.5">
                ${Array.from({ length: r.rating })
                  .map(
                    () => `
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                `
                  )
                  .join('')}
              </div>
              <span class="inline-flex items-center gap-1 text-[10px] bg-[#eef8f3] text-[#1b6d48] px-2.5 py-0.5 font-bold border border-[#c4e8d3]">
                <svg class="w-2.5 h-2.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Verified Buyer</span>
              </span>
            </div>

            <h3 class="text-sm font-bold text-[#171513]">"${r.title}"</h3>
            <p class="text-xs sm:text-sm text-[#4a443f] leading-relaxed">
              "${r.content}"
            </p>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-[#e5ded3]">
            <div class="w-10 h-10 bg-[#f4efe7] border border-[#e5ded3] flex items-center justify-center font-bold text-xs text-[#8d3f3d]">
              ${initials}
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-bold text-[#171513] truncate">${r.authorName}</p>
              <p class="text-[10px] text-[#6e6863]">${r.city} • ${r.date}</p>
            </div>
          </div>
        </div>
      `;
      })
      .join('');
  }

  // Initial render from local cache
  renderDynamicHomeReviews(getStoredReviews());

  // Cloudflare D1 real-time sync
  syncReviewsFromCloudflare().then((revs) => {
    renderDynamicHomeReviews(revs);
  });

  window.addEventListener('satvastones:reviews_synced', (e: any) => {
    renderDynamicHomeReviews(e.detail || []);
  });
</script>
