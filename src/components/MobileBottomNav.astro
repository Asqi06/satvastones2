---
// MobileBottomNav.astro — fixed bottom dock, editorial ink on cream
const items = [
  {
    href: '/',
    label: 'Home',
    d: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75'
  },
  {
    href: '/shop',
    label: 'Shop',
    d: 'M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z'
  },
  {
    href: '/wishlist',
    label: 'Saved',
    d: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z'
  },
  {
    href: '/track-order',
    label: 'Track',
    d: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375'
  }
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-[#e5ded3] bg-[#fbf9f5]/96 backdrop-blur-md lg:hidden"
  aria-label="Mobile navigation"
>
  <div class="grid grid-cols-5">
    {items.map((item) => (
      <a
        href={item.href}
        class="group flex flex-col items-center gap-1 py-2.5 text-[#14110f] transition-colors active:bg-[#f0ece5]"
        aria-label={item.label}
      >
        <svg class="h-[18px] w-[18px] stroke-[1.4]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d={item.d} />
        </svg>
        <span class="text-[8px] font-medium uppercase tracking-[0.14em] text-[#6f675f] group-active:text-[#14110f]">
          {item.label}
        </span>
      </a>
    ))}

    <button
      id="mobile-dock-cart-btn"
      type="button"
      aria-label="Open shopping bag"
      class="group relative flex cursor-pointer flex-col items-center gap-1 py-2.5 text-[#14110f] transition-colors active:bg-[#f0ece5]"
    >
      <span class="relative">
        <svg class="h-[18px] w-[18px] stroke-[1.4]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
        </svg>
        <span
          id="dock-cart-count-badge"
          class="absolute -right-2.5 -top-1.5 flex h-4 min-w-4 items-center justify-center bg-[#14110f] px-1 text-[8px] font-medium leading-none text-[#f6f1e8]"
        >
          0
        </span>
      </span>
      <span class="text-[8px] font-medium uppercase tracking-[0.14em] text-[#6f675f] group-active:text-[#14110f]">
        Bag
      </span>
    </button>
  </div>
</nav>

<script>
  import { getCartItems } from '../stores/cartStore';

  function updateDockBadge() {
    const badge = document.getElementById('dock-cart-count-badge');
    const items = getCartItems();
    const count = items.reduce((acc, i) => acc + i.quantity, 0);
    if (badge) {
      badge.textContent = count.toString();
      badge.style.display = count > 0 ? 'flex' : 'none';
    }
  }

  updateDockBadge();
  window.addEventListener('satvastones:cart_updated', updateDockBadge);

  document.getElementById('mobile-dock-cart-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('satvastones:open_cart'));
  });
</script>
