---
// MobileBottomNav.astro - Jewelsmars Fixed Bottom App Navigation Dock
---

<nav class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#eeeeee] py-2 px-3 shadow-[0_-4px_20px_rgba(0,0,0,0.06)] flex items-center justify-around" aria-label="Mobile Bottom Navigation">
  <!-- 1. Home -->
  <a href="/" class="flex flex-col items-center gap-0.5 text-[#111111] hover:text-[#f2707f] transition-colors py-1" aria-label="Go to Home">
    <svg class="w-5 h-5 stroke-[1.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
    </svg>
    <span class="text-[10px] font-semibold tracking-tight">Home</span>
  </a>

  <!-- 2. Categories / Shop -->
  <a href="/shop" class="flex flex-col items-center gap-0.5 text-[#111111] hover:text-[#f2707f] transition-colors py-1" aria-label="Browse Jewellery Suites">
    <svg class="w-5 h-5 stroke-[1.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
    </svg>
    <span class="text-[10px] font-semibold tracking-tight">Suites</span>
  </a>

  <!-- 3. Wishlist -->
  <a href="/wishlist" class="flex flex-col items-center gap-0.5 text-[#111111] hover:text-[#f2707f] transition-colors py-1 relative" aria-label="View Saved Wishlist">
    <svg class="w-5 h-5 stroke-[1.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
    </svg>
    <span class="text-[10px] font-semibold tracking-tight">Wishlist</span>
  </a>

  <!-- 4. Track Order -->
  <a href="/track-order" class="flex flex-col items-center gap-0.5 text-[#111111] hover:text-[#f2707f] transition-colors py-1" aria-label="Track Shipment">
    <svg class="w-5 h-5 stroke-[1.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.375c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v10.875c0 .621.504 1.125 1.125 1.125h1.5" />
    </svg>
    <span class="text-[10px] font-semibold tracking-tight">Track</span>
  </a>

  <!-- 5. Cart Button with Trigger -->
  <button
    id="mobile-dock-cart-btn"
    aria-label="Open Shopping Bag"
    class="flex flex-col items-center gap-0.5 text-[#111111] hover:text-[#f2707f] transition-colors py-1 relative cursor-pointer"
  >
    <div class="relative">
      <svg class="w-5 h-5 stroke-[1.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
      </svg>
      <span
        id="dock-cart-count-badge"
        class="absolute -top-1 -right-2 bg-[#f2707f] text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none"
      >
        0
      </span>
    </div>
    <span class="text-[10px] font-semibold tracking-tight">Bag</span>
  </button>
</nav>

<script>
  import { getCartItems } from '../stores/cartStore';

  function updateDockBadge() {
    const badge = document.getElementById('dock-cart-count-badge');
    const items = getCartItems();
    const count = items.reduce((acc, i) => acc + i.quantity, 0);
    if (badge) {
      badge.textContent = count.toString();
      badge.style.display = count > 0 ? 'flex' : 'none';
    }
  }

  updateDockBadge();
  window.addEventListener('satvastones:cart_updated', updateDockBadge);

  document.getElementById('mobile-dock-cart-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('satvastones:open_cart'));
  });
</script>
