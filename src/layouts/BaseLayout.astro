---
import SEOHead from '../components/SEOHead.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer';
import SearchModal from '../components/SearchModal';
import SocialProofToast from '../components/SocialProofToast';
import RingSizeModal from '../components/RingSizeModal';
import GSTInvoiceModal from '../components/GSTInvoiceModal';
import CookieConsentManager from '../components/CookieConsentManager';
import WelcomeOfferPopup from '../components/WelcomeOfferPopup';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'product' | 'article';
  schema?: Record<string, any>;
  noindex?: boolean;
}

const props = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index';
const isSensitiveRoute =
  Astro.url.pathname.startsWith('/checkout') ||
  Astro.url.pathname.startsWith('/admin');
const heroPosterUrl =
  'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1920&q=80&fm=webp';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <SEOHead {...props} />
    {isHome && (
      <link rel="preload" as="image" href={heroPosterUrl} fetchpriority="high" />
    )}
    {!isSensitiveRoute && (
      <>
        <!-- Google Consent Mode v2 (DPDP Default Denied) + GA4 Analytics (excluded on /checkout & /admin per PCI/secure-checkout) -->
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          var analyticsGranted = false;
          var marketingGranted = false;
          try {
            var saved = JSON.parse(localStorage.getItem('satvastones_dpdp_consent') || 'null');
            if (saved && saved.analytics) analyticsGranted = true;
            if (saved && saved.marketing) marketingGranted = true;
          } catch (e) {}
          gtag('consent', 'default', {
            analytics_storage: analyticsGranted ? 'granted' : 'denied',
            ad_storage: marketingGranted ? 'granted' : 'denied',
            ad_user_data: marketingGranted ? 'granted' : 'denied',
            ad_personalization: marketingGranted ? 'granted' : 'denied'
          });
          gtag('js', new Date());
          gtag('config', 'G-WPQLV3GX0Y');
        </script>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WPQLV3GX0Y"></script>
      </>
    )}
    <script is:inline>
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('has-js');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#111111] selection:bg-[#c5a059] selection:text-[#14110f]">
    <!-- Accessible Skip to Main Content Link for Screen Readers & Keyboard Users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[999999] focus:bg-[#111111] focus:text-white focus:px-4 focus:py-2.5 focus:rounded-xl focus:text-xs focus:font-bold focus:shadow-xl focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Announcement Bar (kept on interior pages; the homepage hero owns the first screen) -->
    {!isHome && <AnnouncementBar />}

    <!-- Navigation Header (transparent overlay on the homepage, solid elsewhere) -->
    <Header overlay={isHome} />

    <!-- Main Content Slot (with mobile dock clearance) -->
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <!-- WhatsApp Floating Concierge Widget -->
    <WhatsAppButton />

    <!-- Footer -->
    <Footer />

    <!-- Mobile Fixed Bottom Navigation Bar -->
    <MobileBottomNav />

    <!-- Client-side Interactive Islands (Deferred to client:idle to avoid hydration blocking LCP/FCP) -->
    <CartDrawer client:idle />
    <SearchModal client:idle />
    <SocialProofToast client:idle />
    <RingSizeModal client:idle />
    <GSTInvoiceModal client:idle />
    <CookieConsentManager client:idle />
    {!isSensitiveRoute && <WelcomeOfferPopup client:idle />}

    <!-- Motion layer -->
    <SmoothScroll />
    <ScrollReveal />
    <script>
      import '../scripts/catalog-cards';
    </script>
  </body>
</html>
