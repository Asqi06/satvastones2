---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Track Order', url: '/track-order' }
];
---

<BaseLayout
  title="Track Order | Satvastones Anti-Tarnish Jewellery"
  description="Track your Satvastones parcel and download your GST invoice. Orders are dispatched from our Vapi atelier within 24–48 hours via BlueDart or Delhivery express."
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <PageIntro
      eyebrow="Order status & invoice"
      title="Where is my parcel?"
      lede="Enter the order reference from your confirmation message, or the courier AWB. Every parcel leaves our Vapi atelier within 24–48 hours."
      crumbs={breadcrumbs}
    />

    <div class="mx-auto max-w-[1440px] px-5 pb-16 sm:px-8 sm:pb-24 lg:px-10">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Lookup -->
        <div class="lg:col-span-5">
          <div class="border border-[#e5ded3] bg-white p-5 sm:p-7 lg:sticky lg:top-24">
            <div class="border-b border-[#e5ded3] pb-3">
              <p class="eyebrow text-[#8d3f3d]">Lookup</p>
              <h2 class="font-display mt-1.5 text-[1.55rem] leading-none">Find your order</h2>
            </div>

            <form id="track-order-form" class="mt-5 space-y-4" novalidate>
              <div>
                <label for="track-order-id" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">
                  Order reference or AWB *
                </label>
                <input
                  id="track-order-id"
                  type="text"
                  required
                  autocomplete="off"
                  placeholder="SAT-2026-784912 or BLR-892147321"
                  class="track-input uppercase tracking-[0.06em]"
                />
              </div>

              <div>
                <label for="track-contact" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">
                  Phone or email <span class="normal-case tracking-normal text-[#8a8279]">(optional)</span>
                </label>
                <input
                  id="track-contact"
                  type="text"
                  autocomplete="off"
                  placeholder="9016703180 or priya@example.com"
                  class="track-input"
                />
              </div>

              <p id="track-error" class="hidden border-l-2 border-[#8d3f3d] bg-[#f8eeee] px-3 py-2 text-[11px] leading-relaxed text-[#8d3f3d]" role="alert"></p>

              <button
                type="submit"
                class="flex w-full cursor-pointer items-center justify-center gap-2 bg-[#14110f] px-6 py-3.5 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]"
              >
                Track shipment <span aria-hidden="true">→</span>
              </button>
            </form>

            <p class="mt-4 border-t border-[#e5ded3] pt-3 text-[10px] leading-relaxed text-[#8a8279]">
              Lost the reference? Message{' '}
              <a href="https://wa.me/919016703180" target="_blank" rel="noopener noreferrer" class="text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4">
                +91 90167 03180
              </a>{' '}
              or email{' '}
              <a href="mailto:support@satvastones.in" class="text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4">
                support@satvastones.in
              </a>
              .
            </p>
          </div>
        </div>

        <!-- Result -->
        <div class="lg:col-span-7">
          <!-- Placeholder before lookup -->
          <div id="tracking-placeholder" class="border border-[#e5ded3] bg-[#f4efe7] p-6 sm:p-8">
            <p class="eyebrow text-[#8d3f3d]">What happens next</p>
            <h2 class="font-display mt-2 text-[1.8rem] leading-tight sm:text-[2.2rem]">From atelier to doorstep.</h2>
            <ol class="mt-6 space-y-5">
              {[
                { t: 'Order confirmed', d: 'Payment verified and inventory reserved. You receive an SMS and email immediately.' },
                { t: 'Packed in Vapi', d: 'Hand-inspected, wrapped in the velvet pouch, sealed with the care certificate.' },
                { t: 'Dispatched in 24–48h', d: 'Handed to BlueDart or Delhivery air express with a live AWB number.' },
                { t: 'Delivered', d: '2–3 business days to metros, 3–5 to the rest of India.' }
              ].map((s, i) => (
                <li class="flex gap-4">
                  <span class="font-display text-[1.1rem] leading-none text-[#c5a059]">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p class="text-[12.5px] font-medium text-[#14110f]">{s.t}</p>
                    <p class="mt-0.5 text-[11.5px] leading-relaxed text-[#6f675f]">{s.d}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <!-- Live result -->
          <div id="tracking-result" class="hidden border border-[#e5ded3] bg-white p-5 sm:p-7">
            <div class="flex flex-col justify-between gap-3 border-b border-[#e5ded3] pb-4 sm:flex-row sm:items-start">
              <div>
                <p class="text-[9px] uppercase tracking-[0.18em] text-[#c5a059]">Vapi atelier dispatch</p>
                <h2 id="result-order-num" class="font-display mt-1.5 text-[1.4rem] leading-none"></h2>
                <p id="result-patron-info" class="mt-1.5 text-[11px] text-[#8a8279]"></p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <span id="result-status-pill" class="inline-block border border-[#cfe3d6] bg-[#f0f7f2] px-2.5 py-1 text-[9px] uppercase tracking-[0.12em] text-[#2f7d5a]">
                  Dispatched from Vapi
                </span>
                <button
                  id="track-print-invoice-btn"
                  type="button"
                  class="flex cursor-pointer items-center gap-1.5 border border-[#14110f] px-2.5 py-1 text-[9px] uppercase tracking-[0.12em] text-[#14110f] transition-colors hover:bg-[#14110f] hover:text-[#f6f1e8]"
                >
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                  GST invoice
                </button>
              </div>
            </div>

            <!-- Timeline -->
            <ol
              id="tracking-timeline-container"
              class="relative mt-6 space-y-5 border-l border-[#e5ded3] pl-6"
            >
              <li id="step-verified" class="relative">
                <span class="absolute -left-[1.6rem] top-0.5 h-2.5 w-2.5 border border-[#2f7d5a] bg-[#2f7d5a]"></span>
                <p class="text-[12px] font-medium text-[#14110f]">Order received &amp; confirmed</p>
                <p class="mt-0.5 text-[11px] leading-relaxed text-[#8a8279]">Inventory reserved and payment verified.</p>
              </li>

              <li id="step-packing" class="relative">
                <span class="absolute -left-[1.6rem] top-0.5 h-2.5 w-2.5 border border-[#2f7d5a] bg-[#2f7d5a]"></span>
                <p class="text-[12px] font-medium text-[#14110f]">Packed at the Vapi atelier</p>
                <p class="mt-0.5 text-[11px] leading-relaxed text-[#8a8279]">Hand-inspected, velvet pouch, warranty certificate.</p>
              </li>

              <li id="step-dispatched" class="relative">
                <span id="step-dispatched-dot" class="absolute -left-[1.6rem] top-0.5 h-2.5 w-2.5 border border-[#8d3f3d] bg-[#8d3f3d]"></span>
                <p id="step-dispatched-title" class="text-[12px] font-medium text-[#8d3f3d]">Dispatched within 24–48 hours</p>
                <p id="result-courier-details" class="mt-0.5 text-[11px] leading-relaxed text-[#6f675f]">Handed to BlueDart or Delhivery from the Vapi hub.</p>
              </li>

              <li id="step-transit" class="relative opacity-50">
                <span id="step-transit-dot" class="absolute -left-[1.6rem] top-0.5 h-2.5 w-2.5 border border-[#b9b1a7] bg-[#fbf9f5]"></span>
                <p class="text-[12px] font-medium text-[#6f675f]">In transit · air express</p>
                <p class="mt-0.5 text-[11px] leading-relaxed text-[#8a8279]">Moving through the regional logistics network.</p>
              </li>

              <li id="step-delivered" class="relative opacity-50">
                <span id="step-delivered-dot" class="absolute -left-[1.6rem] top-0.5 h-2.5 w-2.5 border border-[#b9b1a7] bg-[#fbf9f5]"></span>
                <p class="text-[12px] font-medium text-[#6f675f]">Delivered</p>
                <p class="mt-0.5 text-[11px] leading-relaxed text-[#8a8279]">Safely handed to the recipient.</p>
              </li>
            </ol>

            <!-- Contents -->
            <div class="mt-6 border-t border-[#e5ded3] pt-4">
              <p class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Package contents</p>
              <div id="result-items-list" class="mt-2.5 space-y-2"></div>
            </div>

            <!-- Policy -->
            <div class="mt-5 border border-[#e6d6bb] bg-[#faf3e6] p-4">
              <p class="text-[9px] uppercase tracking-[0.16em] text-[#8a5314]">Delivery &amp; inspection</p>
              <ul class="mt-2 space-y-1.5 text-[11px] leading-relaxed text-[#6b4a1c]">
                <li>Cancellation is possible only before dispatch. Once with the courier, it cannot be recalled.</li>
                <li>No cash refunds. Transit damage needs an unedited 360° unboxing video for a free replacement.</li>
              </ul>
              <a href="/refund-policy" class="link-line mt-2.5 inline-flex text-[9px] uppercase tracking-[0.14em] text-[#6b4a1c]">
                Read the refund policy
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .track-input {
    display: block;
    width: 100%;
    height: 2.75rem;
    border: 1px solid #d8d0c4;
    background-color: #fbf9f5;
    padding: 0 0.875rem;
    font-size: 12px;
    color: #14110f;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .track-input::placeholder {
    color: #9a938b;
    text-transform: none;
    letter-spacing: normal;
  }

  .track-input:focus {
    border-color: #14110f;
    background-color: #ffffff;
  }
</style>

<script>
  import { getAdminOrders, findOrderByRef, type AdminOrder } from '../stores/adminStore';
  import { fetchOrderFromCloudflare } from '../lib/cloudflare';
  import { getSupabase } from '../lib/supabase';

  const form = document.getElementById('track-order-form');
  const resultBox = document.getElementById('tracking-result');
  const placeholder = document.getElementById('tracking-placeholder');
  const orderNumDisplay = document.getElementById('result-order-num');
  const patronInfoDisplay = document.getElementById('result-patron-info');
  const courierDetailsDisplay = document.getElementById('result-courier-details');
  const statusPill = document.getElementById('result-status-pill');
  const itemsList = document.getElementById('result-items-list');
  const invoiceBtn = document.getElementById('track-print-invoice-btn');
  const orderInput = document.getElementById('track-order-id') as HTMLInputElement;
  const errorEl = document.getElementById('track-error');

  let currentMatchedOrder: AdminOrder | null = null;

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    resultBox?.classList.add('hidden');
    placeholder?.classList.remove('hidden');
  }

  async function performLookup(val: string) {
    if (!val) return;
    const cleanVal = val.trim();
    errorEl?.classList.add('hidden');

    // 1. Local store helper
    let matched = findOrderByRef(cleanVal);

    // 2. Cloudflare D1 edge database
    if (!matched) {
      try {
        const cfOrder = await fetchOrderFromCloudflare(cleanVal);
        if (cfOrder) matched = cfOrder;
      } catch (e) {
        console.warn('Cloudflare D1 lookup error:', e);
      }
    }

    // 3. Supabase PostgreSQL cloud if configured
    if (!matched) {
      try {
        const sb = getSupabase();
        if (sb) {
          const { data } = await sb
            .from('orders')
            .select('*')
            .or(`order_number.ilike.%${cleanVal}%,tracking_number.ilike.%${cleanVal}%,phone.ilike.%${cleanVal}%`)
            .limit(1);

          if (data && data[0]) {
            const d = data[0];
            matched = {
              id: d.id,
              orderNumber: d.order_number,
              createdAt: d.created_at,
              customerName: d.customer_name,
              email: d.email,
              phone: d.phone,
              address: d.address,
              city: d.city,
              state: d.state,
              pincode: d.pincode,
              items: d.items,
              subtotalPaise: d.subtotal_paise,
              shippingPaise: d.shipping_paise,
              discountPaise: d.discount_paise,
              totalPaise: d.total_paise,
              paymentMethod: d.payment_method,
              paymentStatus: d.payment_status,
              fulfillmentStatus: d.fulfillment_status,
              courierPartner: d.courier_partner,
              trackingNumber: d.tracking_number
            };
          }
        }
      } catch (err) {
        console.warn('Cloud track query notice:', err);
      }
    }

    // 4. Local order history — exact reference or exact phone match only.
    // Never fall back to an unrelated order.
    if (!matched) {
      const orders = getAdminOrders();
      matched =
        orders.find(
          (o) =>
            o.orderNumber.toUpperCase() === cleanVal.toUpperCase() ||
            (o.trackingNumber && o.trackingNumber.toUpperCase() === cleanVal.toUpperCase()) ||
            (o.phone && o.phone.replace(/\s+/g, '') === cleanVal.replace(/\s+/g, ''))
        ) ?? null;
    }

    if (!matched) {
      showError('No order found for that reference. Check the number from your confirmation SMS, or contact support and we will look it up for you.');
      return;
    }

    currentMatchedOrder = matched;
    if (orderNumDisplay) orderNumDisplay.textContent = matched.orderNumber;
    if (patronInfoDisplay) {
      patronInfoDisplay.textContent = `${matched.customerName} · ${matched.city}, ${matched.state} ${matched.pincode}`;
    }

    const courier = matched.courierPartner || 'BlueDart Air Express';
    const awb = matched.trackingNumber || '—';

    if (courierDetailsDisplay) {
      courierDetailsDisplay.textContent = `Dispatched via ${courier} (AWB: ${awb}) from the Vapi atelier.`;
    }

    if (statusPill) {
      const base = 'inline-block px-2.5 py-1 text-[9px] uppercase tracking-[0.12em] border ';
      if (matched.fulfillmentStatus === 'VERIFIED') {
        statusPill.textContent = 'Order verified';
        statusPill.className = base + 'border-[#d3dbe6] bg-[#f1f4f8] text-[#3b5a7a]';
      } else if (matched.fulfillmentStatus === 'PACKING_AT_VAPI') {
        statusPill.textContent = 'Packing at Vapi';
        statusPill.className = base + 'border-[#e6d6bb] bg-[#faf3e6] text-[#8a5314]';
      } else if (matched.fulfillmentStatus === 'DELIVERED') {
        statusPill.textContent = 'Delivered';
        statusPill.className = base + 'border-[#e5ded3] bg-[#f4efe7] text-[#6f675f]';
      } else {
        statusPill.textContent = 'Dispatched from Vapi';
        statusPill.className = base + 'border-[#cfe3d6] bg-[#f0f7f2] text-[#2f7d5a]';
      }
    }

    if (itemsList) {
      itemsList.innerHTML = matched.items
        .map(
          (i) => `
        <div class="flex items-center gap-3 border border-[#e5ded3] bg-[#fbf9f5] p-2">
          <img src="${i.image}" alt="${i.name}" class="h-11 w-9 shrink-0 border border-[#e5ded3] bg-white object-cover" />
          <div class="min-w-0 flex-1">
            <p class="truncate text-[11.5px] text-[#14110f]">${i.name}</p>
            <p class="mt-0.5 text-[10px] uppercase tracking-[0.08em] text-[#8a8279]">Qty ${i.quantity} · ₹${Math.round(i.pricePaise / 100).toLocaleString('en-IN')}</p>
          </div>
        </div>
      `
        )
        .join('');
    }

    placeholder?.classList.add('hidden');
    if (resultBox) {
      resultBox.classList.remove('hidden');
      resultBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = orderInput?.value.trim();
    if (!value) {
      showError('Enter an order reference or AWB number to continue.');
      orderInput?.focus();
      return;
    }
    performLookup(value);
  });

  invoiceBtn?.addEventListener('click', () => {
    if (currentMatchedOrder) {
      window.dispatchEvent(new CustomEvent('satvastones:open_invoice', { detail: currentMatchedOrder }));
    }
  });

  // Direct link from checkout or a confirmation email
  const params = new URLSearchParams(window.location.search);
  const directOrder = params.get('order') || params.get('awb') || params.get('ref');
  if (directOrder) {
    if (orderInput) orderInput.value = directOrder;
    performLookup(directOrder);
  }
</script>
