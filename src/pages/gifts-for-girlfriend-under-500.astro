---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gifts for Girlfriend Under ₹500', url: '/gifts-for-girlfriend-under-500' }
];

const giftIdeas = [
  {
    title: 'Nickel-Free & Hypoallergenic Earrings',
    copy: 'Featherlight studs, crystal drops, and daily hoops safe for sensitive ears — waterproof and sweat-proof.',
    href: '/collections/earrings',
    cta: 'Shop earrings'
  },
  {
    title: 'Minimal Anti-Tarnish Rings',
    copy: 'Everyday 18K gold PVD rings in 316L surgical steel that never turn fingers green.',
    href: '/collections/rings',
    cta: 'Shop rings'
  },
  {
    title: 'Waterproof Bracelets & Bangles',
    copy: 'Daily-wear bracelets and cuffs she can wear to college, office, showers, and outings without losing color.',
    href: '/collections/bracelets',
    cta: 'Shop bracelets'
  },
  {
    title: 'Waterproof Necklaces & Pendants',
    copy: 'Minimalist pendants and everyday chains crafted to stay lustrous in Indian humidity.',
    href: '/collections/necklaces',
    cta: 'Shop necklaces'
  }
];

const giftFaqs = [
  {
    q: 'What is the best birthday gift for a girlfriend under ₹500 in India?',
    a: 'Waterproof, anti-tarnish jewellery is one of the best birthday gifts for a girlfriend under ₹500 because she can wear it every day without it turning black. Satvastones offers 18K gold PVD plated earrings, bracelets, rings, and necklaces in 316L surgical stainless steel with fast pan-India delivery.'
  },
  {
    q: 'Can I get good quality anti-tarnish jewellery gifts under ₹500 that won’t lose color?',
    a: 'Yes. While cheap brass alloy jewellery tarnishes in days and stains skin green, Satvastones crafts affordable 316L surgical stainless steel + 18K gold vacuum PVD jewellery that is waterproof, sweat-proof, hypoallergenic, and nickel-free.'
  },
  {
    q: 'Do you offer combo discounts and free delivery on gifts?',
    a: 'Yes. You can combine any 2+ pieces in our Stack Studio to unlock automatic bundle savings, and all orders above ₹499 get free express shipping across India.'
  },
  {
    q: 'How fast will my gift reach, and is Cash on Delivery available?',
    a: 'Every gift order is hand-inspected and dispatched from our Vapi, Gujarat atelier within 24–48 hours. Metro deliveries take 2–3 business days and pan-India orders take 3–5 business days. Both UPI/Razorpay and Cash on Delivery are available.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: giftFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Satvastones Anti-Tarnish Jewellery Gifts Under ₹500',
  numberOfItems: 0,
  itemListElement: []
};
---

<BaseLayout
  title="Best Jewellery Gifts for Girlfriend Under ₹500 | Anti-Tarnish & Waterproof"
  description="Looking for the best gift or birthday gift for your girlfriend under ₹500? Shop waterproof 18K gold-plated anti-tarnish jewellery & jewelry gifts starting at ₹149. Free shipping > ₹499 & COD."
  canonicalUrl="https://www.satvastones.in/collections/gifts-for-girlfriend-under-500"
  schema={[itemListSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <PageIntro
      eyebrow="Gifting Under ₹500 · Waterproof & Non-Tarnish"
      title="Best jewellery gifts for girlfriend under ₹500."
      lede="Thoughtful birthday, anniversary, and everyday jewellery gifts she will never have to take off. 18K gold PVD on nickel-free 316L surgical steel — live from our catalogue."
      crumbs={breadcrumbs}
    >
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
        <span>Waterproof &amp; Anti-Tarnish</span>
        <span aria-hidden="true" class="text-[#c5a059]">✦</span>
        <span>Nickel-Free for Sensitive Skin</span>
        <span aria-hidden="true" class="text-[#c5a059]">✦</span>
        <span>24–48h Vapi Dispatch · COD Available</span>
      </div>
    </PageIntro>

    <!-- Live Under ₹500 Products Grid (Populated from Live D1 Catalogue — Zero Mock Data) -->
    <section class="border-y border-[#e5ded3] bg-[#f8f4ed] py-14 sm:py-20">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow text-[#8d3f3d]">Live under ₹500 picks</p>
            <h2 class="font-display mt-2 text-[2rem] leading-tight sm:text-[2.6rem]">
              Gift-ready pieces under ₹500.
            </h2>
          </div>
          <a href="/shop" class="link-line text-[10px] uppercase tracking-[0.18em] text-[#14110f]">
            Shop all jewellery
          </a>
        </div>

        <div
          id="under-500-grid"
          data-live-products="under-500"
          class="mt-8 grid grid-cols-2 gap-x-3 gap-y-9 sm:gap-x-5 lg:grid-cols-4 lg:gap-x-6"
        >
          <p class="col-span-full py-10 text-center text-xs uppercase tracking-[0.16em] text-[#8a8279]">
            Loading live catalogue…
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border border-[#e0d7c9] bg-[#f4efe7] px-5 py-4">
          <p class="text-[13px] text-[#14110f]">
            Want to build a custom birthday gift combo? Combine 2+ pieces in <strong>Stack Studio</strong> and save automatically + free shipping above ₹499.
          </p>
          <a
            href="/stack-builder"
            class="inline-flex items-center gap-2 bg-[#14110f] px-5 py-3 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]"
          >
            Build a gift stack <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Curated Gift Categories -->
    <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10">
      <div class="max-w-2xl">
        <p class="eyebrow text-[#8d3f3d]">Browse by category</p>
        <h2 class="font-display mt-2 text-[2rem] leading-tight sm:text-[2.6rem]">
          What she’ll actually wear every day.
        </h2>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {giftIdeas.map((idea) => (
          <a
            href={idea.href}
            class="group border border-[#e5ded3] bg-white p-6 transition-colors hover:border-[#c5a059]"
          >
            <h3 class="font-serif text-xl text-[#14110f]">{idea.title}</h3>
            <p class="mt-2.5 text-[13px] leading-relaxed text-[#5f5851]">{idea.copy}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.16em] text-[#8d3f3d] group-hover:text-[#14110f]">
              {idea.cta} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Gift FAQs -->
    <section class="border-t border-[#e5ded3] bg-[#fbf9f5] py-16 sm:py-20">
      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 sm:px-8 lg:grid-cols-12 lg:gap-14 lg:px-10">
        <div class="lg:col-span-4">
          <p class="eyebrow text-[#8d3f3d]">Gifting FAQ</p>
          <h2 class="font-display mt-3 text-[2rem] leading-tight sm:text-[2.5rem]">
            Gift questions, answered.
          </h2>
          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.14em]">
            <a href="/collections/gift-sets" class="link-line text-[#14110f]">Curated gift sets</a>
            <a href="/affordable-anti-tarnish-jewellery-india" class="link-line text-[#14110f]">Affordable India guide</a>
            <a href="/anti-tarnish-jewellery-vapi" class="link-line text-[#14110f]">Vapi Gujarat atelier</a>
          </div>
        </div>

        <div class="border-t border-[#e5ded3] lg:col-span-8">
          {giftFaqs.map((faq, idx) => (
            <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden" open={idx < 2}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                <h3 class="font-serif text-lg leading-snug text-[#14110f] sm:text-xl">{faq.q}</h3>
                <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="pt-3 text-[13px] leading-relaxed text-[#5f5851]">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    async function hydrateLiveUnder500() {
      const grid = document.getElementById('under-500-grid');
      if (!grid || grid.dataset.ssrHydrated === 'true') return;
      try {
        const res = await fetch('/api/products', { headers: { Accept: 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        const products = Array.isArray(data?.products)
          ? data.products.filter((p: any) => p.isPublished !== false && p.inStock !== false)
          : [];
        const under500 = products
          .filter((p: any) => Number(p.pricePaise) <= 50000)
          .sort((a: any, b: any) => Number(a.pricePaise) - Number(b.pricePaise));
        const list = under500.length ? under500 : products.slice(0, 8);
        if (!list.length) {
          grid.innerHTML = `<p class="col-span-full py-10 text-center text-sm text-[#5f5851]">New gift pieces are being added — <a href="/shop" class="underline">browse all available jewellery</a>.</p>`;
          return;
        }
        grid.innerHTML = list
          .map((product: any) => {
            const primaryImage = product.image || product.images?.[0]?.url || '';
            const priceRupees = Math.round(Number(product.pricePaise) / 100);
            const compareRupees = product.compareAtPricePaise ? Math.round(Number(product.compareAtPricePaise) / 100) : null;
            return `
              <div class="product-card group relative flex flex-col">
                <a href="/products/${product.slug}" class="relative block aspect-[3/4] overflow-hidden bg-[#f1ece3]" aria-label="${product.name}">
                  ${priceRupees <= 500 ? `<span class="absolute left-3 top-3 z-10 bg-[#14110f] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#f6f1e8]">Under ₹500</span>` : ''}
                  <img src="${primaryImage}" alt="${product.name}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </a>
                <div class="flex flex-1 flex-col gap-2 pt-3.5">
                  <h3 class="font-serif text-[15px] leading-snug text-[#14110f] sm:text-base">
                    <a href="/products/${product.slug}">${product.name}</a>
                  </h3>
                  <div class="mt-auto flex items-baseline gap-2">
                    <span class="text-sm font-medium text-[#14110f]">₹${priceRupees.toLocaleString('en-IN')}</span>
                    ${compareRupees ? `<span class="text-[11px] text-[#a39a91] line-through">₹${compareRupees.toLocaleString('en-IN')}</span>` : ''}
                  </div>
                </div>
              </div>
            `;
          })
          .join('');
      } catch {
        /* leave SSR content intact */
      }
    }
    hydrateLiveUnder500();
  </script>
</BaseLayout>
