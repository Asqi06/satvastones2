---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS, formatPrice } from '../data/products';

const necklaces = PRODUCTS.filter((p) => p.category === 'necklaces');
const rings = PRODUCTS.filter((p) => p.category === 'rings');
const earrings = PRODUCTS.filter((p) => p.category === 'earrings');
const bracelets = PRODUCTS.filter((p) => p.category === 'bracelets' || p.category === 'bangles').slice(0, 4);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Stack Studio', url: '/stack-builder' }
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Stack Studio — build a 15% off jewellery set',
  description:
    'Build a three-piece anti-tarnish jewellery stack and save 15%. Waterproof 18K gold PVD over 316L surgical steel, dispatched from Vapi, Gujarat.',
  url: 'https://www.satvastones.in/stack-builder',
  isPartOf: { '@type': 'WebSite', name: 'Satvastones Jewellery', url: 'https://www.satvastones.in' }
};

const steps = [
  { key: 'necklace', label: 'Necklace', title: 'Choose your necklace', note: '18K vacuum PVD', items: necklaces },
  { key: 'ring', label: 'Ring', title: 'Choose your ring', note: 'Comfort-fit band', items: rings },
  { key: 'earring', label: 'Earring', title: 'Choose your earrings', note: 'Zero ear irritation', items: earrings }
];
---

<BaseLayout
  title="Stack Studio — Build a 15% Off Jewellery Set | Satvastones"
  description="Build your own anti-tarnish jewellery stack: pick a necklace, ring and earrings, then save 15% instantly. Waterproof 18K gold PVD, free India delivery over ₹499."
  schema={pageSchema}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <!-- Header -->
    <header class="mx-auto max-w-[1440px] px-5 pb-8 pt-6 sm:px-8 sm:pb-10 sm:pt-8 lg:px-10">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-[10px] uppercase tracking-[0.16em] text-[#8a8279]">
          <li><a href="/" class="transition-colors hover:text-[#14110f]">Home</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li aria-current="page" class="text-[#14110f]">Stack Studio</li>
        </ol>
      </nav>

      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow text-[#8d3f3d]">The stacking edit</p>
          <h1 class="font-display mt-3 text-[2.75rem] leading-[0.95] tracking-[-0.035em] sm:text-[4.25rem] lg:text-[5.25rem]">
            Build your stack.
          </h1>
        </div>
        <div class="lg:col-span-4 lg:pb-2">
          <p class="max-w-sm text-[13px] leading-relaxed text-[#5f5851]">
            Three pieces, one considered look. Pick a necklace, a ring and a pair of earrings — we take 15% off the set automatically.
          </p>
          <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
            <span>15% off the set</span>
            <span aria-hidden="true" class="text-[#c5a059]">✦</span>
            <span>Free delivery over ₹499</span>
            <span aria-hidden="true" class="text-[#c5a059]">✦</span>
            <span>24–48h dispatch</span>
          </p>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1440px] px-5 pb-16 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Steps -->
        <div class="space-y-4 lg:col-span-7">
          {steps.map((step, stepIndex) => (
            <section
              class="border border-[#e5ded3] bg-white p-5 sm:p-6"
              aria-labelledby={`stack-step-${step.key}`}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#e5ded3] pb-3">
                <h2 id={`stack-step-${step.key}`} class="flex items-baseline gap-3">
                  <span class="font-display text-[1.35rem] leading-none text-[#c5a059]">
                    {String(stepIndex + 1).padStart(2, '0')}
                  </span>
                  <span class="font-display text-[1.25rem] leading-none">{step.title}</span>
                </h2>
                <span class="text-[9px] uppercase tracking-[0.14em] text-[#8a8279]">{step.note}</span>
              </div>

              <div class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
                {step.items.map((item, idx) => (
                  <label class="stack-option-card group relative flex cursor-pointer flex-col border border-[#ded5c7] bg-[#fbf9f5] p-2 transition-colors hover:border-[#b9ae9f] has-[:checked]:border-[#14110f] has-[:checked]:bg-[#f4efe7]">
                    <input
                      type="radio"
                      name={`stack-${step.key}`}
                      value={item.id}
                      checked={idx === 0}
                      data-name={item.name}
                      data-price={item.pricePaise}
                      data-image={item.images[0]?.url}
                      data-slug={item.slug}
                      class="sr-only stack-radio"
                      aria-label={`${item.name} — ${formatPrice(item.pricePaise)}`}
                    />
                    <img
                      src={item.images[0]?.url}
                      alt={item.name}
                      width="300"
                      height="300"
                      loading={stepIndex === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="aspect-square w-full bg-[#f1ece3] object-cover transition-opacity group-hover:opacity-90"
                    />
                    <div class="mt-2 min-w-0">
                      <p class="line-clamp-1 text-[11px] leading-snug text-[#14110f]">{item.name}</p>
                      <p class="mt-0.5 text-[11px] font-medium text-[#8d3f3d]">{formatPrice(item.pricePaise)}</p>
                    </div>
                    <span class="selected-check absolute right-2 top-2 hidden h-5 w-5 items-center justify-center bg-[#14110f] text-[#f6f1e8]">
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                    </span>
                  </label>
                ))}
              </div>
            </section>
          ))}

          <!-- Extra AOV: bracelets -->
          {bracelets.length > 0 && (
            <section class="border border-[#e0d7c9] bg-[#f4efe7] p-5 sm:p-6" aria-labelledby="stack-bracelet-title">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <p class="eyebrow text-[#8d3f3d]">One more layer</p>
                  <h2 id="stack-bracelet-title" class="font-display mt-1.5 text-[1.4rem] leading-none">
                    Finish with a bracelet.
                  </h2>
                </div>
                <a href="/collections/bracelets" class="link-line text-[10px] uppercase tracking-[0.14em] text-[#14110f]">
                  All bracelets
                </a>
              </div>
              <p class="mt-2 max-w-md text-[12px] leading-relaxed text-[#5f5851]">
                Stack a second piece on the same wrist — or pair a kada with the set. Every extra piece still counts toward the 15%.
              </p>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {bracelets.map((item) => (
                  <ProductCard product={item} />
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- Summary -->
        <div class="lg:col-span-5 lg:sticky lg:top-24">
          <div class="border border-[#e0d7c9] bg-[#f4efe7] p-5 sm:p-6">
            <div class="flex items-baseline justify-between gap-3 border-b border-[#ded5c7] pb-3.5">
              <div>
                <p class="eyebrow text-[#8d3f3d]">Atelier set privilege</p>
                <h2 class="font-display mt-1.5 text-[1.6rem] leading-none">Your three-piece stack</h2>
              </div>
              <span class="bg-[#14110f] px-2.5 py-1 text-[9px] uppercase tracking-[0.14em] text-[#f6f1e8]">
                Save 15%
              </span>
            </div>

            <div id="stack-summary-list" class="divide-y divide-[#ded5c7] text-[11px]"></div>

            <div class="space-y-2 border-t border-[#ded5c7] pt-4 text-[11px] text-[#6f675f]">
              <div class="flex justify-between">
                <span>Individual value</span>
                <span id="stack-raw-sum" class="text-[#9a938b] line-through">₹0</span>
              </div>
              <div class="flex justify-between font-medium text-[#2f7d5a]">
                <span id="stack-savings-label">Stack savings (15% off)</span>
                <span id="stack-savings">− ₹0</span>
              </div>
              <div class="flex items-baseline justify-between border-t border-[#ded5c7] pt-3 text-[#14110f]">
                <span class="text-[10px] uppercase tracking-[0.16em]">Set price</span>
                <span id="stack-final-price" class="font-display text-[1.85rem] leading-none">₹0</span>
              </div>
            </div>

            <button
              id="add-stack-to-bag-btn"
              type="button"
              class="mt-4 flex w-full cursor-pointer items-center justify-center gap-2 bg-[#14110f] py-4 text-[10px] font-medium uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]"
            >
              <span id="add-stack-btn-text">Add stack to bag — 15% off</span>
            </button>

            <p class="mt-2.5 text-center text-[9px] uppercase tracking-[0.1em] text-[#8a8279]">
              Free express shipping · velvet pouch · 7-day returns
            </p>

            <ul class="mt-5 space-y-2.5 border-t border-[#ded5c7] pt-4 text-[11px] leading-relaxed text-[#5f5851]">
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 text-[#c5a059]" aria-hidden="true">✦</span>
                <span><strong class="font-medium text-[#14110f]">Waterproof by design.</strong> 18K gold PVD over 316L surgical steel — shower, gym and monsoon safe.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 text-[#c5a059]" aria-hidden="true">✦</span>
                <span><strong class="font-medium text-[#14110f]">Gift-ready.</strong> Velvet box, anti-tarnish pouch and care certificate included free.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 text-[#c5a059]" aria-hidden="true">✦</span>
                <span><strong class="font-medium text-[#14110f]">Direct from the atelier.</strong> Hand-inspected in Vapi and dispatched within 24–48 hours.</span>
              </li>
            </ul>
          </div>

          <a
            href="/materials"
            class="mt-3 flex items-center justify-between border border-[#e5ded3] bg-[#fbf9f5] px-4 py-3 text-[10px] uppercase tracking-[0.14em] text-[#14110f] transition-colors hover:border-[#c5a059]"
          >
            <span>What is 18K gold PVD?</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { addMultipleToCart } from '../stores/cartStore';
  import { getSiteSettings } from '../stores/adminStore';

  function formatINR(paise: number) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  }

  const settings = getSiteSettings();
  const discountPercent =
    typeof settings.stackDiscountPercent === 'number' ? settings.stackDiscountPercent : 15;

  const savingsLabel = document.getElementById('stack-savings-label');
  if (savingsLabel) savingsLabel.textContent = `Stack savings (${discountPercent}% off)`;

  // Filter client-side based on admin curation
  if (settings.stackStudioEnabledProducts && settings.stackStudioEnabledProducts.length > 0) {
    const enabled = settings.stackStudioEnabledProducts;
    document.querySelectorAll('.stack-option-card').forEach((card) => {
      const input = card.querySelector('.stack-radio') as HTMLInputElement;
      if (input && !enabled.includes(input.value) && !enabled.includes(input.dataset.slug || '')) {
        if (!input.checked) {
          (card as HTMLElement).style.display = 'none';
        }
      }
    });
  }

  function getSelectedStack() {
    const radios = document.querySelectorAll('.stack-radio:checked') as NodeListOf<HTMLInputElement>;
    return Array.from(radios).map((r) => ({
      productId: r.value,
      name: r.dataset.name || '',
      pricePaise: parseInt(r.dataset.price || '0', 10),
      image: r.dataset.image || '',
      slug: r.dataset.slug || '',
      quantity: 1
    }));
  }

  function updateStackSummary() {
    const items = getSelectedStack();
    const listEl = document.getElementById('stack-summary-list');
    const rawSumEl = document.getElementById('stack-raw-sum');
    const savingsEl = document.getElementById('stack-savings');
    const finalPriceEl = document.getElementById('stack-final-price');

    const rawTotal = items.reduce((acc, cur) => acc + cur.pricePaise, 0);
    const savings = Math.round(rawTotal * (discountPercent / 100));
    const finalTotal = rawTotal - savings;

    if (listEl) {
      listEl.innerHTML = items
        .map(
          (item) => `
        <div class="flex items-center gap-3 py-2.5">
          <img src="${item.image}" alt="${item.name}" class="h-14 w-12 shrink-0 border border-[#ded5c7] bg-[#fbf9f5] object-cover" />
          <div class="min-w-0 flex-1">
            <p class="truncate text-[12px] leading-snug text-[#14110f]">${item.name}</p>
            <p class="mt-0.5 text-[9px] uppercase tracking-[0.12em] text-[#8a8279]">18K gold PVD</p>
          </div>
          <span class="shrink-0 text-[12px] text-[#14110f]">${formatINR(item.pricePaise)}</span>
        </div>
      `
        )
        .join('');
    }

    if (rawSumEl) rawSumEl.textContent = formatINR(rawTotal);
    if (savingsEl) savingsEl.textContent = `− ${formatINR(savings)}`;
    if (finalPriceEl) finalPriceEl.textContent = formatINR(finalTotal);
  }

  // Update check icons and recalculate
  document.querySelectorAll('.stack-radio').forEach((radio) => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('.stack-option-card').forEach((card) => {
        const input = card.querySelector('.stack-radio') as HTMLInputElement;
        const check = card.querySelector('.selected-check');
        if (input?.checked) {
          check?.classList.remove('hidden');
          check?.classList.add('flex');
        } else {
          check?.classList.add('hidden');
          check?.classList.remove('flex');
        }
      });
      updateStackSummary();
    });
  });

  // Initial state
  document.querySelectorAll('.stack-option-card').forEach((card) => {
    const input = card.querySelector('.stack-radio') as HTMLInputElement;
    const check = card.querySelector('.selected-check');
    if (input?.checked) {
      check?.classList.remove('hidden');
      check?.classList.add('flex');
    }
  });

  updateStackSummary();

  // Add the stack with the same discount the page promises.
  const addBtn = document.getElementById('add-stack-to-bag-btn') as HTMLButtonElement | null;
  const addBtnText = document.getElementById('add-stack-btn-text');
  const defaultBtnLabel = `Add stack to bag — ${discountPercent}% off`;

  addBtn?.addEventListener('click', () => {
    const items = getSelectedStack();
    if (items.length === 0) return;

    const multiplier = 1 - discountPercent / 100;
    const discountedItems = items.map((item) => ({
      ...item,
      variantId: `stack-${discountPercent}off`,
      name: `${item.name} (Stack ${discountPercent}% off)`,
      pricePaise: Math.round(item.pricePaise * multiplier)
    }));

    addMultipleToCart(discountedItems);

    if (addBtnText) addBtnText.textContent = 'Stack added to bag';
    if (addBtn) addBtn.disabled = true;

    setTimeout(() => {
      if (addBtnText) addBtnText.textContent = defaultBtnLabel;
      if (addBtn) addBtn.disabled = false;
    }, 1800);
  });
</script>
