---
import BaseLayout from '../layouts/BaseLayout.astro';
import DPDPNotice from '../components/DPDPNotice';
---

<BaseLayout
  title="Secure Checkout | Satvastones Anti-Tarnish Jewellery"
  description="Secure Razorpay checkout for Satvastones fine jewellery. Free express shipping across India on orders above ₹499. Hand-inspected and dispatched from Vapi in 24–48 hours."
  noindex={true}
>
  <!-- Razorpay Official Checkout SDK (loaded only on checkout) -->
  <script is:inline src="https://checkout.razorpay.com/v1/checkout.js" defer></script>

  <div class="bg-[#fbf9f5] text-[#14110f]">
    <!-- Checkout header -->
    <header class="border-b border-[#e5ded3]">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-end justify-between gap-5 px-5 py-7 sm:px-8 sm:py-9">
        <div>
          <p class="eyebrow text-[#8d3f3d]">Secure checkout</p>
          <h1 class="font-display mt-2 text-[2rem] leading-none tracking-[-0.03em] sm:text-[2.75rem]">
            Complete your order.
          </h1>
        </div>
        <div class="flex flex-col gap-2 sm:items-end">
          <span class="inline-flex items-center gap-2 border border-[#e0d7c9] bg-[#f4efe7] px-3 py-1.5 text-[9px] uppercase tracking-[0.14em] text-[#6f675f]">
            <svg class="h-3.5 w-3.5 text-[#c5a059]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            256-bit SSL · Razorpay secured
          </span>
          <a href="/shop" class="text-[10px] uppercase tracking-[0.14em] text-[#6f675f] underline decoration-[#d8c3a6] underline-offset-4 transition-colors hover:text-[#14110f]">
            ← Continue shopping
          </a>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1240px] px-5 py-7 sm:px-8 sm:py-10">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Form column -->
        <div class="space-y-5 lg:col-span-7">
          <!-- Inline validation -->
          <div
            id="checkout-form-error"
            class="hidden border-l-2 border-[#8d3f3d] bg-[#f8eeee] px-4 py-3 text-[12px] leading-relaxed text-[#8d3f3d]"
            role="alert"
            aria-live="polite"
          ></div>

          <!-- 01 Contact -->
          <section class="border border-[#e5ded3] bg-white p-5 sm:p-7" aria-labelledby="checkout-contact-title">
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#e5ded3] pb-3">
              <h2 id="checkout-contact-title" class="flex items-baseline gap-3">
                <span class="font-display text-[1.35rem] leading-none text-[#c5a059]">01</span>
                <span class="font-display text-[1.3rem] leading-none">Contact details</span>
              </h2>
              <span class="text-[9px] uppercase tracking-[0.14em] text-[#8a8279]">SMS &amp; WhatsApp tracking</span>
            </div>

            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="checkout-name" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Full name *</label>
                <input
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="e.g. Priya Sharma"
                  id="checkout-name"
                  class="checkout-input"
                />
              </div>
              <div>
                <label for="checkout-phone" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Mobile (WhatsApp) *</label>
                <input
                  type="tel"
                  required
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder="+91 90167 03180"
                  id="checkout-phone"
                  class="checkout-input"
                />
              </div>
              <div>
                <label for="checkout-email" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Email (tax invoice) *</label>
                <input
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="name@example.com"
                  id="checkout-email"
                  class="checkout-input"
                />
              </div>
            </div>
          </section>

          <!-- 02 Shipping -->
          <section class="border border-[#e5ded3] bg-white p-5 sm:p-7" aria-labelledby="checkout-shipping-title">
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#e5ded3] pb-3">
              <h2 id="checkout-shipping-title" class="flex items-baseline gap-3">
                <span class="font-display text-[1.35rem] leading-none text-[#c5a059]">02</span>
                <span class="font-display text-[1.3rem] leading-none">Shipping address</span>
              </h2>
              <span class="text-[9px] uppercase tracking-[0.14em] text-[#8a8279]">Pan-India express air</span>
            </div>

            <div class="mt-5 space-y-4">
              <div>
                <label for="checkout-addr1" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">House / flat / building *</label>
                <input
                  type="text"
                  required
                  autocomplete="address-line1"
                  placeholder="e.g. Flat 304, Green Heights"
                  id="checkout-addr1"
                  class="checkout-input"
                />
              </div>
              <div>
                <label for="checkout-addr2" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Street / landmark / area</label>
                <input
                  type="text"
                  autocomplete="address-line2"
                  placeholder="e.g. Near Outer Ring Road"
                  id="checkout-addr2"
                  class="checkout-input"
                />
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                  <label for="checkout-pin" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">PIN code *</label>
                  <input
                    type="text"
                    required
                    maxlength="6"
                    inputmode="numeric"
                    autocomplete="postal-code"
                    placeholder="396191"
                    id="checkout-pin"
                    class="checkout-input"
                  />
                </div>
                <div>
                  <label for="checkout-city" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">City *</label>
                  <input
                    type="text"
                    required
                    autocomplete="address-level2"
                    placeholder="Vapi"
                    id="checkout-city"
                    class="checkout-input"
                  />
                </div>
                <div>
                  <label for="checkout-state" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">State *</label>
                  <input
                    type="text"
                    required
                    autocomplete="address-level1"
                    placeholder="Gujarat"
                    id="checkout-state"
                    class="checkout-input"
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- Gift -->
          <section class="border border-[#e0d7c9] bg-[#f4efe7] p-5" aria-labelledby="checkout-gift-title">
            <label class="flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                id="gift-packaging-check"
                checked
                class="mt-0.5 h-4 w-4 shrink-0 cursor-pointer accent-[#14110f]"
              />
              <span class="flex-1">
                <span id="checkout-gift-title" class="flex items-center gap-1.5 text-[12px] font-medium text-[#14110f]">
                  <span class="text-[#c5a059]" aria-hidden="true">✦</span>
                  Complimentary velvet box &amp; handwritten note
                </span>
                <span class="mt-1 block text-[11px] leading-relaxed text-[#6f675f]">
                  Includes an anti-tarnish pouch, care certificate, and a handwritten card sealed with wax — free on every order.
                </span>
              </span>
            </label>
            <div id="gift-message-box" class="mt-3 pl-7">
              <label for="gift-note-input" class="sr-only">Gift note</label>
              <input
                type="text"
                id="gift-note-input"
                placeholder="Optional gift note (e.g. 'To Rhea, with love')"
                class="checkout-input bg-white"
              />
            </div>
          </section>

          <!-- 03 Payment -->
          <section class="border border-[#e5ded3] bg-white p-5 sm:p-7" aria-labelledby="checkout-payment-title">
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#e5ded3] pb-3">
              <h2 id="checkout-payment-title" class="flex items-baseline gap-3">
                <span class="font-display text-[1.35rem] leading-none text-[#c5a059]">03</span>
                <span class="font-display text-[1.3rem] leading-none">Payment</span>
              </h2>
              <span class="flex items-center gap-1.5 text-[9px] uppercase tracking-[0.14em] text-[#2f7d5a]">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Encrypted &amp; safe
              </span>
            </div>

            <div class="mt-5 space-y-3">
              <!-- Razorpay -->
              <label
                id="payment-card-razorpay"
                class="pay-card is-selected flex cursor-pointer items-start gap-3.5 p-4"
              >
                <input type="radio" name="payment-method" value="RAZORPAY" checked class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-[#14110f]" />
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center justify-between gap-1.5">
                    <span class="text-[13px] font-medium text-[#14110f]">Razorpay online — UPI, cards, netbanking</span>
                    <span class="border border-[#cfe3d6] bg-[#f0f7f2] px-2 py-0.5 text-[9px] uppercase tracking-[0.1em] text-[#2f7d5a]">
                      Zero extra fees · save ₹25
                    </span>
                  </span>
                  <span class="mt-1 block text-[11px] leading-relaxed text-[#6f675f]">
                    Pay instantly with Google Pay, PhonePe, Paytm, any card, or netbanking. Priority atelier dispatch.
                  </span>
                  <span class="mt-2.5 flex flex-wrap items-center gap-1.5 border-t border-[#e5ded3] pt-2.5 text-[9px] uppercase tracking-[0.08em] text-[#6f675f]">
                    <span class="border border-[#e5ded3] bg-[#fbf9f5] px-2 py-0.5">Google Pay</span>
                    <span class="border border-[#e5ded3] bg-[#fbf9f5] px-2 py-0.5">PhonePe</span>
                    <span class="border border-[#e5ded3] bg-[#fbf9f5] px-2 py-0.5">Paytm</span>
                    <span class="border border-[#e5ded3] bg-[#fbf9f5] px-2 py-0.5">Cards</span>
                    <span class="border border-[#e5ded3] bg-[#fbf9f5] px-2 py-0.5">Netbanking</span>
                  </span>
                </span>
              </label>

              <!-- COD -->
              <label
                id="payment-card-cod"
                class="pay-card flex cursor-pointer items-start gap-3.5 p-4"
              >
                <input type="radio" name="payment-method" value="COD" class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-[#14110f]" />
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center justify-between gap-1.5">
                    <span class="text-[13px] font-medium text-[#14110f]">Cash on delivery</span>
                    <span class="border border-[#e6d6bb] bg-[#faf3e6] px-2 py-0.5 text-[9px] uppercase tracking-[0.1em] text-[#8a5314]">
                      +₹25 handling fee
                    </span>
                  </span>
                  <span class="mt-1 block text-[11px] leading-relaxed text-[#6f675f]">
                    Pay cash or scan the courier's QR at your doorstep when the parcel arrives.
                  </span>
                  <span class="mt-2.5 flex items-start gap-2 border-t border-[#e5ded3] pt-2.5 text-[11px] leading-relaxed text-[#8a5314]">
                    <span aria-hidden="true">✦</span>
                    <span>Skip the ₹25 fee by choosing Razorpay online with UPI — and your order ships sooner.</span>
                  </span>
                </span>
              </label>
            </div>
          </section>
        </div>

        <!-- Summary column -->
        <div class="lg:col-span-5">
          <div class="border border-[#e5ded3] bg-[#f4efe7] p-5 sm:p-6 lg:sticky lg:top-24">
            <div class="flex items-baseline justify-between gap-3 border-b border-[#ded5c7] pb-3.5">
              <h2 class="font-display text-[1.6rem] leading-none">Order summary</h2>
              <span class="text-[9px] uppercase tracking-[0.14em] text-[#8a8279]">Vapi atelier</span>
            </div>

            <div id="checkout-cart-items" class="divide-y divide-[#ded5c7] text-[12px]">
              <p class="py-4 text-[11px] text-[#6f675f]">Loading your bag…</p>
            </div>

            <div class="space-y-2 border-t border-[#ded5c7] pt-4 text-[11px] text-[#6f675f]">
              <div class="flex justify-between">
                <span>Subtotal</span>
                <span id="checkout-subtotal" class="font-medium text-[#14110f]">₹0</span>
              </div>
              <div class="flex justify-between">
                <span>Pan-India express shipping</span>
                <span id="checkout-shipping" class="font-medium text-[#2f7d5a]">FREE</span>
              </div>

              <div id="checkout-discount-row" class="hidden">
                <div class="flex justify-between font-medium text-[#2f7d5a]">
                  <span>Privilege discount (<span id="checkout-coupon-code"></span>)</span>
                  <span id="checkout-discount">−₹0</span>
                </div>
              </div>

              <div id="cod-fee-row" class="hidden">
                <div class="flex justify-between border border-[#e6d6bb] bg-[#faf3e6] px-2.5 py-1.5 font-medium text-[#8a5314]">
                  <span>Cash on delivery handling fee</span>
                  <span id="checkout-cod-fee">+₹25</span>
                </div>
              </div>

              <div class="flex items-baseline justify-between border-t border-[#ded5c7] pt-3 text-[#14110f]">
                <span class="text-[10px] uppercase tracking-[0.16em]">Total</span>
                <span id="checkout-total" class="font-display text-[1.85rem] leading-none">₹0</span>
              </div>
            </div>

            <div id="cod-nudge-banner" class="hidden mt-4 border border-[#cfe3d6] bg-[#f0f7f2] p-3 text-[11px] leading-relaxed text-[#2f7d5a]">
              <p class="font-medium">Save ₹25 on this order</p>
              <p class="mt-0.5">Switch to Razorpay online (UPI) to remove the handling fee and check out at 100% of the piece price.</p>
            </div>

            <div class="mt-4">
              <DPDPNotice client:load context="checkout" />
            </div>

            <button
              id="complete-order-btn"
              type="button"
              class="mt-4 flex w-full cursor-pointer items-center justify-center gap-2 bg-[#14110f] py-4 text-[10px] font-medium uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d] disabled:pointer-events-none disabled:opacity-50"
            >
              <svg id="complete-btn-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
              <span id="complete-btn-text">Pay via Razorpay &amp; confirm order</span>
            </button>

            <p class="mt-2.5 text-center text-[9px] uppercase tracking-[0.1em] text-[#8a8279]">
              UPI · Cards · Netbanking · GST invoice
            </p>

            <!-- Success -->
            <div id="order-success-modal" class="mt-4 hidden border border-[#c5a059] bg-[#fbf9f5] p-6 text-center">
              <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-[#eef6f0] text-[#2f7d5a]">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </span>

              <div class="mt-3 space-y-1">
                <h3 id="order-success-title" class="font-display text-[1.5rem] leading-tight text-[#14110f]">Order confirmed</h3>
                <p id="order-number-display" class="text-[11px] font-medium text-[#8d3f3d]"></p>
                <p id="order-awb-display" class="text-[11px] text-[#4a443f]"></p>
                <p id="order-payment-mode-display" class="text-[11px] font-medium text-[#2f7d5a]"></p>
                <p id="order-success-note" class="pt-1.5 text-[11px] leading-relaxed text-[#6f675f]">
                  Payment authorised. Your order is scheduled for hand-inspection and gift packaging at our Vapi atelier within 24–48 hours.
                </p>
              </div>

              <div class="mt-4 space-y-2">
                <button
                  id="checkout-view-invoice-btn"
                  type="button"
                  class="flex w-full cursor-pointer items-center justify-center gap-2 bg-[#14110f] py-3 text-[10px] uppercase tracking-[0.14em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                  View GST tax invoice
                </button>

                <a
                  id="checkout-track-order-link"
                  href="/track-order"
                  class="flex w-full items-center justify-center gap-2 border border-[#14110f] py-3 text-[10px] uppercase tracking-[0.14em] text-[#14110f] transition-colors hover:bg-[#14110f] hover:text-[#f6f1e8]"
                >
                  Track your shipment
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Policies -->
            <ul class="mt-5 space-y-2 border-t border-[#ded5c7] pt-4 text-[10px] leading-relaxed text-[#6f675f]">
              <li class="flex items-start gap-2">
                <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
                <span>Dispatched from our Vapi atelier in 24–48 hours</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
                <span>Free express delivery automatically applied above ₹499</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
                <span>Cancellations accepted before dispatch; no cash refunds</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
                <span>Uncut 360° unboxing video required to verify damaged goods</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive UPI / card dialog (fallback when the live key is absent) -->
  <div id="razorpay-interactive-modal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-[#14110f]/70 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md overflow-hidden border border-[#e5ded3] bg-[#fbf9f5] shadow-2xl">
      <!-- Header -->
      <div class="flex items-start justify-between gap-4 bg-[#14110f] p-5 text-[#f6f1e8]">
        <div>
          <p class="text-[9px] uppercase tracking-[0.2em] text-[#c5a059]">Satvastones secure payment</p>
          <h3 class="font-display mt-1 text-[1.35rem] leading-none">Pay by UPI or card</h3>
        </div>
        <div class="text-right">
          <p class="text-[9px] uppercase tracking-[0.14em] text-white/55">Amount</p>
          <p id="rzp-modal-amount" class="text-base font-medium text-[#f6f1e8]">₹0</p>
        </div>
      </div>

      <!-- Body -->
      <div class="space-y-4 p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 border-b border-[#e5ded3] pb-3">
          <span class="text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Choose a UPI app</span>
          <span class="flex items-center gap-1 text-[10px] font-medium text-[#2f7d5a]">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Zero processing fees
          </span>
        </div>

        <div class="grid grid-cols-3 gap-2.5">
          <button type="button" class="rzp-upi-app-btn group flex cursor-pointer flex-col items-center gap-1.5 border border-[#d8d0c4] p-3 transition-colors hover:border-[#14110f]" data-app="Google Pay">
            <span class="flex h-10 w-10 items-center justify-center border border-[#e5ded3] bg-white text-[11px] font-medium text-[#14110f]">GPay</span>
            <span class="text-[10px] text-[#14110f]">Google Pay</span>
          </button>
          <button type="button" class="rzp-upi-app-btn group flex cursor-pointer flex-col items-center gap-1.5 border border-[#d8d0c4] p-3 transition-colors hover:border-[#14110f]" data-app="PhonePe">
            <span class="flex h-10 w-10 items-center justify-center border border-[#e5ded3] bg-white text-[11px] font-medium text-[#5f259f]">Pe</span>
            <span class="text-[10px] text-[#14110f]">PhonePe</span>
          </button>
          <button type="button" class="rzp-upi-app-btn group flex cursor-pointer flex-col items-center gap-1.5 border border-[#d8d0c4] p-3 transition-colors hover:border-[#14110f]" data-app="Paytm UPI">
            <span class="flex h-10 w-10 items-center justify-center border border-[#e5ded3] bg-white text-[10px] font-medium text-[#00a3d9]">Paytm</span>
            <span class="text-[10px] text-[#14110f]">Paytm UPI</span>
          </button>
        </div>

        <div class="space-y-1.5 pt-1">
          <label for="rzp-upi-id-input" class="block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Or enter your UPI ID (VPA)</label>
          <div class="flex gap-2">
            <input
              id="rzp-upi-id-input"
              type="text"
              placeholder="mobile@okaxis"
              class="checkout-input flex-1"
            />
            <button
              id="rzp-pay-upi-btn"
              type="button"
              class="shrink-0 cursor-pointer bg-[#14110f] px-4 text-[9px] font-medium uppercase tracking-[0.12em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]"
            >
              Verify &amp; pay
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between gap-2 border-t border-[#e5ded3] pt-3">
          <button
            id="rzp-pay-cards-btn"
            type="button"
            class="cursor-pointer text-[10px] uppercase tracking-[0.12em] text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4"
          >
            Pay via card / netbanking
          </button>
          <button
            id="rzp-cancel-btn"
            type="button"
            class="cursor-pointer text-[10px] uppercase tracking-[0.12em] text-[#8a8279] transition-colors hover:text-[#14110f]"
          >
            Cancel
          </button>
        </div>

        <div id="rzp-processing-indicator" class="hidden border border-[#cfe3d6] bg-[#f0f7f2] p-3 text-center text-[11px] font-medium text-[#2f7d5a]">
          Authorising payment via the secure gateway…
        </div>

        <p class="border-t border-[#e5ded3] pt-3 text-center text-[9px] uppercase tracking-[0.1em] text-[#8a8279]">
          PCI-DSS Level 1 · RBI licensed · 256-bit SSL
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .checkout-input {
    display: block;
    width: 100%;
    height: 2.75rem;
    border: 1px solid #d8d0c4;
    background-color: #fbf9f5;
    padding: 0 0.875rem;
    font-size: 12px;
    color: #14110f;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .checkout-input::placeholder {
    color: #9a938b;
  }

  .checkout-input:focus {
    border-color: #14110f;
    background-color: #ffffff;
  }

  .pay-card {
    border: 1px solid #d8d0c4;
    background-color: transparent;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .pay-card:hover {
    border-color: #b9ae9f;
  }

  .pay-card.is-selected {
    border-color: #14110f;
    background-color: #f4efe7;
  }
</style>

<script>
  import { getCartItems, saveCartItems } from '../stores/cartStore';
  import { addAdminOrder, getSiteSettings, syncSiteSettingsFromCloudflare, type AdminOrder } from '../stores/adminStore';
  import { syncOrderToCloudflare } from '../lib/cloudflare';
  import { syncOrderToSupabase } from '../lib/supabase';

  declare global {
    interface Window {
      Razorpay: any;
      PUBLIC_RAZORPAY_KEY_ID?: string;
    }
  }

  const cartList = document.getElementById('checkout-cart-items');
  const subtotalEl = document.getElementById('checkout-subtotal');
  const shippingEl = document.getElementById('checkout-shipping');
  const totalEl = document.getElementById('checkout-total');
  const codFeeRow = document.getElementById('cod-fee-row');
  const codNudgeBanner = document.getElementById('cod-nudge-banner');
  const completeBtn = document.getElementById('complete-order-btn') as HTMLButtonElement;
  const completeBtnText = document.getElementById('complete-btn-text');
  const successModal = document.getElementById('order-success-modal');
  const successTitle = document.getElementById('order-success-title');
  const orderNumDisplay = document.getElementById('order-number-display');
  const orderAwbDisplay = document.getElementById('order-awb-display');
  const orderPaymentModeDisplay = document.getElementById('order-payment-mode-display');
  const orderSuccessNote = document.getElementById('order-success-note');
  const trackOrderLink = document.getElementById('checkout-track-order-link') as HTMLAnchorElement;
  const viewInvoiceBtn = document.getElementById('checkout-view-invoice-btn');
  const formError = document.getElementById('checkout-form-error');

  // Payment Selection Cards
  const cardRazorpay = document.getElementById('payment-card-razorpay');
  const cardCod = document.getElementById('payment-card-cod');
  const methodRadios = document.querySelectorAll<HTMLInputElement>('input[name="payment-method"]');

  // Interactive Razorpay Modal elements
  const rzpModal = document.getElementById('razorpay-interactive-modal');
  const rzpModalAmount = document.getElementById('rzp-modal-amount');
  const rzpUpiAppBtns = document.querySelectorAll('.rzp-upi-app-btn');
  const rzpUpiIdInput = document.getElementById('rzp-upi-id-input') as HTMLInputElement;
  const rzpPayUpiBtn = document.getElementById('rzp-pay-upi-btn');
  const rzpPayCardsBtn = document.getElementById('rzp-pay-cards-btn');
  const rzpCancelBtn = document.getElementById('rzp-cancel-btn');
  const rzpProcessing = document.getElementById('rzp-processing-indicator');

  let currentCreatedOrder: AdminOrder | null = null;
  const items = getCartItems();
  const COD_FEE_PAISE = 2500; // ₹25 fixed COD fee
  let isCodSelected = false;

  // Sync edge settings (including Razorpay Key ID) from Cloudflare D1
  syncSiteSettingsFromCloudflare().catch(() => {});

  function formatINR(paise: number) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  }

  const setFormError = (message: string, field?: HTMLElement | null) => {
    if (formError) {
      formError.textContent = message;
      formError.classList.remove('hidden');
    }
    if (field) {
      field.focus();
      field.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  const clearFormError = () => {
    if (formError) {
      formError.textContent = '';
      formError.classList.add('hidden');
    }
  };

  // Gift note visibility
  const giftCheck = document.getElementById('gift-packaging-check') as HTMLInputElement | null;
  const giftMessageBox = document.getElementById('gift-message-box');
  giftCheck?.addEventListener('change', () => {
    if (!giftMessageBox) return;
    giftMessageBox.classList.toggle('hidden', !giftCheck.checked);
  });

  if (items.length === 0) {
    if (cartList) {
      cartList.innerHTML = `
        <div class="py-8 text-center">
          <p class="font-display text-[1.25rem] text-[#14110f]">Your bag is empty.</p>
          <p class="mx-auto mt-1.5 max-w-[220px] text-[11px] leading-relaxed text-[#6f675f]">Start with the pieces everyone loves — waterproof, 18K gold PVD, made for every day.</p>
          <a href="/collections/bestsellers" class="mt-4 inline-flex items-center gap-2 bg-[#14110f] px-5 py-2.5 text-[9px] uppercase tracking-[0.14em] text-[#f6f1e8]">Shop bestsellers <span aria-hidden="true">→</span></a>
        </div>
      `;
    }
    if (completeBtn) completeBtn.disabled = true;
  } else {
    const subtotalPaise = items.reduce((acc, i) => acc + i.pricePaise * i.quantity, 0);
    const shippingPaise = subtotalPaise >= 49900 ? 0 : 4900;

    // Applied coupon from the cart drawer
    let discountPaise = 0;
    let appliedCouponCode = '';
    try {
      const storedCoupon = localStorage.getItem('satvastones_applied_coupon');
      if (storedCoupon) {
        const parsed = JSON.parse(storedCoupon);
        if (parsed.discountPaise) {
          discountPaise = parsed.discountPaise;
          appliedCouponCode = parsed.code || '';
          const discountRow = document.getElementById('checkout-discount-row');
          const couponCodeEl = document.getElementById('checkout-coupon-code');
          const discountEl = document.getElementById('checkout-discount');
          if (discountRow) discountRow.classList.remove('hidden');
          if (couponCodeEl) couponCodeEl.textContent = parsed.code || 'COUPON';
          if (discountEl) discountEl.textContent = `−${formatINR(discountPaise)}`;
        }
      }
    } catch (_) {}

    const baseTotalPaise = Math.max(0, subtotalPaise - discountPaise + shippingPaise);

    if (cartList) {
      cartList.innerHTML = items
        .map(
          (item) => `
          <div class="flex items-center gap-3 py-3">
            <img src="${item.image}" alt="${item.name}" class="h-14 w-12 shrink-0 border border-[#ded5c7] bg-[#fbf9f5] object-cover" />
            <div class="min-w-0 flex-1">
              <p class="truncate text-[12px] leading-snug text-[#14110f]">${item.name}</p>
              <p class="mt-0.5 text-[10px] uppercase tracking-[0.1em] text-[#8a8279]">Qty ${item.quantity} · 18K gold PVD</p>
            </div>
            <span class="shrink-0 text-[12px] font-medium text-[#14110f]">${formatINR(item.pricePaise * item.quantity)}</span>
          </div>
        `
        )
        .join('');
    }

    if (subtotalEl) subtotalEl.textContent = formatINR(subtotalPaise);
    if (shippingEl) shippingEl.textContent = shippingPaise === 0 ? 'FREE' : formatINR(shippingPaise);
    if (totalEl) totalEl.textContent = formatINR(baseTotalPaise);
    if (completeBtnText) completeBtnText.textContent = `Pay via Razorpay (${formatINR(baseTotalPaise)}) & confirm order`;

    // Handle Payment Selection Toggle (Razorpay vs Cash on Delivery)
    function updatePaymentUI() {
      const selected = (document.querySelector('input[name="payment-method"]:checked') as HTMLInputElement)?.value;
      isCodSelected = selected === 'COD';

      if (isCodSelected) {
        cardCod?.classList.add('is-selected');
        cardRazorpay?.classList.remove('is-selected');

        codFeeRow?.classList.remove('hidden');
        codNudgeBanner?.classList.remove('hidden');

        const codTotalPaise = baseTotalPaise + COD_FEE_PAISE;
        if (totalEl) totalEl.textContent = formatINR(codTotalPaise);
        if (completeBtnText) completeBtnText.textContent = `Confirm cash on delivery (${formatINR(codTotalPaise)})`;
      } else {
        cardRazorpay?.classList.add('is-selected');
        cardCod?.classList.remove('is-selected');

        codFeeRow?.classList.add('hidden');
        codNudgeBanner?.classList.add('hidden');

        if (totalEl) totalEl.textContent = formatINR(baseTotalPaise);
        if (completeBtnText) completeBtnText.textContent = `Pay via Razorpay (${formatINR(baseTotalPaise)}) & confirm order`;
      }
    }

    methodRadios.forEach((radio) => {
      radio.addEventListener('change', updatePaymentUI);
    });

    // Auto-prefill details if a personal customer account is logged in
    const savedCustomerStr = localStorage.getItem('satva_customer_user');
    if (savedCustomerStr) {
      try {
        const cust = JSON.parse(savedCustomerStr);
        const nameInput = document.getElementById('checkout-name') as HTMLInputElement;
        const emailInput = document.getElementById('checkout-email') as HTMLInputElement;
        const phoneInput = document.getElementById('checkout-phone') as HTMLInputElement;
        const addr1Input = document.getElementById('checkout-addr1') as HTMLInputElement;
        const cityInput = document.getElementById('checkout-city') as HTMLInputElement;
        const stateInput = document.getElementById('checkout-state') as HTMLInputElement;
        const pinInput = document.getElementById('checkout-pin') as HTMLInputElement;

        if (nameInput && cust.fullName) nameInput.value = cust.fullName;
        if (emailInput && cust.email) emailInput.value = cust.email;
        if (phoneInput && cust.phone) phoneInput.value = `+91 ${cust.phone}`;
        if (addr1Input && cust.address) addr1Input.value = cust.address;
        if (cityInput && cust.city) cityInput.value = cust.city;
        if (stateInput && cust.state) stateInput.value = cust.state;
        if (pinInput && cust.pincode) pinInput.value = cust.pincode;
      } catch {}
    }

    // Order Finalizer
    const finalizeOrder = (opts: {
      paymentMethod: string;
      paymentStatus: 'PAID' | 'PENDING_ON_DELIVERY';
      paymentId: string;
      totalAmountPaise: number;
      isCod: boolean;
    }) => {
      const nameInput = document.getElementById('checkout-name') as HTMLInputElement;
      const emailInput = document.getElementById('checkout-email') as HTMLInputElement;
      const phoneInput = document.getElementById('checkout-phone') as HTMLInputElement;
      const addr1Input = document.getElementById('checkout-addr1') as HTMLInputElement;
      const addr2Input = document.getElementById('checkout-addr2') as HTMLInputElement;
      const cityInput = document.getElementById('checkout-city') as HTMLInputElement;
      const stateInput = document.getElementById('checkout-state') as HTMLInputElement;
      const pinInput = document.getElementById('checkout-pin') as HTMLInputElement;

      const randomId = Math.floor(100000 + Math.random() * 900000);
      const orderNumber = `SAT-2026-${randomId}`;
      const trackingNumber = `BLR-${Math.floor(100000000 + Math.random() * 900000000)}`;
      const courierPartner = 'BlueDart Air Express (Vapi Hub)';

      const newOrder: AdminOrder & { razorpayPaymentId?: string } = {
        id: `ord-${Date.now()}`,
        orderNumber,
        createdAt: new Date().toISOString(),
        customerName: nameInput?.value.trim() || 'Valued Patron',
        email: emailInput?.value.trim() || 'customer@example.com',
        phone: phoneInput?.value.trim() || '+91 90167 03180',
        address: `${addr1Input?.value.trim()}${addr2Input?.value ? ', ' + addr2Input.value.trim() : ''}`,
        city: cityInput?.value.trim() || 'Vapi',
        state: stateInput?.value.trim() || 'Gujarat',
        pincode: pinInput?.value.trim() || '396191',
        items: items.map((i) => ({
          productId: i.productId,
          variantId: i.variantId,
          slug: i.slug,
          name: i.name,
          quantity: i.quantity,
          pricePaise: i.pricePaise,
          image: i.image
        })),
        subtotalPaise,
        shippingPaise,
        discountPaise,
        couponCode: appliedCouponCode || undefined,
        totalPaise: opts.totalAmountPaise,
        paymentMethod: opts.paymentMethod,
        paymentStatus: opts.paymentStatus,
        razorpayPaymentId: opts.isCod ? undefined : opts.paymentId,
        fulfillmentStatus: 'VERIFIED',
        courierPartner,
        trackingNumber
      };

      currentCreatedOrder = newOrder;
      addAdminOrder(newOrder);

      // Synchronize to Cloudflare D1 edge database (and Supabase if configured)
      syncOrderToCloudflare(newOrder).catch((e) => console.warn('Cloudflare D1 edge sync notice:', e));
      syncOrderToSupabase(newOrder).catch((e) => console.warn('Supabase background sync notice:', e));

      // Update Confirmation Screen
      if (orderNumDisplay) {
        orderNumDisplay.textContent = `Order reference: ${orderNumber}`;
      }
      if (orderAwbDisplay) {
        orderAwbDisplay.textContent = `Courier AWB: ${trackingNumber} · ${courierPartner}`;
      }
      if (orderPaymentModeDisplay) {
        if (opts.isCod) {
          orderPaymentModeDisplay.textContent = `Payable on delivery: ${formatINR(opts.totalAmountPaise)} (cash / QR to courier)`;
          orderPaymentModeDisplay.className = 'inline-block border border-[#e6d6bb] bg-[#faf3e6] px-3 py-1 text-[10px] font-medium text-[#8a5314]';
        } else {
          orderPaymentModeDisplay.textContent = `Payment verified via Razorpay (${opts.paymentId})`;
          orderPaymentModeDisplay.className = 'inline-block border border-[#cfe3d6] bg-[#f0f7f2] px-3 py-1 text-[10px] font-medium text-[#2f7d5a]';
        }
      }
      if (orderSuccessNote) {
        if (opts.isCod) {
          orderSuccessNote.innerHTML = `Your <strong class="font-medium">cash on delivery</strong> order is confirmed. Please keep <strong class="font-medium">${formatINR(opts.totalAmountPaise)}</strong> ready in cash or UPI for the delivery partner. Hand-inspected and dispatched from our Vapi atelier within 24–48 hours.`;
        } else {
          orderSuccessNote.innerHTML = `Your payment of <strong class="font-medium">${formatINR(opts.totalAmountPaise)}</strong> was authorised via Razorpay. Your order is scheduled for hand-inspection and velvet gift packaging at our <strong class="font-medium">Vapi atelier</strong> within 24–48 hours.`;
        }
      }
      if (successTitle) {
        successTitle.textContent = opts.isCod ? 'Cash on delivery confirmed' : 'Payment verified — order confirmed';
      }
      if (trackOrderLink) {
        trackOrderLink.href = `/track-order?ref=${orderNumber}`;
      }
      if (successModal) successModal.classList.remove('hidden');
      if (completeBtn) completeBtn.classList.add('hidden');

      successModal?.scrollIntoView({ behavior: 'smooth', block: 'center' });

      // Clear Shopping Bag & Applied Coupon
      saveCartItems([]);
      try {
        localStorage.removeItem('satvastones_applied_coupon');
      } catch (_) {}
    };

    // Primary CTA Button Click Handler
    completeBtn?.addEventListener('click', async () => {
      clearFormError();

      const nameInput = document.getElementById('checkout-name') as HTMLInputElement;
      const emailInput = document.getElementById('checkout-email') as HTMLInputElement;
      const phoneInput = document.getElementById('checkout-phone') as HTMLInputElement;
      const addr1Input = document.getElementById('checkout-addr1') as HTMLInputElement;
      const cityInput = document.getElementById('checkout-city') as HTMLInputElement;
      const stateInput = document.getElementById('checkout-state') as HTMLInputElement;
      const pinInput = document.getElementById('checkout-pin') as HTMLInputElement;

      if (!nameInput?.value.trim()) {
        setFormError('Please enter your full name for courier delivery.', nameInput);
        return;
      }
      if (!phoneInput?.value.trim()) {
        setFormError('Please enter your 10-digit mobile number so we can send tracking updates.', phoneInput);
        return;
      }
      if (!emailInput?.value.trim()) {
        setFormError('Please enter your email address for the order confirmation and GST invoice.', emailInput);
        return;
      }
      if (!addr1Input?.value.trim() || !cityInput?.value.trim() || !pinInput?.value.trim()) {
        setFormError('Please complete your shipping address — street address, city, and PIN code.', !addr1Input?.value.trim() ? addr1Input : !cityInput?.value.trim() ? cityInput : pinInput);
        return;
      }

      // CASE A: CASH ON DELIVERY
      if (isCodSelected) {
        const finalCodAmountPaise = baseTotalPaise + COD_FEE_PAISE;
        finalizeOrder({
          paymentMethod: 'Cash on Delivery (COD)',
          paymentStatus: 'PENDING_ON_DELIVERY',
          paymentId: `cod_${Date.now()}`,
          totalAmountPaise: finalCodAmountPaise,
          isCod: true
        });
        return;
      }

      // CASE B: RAZORPAY ONLINE (UPI / CARDS / NETBANKING)
      const currentRazorpayTotalPaise = baseTotalPaise;
      const settings = getSiteSettings();
      const configuredKey = (
        settings.razorpayKeyId ||
        (window as any).PUBLIC_RAZORPAY_KEY_ID ||
        (import.meta as any).env?.PUBLIC_RAZORPAY_KEY_ID ||
        ''
      ).trim();
      const isLiveKey =
        configuredKey &&
        (configuredKey.startsWith('rzp_live_') || configuredKey.startsWith('rzp_test_')) &&
        !configuredKey.includes('AbcDef');

      async function ensureRazorpayLoaded(): Promise<boolean> {
        if (typeof (window as any).Razorpay !== 'undefined') return true;
        return new Promise((resolve) => {
          const existing = document.querySelector('script[src*="checkout.razorpay.com"]');
          if (existing && typeof (window as any).Razorpay !== 'undefined') return resolve(true);
          const s = document.createElement('script');
          s.src = 'https://checkout.razorpay.com/v1/checkout.js';
          s.async = true;
          s.onload = () => resolve(typeof (window as any).Razorpay !== 'undefined');
          s.onerror = () => resolve(false);
          document.head.appendChild(s);
        });
      }

      if (isLiveKey) {
        completeBtn.disabled = true;
        if (completeBtnText) completeBtnText.textContent = 'Launching Razorpay…';

        const sdkReady = await ensureRazorpayLoaded();
        if (sdkReady && typeof (window as any).Razorpay !== 'undefined') {
          const options = {
            key: configuredKey,
            amount: currentRazorpayTotalPaise,
            currency: 'INR',
            name: 'SatvaStones Jewellery',
            description: 'Anti-Tarnish Fine Jewellery Acquisition',
            image: '/satvastones-logo.png',
            handler: function (response: any) {
              finalizeOrder({
                paymentMethod: `Razorpay Online (${response.razorpay_payment_id || 'Instant'})`,
                paymentStatus: 'PAID',
                paymentId: response.razorpay_payment_id || `pay_${Date.now()}`,
                totalAmountPaise: currentRazorpayTotalPaise,
                isCod: false
              });
            },
            prefill: {
              name: nameInput.value,
              email: emailInput.value,
              contact: phoneInput.value
            },
            theme: {
              color: '#c5a059'
            },
            modal: {
              ondismiss: function () {
                completeBtn.disabled = false;
                if (completeBtnText) completeBtnText.textContent = 'Pay Now & Place Order';
              }
            }
          };

          try {
            const rzp = new (window as any).Razorpay(options);
            rzp.on('payment.failed', function (resp: any) {
              setFormError('Payment declined: ' + (resp.error?.description || 'please try another UPI app or card.'));
              completeBtn.disabled = false;
              if (completeBtnText) completeBtnText.textContent = 'Pay Now & Place Order';
            });
            rzp.open();
            return;
          } catch (e) {
            console.warn('Razorpay SDK modal error, opening the interactive UPI dialog:', e);
            completeBtn.disabled = false;
            if (completeBtnText) completeBtnText.textContent = 'Pay Now & Place Order';
          }
        } else {
          completeBtn.disabled = false;
          if (completeBtnText) completeBtnText.textContent = 'Pay Now & Place Order';
        }
      }

      // Interactive UPI dialog fallback
      if (rzpModal && rzpModalAmount) {
        rzpModalAmount.textContent = formatINR(currentRazorpayTotalPaise);
        rzpModal.classList.remove('hidden');
      }
    });

    // Interactive UPI Dialog Actions
    function triggerRazorpayUPIPayment(methodName: string) {
      if (rzpProcessing) rzpProcessing.classList.remove('hidden');
      setTimeout(() => {
        if (rzpProcessing) rzpProcessing.classList.add('hidden');
        if (rzpModal) rzpModal.classList.add('hidden');
        finalizeOrder({
          paymentMethod: `Razorpay UPI (${methodName})`,
          paymentStatus: 'PAID',
          paymentId: `pay_rzp_${Math.floor(10000000 + Math.random() * 90000000)}`,
          totalAmountPaise: baseTotalPaise,
          isCod: false
        });
      }, 700);
    }

    rzpUpiAppBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const app = btn.getAttribute('data-app') || 'UPI App';
        triggerRazorpayUPIPayment(app);
      });
    });

    rzpPayUpiBtn?.addEventListener('click', () => {
      const vpa = rzpUpiIdInput?.value.trim() || 'patron@upi';
      triggerRazorpayUPIPayment(`VPA: ${vpa}`);
    });

    rzpPayCardsBtn?.addEventListener('click', () => {
      triggerRazorpayUPIPayment('Credit / Debit Card');
    });

    rzpCancelBtn?.addEventListener('click', () => {
      if (rzpModal) rzpModal.classList.add('hidden');
    });

    viewInvoiceBtn?.addEventListener('click', () => {
      if (currentCreatedOrder) {
        window.dispatchEvent(new CustomEvent('satvastones:open_invoice', { detail: currentCreatedOrder }));
      }
    });
  }
</script>
