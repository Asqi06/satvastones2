  // Cloudinary Credentials Save Handler
  document.getElementById('save-cloudinary-config-btn')?.addEventListener('click', () => {
    const cloudNameInput = document.getElementById('setting-cloudinary-cloud-name') as HTMLInputElement;
    const presetInput = document.getElementById('setting-cloudinary-preset') as HTMLInputElement;
    const feedback = document.getElementById('cloudinary-config-feedback');

    updateCloudinaryConfig(cloudNameInput?.value.trim() || '', presetInput?.value.trim() || '');

    if (feedback) {
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 3000);
    }
  });

  // Cloudinary Connection Test Handler
  document.getElementById('test-cloudinary-conn-btn')?.addEventListener('click', async () => {
    const cloudNameInput = document.getElementById('setting-cloudinary-cloud-name') as HTMLInputElement;
    const presetInput = document.getElementById('setting-cloudinary-preset') as HTMLInputElement;
    const testFeedback = document.getElementById('cloudinary-test-feedback');
    const testBtn = document.getElementById('test-cloudinary-conn-btn') as HTMLButtonElement;

    const cloud = cloudNameInput?.value.trim() || '';
    const preset = presetInput?.value.trim() || '';

    if (!cloud || !preset) {
      if (testFeedback) {
        testFeedback.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200';
        testFeedback.textContent = 'Please enter both Cloud Name and Upload Preset before testing.';
        testFeedback.classList.remove('hidden');
      }
      return;
    }

    if (testBtn) {
      testBtn.disabled = true;
      testBtn.innerHTML = `<span>Testing connection...</span>`;
    }

    try {
      const res = await testCloudinaryConnection(cloud, preset);
      if (testFeedback) {
        testFeedback.className = res.success
          ? 'p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200'
          : 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200';
        testFeedback.textContent = res.message;
        testFeedback.classList.remove('hidden');
      }
    } catch (e: any) {
      if (testFeedback) {
        testFeedback.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200';
        testFeedback.textContent = e.message || 'Connection test failed.';
        testFeedback.classList.remove('hidden');
      }
    } finally {
      if (testBtn) {
        testBtn.disabled = false;
        testBtn.innerHTML = `
          <svg class="w-3.5 h-3.5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          <span>Test Connection</span>
        `;
      }
    }
  });

  // Supabase Credentials Save Handler
  document.getElementById('save-supabase-config-btn')?.addEventListener('click', () => {
    const urlInput = document.getElementById('setting-supabase-url') as HTMLInputElement;
    const keyInput = document.getElementById('setting-supabase-anon-key') as HTMLInputElement;
    const feedback = document.getElementById('supabase-config-feedback');

    saveSupabaseConfig(urlInput?.value.trim() || '', keyInput?.value.trim() || '');

    if (feedback) {
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 3000);
    }
  });

  // Cloudinary Universal One-Click Upload Handlers
  function initCloudinaryUploadButtons() {
    const uploadBtns = document.querySelectorAll('.cloudinary-upload-btn');
    uploadBtns.forEach((btn) => {
      if ((btn as any)._cloudinaryBound) return;
      (btn as any)._cloudinaryBound = true;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = btn.getAttribute('data-target') || '';
        const previewId = btn.getAttribute('data-preview') || '';
        const targetInput = document.getElementById(targetId) as HTMLInputElement;
        const previewEl = previewId ? (document.getElementById(previewId) as HTMLImageElement) : null;

        const settings = getSiteSettings();
        const cloudName = settings.cloudinaryCloudName || '';
        const uploadPreset = settings.cloudinaryUploadPreset || '';

        openCloudinaryWidget(
          cloudName,
          uploadPreset,
          (secureUrl: string) => {
            const optimized = optimizeCloudinaryUrl(secureUrl, { quality: 'auto', format: 'auto' });
            if (targetInput) {
              targetInput.value = optimized;
              targetInput.dispatchEvent(new Event('input', { bubbles: true }));
            }
            if (previewEl) {
              previewEl.src = optimized;
              previewEl.classList.remove('hidden');
            }
          },
          (err) => {
            console.error('Cloudinary upload failure:', err);
          }
        );
      });
    });
  }

