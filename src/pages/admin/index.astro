  // ==========================================
  // 6. STACK STUDIO CURATION LOGIC
  // ==========================================
  function renderStackStudio() {
    const products = getAdminProducts();
    const settings = getSiteSettings();
    const enabledIds = settings.stackStudioEnabledProducts || [];
    const container = document.getElementById('stackstudio-matrix-container');
    const discountInput = document.getElementById('admin-stack-discount') as HTMLInputElement;

    if (discountInput) {
      discountInput.value = String(settings.stackDiscountPercent || 15);
    }

    if (!container) return;

    const slots = [
      { name: 'Slot 1: Statement Necklaces', category: 'necklaces' },
      { name: 'Slot 2: Everyday Rings', category: 'rings' },
      { name: 'Slot 3: Waterproof Huggies & Earrings', category: 'earrings' },
      { name: 'Slot 4: Bracelets & Kada Bangles', category: 'bracelets' }
    ];

    // If the saved curation predates the current catalogue (legacy product IDs),
    // treat every product as enabled instead of showing an empty matrix.
    const curationIsStale = !products.some(
      (p) => enabledIds.includes(p.id) || enabledIds.includes(p.slug)
    );

    container.innerHTML = slots
      .map((slot) => {
        const matchingProds = products.filter(
          (p) => p.category === slot.category || (slot.category === 'bracelets' && p.category === 'bangles')
        );

        return `
        <div class="bg-gray-50 p-5 rounded-2xl border border-gray-200 space-y-3">
          <div class="flex items-center justify-between border-b border-gray-200 pb-2">
            <h3 class="font-bold text-xs uppercase tracking-wider text-gray-900">${slot.name}</h3>
            <span class="text-[11px] text-gray-500 font-semibold">${matchingProds.length} Products in Catalog</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            ${matchingProds
              .map((p) => {
                const isChecked = curationIsStale || enabledIds.includes(p.id) || enabledIds.includes(p.slug);
                return `
              <label class="bg-white p-3 rounded-xl border border-gray-200 flex items-center justify-between gap-3 cursor-pointer hover:border-[#e5ded3] transition-all">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src="${safeAdminUrl(p.image)}" alt="${escapeAdminHtml(p.name)}" class="w-10 h-12 object-cover rounded-lg border border-gray-100 shrink-0" />
                  <div class="min-w-0">
                    <p class="font-bold text-xs text-gray-900 truncate">${escapeAdminHtml(p.name)}</p>
                    <p class="text-[10px] text-gray-500">${formatINR(p.pricePaise)} • ${escapeAdminHtml(p.sku)}</p>
                  </div>
                </div>
                <input
                  type="checkbox"
                  class="stack-item-toggle w-4 h-4 accent-[#8d3f3d] rounded shrink-0 cursor-pointer"
                  data-prod-id="${escapeAdminHtml(p.id)}"
                  ${isChecked ? 'checked' : ''}
                />
              </label>
            `;
              })
              .join('')}
          </div>
        </div>
      `;
      })
      .join('');

    // Wire Save Stack Studio Rules
    const saveBtn = document.getElementById('save-stackstudio-rules-btn');
    saveBtn?.addEventListener('click', () => {
      const checkedBoxes = document.querySelectorAll('.stack-item-toggle:checked') as NodeListOf<HTMLInputElement>;
      const selectedIds = Array.from(checkedBoxes).map((cb) => cb.dataset.prodId || '');
      const newDiscount = Number(discountInput?.value || 15);

      const currentSettings = getSiteSettings();
      saveSiteSettings({
        ...currentSettings,
        stackDiscountPercent: newDiscount,
        stackStudioEnabledProducts: selectedIds
      });

      const feedback = document.getElementById('stackstudio-feedback');
      if (feedback) {
        feedback.classList.remove('hidden');
        setTimeout(() => feedback.classList.add('hidden'), 2500);
      }
    });
  }

