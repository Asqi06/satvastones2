                </button>
              </div>
              <span id="cat-feedback-${cat.slug}" class="text-xs font-bold text-emerald-700 hidden">Updated!</span>
            </div>
          </div>
        </div>
      </div>
    `
      )
      .join('');

    // Wire Category Save Buttons
    document.querySelectorAll('.save-category-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const slug = (e.currentTarget as HTMLElement).dataset.slug || '';
        const nameInput = document.getElementById(`cat-name-${slug}`) as HTMLInputElement;
        const taglineInput = document.getElementById(`cat-tagline-${slug}`) as HTMLInputElement;
        const descInput = document.getElementById(`cat-desc-${slug}`) as HTMLTextAreaElement;
        const imgInput = document.getElementById(`cat-image-${slug}`) as HTMLInputElement;
        const feedback = document.getElementById(`cat-feedback-${slug}`);

        updateAdminCategory(slug, {
          name: nameInput?.value.trim(),
          tagline: taglineInput?.value.trim(),
          description: descInput?.value.trim(),
          image: imgInput?.value.trim()
        });

        if (feedback) {
          feedback.classList.remove('hidden');
          setTimeout(() => feedback.classList.add('hidden'), 2500);
        }
      });
    });

    initCloudinaryUploadButtons();
  }

  // ==========================================
  // 6. STACK STUDIO CURATION LOGIC
  // ==========================================
  function renderStackStudio() {
    const products = getAdminProducts();
    const settings = getSiteSettings();
    const enabledIds = settings.stackStudioEnabledProducts || [];
    const container = document.getElementById('stackstudio-matrix-container');
    const discountInput = document.getElementById('admin-stack-discount') as HTMLInputElement;

    if (discountInput) {
      discountInput.value = String(settings.stackDiscountPercent || 15);
    }

    if (!container) return;

    const slots = [
      { name: 'Slot 1: Statement Necklaces', category: 'necklaces' },
      { name: 'Slot 2: Everyday Rings', category: 'rings' },
      { name: 'Slot 3: Waterproof Huggies & Earrings', category: 'earrings' },
      { name: 'Slot 4: Bracelets & Kada Bangles', category: 'bracelets' }
    ];

    container.innerHTML = slots
      .map((slot) => {
        const matchingProds = products.filter(
          (p) => p.category === slot.category || (slot.category === 'bracelets' && p.category === 'bangles')
        );

        return `
        <div class="bg-gray-50 p-5 rounded-2xl border border-gray-200 space-y-3">
          <div class="flex items-center justify-between border-b border-gray-200 pb-2">
            <h3 class="font-bold text-xs uppercase tracking-wider text-gray-900">${slot.name}</h3>
            <span class="text-[11px] text-gray-500 font-semibold">${matchingProds.length} Products in Catalog</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            ${matchingProds
              .map((p) => {
                const isChecked = enabledIds.includes(p.id) || enabledIds.includes(p.slug);
                return `
              <label class="bg-white p-3 rounded-xl border border-gray-200 flex items-center justify-between gap-3 cursor-pointer hover:border-[#f9d8dc] transition-all">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src="${p.image}" alt="${p.name}" class="w-10 h-12 object-cover rounded-lg border border-gray-100 shrink-0" />
                  <div class="min-w-0">
                    <p class="font-bold text-xs text-gray-900 truncate">${p.name}</p>
                    <p class="text-[10px] text-gray-500">${formatINR(p.pricePaise)} • ${p.sku}</p>
                  </div>
                </div>
                <input
                  type="checkbox"
                  class="stack-item-toggle w-4 h-4 accent-[#f2707f] rounded shrink-0 cursor-pointer"
                  data-prod-id="${p.id}"
                  ${isChecked ? 'checked' : ''}
                />
              </label>
            `;
              })
              .join('')}
          </div>
        </div>
      `;
      })
      .join('');

    // Wire Save Stack Studio Rules
    const saveBtn = document.getElementById('save-stackstudio-rules-btn');
    saveBtn?.addEventListener('click', () => {
      const checkedBoxes = document.querySelectorAll('.stack-item-toggle:checked') as NodeListOf<HTMLInputElement>;
      const selectedIds = Array.from(checkedBoxes).map((cb) => cb.dataset.prodId || '');
      const newDiscount = Number(discountInput?.value || 15);

      const currentSettings = getSiteSettings();
      saveSiteSettings({
        ...currentSettings,
        stackDiscountPercent: newDiscount,
        stackStudioEnabledProducts: selectedIds
      });

      const feedback = document.getElementById('stackstudio-feedback');
      if (feedback) {
        feedback.classList.remove('hidden');
        setTimeout(() => feedback.classList.add('hidden'), 2500);
      }
    });
  }

  const settingsForm = document.getElementById('site-settings-form');
  settingsForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const currentSettings = getSiteSettings();
    const shipInput = document.getElementById('setting-shipping-charge') as HTMLInputElement;
    const threshInput = document.getElementById('setting-free-threshold') as HTMLInputElement;
    const stackInput = document.getElementById('setting-stack-discount') as HTMLInputElement;
    const annInput = document.getElementById('setting-announcement-text') as HTMLTextAreaElement;
    const heroH1 = document.getElementById('setting-hero-headline') as HTMLInputElement;
    const heroTag = document.getElementById('setting-hero-tagline') as HTMLInputElement;
    const heroImg = document.getElementById('setting-hero-image') as HTMLInputElement;
    const feedback = document.getElementById('settings-save-feedback');

    const cats = ['rings', 'necklaces', 'bracelets', 'earrings', 'bangles', 'gift-sets'];
    const catImages: Record<string, string> = { ...currentSettings.categoryImages };
    cats.forEach((cat) => {
      const el = document.getElementById(`cat-img-${cat}`) as HTMLInputElement;
      if (el) catImages[cat] = el.value.trim();
    });

    const toastCheck = document.getElementById('setting-social-proof-toast') as HTMLInputElement;

    const newSettings: SiteSettings = {
      ...currentSettings,
      shippingChargePaise: Math.round(Number(shipInput.value) * 100),
      freeShippingThresholdPaise: Math.round(Number(threshInput.value) * 100),
      stackDiscountPercent: Number(stackInput.value),
      announcementText: annInput.value.trim(),
      heroHeadline: heroH1.value.trim(),
      heroTagline: heroTag.value.trim(),
      heroImage: heroImg.value.trim(),
      categoryImages: catImages,
      enableSocialProofToast: toastCheck ? toastCheck.checked : true
    };

    saveSiteSettings(newSettings);

    if (feedback) {
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 3500);
    }
  });

  // Live Hero Banner Interactive Preview & Presets
  const heroImgInput = document.getElementById('setting-hero-image') as HTMLInputElement;
  const heroH1Input = document.getElementById('setting-hero-headline') as HTMLInputElement;
  const heroImgPreview = document.getElementById('hero-img-preview') as HTMLImageElement;
  const heroPreviewTitle = document.getElementById('hero-preview-title');
  const heroLocalFileInput = document.getElementById('hero-local-file-input') as HTMLInputElement;

  if (heroImgInput && heroImgPreview) {
    heroImgInput.addEventListener('input', () => {
      if (heroImgInput.value) {
        heroImgPreview.src = heroImgInput.value;
      }
    });
  }

  if (heroH1Input && heroPreviewTitle) {
    heroH1Input.addEventListener('input', () => {
      heroPreviewTitle.textContent = heroH1Input.value || 'Jewellery that feels like you.';
    });
  }

  // Quick Preset Buttons
  document.querySelectorAll('.hero-preset-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const url = target.dataset.url;
      if (url && heroImgInput && heroImgPreview) {
        heroImgInput.value = url;
        heroImgPreview.src = url;
      }
    });
  });

  // Local File Upload -> Base64 Data URL
  if (heroLocalFileInput && heroImgInput && heroImgPreview) {
    heroLocalFileInput.addEventListener('change', () => {
      const file = heroLocalFileInput.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const result = ev.target?.result as string;
          if (result) {
            heroImgInput.value = result;
            heroImgPreview.src = result;
          }
        };
        reader.readAsDataURL(file);
      }
    });
  }

  // ==========================================
  // 5. 360° VIDEO CLAIMS LOGIC
  // ==========================================
  function renderClaims() {
    // Edge sync from Cloudflare D1
    fetchClaimsFromCloudflare().then((cfClaims) => {
      if (cfClaims && cfClaims.length > 0) {
        const local = getDamageClaims();
        const existingIds = new Set(local.map((c) => c.id));
        const newFromCf = cfClaims.filter((c) => !existingIds.has(c.id));
        if (newFromCf.length > 0) {
          saveDamageClaims([...newFromCf, ...local]);
        }
      }
    }).catch(() => {});

    const claims = getDamageClaims();
    const container = document.getElementById('claims-list-container');
    if (!container) return;

    if (claims.length === 0) {
      container.innerHTML = `<p class="text-xs text-gray-500 py-4">No damage claims pending review.</p>`;
      return;
    }

    container.innerHTML = claims
      .map(
        (c) => `
      <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col sm:flex-row justify-between items-start gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="font-bold text-sm text-gray-900">${c.orderNumber}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${
              c.status === 'REPLACEMENT_APPROVED'
                ? 'bg-emerald-50 text-emerald-700'
                : 'bg-amber-50 text-amber-700'
            }">${c.status}</span>
          </div>
          <p class="text-xs text-gray-800">Patron: <strong>${c.customerName}</strong> (${c.phone})</p>
          <p class="text-xs text-gray-600">${c.description}</p>
          <a href="${c.videoProofUrl}" target="_blank" class="inline-flex items-center gap-1 text-xs text-[#f2707f] font-bold hover:underline">
            View 360° Unboxing Video Proof →
          </a>
        </div>

        <div class="space-x-2 shrink-0">
          <button
            class="approve-claim-btn bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer"
            data-claim-id="${c.id}"
          >
            Approve Free Replacement
          </button>
          <button
            class="reject-claim-btn bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer"
            data-claim-id="${c.id}"
          >
            Reject
          </button>
        </div>
      </div>
    `
      )
      .join('');

    document.querySelectorAll('.approve-claim-btn').forEach((b) => {
      b.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.claimId || '';
        updateClaimStatus(id, 'REPLACEMENT_APPROVED');
        updateClaimStatusInCloudflare(id, 'REPLACEMENT_APPROVED').catch((err) =>
          console.warn('Cloudflare D1 claim sync error:', err)
        );
        renderClaims();
      });
    });

    document.querySelectorAll('.reject-claim-btn').forEach((b) => {
      b.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.claimId || '';
        updateClaimStatus(id, 'REJECTED');
        updateClaimStatusInCloudflare(id, 'REJECTED').catch((err) =>
          console.warn('Cloudflare D1 claim sync error:', err)
        );
        renderClaims();
      });
    });
  }

  // Order & Product Search Handlers
  const orderSearchInput = document.getElementById('order-search-input') as HTMLInputElement;
  orderSearchInput?.addEventListener('input', () => {
    renderOrders(orderSearchInput.value.trim());
  });

  const productSearchInput = document.getElementById('product-search-input') as HTMLInputElement;
  productSearchInput?.addEventListener('input', () => {
    renderProducts(productSearchInput.value.trim());
  });

  // Refresh Desk
  document.getElementById('admin-refresh-btn')?.addEventListener('click', () => {
    renderOrders();
    renderProducts();
    renderCoupons();
    populateSettingsForm();
    renderClaims();
  });

  // Check auth and mount
  checkAuth();
  window.addEventListener('satvastones:orders_updated', () => renderOrders());
  window.addEventListener('satvastones:products_updated', () => renderProducts());
  window.addEventListener('satvastones:coupons_updated', () => renderCoupons());
</script>
