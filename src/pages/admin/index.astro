          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Compare at Price (₹)</label>
            <input id="prod-compare-price" type="number" min="1" placeholder="2499" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]" />
