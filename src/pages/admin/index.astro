    const heroImg = document.getElementById('setting-hero-image') as HTMLInputElement;
    const cloudNameInput = document.getElementById('setting-cloudinary-cloud-name') as HTMLInputElement;
    const presetInput = document.getElementById('setting-cloudinary-preset') as HTMLInputElement;

    if (shipInput) shipInput.value = String(Math.round(settings.shippingChargePaise / 100));
    if (threshInput) threshInput.value = String(Math.round(settings.freeShippingThresholdPaise / 100));
    if (stackInput) stackInput.value = String(settings.stackDiscountPercent || 15);
    if (annInput) annInput.value = settings.announcementText;
    if (heroH1) heroH1.value = settings.heroHeadline;
    if (heroTag) heroTag.value = settings.heroTagline;
    if (heroImg) heroImg.value = settings.heroImage;
    if (cloudNameInput) cloudNameInput.value = settings.cloudinaryCloudName || '';
    if (presetInput) presetInput.value = settings.cloudinaryUploadPreset || '';

    // Razorpay Credentials
    const rzpKeyInput = document.getElementById('setting-razorpay-key-id') as HTMLInputElement;
    const rzpSecretInput = document.getElementById('setting-razorpay-key-secret') as HTMLInputElement;
    const rzpBadge = document.getElementById('razorpay-status-badge');
    if (rzpKeyInput) rzpKeyInput.value = settings.razorpayKeyId || '';
    if (rzpSecretInput && settings.razorpayKeySecret && !settings.razorpayKeySecret.startsWith('•••')) {
      rzpSecretInput.value = settings.razorpayKeySecret;
    }
    if (rzpBadge) {
      const key = settings.razorpayKeyId || '';
      if (key.startsWith('rzp_live_')) {
        rzpBadge.textContent = '● Live Production Active';
        rzpBadge.className = 'text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full border border-emerald-300';
      } else if (key.startsWith('rzp_test_')) {
        rzpBadge.textContent = '▲ Test Sandbox Key';
        rzpBadge.className = 'text-[10px] bg-amber-100 text-amber-900 font-bold px-2.5 py-0.5 rounded-full border border-amber-300';
      } else {
        rzpBadge.textContent = 'Pending Setup';
        rzpBadge.className = 'text-[10px] bg-gray-100 text-gray-600 font-bold px-2.5 py-0.5 rounded-full border border-gray-200';
      }
