        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Product Image URL *</label>
          <div class="flex gap-2">
            <input id="prod-image" type="url" required placeholder="https://images.unsplash.com/..." class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]" />
            <button
              type="button"
              class="cloudinary-upload-btn shrink-0 bg-rose-50 hover:bg-rose-100 text-[#a1505a] border border-[#f9d8dc] px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer"
