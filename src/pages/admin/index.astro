---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Operations Gate | Satvastones"
  description="Restricted operations gateway for Satvastones Jewellery."
  noindex={true}
>
  <!-- Cloudinary Official Upload Widget SDK -->
  <script is:inline src="https://upload-widget.cloudinary.com/global/all.js"></script>

  <div class="bg-[#f8f9fa] min-h-screen py-8 text-[#1A1A1A]">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- ========================================== -->
      <!-- 1. SECURE ADMIN AUTHENTICATION GATE SCREEN -->
      <!-- ========================================== -->
      <div id="admin-login-gate" class="min-h-[70vh] flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md p-8 sm:p-10 rounded-2xl shadow-xl border border-gray-200 text-center space-y-6">
          <div class="space-y-3">
            <img
              src="/satvastones-logo.png"
              alt="Satvastones"
              class="h-9 w-auto object-contain mx-auto mb-2"
            />
            <div class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-gray-700 bg-gray-100 px-3.5 py-1 rounded-full">
              <svg class="w-3.5 h-3.5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
              <span>Restricted Operations Gateway</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900 tracking-tight">
              Store Manager Access
            </h1>
            <p class="text-xs text-gray-500 leading-relaxed max-w-xs mx-auto">
              This terminal is strictly for authorized personnel of Satvastones (Anirudh A Verma). All session access is audited.
            </p>
          </div>

          <form id="admin-login-form" class="space-y-4 text-left">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Admin Username</label>
              <input
                id="admin-username-input"
                type="text"
                required
                autocomplete="username"
                placeholder="e.g. anirudh or admin"
                class="w-full bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
              />
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="block text-xs font-bold text-gray-700">Security Passkey</label>
                <span class="text-[10px] text-gray-400 font-mono">satva@vapi2026</span>
              </div>
              <div class="relative">
                <input
                  id="admin-password-input"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="Enter master passkey..."
                  class="w-full bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f] pr-10"
                />
                <button
                  type="button"
                  id="toggle-pwd-btn"
                  class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-700 cursor-pointer"
                  aria-label="Toggle password visibility"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </button>
              </div>
            </div>

            <p id="login-error-msg" class="text-xs text-red-600 font-bold hidden"></p>

            <button
              id="admin-login-btn"
              type="submit"
              class="w-full bg-[#111111] hover:bg-black text-white py-3 text-xs font-bold uppercase tracking-wider rounded-xl transition-all cursor-pointer shadow-md"
            >
              Authenticate & Unlock Terminal →
            </button>
          </form>

          <div class="pt-2 border-t border-gray-100 text-[10px] text-gray-400">
            Vapi Store Hub (Gujarat, India) • 256-Bit Encrypted Session
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- 2. AUTHENTICATED DASHBOARD (HIDDEN INITIALLY) -->
      <!-- ========================================== -->
      <div id="admin-dashboard-view" class="hidden space-y-6">
        
        <!-- Admin Top Bar -->
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-gray-200 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <img
              src="/satvastones-logo.png"
              alt="Satvastones"
              class="h-8 sm:h-9 w-auto object-contain"
            />
            <div class="border-l border-gray-200 pl-3.5">
              <h1 class="text-base sm:text-lg font-bold text-gray-900">
                Operations & Management Desk
              </h1>
              <p class="text-xs text-gray-500">
                Chala Atelier, Vapi (Gujarat - 396191) • Sole Proprietor: <strong>Anirudh A Verma</strong> • GSTIN: <strong>24DDAPV4074H1ZF</strong>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="text-right">
              <p class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Vapi Hub Local Time</p>
              <p id="admin-clock" class="text-xs font-bold text-gray-800"></p>
            </div>
            <button
              id="admin-refresh-btn"
              type="button"
              class="bg-gray-50 hover:bg-gray-100 text-gray-700 border border-gray-200 px-3 py-1.5 rounded-xl text-xs font-semibold cursor-pointer flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
              </svg>
              <span>Refresh</span>
            </button>
            <button
              id="admin-logout-btn"
              type="button"
              class="bg-black hover:bg-gray-800 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold cursor-pointer flex items-center gap-1.5 transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
              </svg>
              <span>Sign Out</span>
            </button>
          </div>
        </div>

        <!-- Metric KPI Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs space-y-1">
            <span class="text-[10px] uppercase font-bold text-gray-400">Total Gross Sales</span>
            <p id="metric-sales" class="text-2xl font-bold text-gray-900">₹0</p>
            <p class="text-[11px] text-emerald-700 font-semibold">100% Razorpay Verified</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs space-y-1">
            <span class="text-[10px] uppercase font-bold text-gray-400">Total Orders</span>
            <p id="metric-orders" class="text-2xl font-bold text-[#f2707f]">0</p>
            <p class="text-[11px] text-gray-500">Pan-India Dispatched</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs space-y-1">
            <span class="text-[10px] uppercase font-bold text-gray-400">Pending at Vapi Hub</span>
            <p id="metric-pending" class="text-2xl font-bold text-amber-600">0</p>
            <p class="text-[11px] text-amber-700 font-semibold">Under 24–48h SLA</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs space-y-1">
            <span class="text-[10px] uppercase font-bold text-gray-400">Average Order Value</span>
            <p id="metric-aov" class="text-2xl font-bold text-gray-900">₹0</p>
            <p class="text-[11px] text-[#007c52] font-semibold">Boosted via Stack Studio</p>
          </div>
        </div>

        <!-- Main Workspace Tabs Container -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-xs overflow-hidden">
          
          <!-- Navigation Tabs -->
          <div class="flex border-b border-gray-200 bg-gray-50/70 text-xs font-bold overflow-x-auto whitespace-nowrap">
            <button id="tab-btn-orders" class="admin-tab-btn py-3.5 px-6 text-[#f2707f] border-b-2 border-[#f2707f] bg-white cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
              <span>Orders & Fulfillment (<span id="tab-orders-count">0</span>)</span>
            </button>

            <button id="tab-btn-products" class="admin-tab-btn py-3.5 px-6 text-gray-500 hover:text-black cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
              </svg>
              <span>Products & Inventory (<span id="tab-products-count">0</span>)</span>
            </button>

            <button id="tab-btn-coupons" class="admin-tab-btn py-3.5 px-6 text-gray-500 hover:text-black cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
              </svg>
              <span>Coupons & Promos (<span id="tab-coupons-count">0</span>)</span>
            </button>

            <button id="tab-btn-categories" class="admin-tab-btn py-3.5 px-6 text-gray-500 hover:text-black cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
              <span>Categories & Visuals</span>
            </button>

            <button id="tab-btn-stackstudio" class="admin-tab-btn py-3.5 px-6 text-gray-500 hover:text-black cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
              </svg>
              <span>Stack Studio Curation</span>
            </button>

            <button id="tab-btn-settings" class="admin-tab-btn py-3.5 px-6 text-gray-500 hover:text-black cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Site & Pricing Settings</span>
            </button>

            <button id="tab-btn-claims" class="admin-tab-btn py-3.5 px-6 text-gray-500 hover:text-black cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
              </svg>
              <span>360° Unboxing Video Claims</span>
            </button>
          </div>

          <!-- ========================================== -->
          <!-- PANEL 1: ORDERS & INVOICES                 -->
          <!-- ========================================== -->
          <div id="panel-orders" class="p-5 sm:p-6 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <h2 class="text-base font-bold text-gray-900">Customer Orders (Dispatched from Vapi in 24–48h)</h2>
                <p class="text-xs text-gray-500">Live order fulfillment, AWB tracking assignment, and official GST tax invoices</p>
              </div>
              <div class="flex items-center gap-2">
                <input
                  id="order-search-input"
                  type="text"
                  placeholder="Search by Order, Name or City..."
                  class="bg-gray-50 border border-gray-200 px-3.5 py-1.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f] w-64"
                />
              </div>
            </div>

            <!-- Orders Table -->
            <div class="overflow-x-auto border border-gray-200 rounded-xl">
              <table class="w-full text-xs text-left">
                <thead>
                  <tr class="bg-gray-100 text-gray-800 font-bold border-b border-gray-200">
                    <th class="py-3 px-3.5">Order Ref</th>
                    <th class="py-3 px-3.5">Customer & Contact</th>
                    <th class="py-3 px-3.5">Destination</th>
                    <th class="py-3 px-3.5">Items</th>
                    <th class="py-3 px-3.5 text-right">Amount</th>
                    <th class="py-3 px-3.5 text-center">Fulfillment Status</th>
                    <th class="py-3 px-3.5">Courier & AWB</th>
                    <th class="py-3 px-3.5 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-orders-tbody" class="divide-y divide-gray-100 text-gray-700"></tbody>
              </table>
            </div>
          </div>

          <!-- ========================================== -->
          <!-- PANEL 2: PRODUCTS & INVENTORY CRUD         -->
          <!-- ========================================== -->
          <div id="panel-products" class="hidden p-5 sm:p-6 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <h2 class="text-base font-bold text-gray-900">Fine Jewellery Inventory Control</h2>
                <p class="text-xs text-gray-500">Add, edit, delete catalog products, set prices, and toggle stock</p>
              </div>
              <div class="flex items-center gap-3">
                <input
                  id="product-search-input"
                  type="text"
                  placeholder="Search products or SKU..."
                  class="bg-gray-50 border border-gray-200 px-3.5 py-1.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
                />
                <button
                  id="add-product-btn"
                  type="button"
                  class="bg-black hover:bg-gray-800 text-white px-4 py-2 rounded-xl text-xs font-bold cursor-pointer flex items-center gap-1.5 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                  <span>+ Add Product</span>
                </button>
              </div>
            </div>

            <!-- Products Grid -->
            <div id="admin-products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"></div>
          </div>

          <!-- ========================================== -->
          <!-- PANEL 3: COUPONS & PROMOS CRUD             -->
          <!-- ========================================== -->
          <div id="panel-coupons" class="hidden p-5 sm:p-6 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <h2 class="text-base font-bold text-gray-900">Promotional Discounts & Coupons</h2>
                <p class="text-xs text-gray-500">Configure stackable codes, AOV thresholds, and active status</p>
              </div>
              <button
                id="add-coupon-btn"
                type="button"
                class="bg-black hover:bg-gray-800 text-white px-4 py-2 rounded-xl text-xs font-bold cursor-pointer flex items-center gap-1.5 transition-colors self-start sm:self-auto"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>+ Create Coupon</span>
              </button>
            </div>

            <!-- Coupons List -->
            <div id="admin-coupons-list" class="space-y-3"></div>
          </div>

          <!-- ========================================== -->
          <!-- PANEL 4: SITE & PRICING SETTINGS           -->
          <!-- ========================================== -->
          <div id="panel-settings" class="hidden p-5 sm:p-6 space-y-6">
            <div>
              <h2 class="text-base font-bold text-gray-900">Dynamic Store Configuration</h2>
              <p class="text-xs text-gray-500">Manage delivery charges, Stack Studio discount, announcement marquee, hero content, and category images</p>
            </div>

            <form id="site-settings-form" class="space-y-6 max-w-4xl">
              
              <!-- Pricing & Shipping Rates -->
              <div class="bg-gray-50 p-5 rounded-2xl border border-gray-200 space-y-4">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Shipping & Discount Rates</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Standard Delivery Fee (₹)</label>
                    <input
                      id="setting-shipping-charge"
                      type="number"
                      required
                      min="0"
                      class="w-full bg-white border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
                    />
                    <p class="text-[10px] text-gray-400 mt-1">Charged on orders below free shipping threshold</p>
                  </div>

                  <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Free Shipping Threshold (₹)</label>
                    <input
                      id="setting-free-threshold"
                      type="number"
                      required
                      min="0"
                      class="w-full bg-white border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
                    />
                    <p class="text-[10px] text-gray-400 mt-1">Default ₹499 across all India orders</p>
                  </div>

                  <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Stack Studio Privilege Discount (%)</label>
                    <input
                      id="setting-stack-discount"
                      type="number"
                      required
                      min="1"
                      max="90"
