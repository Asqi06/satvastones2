    cats.forEach((cat) => {
      const el = document.getElementById(`cat-img-${cat}`) as HTMLInputElement;
      if (el) catImages[cat] = el.value.trim();
    });

    const toastCheck = document.getElementById('setting-social-proof-toast') as HTMLInputElement;

    // Razorpay Credentials
    const rzpKeyInput = document.getElementById('setting-razorpay-key-id') as HTMLInputElement;
    const rzpSecretInput = document.getElementById('setting-razorpay-key-secret') as HTMLInputElement;
    const rzpKeyVal = rzpKeyInput?.value.trim() || '';
    const rzpSecretVal = rzpSecretInput?.value.trim() || '';

    // Google OAuth Client ID
    const googleClientInput = document.getElementById('setting-google-client-id') as HTMLInputElement;
    const googleClientVal = googleClientInput?.value.trim() || '';

    const newSettings: SiteSettings = {
      ...currentSettings,
      shippingChargePaise: Math.round(Number(shipInput.value) * 100),
      freeShippingThresholdPaise: Math.round(Number(threshInput.value) * 100),
      stackDiscountPercent: Number(stackInput.value),
      announcementText: annInput.value.trim(),
      heroHeadline: heroH1.value.trim(),
      heroTagline: heroTag.value.trim(),
      heroImage: heroImg.value.trim(),
      categoryImages: catImages,
      razorpayKeyId: rzpKeyVal,
      ...(rzpSecretVal && !rzpSecretVal.startsWith('•••') ? { razorpayKeySecret: rzpSecretVal } : {}),
      googleClientId: googleClientVal,
      enableSocialProofToast: toastCheck ? toastCheck.checked : true
    };

    saveSiteSettings(newSettings);

    if (feedback) {
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 3500);
    }
  });

  // Live Hero Banner Interactive Preview & Presets
  const heroImgInput = document.getElementById('setting-hero-image') as HTMLInputElement;
  const heroH1Input = document.getElementById('setting-hero-headline') as HTMLInputElement;
  const heroImgPreview = document.getElementById('hero-img-preview') as HTMLImageElement;
  const heroPreviewTitle = document.getElementById('hero-preview-title');
  const heroLocalFileInput = document.getElementById('hero-local-file-input') as HTMLInputElement;

  if (heroImgInput && heroImgPreview) {
    heroImgInput.addEventListener('input', () => {
      if (heroImgInput.value) {
        heroImgPreview.src = heroImgInput.value;
      }
    });
  }

  if (heroH1Input && heroPreviewTitle) {
    heroH1Input.addEventListener('input', () => {
      heroPreviewTitle.textContent = heroH1Input.value || 'Jewellery that feels like you.';
    });
  }

  // Quick Preset Buttons
  document.querySelectorAll('.hero-preset-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const url = target.dataset.url;
      if (url && heroImgInput && heroImgPreview) {
        heroImgInput.value = url;
        heroImgPreview.src = url;
      }
    });
  });

  // Local File Upload -> Base64 Data URL
  if (heroLocalFileInput && heroImgInput && heroImgPreview) {
    heroLocalFileInput.addEventListener('change', () => {
      const file = heroLocalFileInput.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const result = ev.target?.result as string;
          if (result) {
            heroImgInput.value = result;
            heroImgPreview.src = result;
          }
        };
        reader.readAsDataURL(file);
      }
    });
  }

  // ==========================================
  // 5. 360° VIDEO CLAIMS LOGIC
  // ==========================================
  function renderClaims() {
    // Edge sync from Cloudflare D1
    fetchClaimsFromCloudflare().then((cfClaims) => {
      if (cfClaims && cfClaims.length > 0) {
        const local = getDamageClaims();
        const existingIds = new Set(local.map((c) => c.id));
        const newFromCf = cfClaims.filter((c) => !existingIds.has(c.id));
        if (newFromCf.length > 0) {
          saveDamageClaims([...newFromCf, ...local]);
        }
      }
    }).catch(() => {});

    const claims = getDamageClaims();
    const container = document.getElementById('claims-list-container');
    if (!container) return;

    if (claims.length === 0) {
      container.innerHTML = `<p class="text-xs text-gray-500 py-4">No damage claims pending review.</p>`;
      return;
    }

    container.innerHTML = claims
      .map(
        (c) => `
      <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col sm:flex-row justify-between items-start gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="font-bold text-sm text-gray-900">${escapeAdminHtml(c.orderNumber)}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${
              c.status === 'REPLACEMENT_APPROVED'
                ? 'bg-emerald-50 text-emerald-700'
                : 'bg-amber-50 text-amber-700'
            }">${escapeAdminHtml(c.status)}</span>
          </div>
          <p class="text-xs text-gray-800">Patron: <strong>${escapeAdminHtml(c.customerName)}</strong> (${escapeAdminHtml(c.phone)})</p>
          <p class="text-xs text-gray-600">${escapeAdminHtml(c.description)}</p>
          <a href="${safeAdminUrl(c.videoProofUrl)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-[#8d3f3d] font-bold hover:underline">
            View 360° Unboxing Video Proof →
          </a>
        </div>

        <div class="space-x-2 shrink-0">
          <button
            class="approve-claim-btn bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer"
            data-claim-id="${escapeAdminHtml(c.id)}"
          >
            Approve Free Replacement
          </button>
          <button
            class="reject-claim-btn bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer"
            data-claim-id="${escapeAdminHtml(c.id)}"
          >
            Reject
          </button>
        </div>
      </div>
    `
      )
      .join('');

    document.querySelectorAll('.approve-claim-btn').forEach((b) => {
      b.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.claimId || '';
        updateClaimStatus(id, 'REPLACEMENT_APPROVED');
        updateClaimStatusInCloudflare(id, 'REPLACEMENT_APPROVED').catch((err) =>
          console.warn('Cloudflare D1 claim sync error:', err)
        );
        renderClaims();
      });
    });

    document.querySelectorAll('.reject-claim-btn').forEach((b) => {
      b.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.claimId || '';
        updateClaimStatus(id, 'REJECTED');
        updateClaimStatusInCloudflare(id, 'REJECTED').catch((err) =>
          console.warn('Cloudflare D1 claim sync error:', err)
        );
        renderClaims();
      });
    });
  }

  // ==========================================
  // 6. CUSTOMER REVIEWS MANAGEMENT
  // ==========================================
  function renderReviews() {
    const list = document.getElementById('admin-reviews-list');
    const countEl = document.getElementById('tab-reviews-count');
    if (!list) return;

    const all = getStoredReviews();
    if (countEl) countEl.textContent = String(all.length);

    if (all.length === 0) {
      list.innerHTML = `<p class="text-xs text-gray-500 py-4">No reviews recorded yet.</p>`;
      return;
    }

    list.innerHTML = all
      .map(
        (r) => `
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-start justify-between gap-3 hover:bg-white transition-colors">
        <div class="space-y-1.5 flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs font-bold text-gray-900">${escapeAdminHtml(r.authorName)}</span>
            <span class="text-[10px] text-gray-400">•</span>
            <span class="text-[11px] text-gray-500">${escapeAdminHtml(r.city || 'Customer')}</span>
            <span class="text-[10px] ${
              r.verifiedBuyer
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                : 'bg-gray-100 text-gray-500 border-gray-200'
            } font-bold px-2 py-0.5 rounded-full border">
              ${r.verifiedBuyer ? 'Verified buyer' : 'Customer review'}
            </span>
            <span class="text-[11px] font-bold text-[#c5a059]">★ ${Number(r.rating) || 0} / 5</span>
          </div>
          <p class="text-xs font-bold text-gray-800">"${escapeAdminHtml(r.title)}"</p>
          <p class="text-xs text-gray-600 leading-relaxed">${escapeAdminHtml(r.content)}</p>
          <p class="text-[10px] text-gray-400">Piece: <strong>${escapeAdminHtml(r.productName || r.productId || 'General Atelier Review')}</strong> • Date: ${escapeAdminHtml(r.date)}</p>
        </div>
        <div class="self-end sm:self-start">
          <button
            class="delete-review-btn text-xs font-bold text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
            data-review-id="${escapeAdminHtml(r.id)}"
          >
            Delete
          </button>
        </div>
      </div>
    `
      )
      .join('');

    list.querySelectorAll('.delete-review-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.reviewId || '';
        if (confirm('Delete this customer review permanently from Cloudflare D1?')) {
          await deleteCustomerReview(id);
          renderReviews();
        }
      });
    });
  }

  document.getElementById('refresh-reviews-btn')?.addEventListener('click', () => {
    syncReviewsFromCloudflare().then(() => renderReviews());
  });

  // Order & Product Search Handlers
  const orderSearchInput = document.getElementById('order-search-input') as HTMLInputElement;
  orderSearchInput?.addEventListener('input', () => {
    renderOrders(orderSearchInput.value.trim());
  });

  const productSearchInput = document.getElementById('product-search-input') as HTMLInputElement;
  productSearchInput?.addEventListener('input', () => {
    renderProducts(productSearchInput.value.trim());
  });

  // Refresh Desk
  document.getElementById('admin-refresh-btn')?.addEventListener('click', () => {
    renderOrders();
    renderProducts();
    renderBlogs();
    renderCoupons();
    populateSettingsForm();
    renderClaims();
    renderReviews();
    syncSiteSettingsFromCloudflare().then(() => populateSettingsForm());
    syncProductsFromCloudflare().then(() => renderProducts());
    syncCouponsFromCloudflare().then(() => renderCoupons());
    syncReviewsFromCloudflare().then(() => renderReviews());
  });

  // ==========================================
  // 7. JOURNAL & BLOGS CRUD LOGIC
  // ==========================================
  let adminBlogsCache: BlogPost[] = [];
  let blogSlugTouched = false;

  const blogModal = document.getElementById('blog-modal');
  const blogModalTitle = document.getElementById('blog-modal-title');
  const blogForm = document.getElementById('blog-form') as HTMLFormElement | null;
  const blogIdInput = document.getElementById('blog-id') as HTMLInputElement | null;
  const blogTitleInput = document.getElementById('blog-title') as HTMLInputElement | null;
  const blogSlugInput = document.getElementById('blog-slug') as HTMLInputElement | null;
  const blogCategoryInput = document.getElementById('blog-category') as HTMLSelectElement | null;
  const blogAuthorInput = document.getElementById('blog-author') as HTMLInputElement | null;
  const blogTagsInput = document.getElementById('blog-tags') as HTMLInputElement | null;
  const blogCoverInput = document.getElementById('blog-cover') as HTMLInputElement | null;
  const blogCoverFile = document.getElementById('blog-cover-file') as HTMLInputElement | null;
  const blogCoverUploadLabel = document.getElementById('blog-cover-upload-label');
  const blogCoverPreviewWrap = document.getElementById('blog-cover-preview-wrap');
  const blogCoverPreview = document.getElementById('blog-cover-preview') as HTMLImageElement | null;
  const blogExcerptInput = document.getElementById('blog-excerpt') as HTMLTextAreaElement | null;
  const blogContentInput = document.getElementById('blog-content') as HTMLTextAreaElement | null;
  const blogPreviewPane = document.getElementById('blog-preview-pane');
  const blogToolbar = document.getElementById('blog-toolbar');
  const blogModeWrite = document.getElementById('blog-mode-write');
  const blogModePreview = document.getElementById('blog-mode-preview');
  const blogSeoTitleInput = document.getElementById('blog-seo-title') as HTMLInputElement | null;
  const blogSeoDescInput = document.getElementById('blog-seo-desc') as HTMLInputElement | null;
  const blogStatusInput = document.getElementById('blog-status') as HTMLSelectElement | null;
  const blogFeaturedInput = document.getElementById('blog-featured') as HTMLInputElement | null;
  const blogFormError = document.getElementById('blog-form-error');
  const saveBlogBtn = document.getElementById('save-blog-btn') as HTMLButtonElement | null;
  const blogSearchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const blogStatusFilter = document.getElementById('blog-status-filter') as HTMLSelectElement | null;

  function escapeBlogHtml(v: unknown): string {
    return String(v ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function blogSlugify(value: string): string {
    return String(value || '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)+/g, '')
      .slice(0, 120);
  }

  function syncCoverPreview() {
    const url = blogCoverInput?.value.trim() || '';
    if (url && blogCoverPreview && blogCoverPreviewWrap) {
      blogCoverPreview.src = url;
      blogCoverPreviewWrap.classList.remove('hidden');
    } else {
      blogCoverPreviewWrap?.classList.add('hidden');
    }
  }

  function setBlogEditorMode(mode: 'write' | 'preview') {
    if (mode === 'preview') {
      blogContentInput?.classList.add('hidden');
      blogToolbar?.classList.add('hidden');
      blogPreviewPane?.classList.remove('hidden');
      if (blogPreviewPane) {
        blogPreviewPane.innerHTML =
          renderEditorialMarkdown(blogContentInput?.value || '') ||
          '<p class="text-xs text-gray-400">Nothing to preview yet.</p>';
      }
      blogModePreview?.classList.add('bg-[#14110f]', 'text-white');
      blogModePreview?.classList.remove('bg-gray-100', 'text-gray-600');
      blogModeWrite?.classList.remove('bg-[#14110f]', 'text-white');
      blogModeWrite?.classList.add('bg-gray-100', 'text-gray-600');
    } else {
      blogContentInput?.classList.remove('hidden');
      blogToolbar?.classList.remove('hidden');
      blogPreviewPane?.classList.add('hidden');
      blogModeWrite?.classList.add('bg-[#14110f]', 'text-white');
      blogModeWrite?.classList.remove('bg-gray-100', 'text-gray-600');
      blogModePreview?.classList.remove('bg-[#14110f]', 'text-white');
      blogModePreview?.classList.add('bg-gray-100', 'text-gray-600');
    }
  }

  blogModeWrite?.addEventListener('click', () => setBlogEditorMode('write'));
  blogModePreview?.addEventListener('click', () => setBlogEditorMode('preview'));

  // Markdown quick formatting toolbar
  document.querySelectorAll<HTMLButtonElement>('.blog-md-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!blogContentInput) return;
      const start = blogContentInput.selectionStart || 0;
      const end = blogContentInput.selectionEnd || 0;
      const val = blogContentInput.value;
      const selected = val.slice(start, end);
      let replacement = selected;

      if (btn.dataset.mdPrefix) {
        replacement = `${btn.dataset.mdPrefix}${selected || 'Heading or item'}`;
      } else if (btn.dataset.mdWrap) {
        const w = btn.dataset.mdWrap;
        replacement = `${w}${selected || 'emphasized text'}${w}`;
      } else if (btn.dataset.mdLink) {
        const url = prompt('Enter destination URL (e.g. /collections/necklaces or https://...):', '/shop');
        if (!url) return;
        replacement = `[${selected || 'Explore the collection'}](${url.trim()})`;
      }

      blogContentInput.value = val.slice(0, start) + replacement + val.slice(end);
      blogContentInput.focus();
      blogContentInput.setSelectionRange(start + replacement.length, start + replacement.length);
    });
  });

  blogTitleInput?.addEventListener('input', () => {
    if (!blogSlugTouched && blogSlugInput && blogTitleInput) {
      blogSlugInput.value = blogSlugify(blogTitleInput.value);
    }
  });
  blogSlugInput?.addEventListener('input', () => {
    blogSlugTouched = Boolean(blogSlugInput.value.trim());
  });
  blogCoverInput?.addEventListener('input', syncCoverPreview);

  // Direct Cover Image Upload to Cloudflare R2 (/api/upload)
  blogCoverFile?.addEventListener('change', async () => {
    const file = blogCoverFile.files?.[0];
    if (!file) return;
    if (blogCoverUploadLabel) blogCoverUploadLabel.textContent = 'Uploading...';
    try {
      const formData = new FormData();
      formData.append('file', file);
      const token = getSavedToken();
      const res = await fetch('/api/upload', {
        method: 'POST',
        credentials: 'include',
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: formData
      });
      const data = await res.json();
      if (res.ok && data?.url && blogCoverInput) {
        blogCoverInput.value = data.url;
        syncCoverPreview();
      } else {
        alert(data?.error || 'Could not upload cover image.');
      }
    } catch {
      alert('Network error while uploading cover image.');
    } finally {
      if (blogCoverUploadLabel) blogCoverUploadLabel.textContent = 'Upload Image';
      blogCoverFile.value = '';
    }
  });

  function openBlogModal(blog?: BlogPost) {
    if (!blogModal || !blogForm) return;
    blogForm.reset();
    blogFormError?.classList.add('hidden');
    setBlogEditorMode('write');

    if (blog) {
      if (blogModalTitle) blogModalTitle.textContent = 'Edit Journal Article';
      if (blogIdInput) blogIdInput.value = blog.id;
      if (blogTitleInput) blogTitleInput.value = blog.title;
      if (blogSlugInput) blogSlugInput.value = blog.slug;
      blogSlugTouched = true;
      if (blogCategoryInput) blogCategoryInput.value = blog.category || 'Styling Guide';
      if (blogAuthorInput) blogAuthorInput.value = blog.author || 'Satvastones Editorial';
      if (blogTagsInput) blogTagsInput.value = (blog.tags || []).join(', ');
      if (blogCoverInput) blogCoverInput.value = blog.coverImage || '';
      if (blogExcerptInput) blogExcerptInput.value = blog.excerpt || '';
      if (blogContentInput) blogContentInput.value = blog.content || '';
      if (blogSeoTitleInput) blogSeoTitleInput.value = blog.seoTitle || '';
      if (blogSeoDescInput) blogSeoDescInput.value = blog.seoDescription || '';
      if (blogStatusInput) blogStatusInput.value = blog.status || 'published';
      if (blogFeaturedInput) blogFeaturedInput.checked = Boolean(blog.isFeatured);
      if (saveBlogBtn) saveBlogBtn.textContent = 'Update Article';
    } else {
      if (blogModalTitle) blogModalTitle.textContent = 'Write New Journal Article';
      if (blogIdInput) blogIdInput.value = '';
      blogSlugTouched = false;
      if (blogAuthorInput) blogAuthorInput.value = 'Satvastones Editorial';
      if (blogStatusInput) blogStatusInput.value = 'published';
      if (saveBlogBtn) saveBlogBtn.textContent = 'Publish Article';
    }

    syncCoverPreview();
    blogModal.classList.remove('hidden');
  }

  function closeBlogModal() {
    blogModal?.classList.add('hidden');
  }

  document.getElementById('add-blog-btn')?.addEventListener('click', () => openBlogModal());
  document.getElementById('close-blog-modal')?.addEventListener('click', closeBlogModal);
  document.getElementById('cancel-blog-modal')?.addEventListener('click', closeBlogModal);

  blogForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!blogTitleInput || !blogContentInput) return;
    blogFormError?.classList.add('hidden');

    const title = blogTitleInput.value.trim();
    const content = blogContentInput.value.trim();
    if (saveBlogBtn) {
      saveBlogBtn.disabled = true;
      saveBlogBtn.textContent = 'Saving...';
    }

    const result = await saveAdminBlog({
      id: blogIdInput?.value.trim() || undefined,
      title,
      slug: blogSlugInput?.value.trim() || undefined,
      category: blogCategoryInput?.value || 'Styling Guide',
      author: blogAuthorInput?.value.trim() || 'Satvastones Editorial',
      tags: (blogTagsInput?.value || '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      coverImage: blogCoverInput?.value.trim() || '',
      excerpt: blogExcerptInput?.value.trim() || '',
      content,
      seoTitle: blogSeoTitleInput?.value.trim() || '',
      seoDescription: blogSeoDescInput?.value.trim() || '',
      status: (blogStatusInput?.value === 'draft' ? 'draft' : 'published') as 'published' | 'draft',
      isFeatured: Boolean(blogFeaturedInput?.checked)
    });

    if (saveBlogBtn) {
      saveBlogBtn.disabled = false;
      saveBlogBtn.textContent = blogIdInput?.value ? 'Update Article' : 'Publish Article';
    }

    if (!result.ok) {
      if (blogFormError) {
        blogFormError.textContent = result.error || 'Could not save article.';
        blogFormError.classList.remove('hidden');
      }
      return;
    }

    closeBlogModal();
    await renderBlogs();
  });

  function drawBlogsList() {
    const container = document.getElementById('admin-blogs-list');
    const countEl = document.getElementById('tab-blogs-count');
    if (countEl) countEl.textContent = String(adminBlogsCache.length);
    if (!container) return;

    const q = (blogSearchInput?.value || '').trim().toLowerCase();
    const statusVal = blogStatusFilter?.value || 'all';

    const filtered = adminBlogsCache.filter((b) => {
      if (statusVal !== 'all' && b.status !== statusVal) return false;
      if (!q) return true;
      return (
        b.title.toLowerCase().includes(q) ||
        b.category.toLowerCase().includes(q) ||
        b.excerpt.toLowerCase().includes(q) ||
        (b.tags || []).some((t) => t.toLowerCase().includes(q))
      );
    });

    if (!filtered.length) {
      container.innerHTML = `
        <div class="col-span-full border border-dashed border-[#d8d0c4] bg-[#f4efe7]/60 p-10 text-center">
          <p class="font-display text-xl text-[#14110f]">No articles yet</p>
          <p class="mt-1.5 text-xs text-[#6f675f]">Write styling guides, anti-tarnish care tips, or gifting stories to bring organic Google traffic to your store.</p>
          <button type="button" id="empty-new-blog-btn" class="mt-4 cursor-pointer bg-[#14110f] px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#f6f1e8] hover:bg-[#8d3f3d]">+ Write First Article</button>
        </div>
      `;
      document.getElementById('empty-new-blog-btn')?.addEventListener('click', () => openBlogModal());
      return;
    }

    container.innerHTML = filtered
      .map((b) => {
        const statusBadge =
          b.status === 'published'
            ? '<span class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider">Published</span>'
            : '<span class="bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider">Draft</span>';
        const featuredBadge = b.isFeatured
          ? '<span class="bg-[#14110f] text-[#e3c98d] px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider">Featured</span>'
          : '';
        const dateLabel = b.publishedAt
          ? new Date(b.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
          : '';
        return `
          <div class="flex flex-col overflow-hidden border border-[#e5ded3] bg-white">
            ${
              b.coverImage
                ? `<div class="aspect-[16/9] overflow-hidden bg-[#f1ece3]"><img src="${escapeBlogHtml(b.coverImage)}" alt="${escapeBlogHtml(b.title)}" class="h-full w-full object-cover" /></div>`
                : `<div class="flex aspect-[16/9] items-center justify-center bg-[#f4efe7] text-[10px] uppercase tracking-[0.18em] text-[#8a8279]">No cover image</div>`
            }
            <div class="flex flex-1 flex-col justify-between p-4 space-y-3">
              <div>
                <div class="flex flex-wrap items-center gap-1.5">
                  ${statusBadge}
                  ${featuredBadge}
                  <span class="text-[9.5px] uppercase tracking-[0.14em] text-[#8d3f3d]">${escapeBlogHtml(b.category)}</span>
                </div>
                <h3 class="font-display mt-2 text-lg leading-snug text-[#14110f]">${escapeBlogHtml(b.title)}</h3>
                <p class="mt-1 line-clamp-2 text-[11.5px] leading-relaxed text-[#5f5851]">${escapeBlogHtml(b.excerpt)}</p>
                <p class="mt-2 text-[10px] text-[#8a8279]">${escapeBlogHtml(b.author)} · ${b.readTimeMinutes} min read ${dateLabel ? `· ${escapeBlogHtml(dateLabel)}` : ''}</p>
              </div>
              <div class="flex items-center justify-between gap-2 border-t border-[#efe9df] pt-3">
                ${
                  b.status === 'published'
                    ? `<a href="/journal/${encodeURIComponent(b.slug)}" target="_blank" rel="noopener noreferrer" class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#8d3f3d] hover:underline">View Live ↗</a>`
                    : `<span class="text-[10px] text-gray-400">Draft only</span>`
                }
                <div class="flex items-center gap-1.5">
                  <button type="button" data-edit-blog="${escapeBlogHtml(b.id)}" class="edit-blog-btn cursor-pointer border border-[#e5ded3] px-2.5 py-1 text-[10px] font-semibold text-[#14110f] hover:border-[#14110f]">Edit</button>
                  <button type="button" data-delete-blog="${escapeBlogHtml(b.id)}" data-delete-title="${escapeBlogHtml(b.title)}" class="delete-blog-btn cursor-pointer border border-red-200 bg-red-50 px-2.5 py-1 text-[10px] font-semibold text-red-700 hover:bg-red-600 hover:text-white">Delete</button>
                </div>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    container.querySelectorAll<HTMLButtonElement>('.edit-blog-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const found = adminBlogsCache.find((item) => item.id === btn.dataset.editBlog);
        if (found) openBlogModal(found);
      });
    });

    container.querySelectorAll<HTMLButtonElement>('.delete-blog-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.deleteBlog;
        const title = btn.dataset.deleteTitle || 'this article';
        if (!id) return;
        if (!confirm(`Delete "${title}"? This will also remove it from /journal and /sitemap.xml.`)) return;
        const res = await deleteAdminBlog(id);
        if (!res.ok) {
          alert(res.error || 'Could not delete article.');
          return;
        }
        await renderBlogs();
      });
    });
  }

  async function renderBlogs() {
    adminBlogsCache = await fetchAllAdminBlogs();
    drawBlogsList();
  }

  blogSearchInput?.addEventListener('input', drawBlogsList);
  blogStatusFilter?.addEventListener('change', drawBlogsList);

  // Copy Feed / Sitemap URL buttons
  document.querySelectorAll<HTMLButtonElement>('.seo-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetUrl = btn.dataset.copyUrl;
      if (!targetUrl) return;
      try {
        await navigator.clipboard.writeText(targetUrl);
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = orig;
        }, 1600);
      } catch {
        prompt('Copy URL:', targetUrl);
      }
    });
  });

  // Check auth and mount
  checkAuth();
  window.addEventListener('satvastones:orders_updated', () => renderOrders());
  window.addEventListener('satvastones:products_updated', () => renderProducts());
  window.addEventListener('satvastones:coupons_updated', () => renderCoupons());
  window.addEventListener('satvastones:review_added', () => renderReviews());
  window.addEventListener('satvastones:reviews_synced', () => renderReviews());
</script>
