            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
              </svg>
              <span>Upload via Cloudinary</span>
            </button>
          </div>
          <img id="prod-img-preview" src="" alt="Product Preview" class="w-16 h-20 rounded-xl object-cover border border-gray-200 mt-2 hidden" />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Short Headline / Catchphrase</label>
          <input id="prod-headline" type="text" placeholder="Sculptural statement band with French twist" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Material</label>
            <input id="prod-material" type="text" value="316L Surgical Stainless Steel" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Finish</label>
            <input id="prod-finish" type="text" value="18K Vacuum Gold PVD" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl" />
          </div>
