  const DEFAULT_IMAGE = 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80';
  const prodImgPreview = document.getElementById('prod-img-preview') as HTMLImageElement | null;
  const prodGalleryPreviews = document.getElementById('prod-gallery-previews');
  const prodGalleryUploadBtn = document.getElementById('prod-gallery-upload-btn');

  function isMockDefaultImage(url: string): boolean {
    return !url || url.includes('photo-1599643478518-a784e5dc4c8f');
  }

  function syncProductImagePreviews() {
    const primaryUrl = prodImageInput?.value.trim() || '';
    if (prodImgPreview) {
      if (primaryUrl) {
        prodImgPreview.src = primaryUrl;
        prodImgPreview.classList.remove('hidden');
      } else {
        prodImgPreview.src = '';
        prodImgPreview.classList.add('hidden');
      }
    }

    if (!prodGalleryPreviews) return;
    const urls = linesToArray(prodGalleryInput?.value || '');
    if (!urls.length) {
      prodGalleryPreviews.innerHTML = '';
      prodGalleryPreviews.classList.add('hidden');
      return;
    }

    prodGalleryPreviews.classList.remove('hidden');
    prodGalleryPreviews.innerHTML = urls
      .map(
        (url, idx) => `
          <div class="relative group w-16 h-20 rounded-xl overflow-hidden border border-gray-200 bg-gray-50">
            <img src="${url.replace(/"/g, '&quot;')}" alt="Gallery ${idx + 1}" class="w-full h-full object-cover" />
            <button
              type="button"
              data-remove-gallery-idx="${idx}"
              title="Remove image"
              class="absolute top-1 right-1 w-5 h-5 rounded-full bg-black/75 text-white text-[11px] leading-none flex items-center justify-center hover:bg-red-600 cursor-pointer"
            >×</button>
          </div>
        `
      )
      .join('');

    prodGalleryPreviews.querySelectorAll('[data-remove-gallery-idx]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number((btn as HTMLElement).dataset.removeGalleryIdx);
        const next = linesToArray(prodGalleryInput?.value || '').filter((_u, i) => i !== idx);
        if (prodGalleryInput) prodGalleryInput.value = next.join('\n');
        syncProductImagePreviews();
      });
    });
  }

  prodImageInput?.addEventListener('input', syncProductImagePreviews);
  prodGalleryInput?.addEventListener('input', syncProductImagePreviews);

  prodGalleryUploadBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const settings = getSiteSettings();
    const cloudName = settings.cloudinaryCloudName || '';
    const uploadPreset = settings.cloudinaryUploadPreset || '';

    openCloudinaryWidget(
      cloudName,
      uploadPreset,
      (secureUrl: string) => {
        const optimized = optimizeCloudinaryUrl(secureUrl, { quality: 'auto', format: 'auto' });
        const currentPrimary = prodImageInput?.value.trim() || '';

        // If the primary image field is empty (e.g. after extension pre-fill) or holds the mock fallback,
        // automatically promote the first uploaded image to be the primary product image.
        if (isMockDefaultImage(currentPrimary) && prodImageInput) {
          prodImageInput.value = optimized;
          prodImageInput.dispatchEvent(new Event('input', { bubbles: true }));
        } else if (prodGalleryInput) {
          const existing = linesToArray(prodGalleryInput.value);
          if (optimized !== currentPrimary && !existing.includes(optimized)) {
            existing.push(optimized);
            prodGalleryInput.value = existing.join('\n');
          }
          syncProductImagePreviews();
        }
      },
      (err) => {
        console.error('Cloudinary gallery upload failure:', err);
      },
      { multiple: true }
    );
  });

  function slugify(value: string): string {
    return value
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '')
      .slice(0, 120);
  }

  function showProductError(message: string) {
    if (!prodFormError) return;
    prodFormError.textContent = message;
    prodFormError.classList.remove('hidden');
  }

  function clearProductError() {
    prodFormError?.classList.add('hidden');
  }

  /** `descriptionLines` back to an array without empty entries. */
  function linesToArray(value: string): string[] {
    return value
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean);
  }

  function commaToArray(value: string): string[] {
    return value
      .split(',')
      .map((part) => part.trim())
      .filter(Boolean);
  }

  // Auto-fill the slug while typing the name, until the slug is edited by hand.
  let slugManuallyEdited = false;
  prodSlugInput?.addEventListener('input', () => {
    slugManuallyEdited = prodSlugInput.value.trim().length > 0;
  });
  prodNameInput?.addEventListener('input', () => {
    if (slugManuallyEdited) return;
    prodSlugInput.value = slugify(prodNameInput.value);
  });

  function openProductModal(product?: AdminProduct) {
    if (!productModal) return;
    clearProductError();
    slugManuallyEdited = Boolean(product);

    if (product) {
      if (prodModalTitle) prodModalTitle.textContent = 'Edit Product';
      prodIdInput.value = product.id;
      prodNameInput.value = product.name;
      prodCatInput.value = product.category;
      prodSkuInput.value = product.sku;
      prodSlugInput.value = product.slug || slugify(product.name);
      prodCollectionInput.value = product.collection || 'everyday-luxury';
      prodPriceInput.value = String(Math.round(product.pricePaise / 100));
      prodCompareInput.value = product.compareAtPricePaise ? String(Math.round(product.compareAtPricePaise / 100)) : '';
      prodImageInput.value = product.image;
      prodGalleryInput.value = (product.gallery || []).join('\n');
      prodHeadlineInput.value = product.headline || '';
      prodDescriptionInput.value = product.description || '';
      prodMaterialInput.value = product.material || '316L Surgical Stainless Steel';
      prodFinishInput.value = product.finish || '18K Vacuum Gold PVD';
      prodDimensionsInput.value = product.dimensions || '';
      prodWeightInput.value = product.weightGrams !== undefined ? String(product.weightGrams) : '';
      prodWarrantyInput.value = product.warranty || '6 Months Anti-Tarnish Assurance';
      prodCareInput.value = (product.careInstructions || []).join('\n');
      prodStockInput.checked = product.inStock;
      prodStockQtyInput.value = product.stockQuantity !== undefined ? String(product.stockQuantity) : '';
      prodLowStockInput.value = product.lowStockThreshold !== undefined ? String(product.lowStockThreshold) : '';
      prodSortOrderInput.value = product.sortOrder !== undefined ? String(product.sortOrder) : '';
      prodHsnInput.value = product.hsnCode || '';
      prodBestsellerInput.checked = Boolean(product.isBestseller);
      prodNewArrivalInput.checked = Boolean(product.isNewArrival);
      prodPublishedInput.checked = product.isPublished !== false;
      prodCostInput.value = product.costPaise ? String(Math.round(product.costPaise / 100)) : '';
      prodGstInput.value = product.gstRate !== undefined ? String(product.gstRate) : '3';
      prodTagsInput.value = (product.tags || []).join(', ');
      prodSeoTitleInput.value = product.seoTitle || '';
      prodSeoDescriptionInput.value = product.seoDescription || '';
    } else {
      if (prodModalTitle) prodModalTitle.textContent = 'Add New Product';
      prodIdInput.value = '';
      productForm?.reset();
      slugManuallyEdited = false;
      prodSlugInput.value = '';
      prodCollectionInput.value = 'everyday-luxury';
      prodMaterialInput.value = '316L Surgical Stainless Steel';
      prodFinishInput.value = '18K Vacuum Gold PVD';
      prodWarrantyInput.value = '6 Months Anti-Tarnish Assurance';
      prodGstInput.value = '3';
      prodStockInput.checked = true;
      prodPublishedInput.checked = true;
    }
    syncProductImagePreviews();
    productModal.classList.remove('hidden');
  }

  document.getElementById('add-product-btn')?.addEventListener('click', () => openProductModal());
  document.getElementById('close-product-modal')?.addEventListener('click', () => productModal?.classList.add('hidden'));
  document.getElementById('cancel-product-modal')?.addEventListener('click', () => productModal?.classList.add('hidden'));

  productForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearProductError();

    const editingId = prodIdInput.value;
    const id = editingId || `prod-${Date.now()}`;
    const name = prodNameInput.value.trim();
    const slug = slugify(prodSlugInput.value.trim() || name);
    const pricePaise = Math.round(Number(prodPriceInput.value) * 100);
    const compareAtPricePaise = prodCompareInput.value
      ? Math.round(Number(prodCompareInput.value) * 100)
      : undefined;

    if (!name) {
      showProductError('A product name is required.');
      prodNameInput.focus();
      return;
    }
    if (slug.length < 3) {
      showProductError('The URL slug needs at least 3 characters.');
      prodSlugInput.focus();
      return;
    }
    if (!Number.isFinite(pricePaise) || pricePaise <= 0) {
      showProductError('Enter a selling price greater than ₹0.');
      prodPriceInput.focus();
      return;
    }
    if (compareAtPricePaise && compareAtPricePaise <= pricePaise) {
      showProductError('The compare-at price should be higher than the selling price.');
      prodCompareInput.focus();
      return;
    }

    const slugClash = getAdminProducts().find((p) => p.slug === slug && p.id !== id);
    if (slugClash) {
      showProductError(`The slug "${slug}" is already used by ${slugClash.name}. Choose a different one.`);
      prodSlugInput.focus();
      return;
    }

    const rawPrimary = prodImageInput.value.trim();
    const rawGallery = linesToArray(prodGalleryInput.value);
    const allRealImages = [rawPrimary, ...rawGallery].filter(
      (url, index, all) => Boolean(url) && !isMockDefaultImage(url) && all.indexOf(url) === index
    );
    const image = allRealImages[0] || rawPrimary || DEFAULT_IMAGE;
    const gallery = allRealImages.slice(1);

    const prodData: AdminProduct = {
      id,
      name,
      slug,
      sku: prodSkuInput.value.trim().toUpperCase() || `SAT-${id.slice(-4).toUpperCase()}`,
      category: prodCatInput.value,
      collection: prodCollectionInput.value || 'everyday-luxury',
      pricePaise,
      compareAtPricePaise,
      headline: prodHeadlineInput.value.trim() || name,
      description: prodDescriptionInput.value.trim() || undefined,
      image,
      gallery: gallery.length ? gallery : undefined,
      material: prodMaterialInput.value.trim() || '316L Surgical Stainless Steel + 18K Gold PVD',
      finish: prodFinishInput.value.trim() || 'Mirror Polished',
      dimensions: prodDimensionsInput.value.trim() || undefined,
      weightGrams: prodWeightInput.value ? Number(prodWeightInput.value) : undefined,
      warranty: prodWarrantyInput.value.trim() || undefined,
      careInstructions: linesToArray(prodCareInput.value),
      inStock: prodStockInput.checked,
      stockQuantity: prodStockQtyInput.value !== '' ? Math.max(0, Number(prodStockQtyInput.value)) : undefined,
      lowStockThreshold:
        prodLowStockInput.value !== '' ? Math.max(0, Number(prodLowStockInput.value)) : undefined,
      sortOrder: prodSortOrderInput.value !== '' ? Number(prodSortOrderInput.value) : undefined,
      hsnCode: prodHsnInput.value.trim() || undefined,
      isBestseller: prodBestsellerInput.checked,
      isNewArrival: prodNewArrivalInput.checked,
      isPublished: prodPublishedInput.checked,
      costPaise: prodCostInput.value ? Math.round(Number(prodCostInput.value) * 100) : undefined,
      gstRate: prodGstInput.value ? Number(prodGstInput.value) : undefined,
      tags: commaToArray(prodTagsInput.value),
      seoTitle: prodSeoTitleInput.value.trim() || undefined,
      seoDescription: prodSeoDescriptionInput.value.trim() || undefined
    };

    // Preserve values that this form does not edit.
    if (editingId) {
      const existing = getAdminProducts().find((p) => p.id === editingId);
      if (existing) {
        prodData.variants = existing.variants;
        prodData.isDemo = existing.isDemo;
        prodData.rating = existing.rating;
        prodData.reviewCount = existing.reviewCount;
      }
    }

    const submitBtn = productForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalLabel = submitBtn?.textContent || 'Save Product';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving to catalogue…';
    }

    let saved = false;
    try {
      saved = editingId ? await updateAdminProduct(prodData) : await addAdminProduct(prodData);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }

    if (!saved) {
      // The localStorage copy is kept so the owner can retry, but say so plainly.
      showProductError(
        'Saved locally, but the D1 catalogue did not confirm the write. Check the deployment secrets and connection, then save again.'
      );
      renderProducts();
      return;
    }

    productModal?.classList.add('hidden');
    renderProducts();
    // Refresh the storefront catalogue in this tab (and other open tabs).
    void syncProductsFromCloudflare();
  });

  // ==========================================
  // 3. COUPONS & PROMOS CRUD LOGIC
  // ==========================================
  function renderCoupons() {
    const coupons = getAdminCoupons();
    const countEl = document.getElementById('tab-coupons-count');
    const container = document.getElementById('admin-coupons-list');

    if (countEl) countEl.textContent = String(coupons.length);

    if (container) {
      if (coupons.length === 0) {
        container.innerHTML = `<p class="text-xs text-gray-400 py-4">No coupons created.</p>`;
        return;
      }

      container.innerHTML = coupons
        .map(
          (c) => `
        <div class="p-4 bg-gray-50 rounded-xl border border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs uppercase tracking-wider text-[#8d3f3d] bg-[#f4efe7] border border-[#e5ded3] px-2.5 py-0.5 rounded-lg">
                ${escapeAdminHtml(c.code)}
              </span>
              <span class="text-[11px] font-bold ${c.isActive ? 'text-emerald-700' : 'text-gray-400'}">
                ${c.isActive ? '● Active' : '○ Inactive'}
              </span>
            </div>
            <p class="text-xs text-gray-800">${escapeAdminHtml(c.description || 'Custom promotional discount')}</p>
            <p class="text-[11px] text-gray-500">
              ${c.discountPercent ? `${c.discountPercent}% OFF` : `Flat ${formatINR(c.flatDiscountPaise || 0)} OFF`}
              ${c.minOrderPaise > 0 ? `• Min Order: ${formatINR(c.minOrderPaise)}` : '• No minimum order'}
            </p>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button
              class="toggle-coupon-btn px-2.5 py-1 text-xs font-semibold rounded-lg border ${
                c.isActive ? 'bg-white text-gray-700 border-gray-200 hover:bg-gray-100' : 'bg-emerald-50 text-emerald-700 border-emerald-200'
              } cursor-pointer"
              data-coupon-id="${escapeAdminHtml(c.id)}"
            >
              ${c.isActive ? 'Disable' : 'Enable'}
            </button>
            <button
              class="edit-coupon-btn bg-gray-100 hover:bg-gray-200 text-gray-800 px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer"
              data-coupon-id="${escapeAdminHtml(c.id)}"
            >
              Edit
            </button>
            <button
              class="delete-coupon-btn text-gray-400 hover:text-red-600 px-2 py-1 text-sm font-bold cursor-pointer"
              data-coupon-id="${escapeAdminHtml(c.id)}"
              title="Delete coupon"
            >
              ×
            </button>
          </div>
        </div>
      `
        )
        .join('');

      // Wire Coupon Toggle
      document.querySelectorAll('.toggle-coupon-btn').forEach((b) => {
        b.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.couponId || '';
          toggleCouponActive(id);
          renderCoupons();
        });
      });

      // Wire Coupon Edit
      document.querySelectorAll('.edit-coupon-btn').forEach((b) => {
        b.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.couponId || '';
          const coupon = coupons.find((c) => c.id === id);
          if (coupon) openCouponModal(coupon);
        });
      });

      // Wire Coupon Delete
      document.querySelectorAll('.delete-coupon-btn').forEach((b) => {
        b.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.couponId || '';
          if (confirm('Delete this coupon code?')) {
            await deleteAdminCoupon(id);
            renderCoupons();
          }
        });
      });
    }
  }

  // Coupon Modal Handling
  const couponModal = document.getElementById('coupon-modal');
  const couponForm = document.getElementById('coupon-form');
  const couponModalTitle = document.getElementById('coupon-modal-title');
  const couponIdInput = document.getElementById('coupon-id') as HTMLInputElement;
  const couponCodeInput = document.getElementById('coupon-code') as HTMLInputElement;
  const couponTypeSelect = document.getElementById('coupon-type') as HTMLSelectElement;
  const couponValInput = document.getElementById('coupon-value') as HTMLInputElement;
  const couponMinInput = document.getElementById('coupon-min-order') as HTMLInputElement;
  const couponDescInput = document.getElementById('coupon-desc') as HTMLInputElement;
  const couponActiveInput = document.getElementById('coupon-active') as HTMLInputElement;

  function openCouponModal(coupon?: AdminCoupon) {
    if (!couponModal) return;
    if (coupon) {
      if (couponModalTitle) couponModalTitle.textContent = 'Edit Coupon';
      couponIdInput.value = coupon.id;
      couponCodeInput.value = coupon.code;
      if (coupon.discountPercent) {
        couponTypeSelect.value = 'PERCENT';
        couponValInput.value = String(coupon.discountPercent);
      } else {
        couponTypeSelect.value = 'FLAT';
        couponValInput.value = String(Math.round((coupon.flatDiscountPaise || 0) / 100));
      }
      couponMinInput.value = String(Math.round(coupon.minOrderPaise / 100));
      couponDescInput.value = coupon.description || '';
      couponActiveInput.checked = coupon.isActive;
    } else {
      if (couponModalTitle) couponModalTitle.textContent = 'Create New Coupon';
      couponIdInput.value = '';
      couponForm?.reset();
      couponActiveInput.checked = true;
    }
    couponModal.classList.remove('hidden');
  }

  document.getElementById('add-coupon-btn')?.addEventListener('click', () => openCouponModal());
  document.getElementById('close-coupon-modal')?.addEventListener('click', () => couponModal?.classList.add('hidden'));
  document.getElementById('cancel-coupon-modal')?.addEventListener('click', () => couponModal?.classList.add('hidden'));

  couponForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = couponIdInput.value || `coup-${Date.now()}`;
    const code = couponCodeInput.value.trim().toUpperCase();
    const isPercent = couponTypeSelect.value === 'PERCENT';
    const val = Number(couponValInput.value);
    const minPaise = Math.round(Number(couponMinInput.value || 0) * 100);

    const couponData: AdminCoupon = {
      id,
      code,
      discountPercent: isPercent ? val : undefined,
      flatDiscountPaise: !isPercent ? Math.round(val * 100) : undefined,
      minOrderPaise: minPaise,
      description: couponDescInput.value.trim(),
      isActive: couponActiveInput.checked
    };

    if (couponIdInput.value) {
      updateAdminCoupon(couponData);
    } else {
      addAdminCoupon(couponData);
    }

    couponModal?.classList.add('hidden');
    renderCoupons();
  });

