          const badges = [
            p.isDemo
              ? '<span class="border border-[#b9ae9f] bg-[#f4efe7] px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-[#6f675f]">Demo</span>'
