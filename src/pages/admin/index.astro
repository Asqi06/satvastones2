              ? '<span class="border border-[#c9b9b7] bg-white px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-[#8a8279]">Draft</span>'
              : '',
            p.isBestseller
              ? '<span class="border border-[#d8c3a6] bg-[#fbf6ec] px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-[#8d3f3d]">Bestseller</span>'
              : '',
            p.isNewArrival
              ? '<span class="border border-[#d8c3a6] bg-[#fbf6ec] px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-[#8d3f3d]">New</span>'
              : ''
          ]
            .filter(Boolean)
            .join('');

          return `
        <div class="space-y-3 border border-[#e5ded3] bg-white p-3.5">
          <div class="relative">
            <img src="${escapeAdminHtml(p.image)}" alt="${escapeAdminHtml(p.name)}" class="aspect-[4/3] w-full bg-[#f4efe7] object-cover" />
            <span class="absolute left-2 top-2 bg-[#fbf9f5]/95 px-2 py-0.5 text-[8.5px] uppercase tracking-[0.12em] text-[#14110f] backdrop-blur-xs">
              ${escapeAdminHtml(p.category)}
            </span>
            <span class="absolute right-2 top-2 bg-[#14110f]/80 px-1.5 py-0.5 font-mono text-[9px] text-[#f6f1e8]">
              ${escapeAdminHtml(p.sku)}
            </span>
          </div>

          <div>
            <p class="truncate text-[11.5px] font-medium text-[#14110f]" title="${escapeAdminHtml(p.name)}">${escapeAdminHtml(p.name)}</p>
            <div class="mt-1 flex items-baseline gap-2">
              <span class="font-display text-sm text-[#8d3f3d]">${formatINR(p.pricePaise)}</span>
              ${p.compareAtPricePaise ? `<span class="text-[10px] text-[#9a938b] line-through">${formatINR(p.compareAtPricePaise)}</span>` : ''}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            ${stockLabel}
            ${badges}
          </div>

          <div class="flex items-center justify-between border-t border-[#e5ded3] pt-2.5">
            <button
              class="toggle-stock-btn cursor-pointer text-[10px] font-medium uppercase tracking-[0.1em] ${p.inStock ? 'text-emerald-800' : 'text-[#8d3f3d]'}"
              data-prod-id="${p.id}"
            >
              ${p.inStock ? '● In stock' : '○ Sold out'}
            </button>
            <div class="flex items-center gap-1.5">
              <button
                class="edit-prod-btn cursor-pointer border border-[#e5ded3] px-2.5 py-1 text-[9.5px] font-medium uppercase tracking-[0.1em] text-[#14110f] transition-colors hover:border-[#14110f]"
                data-prod-id="${p.id}"
              >
                Edit
              </button>
              <button
                class="delete-prod-btn cursor-pointer px-1.5 py-1 text-sm font-bold text-[#b9b1a7] transition-colors hover:text-[#8d3f3d]"
                data-prod-id="${p.id}"
                title="Delete product"
              >
                ×
              </button>
            </div>
          </div>
        </div>
      `;
        })
        .join('');

      // Wire Stock Toggle
      document.querySelectorAll('.toggle-stock-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.prodId || '';
          toggleAdminProductStock(id);
          renderProducts();
        });
      });

      // Wire Edit Product
      document.querySelectorAll('.edit-prod-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.prodId || '';
          const prod = products.find((p) => p.id === id);
          if (prod) openProductModal(prod);
        });
      });

      // Wire Delete Product
      document.querySelectorAll('.delete-prod-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.prodId || '';
          const prod = products.find((p) => p.id === id);
          const label = prod ? `“${prod.name}”` : 'this product';
          if (confirm(`Delete ${label}? It will be removed from the storefront catalogue immediately.`)) {
            await deleteAdminProduct(id);
            renderProducts();
            void syncProductsFromCloudflare();
          }
        });
      });
    }
  }

  // ---- Catalogue toolbar: export, demo cleanup, sync banner ----
  function exportProductsCsv() {
    const rows = getAdminProducts();
    const columns: Array<[string, (p: AdminProduct) => string | number]> = [
      ['id', (p) => p.id],
      ['name', (p) => p.name],
      ['slug', (p) => p.slug],
      ['sku', (p) => p.sku],
      ['category', (p) => p.category],
      ['collection', (p) => p.collection || ''],
      ['price_inr', (p) => Math.round(p.pricePaise / 100)],
      ['compare_at_inr', (p) => (p.compareAtPricePaise ? Math.round(p.compareAtPricePaise / 100) : '')],
      ['stock_qty', (p) => (p.stockQuantity ?? '')],
      ['in_stock', (p) => (p.inStock ? 'yes' : 'no')],
      ['published', (p) => (p.isPublished === false ? 'no' : 'yes')],
      ['bestseller', (p) => (p.isBestseller ? 'yes' : 'no')],
      ['new_arrival', (p) => (p.isNewArrival ? 'yes' : 'no')],
      ['hsn', (p) => p.hsnCode || ''],
      ['gst_rate', (p) => (p.gstRate ?? '')],
      ['tags', (p) => (p.tags || []).join('|')],
      ['image', (p) => p.image]
    ];

    const escapeCell = (value: string | number) => {
      let text = String(value ?? '');
      // Spreadsheet apps evaluate cells beginning with these characters.
      // Owner-entered product names/tags are untrusted, so neutralise formulas
      // while leaving genuine numeric values (e.g. negative adjustments) alone.
      if (text && !/^-?\d+(?:\.\d+)?$/.test(text) && /^[=+\-@\t\r]/.test(text)) {
        text = `'${text}`;
      }
      return /[",\n\r]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
    };

    const csv = [
      columns.map(([label]) => label).join(','),
      ...rows.map((product) => columns.map(([, read]) => escapeCell(read(product))).join(','))
    ].join('\r\n');

    const blob = new Blob([`\uFEFF${csv}`], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `satvastones-catalogue-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }

  document.getElementById('export-products-btn')?.addEventListener('click', exportProductsCsv);

  document.getElementById('remove-demo-btn')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const demoCount = getAdminProducts().filter((p) => p.isDemo).length;
    if (!demoCount) {
      alert('There are no demo products left in the catalogue.');
      return;
    }
    if (!confirm(`Remove ${demoCount} seeded demo product${demoCount === 1 ? '' : 's'}? Your own products are kept.`)) {
      return;
    }
    button.disabled = true;
    button.textContent = 'Removing…';
    try {
      const result = await removeDemoProducts();
      if (!result.ok) {
        alert(`Could not remove demo products: ${result.message}`);
        return;
      }
      renderProducts();
      void syncProductsFromCloudflare();
    } finally {
      button.disabled = false;
      button.textContent = 'Remove demo products';
    }
  });

