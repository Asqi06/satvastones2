      <form id="coupon-form" class="space-y-3.5">
        <input type="hidden" id="coupon-id" />
        
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Coupon Code *</label>
          <input id="coupon-code" type="text" required uppercase placeholder="e.g. LUXURY20" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs uppercase tracking-wider rounded-xl focus:outline-none focus:border-[#f2707f]" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Discount Type *</label>
            <select id="coupon-type" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl">
              <option value="PERCENT">Percentage (%)</option>
              <option value="FLAT">Flat Amount (₹)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Discount Value *</label>
            <input id="coupon-value" type="number" required min="1" placeholder="e.g. 15" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Minimum Order Value (₹)</label>
          <input id="coupon-min-order" type="number" min="0" placeholder="e.g. 1999" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl" />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Description / Benefit Notice</label>
          <input id="coupon-desc" type="text" placeholder="e.g. 15% OFF for Festive Orders" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl" />
        </div>

        <div class="flex items-center gap-2 pt-1">
          <input id="coupon-active" type="checkbox" checked class="w-4 h-4 accent-[#f2707f] rounded" />
          <label for="coupon-active" class="text-xs font-bold text-gray-800">Coupon Active</label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
          <button type="button" id="cancel-coupon-modal" class="px-4 py-2 text-xs font-semibold text-gray-600 hover:text-black">Cancel</button>
          <button type="submit" class="bg-black hover:bg-gray-800 text-white px-5 py-2 text-xs font-bold uppercase rounded-xl">Save Coupon</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: UPDATE FULFILLMENT & AWB            -->
  <!-- ========================================== -->
  <div id="fulfillment-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md p-6 sm:p-8 rounded-2xl shadow-2xl border border-gray-200 space-y-5">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <h3 class="text-base font-bold text-gray-900">Update Order Fulfillment</h3>
          <p id="fulfill-order-num" class="text-xs text-gray-500"></p>
        </div>
        <button id="close-fulfill-modal" class="text-gray-400 hover:text-black cursor-pointer">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="fulfillment-form" class="space-y-3.5">
        <input type="hidden" id="fulfill-target-order" />
        
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Fulfillment Status *</label>
          <select id="fulfill-status-select" required class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl font-semibold">
            <option value="VERIFIED">Verified (Order Confirmed)</option>
            <option value="PACKING_AT_VAPI">Packing at Vapi Atelier</option>
            <option value="DISPATCHED">Dispatched from Vapi Store</option>
            <option value="OUT_FOR_DELIVERY">Out for Delivery</option>
            <option value="DELIVERED">Delivered</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Courier Partner *</label>
          <select id="fulfill-courier-select" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl">
            <option value="BlueDart Air Express">BlueDart Air Express</option>
            <option value="Delhivery Prime">Delhivery Prime</option>
            <option value="DTDC Express">DTDC Express</option>
            <option value="Xpressbees Logistics">Xpressbees Logistics</option>
            <option value="India Post Speed Post">India Post Speed Post</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">AWB / Courier Tracking Number *</label>
          <input
            id="fulfill-tracking-input"
            type="text"
            required
            placeholder="e.g. BLR-892147321"
            class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs uppercase tracking-wider rounded-xl focus:outline-none focus:border-[#f2707f]"
          />
          <p class="text-[10px] text-gray-400 mt-1">Patron can track live with this number on /track-order</p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
          <button type="button" id="cancel-fulfill-modal" class="px-4 py-2 text-xs font-semibold text-gray-600 hover:text-black">Cancel</button>
          <button type="submit" class="bg-black hover:bg-gray-800 text-white px-5 py-2 text-xs font-bold uppercase rounded-xl">Update & Dispatch</button>
        </div>
      </form>
    </div>
