  <div id="blog-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-4xl p-6 sm:p-8 shadow-2xl border border-[#e5ded3] space-y-5 max-h-[92vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-[#e5ded3] pb-3">
        <div>
          <p class="text-[9px] uppercase tracking-[0.2em] text-[#8d3f3d]">Editorial Desk</p>
          <h3 id="blog-modal-title" class="font-display text-xl text-[#14110f]">Write New Journal Article</h3>
        </div>
        <button id="close-blog-modal" type="button" class="text-gray-400 hover:text-black cursor-pointer" aria-label="Close blog editor">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="blog-form" class="space-y-4">
        <input type="hidden" id="blog-id" />

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-gray-700 mb-1">Article Title *</label>
            <input id="blog-title" type="text" required placeholder="e.g. How to Style Waterproof 18K Gold PVD Jewellery with Silk Sarees" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#8d3f3d]" />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">URL Slug <span class="font-normal text-gray-400">(/journal/...)</span></label>
            <input id="blog-slug" type="text" placeholder="auto-generated-from-title" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs font-mono rounded-xl focus:outline-none focus:border-[#8d3f3d]" />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Category *</label>
            <select id="blog-category" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#8d3f3d]">
              <option value="Styling Guide">Styling Guide</option>
              <option value="Jewellery Care">Jewellery Care</option>
              <option value="Materials & Craft">Materials &amp; Craft</option>
              <option value="Gifting">Gifting</option>
              <option value="Trends & Stories">Trends &amp; Stories</option>
              <option value="Behind the Atelier">Behind the Atelier</option>
            </select>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Author</label>
            <input id="blog-author" type="text" value="Satvastones Editorial" placeholder="Satvastones Editorial" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#8d3f3d]" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Tags <span class="font-normal text-gray-400">(comma-separated)</span></label>
            <input id="blog-tags" type="text" placeholder="anti-tarnish, saree styling, gold pvd, gift guide" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#8d3f3d]" />
          </div>
        </div>

        <!-- Cover Image + Direct Upload -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-gray-700">Cover Image</label>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input id="blog-cover" type="text" placeholder="Paste image URL or upload directly →" class="flex-1 bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#8d3f3d]" />
            <label class="inline-flex cursor-pointer items-center justify-center gap-1.5 border border-[#14110f] bg-[#f4efe7] px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#14110f] hover:bg-[#14110f] hover:text-white rounded-xl transition-colors">
              <span id="blog-cover-upload-label">Upload Image</span>
              <input id="blog-cover-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif" class="hidden" />
            </label>
          </div>
          <div id="blog-cover-preview-wrap" class="hidden overflow-hidden border border-[#e5ded3] bg-[#f4efe7] max-h-44">
            <img id="blog-cover-preview" src="" alt="Cover preview" class="h-40 w-full object-cover" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Short Excerpt / Summary</label>
          <textarea id="blog-excerpt" rows="2" placeholder="A concise 1–2 sentence hook shown on Journal cards and Google search results..." class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#8d3f3d]"></textarea>
        </div>

        <!-- Markdown Editor + Live Preview -->
        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <label class="block text-xs font-bold text-gray-700">Article Content * <span class="font-normal text-gray-400">(Supports headings, bold, lists, quotes, links)</span></label>
            <div class="flex items-center gap-1 text-[10px]">
              <button type="button" id="blog-mode-write" class="cursor-pointer rounded-lg bg-[#14110f] px-2.5 py-1 font-semibold text-white">Write</button>
              <button type="button" id="blog-mode-preview" class="cursor-pointer rounded-lg bg-gray-100 px-2.5 py-1 font-semibold text-gray-600 hover:bg-gray-200">Preview</button>
            </div>
          </div>

          <div id="blog-toolbar" class="flex flex-wrap gap-1.5 border border-gray-200 bg-gray-50 p-2 rounded-t-xl">
            <button type="button" data-md-prefix="## " class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] font-bold hover:border-[#14110f]">H2</button>
            <button type="button" data-md-prefix="### " class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] font-bold hover:border-[#14110f]">H3</button>
            <button type="button" data-md-wrap="**" class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] font-bold hover:border-[#14110f]">Bold</button>
            <button type="button" data-md-wrap="*" class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] italic hover:border-[#14110f]">Italic</button>
            <button type="button" data-md-prefix="- " class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] hover:border-[#14110f]">• List</button>
            <button type="button" data-md-prefix="> " class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] hover:border-[#14110f]">Quote</button>
            <button type="button" data-md-link="1" class="blog-md-btn cursor-pointer rounded border border-gray-200 bg-white px-2 py-1 text-[10px] hover:border-[#14110f]">Link</button>
          </div>

          <textarea
            id="blog-content"
            rows="11"
            required
            placeholder="Write your article here...&#10;&#10;## Why 18K Gold PVD Lasts Through Indian Summers&#10;Explain the craft, link to your collections like [Explore Necklaces](/collections/necklaces), and help your readers!"
            class="w-full bg-gray-50 border border-gray-200 border-t-0 px-3.5 py-3 text-xs leading-relaxed font-mono rounded-b-xl focus:outline-none focus:border-[#8d3f3d]"
          ></textarea>

          <div id="blog-preview-pane" class="hidden min-h-[240px] max-h-[380px] overflow-y-auto border border-[#e5ded3] bg-[#fbf9f5] p-6 rounded-b-xl"></div>
        </div>

        <!-- Optional SEO Overrides -->
        <details class="border border-[#e5ded3] bg-[#fbf9f5] p-3.5 rounded-xl">
          <summary class="cursor-pointer text-xs font-bold text-[#14110f]">SEO Overrides (Optional — auto-generated if left blank)</summary>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <div>
              <label class="block text-[11px] font-semibold text-gray-700 mb-1">Custom SEO Title</label>
              <input id="blog-seo-title" type="text" placeholder="Defaults to Article Title | Satvastones Journal" class="w-full bg-white border border-gray-200 px-3 py-2 text-xs rounded-lg focus:outline-none focus:border-[#8d3f3d]" />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-gray-700 mb-1">Custom SEO Meta Description</label>
              <input id="blog-seo-desc" type="text" placeholder="Defaults to Excerpt" class="w-full bg-white border border-gray-200 px-3 py-2 text-xs rounded-lg focus:outline-none focus:border-[#8d3f3d]" />
            </div>
          </div>
        </details>

        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-[#e5ded3] pt-4">
          <div class="flex flex-wrap items-center gap-4">
            <label class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span>Status:</span>
              <select id="blog-status" class="border border-gray-200 bg-gray-50 px-2.5 py-1.5 text-xs rounded-lg focus:outline-none focus:border-[#8d3f3d]">
                <option value="published">Published (Live &amp; Indexed)</option>
                <option value="draft">Draft (Hidden)</option>
              </select>
            </label>
            <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
              <input id="blog-featured" type="checkbox" class="rounded border-gray-300" />
              <span>Feature on Journal Hero</span>
            </label>
          </div>

          <div class="flex items-center gap-2">
            <button id="cancel-blog-modal" type="button" class="border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-600 rounded-xl hover:bg-gray-50 cursor-pointer">Cancel</button>
            <button id="save-blog-btn" type="submit" class="bg-[#14110f] hover:bg-[#8d3f3d] text-[#f6f1e8] px-5 py-2 text-xs font-bold uppercase tracking-wider rounded-xl cursor-pointer transition-colors">Save Article</button>
          </div>
        </div>
        <p id="blog-form-error" class="hidden text-xs font-semibold text-red-600"></p>
      </form>
    </div>
  </div>

</BaseLayout>

<script>
  import {
    getAdminOrders,
    updateOrderStatus,
    deleteAdminOrder,
    getAdminProducts,
    addAdminProduct,
    updateAdminProduct,
    deleteAdminProduct,
    toggleAdminProductStock,
    getAdminCoupons,
    addAdminCoupon,
    updateAdminCoupon,
    deleteAdminCoupon,
    toggleCouponActive,
    getSiteSettings,
    saveSiteSettings,
    syncSiteSettingsFromCloudflare,
    syncProductsFromCloudflare,
    removeDemoProducts,
    syncCouponsFromCloudflare,
    updateAdminCategory,
    toggleStackStudioProduct,
    updateCloudinaryConfig,
    getDamageClaims,
    updateClaimStatus,
    type AdminOrder,
    type AdminProduct,
    type AdminCoupon,
    type SiteSettings,
    type CategoryDetail
  } from '../../stores/adminStore';
  import {
    getStoredReviews,
    syncReviewsFromCloudflare,
    deleteCustomerReview
  } from '../../stores/reviewStore';
  import {
    fetchAllAdminBlogs,
    saveAdminBlog,
    deleteAdminBlog,
    type BlogPost
  } from '../../stores/blogStore';
  import { renderEditorialMarkdown } from '../../lib/markdown';
  import { openCloudinaryWidget, optimizeCloudinaryUrl, testCloudinaryConnection, uploadToCloudinaryDirect } from '../../utils/cloudinary';
  import {
    fetchAllOrdersFromCloudflare,
    updateOrderStatusInCloudflare,
    fetchClaimsFromCloudflare,
    updateClaimStatusInCloudflare
  } from '../../lib/cloudflare';
  import { getSupabaseConfig, saveSupabaseConfig, fetchOrdersFromSupabase } from '../../lib/supabase';

  const TOKEN_KEY = 'satvastones_admin_token';
  let inactivityTimer: any = null;

  const loginGate = document.getElementById('admin-login-gate');
  const dashboardView = document.getElementById('admin-dashboard-view');
  const loginForm = document.getElementById('admin-login-form');
  const loginBtn = document.getElementById('admin-login-btn') as HTMLButtonElement;
  const usernameInput = document.getElementById('admin-username-input') as HTMLInputElement;
  const passwordInput = document.getElementById('admin-password-input') as HTMLInputElement;
  const errorMsg = document.getElementById('login-error-msg');
  const logoutBtn = document.getElementById('admin-logout-btn');
  const togglePwdBtn = document.getElementById('toggle-pwd-btn');

  // Toggle Password visibility
  togglePwdBtn?.addEventListener('click', () => {
    passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
  });

  // Centralized token helpers for session persistence across all admin modules
  function getSavedToken(): string {
    return (
      (typeof sessionStorage !== 'undefined' ? sessionStorage.getItem(TOKEN_KEY) : null) ||
      (typeof localStorage !== 'undefined' ? localStorage.getItem(TOKEN_KEY) : null) ||
      ''
    );
  }

  function saveToken(token: string) {
    sessionStorage.setItem(TOKEN_KEY, token);
    localStorage.setItem(TOKEN_KEY, token);
  }

  function clearToken() {
    sessionStorage.removeItem(TOKEN_KEY);
    localStorage.removeItem(TOKEN_KEY);
  }

  // 30-Minute Inactivity Auto-Lock (Bank-Grade Security Standard)
  function resetInactivityTimer() {
    if (inactivityTimer) clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(() => {
      const token = getSavedToken();
      if (token) {
        clearToken();
        alert('Administrative session locked due to 30 minutes of inactivity. Please re-authenticate.');
        checkAuth();
      }
    }, 30 * 60 * 1000); // 30 minutes
  }

  ['mousemove', 'keydown', 'click', 'scroll'].forEach((event) => {
    window.addEventListener(event, () => {
      if (getSavedToken()) {
        resetInactivityTimer();
      }
    }, { passive: true });
  });

  // Check Authentication Status via Cryptographic Edge Endpoint
  async function checkAuth() {
    const token = getSavedToken();
    if (!token) {
      loginGate?.classList.remove('hidden');
      dashboardView?.classList.add('hidden');
      return;
    }

    try {
      const res = await fetch('/api/admin/auth', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json() as any;

      if (res.ok && data.success && data.authenticated) {
        loginGate?.classList.add('hidden');
        dashboardView?.classList.remove('hidden');
        resetInactivityTimer();
        initDashboard();
        return;
      }
    } catch (err) {
      console.warn('Authentication verification offline or edge error:', err);
      // Dev server serves /api/admin/auth through the dev API plugin, so there is
      // no client-side credential bypass here anymore.
    }

    // Invalid or expired token
    clearToken();
    loginGate?.classList.remove('hidden');
    dashboardView?.classList.add('hidden');
  }

  // Handle Server-Side Login Attempt
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = usernameInput?.value.trim();
    const password = passwordInput?.value.trim();

    if (!username || !password) return;

    if (loginBtn) {
      loginBtn.disabled = true;
      loginBtn.innerHTML = 'Verifying Passkey & Encryption...';
    }

    try {
      const res = await fetch('/api/admin/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });

      const data = await res.json() as any;

      if (res.ok && data.success && data.token) {
        saveToken(data.token);
        if (errorMsg) errorMsg.classList.add('hidden');
        passwordInput.value = '';
        checkAuth();
      } else {
        if (errorMsg) {
          errorMsg.textContent = data.error || 'Invalid administrative credentials. Attempt recorded.';
          errorMsg.classList.remove('hidden');
        }
        passwordInput.value = '';
      }
    } catch (err: any) {
      if (errorMsg) {
        errorMsg.textContent = 'Authentication server unreachable. Check your connection and try again.';
        errorMsg.classList.remove('hidden');
      }
    } finally {
      if (loginBtn) {
        loginBtn.disabled = false;
        loginBtn.innerHTML = 'Authenticate & Unlock Terminal →';
      }
    }
  });

  // Handle Logout
  logoutBtn?.addEventListener('click', () => {
    clearToken();
    if (inactivityTimer) clearTimeout(inactivityTimer);
    checkAuth();
  });

  function formatINR(paise: number) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  }

  /** Admin-entered text is inserted with innerHTML, so escape it first. */
  function escapeAdminHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (char) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] as string)
    );
  }

  /** Only http(s) links are allowed in admin-rendered href/src attributes. */
  function safeAdminUrl(value: unknown): string {
    const raw = String(value ?? '').trim();
    if (!raw) return '';
    try {
      const parsed = new URL(raw, window.location.origin);
      if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') return '';
      return escapeAdminHtml(parsed.toString());
    } catch {
      return '';
    }
  }

  function initDashboard() {
    // Live Clock
    const clockEl = document.getElementById('admin-clock');
    const updateClock = () => {
      if (clockEl) {
        clockEl.textContent =
          new Date().toLocaleTimeString('en-IN', {
            timeZone: 'Asia/Kolkata',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
          }) + ' IST';
      }
    };
    updateClock();
    setInterval(updateClock, 1000);

    // Tab Navigation
    const tabs = ['orders', 'products', 'blogs', 'coupons', 'categories', 'stackstudio', 'settings', 'claims', 'reviews'];
    tabs.forEach((tab) => {
      const btn = document.getElementById(`tab-btn-${tab}`);
      const panel = document.getElementById(`panel-${tab}`);
      btn?.addEventListener('click', () => {
        tabs.forEach((t) => {
          document.getElementById(`tab-btn-${t}`)?.classList.remove('text-[#8d3f3d]', 'border-b-2', 'border-[#8d3f3d]', 'bg-white');
          document.getElementById(`tab-btn-${t}`)?.classList.add('text-gray-500');
          document.getElementById(`panel-${t}`)?.classList.add('hidden');
        });
        btn.classList.add('text-[#8d3f3d]', 'border-b-2', 'border-[#8d3f3d]', 'bg-white');
        btn.classList.remove('text-gray-500');
        panel?.classList.remove('hidden');
      });
    });

    renderOrders();
    renderProducts();
    renderBlogs();
    renderCoupons();
    renderCategories();
    renderStackStudio();
    populateSettingsForm();
    renderClaims();
    renderReviews();

    // Edge Sync from Cloudflare D1
    syncSiteSettingsFromCloudflare().then(() => populateSettingsForm());
    syncProductsFromCloudflare().then(() => {
      renderProducts();
      hideSyncBanner();
    });
    syncCouponsFromCloudflare().then(() => renderCoupons());
    syncReviewsFromCloudflare().then(() => renderReviews());
    initCloudinaryUploadButtons();
  }

  // ==========================================
  // 1. ORDERS LOGIC
  // ==========================================
  function renderOrders(filterText = '') {
    const orders = getAdminOrders();
    drawOrders(orders, filterText);

    // 1. Edge Sync from Cloudflare D1 (Authoritative source)
    fetchAllOrdersFromCloudflare().then((cfOrders) => {
      if (cfOrders !== null) {
        saveAdminOrders(cfOrders);
        drawOrders(cfOrders, filterText);
      }
    }).catch(() => {});
  }

  function drawOrders(orders: AdminOrder[], filterText = '') {
    const countEl = document.getElementById('tab-orders-count');
    const salesEl = document.getElementById('metric-sales');
    const ordersEl = document.getElementById('metric-orders');
    const pendingEl = document.getElementById('metric-pending');
    const aovEl = document.getElementById('metric-aov');
    const tbody = document.getElementById('admin-orders-tbody');

    if (countEl) countEl.textContent = String(orders.length);

    const totalSales = orders.reduce((sum, o) => sum + o.totalPaise, 0);
    const pendingCount = orders.filter((o) => o.fulfillmentStatus !== 'DELIVERED').length;
    const aov = orders.length > 0 ? Math.round(totalSales / orders.length) : 0;

    if (salesEl) salesEl.textContent = formatINR(totalSales);
    if (ordersEl) ordersEl.textContent = String(orders.length);
    if (pendingEl) pendingEl.textContent = String(pendingCount);
    if (aovEl) aovEl.textContent = formatINR(aov);

    const filtered = orders.filter((o) => {
      const q = filterText.toLowerCase();
      return (
        o.orderNumber.toLowerCase().includes(q) ||
        o.customerName.toLowerCase().includes(q) ||
        o.city.toLowerCase().includes(q) ||
        (o.trackingNumber && o.trackingNumber.toLowerCase().includes(q))
      );
    });

    if (tbody) {
      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-gray-400">No matching orders found.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered
        .map((o) => {
          let statusBadge = '';
          if (o.fulfillmentStatus === 'VERIFIED') {
            statusBadge = '<span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full font-bold">Verified</span>';
          } else if (o.fulfillmentStatus === 'PACKING_AT_VAPI') {
            statusBadge = '<span class="bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full font-bold">Packing at Vapi</span>';
          } else if (o.fulfillmentStatus === 'DISPATCHED') {
            statusBadge = '<span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-bold">Dispatched</span>';
          } else if (o.fulfillmentStatus === 'OUT_FOR_DELIVERY') {
            statusBadge = '<span class="bg-purple-50 text-purple-700 px-2 py-0.5 rounded-full font-bold">Out for Delivery</span>';
          } else {
            statusBadge = '<span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full font-bold">Delivered</span>';
          }

          return `
          <tr class="hover:bg-gray-50/80 transition-colors">
            <td class="py-3 px-3.5 font-bold text-gray-900">${escapeAdminHtml(o.orderNumber)}</td>
            <td class="py-3 px-3.5">
              <p class="font-bold text-gray-900">${escapeAdminHtml(o.customerName)}</p>
              <p class="text-[11px] text-gray-500">${escapeAdminHtml(o.phone)}</p>
            </td>
            <td class="py-3 px-3.5">
              <p class="font-medium text-gray-900">${escapeAdminHtml(o.city)}, ${escapeAdminHtml(o.state)}</p>
              <p class="text-[11px] text-gray-400">PIN: ${escapeAdminHtml(o.pincode)}</p>
            </td>
            <td class="py-3 px-3.5">
              ${o.items.map((i) => `<p class="truncate max-w-[150px] text-gray-800">${escapeAdminHtml(i.name)} (×${i.quantity})</p>`).join('')}
            </td>
            <td class="py-3 px-3.5 text-right font-bold text-[#8d3f3d]">${formatINR(o.totalPaise)}</td>
            <td class="py-3 px-3.5 text-center">${statusBadge}</td>
            <td class="py-3 px-3.5">
              <p class="font-semibold text-gray-800 text-[11px]">${escapeAdminHtml(o.courierPartner || 'Pending Assignment')}</p>
              <p class="text-[10px] font-mono text-gray-500">${escapeAdminHtml(o.trackingNumber || 'AWB pending')}</p>
            </td>
            <td class="py-3 px-3.5 text-right space-x-1.5 whitespace-nowrap">
              <button
                class="view-invoice-btn bg-black hover:bg-gray-800 text-white px-2.5 py-1 rounded-lg text-[11px] font-bold cursor-pointer"
                data-order-num="${escapeAdminHtml(o.orderNumber)}"
              >
                Invoice
              </button>
              <button
                class="dispatch-action-btn bg-[#f4efe7] hover:bg-[#f0e6d8] text-[#8d3f3d] border border-[#e5ded3] px-2.5 py-1 rounded-lg text-[11px] font-bold cursor-pointer"
                data-order-num="${escapeAdminHtml(o.orderNumber)}"
              >
                Fulfill
              </button>
              <button
                class="delete-order-btn text-gray-400 hover:text-red-600 p-1 rounded cursor-pointer"
                data-order-num="${escapeAdminHtml(o.orderNumber)}"
                title="Delete order"
              >
                ×
              </button>
            </td>
          </tr>
        `;
        })
        .join('');

      // Wire Invoice Click
      document.querySelectorAll('.view-invoice-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const num = (e.currentTarget as HTMLElement).dataset.orderNum;
          const order = orders.find((o) => o.orderNumber === num);
          if (order) {
            window.dispatchEvent(new CustomEvent('satvastones:open_invoice', { detail: order }));
          }
        });
      });

      // Wire Fulfillment Modal Click
      document.querySelectorAll('.dispatch-action-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const num = (e.currentTarget as HTMLElement).dataset.orderNum || '';
          const order = orders.find((o) => o.orderNumber === num);
          if (order) {
            openFulfillmentModal(order);
          }
        });
      });

      // Wire Delete Order
      document.querySelectorAll('.delete-order-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const num = (e.currentTarget as HTMLElement).dataset.orderNum || '';
          if (confirm(`Are you sure you want to delete order ${num}?`)) {
            await deleteAdminOrder(num);
            renderOrders();
          }
        });
      });
    }
  }

  // Fulfillment Modal Logic
  const fulfillModal = document.getElementById('fulfillment-modal');
  const fulfillForm = document.getElementById('fulfillment-form');
  const fulfillTargetInput = document.getElementById('fulfill-target-order') as HTMLInputElement;
  const fulfillNumText = document.getElementById('fulfill-order-num');
  const fulfillStatusSelect = document.getElementById('fulfill-status-select') as HTMLSelectElement;
  const fulfillCourierSelect = document.getElementById('fulfill-courier-select') as HTMLSelectElement;
  const fulfillTrackingInput = document.getElementById('fulfill-tracking-input') as HTMLInputElement;

  function openFulfillmentModal(order: AdminOrder) {
    if (!fulfillModal) return;
    fulfillTargetInput.value = order.orderNumber;
    if (fulfillNumText) fulfillNumText.textContent = `Order ${order.orderNumber} • ${order.customerName}`;
    fulfillStatusSelect.value = order.fulfillmentStatus || 'DISPATCHED';
    fulfillCourierSelect.value = order.courierPartner || 'BlueDart Air Express';
    fulfillTrackingInput.value = order.trackingNumber || `BLR-${Math.floor(100000000 + Math.random() * 900000000)}`;
    fulfillModal.classList.remove('hidden');
  }

  document.getElementById('close-fulfill-modal')?.addEventListener('click', () => fulfillModal?.classList.add('hidden'));
  document.getElementById('cancel-fulfill-modal')?.addEventListener('click', () => fulfillModal?.classList.add('hidden'));

  fulfillForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const orderNum = fulfillTargetInput.value;
    const newStatus = fulfillStatusSelect.value as any;
    const courier = fulfillCourierSelect.value;
    const tracking = fulfillTrackingInput.value.trim();

    updateOrderStatus(orderNum, newStatus, courier, tracking);
    updateOrderStatusInCloudflare(orderNum, newStatus, courier, tracking).catch((err) =>
      console.warn('Cloudflare D1 status sync error:', err)
    );
    fulfillModal?.classList.add('hidden');
    renderOrders();
  });

  // ==========================================
  // 2. PRODUCTS & INVENTORY CRUD LOGIC
  // ==========================================
  function renderProducts(filterText = '') {
    const products = getAdminProducts();
    const countEl = document.getElementById('tab-products-count');
    const grid = document.getElementById('admin-products-grid');
    const demoNote = document.getElementById('demo-products-note');

    if (countEl) countEl.textContent = String(products.length);
    if (demoNote) demoNote.classList.toggle('hidden', !products.some((p) => p.isDemo));

    const filtered = products.filter((p) => {
      const q = filterText.toLowerCase();
      return p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q) || p.category.toLowerCase().includes(q);
    });

    if (grid) {
      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-full border border-dashed border-[#e5ded3] bg-[#fbf9f5] px-6 py-12 text-center">
          <p class="font-display text-lg text-[#14110f]">No products match this search.</p>
          <p class="mt-1 text-[11px] text-[#6f675f]">Clear the search, or add your first piece to the catalogue.</p>
        </div>`;
        return;
      }

      grid.innerHTML = filtered
        .map((p) => {
          const stockQty = typeof p.stockQuantity === 'number' ? p.stockQuantity : null;
          const lowStock =
            stockQty !== null && stockQty > 0 && stockQty <= (p.lowStockThreshold ?? 3);
          const stockLabel = !p.inStock
            ? '<span class="border border-[#c9b9b7] bg-[#f8eeee] px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-[#7a3634]">Sold out</span>'
            : lowStock
              ? `<span class="border border-amber-300 bg-amber-50 px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-amber-800">Low · ${stockQty} left</span>`
              : stockQty !== null
                ? `<span class="border border-[#d8e3d8] bg-[#f1f6f1] px-1.5 py-0.5 text-[8.5px] font-medium uppercase tracking-[0.1em] text-emerald-800">${stockQty} in stock</span>`
