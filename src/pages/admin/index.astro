    // Google Client ID
    const googleClientInput = document.getElementById('setting-google-client-id') as HTMLInputElement;
    if (googleClientInput) googleClientInput.value = settings.googleClientId || '';

    const heroPreview = document.getElementById('hero-img-preview') as HTMLImageElement;
    const heroPreviewTitle = document.getElementById('hero-preview-title');
    const toastCheck = document.getElementById('setting-social-proof-toast') as HTMLInputElement;

    if (heroPreview && settings.heroImage) {
      heroPreview.src = settings.heroImage;
    }
    if (heroPreviewTitle && settings.heroHeadline) {
      heroPreviewTitle.textContent = settings.heroHeadline;
    }
    if (toastCheck) {
      toastCheck.checked = settings.enableSocialProofToast !== false;
    }

    // Supabase DB Credentials
    const sbConfig = getSupabaseConfig();
    const sbUrlInput = document.getElementById('setting-supabase-url') as HTMLInputElement;
    const sbKeyInput = document.getElementById('setting-supabase-anon-key') as HTMLInputElement;
    if (sbConfig) {
      if (sbUrlInput) sbUrlInput.value = sbConfig.url;
      if (sbKeyInput) sbKeyInput.value = sbConfig.anonKey;
    }

    const cats = ['rings', 'necklaces', 'bracelets', 'earrings', 'bangles', 'gift-sets'];
    cats.forEach((cat) => {
      const el = document.getElementById(`cat-img-${cat}`) as HTMLInputElement;
      if (el && settings.categoryImages && settings.categoryImages[cat]) {
