            </div>
            <div id="claims-list-container" class="space-y-3"></div>
          </div>

        </div>

      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: ADD / EDIT PRODUCT                  -->
  <!-- ========================================== -->
  <div id="product-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-lg p-6 sm:p-8 rounded-2xl shadow-2xl border border-gray-200 space-y-5 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h3 id="product-modal-title" class="text-base font-bold text-gray-900">Add New Product</h3>
        <button id="close-product-modal" class="text-gray-400 hover:text-black cursor-pointer">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="product-form" class="space-y-3.5">
        <input type="hidden" id="prod-id" />
        
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Product Name *</label>
          <input id="prod-name" type="text" required placeholder="e.g. Elysian Croissant Dome Ring" class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Category *</label>
            <select id="prod-category" required class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]">
              <option value="rings">Rings</option>
              <option value="necklaces">Necklaces</option>
              <option value="bracelets">Bracelets</option>
              <option value="earrings">Earrings</option>
              <option value="bangles">Bangles</option>
              <option value="gift-sets">Gift Sets</option>
              <option value="jewellery-set">Jewellery Sets</option>
              <option value="mystery-jewellery-jar">Mystery Jewellery Jar</option>
