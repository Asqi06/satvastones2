---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' }
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Satvastones Jewellery',
  description:
    'The story behind Satvastones: anti-tarnish everyday jewellery in 316L surgical steel and 18K gold PVD, hand-inspected and dispatched from Vapi, Gujarat.',
  url: 'https://www.satvastones.in/about',
  mainEntity: {
    '@type': 'JewelryStore',
    name: 'Satvastones Jewellery',
    foundingLocation: { '@type': 'Place', name: 'Vapi, Gujarat, India' },
    founder: { '@type': 'Person', name: 'Anirudh A Verma' },
    taxID: '24DDAPV4074H1ZF'
  }
};

const pillars = [
  {
    kicker: '01',
    title: '18K gold PVD',
    copy: 'A vacuum-deposited gold layer that bonds to the steel at a molecular level — roughly ten times thicker than traditional electroplating.'
  },
  {
    kicker: '02',
    title: 'Skin-safe 316L steel',
    copy: 'Surgical-grade stainless steel, nickel-free and lead-free. Made for sensitive ears, active wrists and Indian humidity.'
  },
  {
    kicker: '03',
    title: 'Direct from Vapi',
    copy: 'Every piece is hand-inspected, cleaned and packed in our Vapi atelier, then dispatched within 24–48 hours.'
  }
];
---

<BaseLayout
  title="About Satvastones | Anti-Tarnish Jewellery in Vapi, India"
  description="Why Satvastones exists: waterproof everyday jewellery for showers, workouts & Indian summers. 316L steel, 18K gold PVD, hand-inspected in Vapi, Gujarat."
  schema={aboutSchema}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <PageIntro
      eyebrow="Our story"
      title="Jewellery that feels like you."
      lede="Crafted with intention, backed by materials science, and dispatched directly from our Vapi atelier in Gujarat."
      crumbs={breadcrumbs}
    >
      <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
        <span>Since 2024</span>
        <span aria-hidden="true" class="text-[#c5a059]">✦</span>
        <span>Sole proprietorship · Anirudh A Verma</span>
        <span aria-hidden="true" class="text-[#c5a059]">✦</span>
        <span>GSTIN 24DDAPV4074H1ZF</span>
      </p>
    </PageIntro>

    <!-- Full-bleed image -->
    <div class="media-frame grain relative aspect-[16/10] w-full overflow-hidden bg-[#f1ece3] sm:aspect-[21/9]">
      <img
        src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=1800&q=80&fm=webp"
        alt="Satvastones jewellery craftsmanship — gold chains and rings on warm stone"
        width="1800"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    <!-- Mission -->
    <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10" aria-labelledby="mission-title" data-reveal>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="eyebrow text-[#8d3f3d]">Our mission</p>
          <h2 id="mission-title" class="font-display mt-2 text-[2rem] leading-[1.02] sm:text-[2.8rem]">
            Why we<br class="hidden sm:block" /> started.
          </h2>
        </div>

        <div class="space-y-4 text-[13.5px] leading-relaxed text-[#4a443f] lg:col-span-8">
          <p class="text-[15px] leading-relaxed text-[#14110f]">
            Everyday jewellery has always forced a choice: solid gold at a price that feels irresponsible, or fashion jewellery that turns your skin green in a fortnight.
          </p>
          <p>
            Satvastones exists to remove that choice. We build pieces you can wear through a morning workout, a rushed commute, a shower and a late dinner — without taking them off first.
          </p>
          <p>
            We will never claim that any metal keeps 100% of its shine forever under every harsh chemical. What we do promise is that the quality of our pieces is exceptionally high: medical-grade 316L surgical stainless steel, finished with authentic 18K vacuum gold PVD, engineered to hold up to sweat, water and tropical heat.
          </p>
          <p>
            That honesty is the product. No invented "was" prices, no fake countdowns, no claims we cannot stand behind. Just well-made jewellery, a fair price, and a real person answering your email.
          </p>
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="border-y border-[#e5ded3] bg-[#f4efe7]" aria-labelledby="pillars-title">
      <div class="mx-auto max-w-[1440px] px-5 py-14 sm:px-8 sm:py-16 lg:px-10">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow text-[#8d3f3d]">What we stand on</p>
            <h2 id="pillars-title" class="font-display mt-2 text-[2rem] leading-tight sm:text-[2.6rem]">
              Three non-negotiables.
            </h2>
          </div>
          <a href="/materials" class="link-line self-start text-[10px] uppercase tracking-[0.16em] text-[#14110f] sm:self-auto">
            Read the material specs
          </a>
        </div>

        <div class="mt-9 grid grid-cols-1 gap-px bg-[#ded5c7] sm:grid-cols-3">
          {pillars.map((pillar) => (
            <div class="bg-[#f4efe7] px-6 py-7">
              <span class="text-[9px] uppercase tracking-[0.24em] text-[#c5a059]">{pillar.kicker}</span>
              <h3 class="font-display mt-2 text-[1.4rem] leading-tight">{pillar.title}</h3>
              <p class="mt-2 max-w-xs text-[12px] leading-relaxed text-[#5f5851]">{pillar.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Provenance -->
    <section class="bg-[#14110f] text-[#f6f1e8]" aria-labelledby="provenance-title">
      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:px-10">
        <div class="lg:col-span-4">
          <p class="eyebrow text-[#c5a059]">Entity &amp; provenance</p>
          <h2 id="provenance-title" class="font-display mt-2 text-[2rem] leading-[1.02] sm:text-[2.8rem]">
            Nothing<br class="hidden sm:block" /> hidden.
          </h2>
          <p class="mt-4 max-w-xs text-[12px] leading-relaxed text-[#b9b1a7]">
            The details most stores bury in a footer. Ours are part of the brand.
          </p>
        </div>

        <dl class="grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-2 lg:col-span-8">
          {[
            { term: 'Brand', value: 'Satvastones Fine Jewellery' },
            { term: 'Legal entity', value: 'Sole proprietorship — Anirudh A Verma' },
            { term: 'GSTIN', value: '24DDAPV4074H1ZF' },
            { term: 'Atelier', value: 'Chala, Vapi, Gujarat 396191, India' },
            { term: 'Support', value: 'support@satvastones.in', href: 'mailto:support@satvastones.in' },
            { term: 'Grievance officer', value: 'Anirudh A Verma · +91 98201 44521' }
          ].map((row) => (
            <div class="bg-[#14110f] px-5 py-4">
              <dt class="text-[9px] uppercase tracking-[0.18em] text-[#c5a059]">{row.term}</dt>
              <dd class="mt-1 text-[12.5px] leading-relaxed text-[#f6f1e8]">
                {row.href ? (
                  <a href={row.href} class="underline decoration-white/25 underline-offset-4 hover:decoration-[#c5a059]">{row.value}</a>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10" aria-labelledby="about-cta-title" data-reveal>
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow text-[#8d3f3d]">Start somewhere</p>
          <h2 id="about-cta-title" class="font-display mt-2 text-[2.1rem] leading-[1.02] sm:text-[3rem]">
            The everyday gold<br class="hidden sm:block" /> you won't take off.
          </h2>
          <p class="mt-3 max-w-md text-[13px] leading-relaxed text-[#5f5851]">
            Begin with a bestseller, or build a stack of three and save 15% automatically.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <a href="/shop" class="inline-flex items-center justify-center gap-2 bg-[#14110f] px-7 py-4 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]">
            Shop all pieces <span aria-hidden="true">→</span>
          </a>
          <a href="/stack-builder" class="inline-flex items-center justify-center gap-2 border border-[#14110f] px-7 py-4 text-[10px] uppercase tracking-[0.16em] text-[#14110f] transition-colors hover:bg-[#f4efe7]">
            Build a stack
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
