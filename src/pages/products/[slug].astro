          </div>
        </div>
      </div>
    </section>

    <!-- Details -->
    <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10" aria-labelledby="details-title" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="eyebrow text-[#8d3f3d]">The finer points</p>
          <h2 id="details-title" class="font-display mt-2 text-[2rem] leading-tight sm:text-[2.6rem]">
            Details, care<br class="hidden sm:block" /> &amp; delivery.
          </h2>
          <p class="mt-4 max-w-xs text-[13px] leading-relaxed text-[#5f5851]">
            Everything we make is designed for real life — water, workouts, and everyday wear included.
          </p>
          <div class="mt-5 flex flex-col gap-2 text-[11px] uppercase tracking-[0.14em]">
            <a href="/materials" class="link-line self-start text-[#14110f]">Our materials</a>
            <a href="/jewellery-care" class="link-line self-start text-[#14110f]">Jewellery care guide</a>
            <a href={`/collections/${product.category}`} class="link-line self-start capitalize text-[#14110f]">
              All {product.category.replace(/-/g, ' ')}
            </a>
          </div>
        </div>

        <div class="border-t border-[#e5ded3]">
          <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <h3 class="font-display text-[1.15rem] leading-snug text-[#14110f]">Description &amp; styling</h3>
              <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="pt-3 text-[13px] leading-relaxed text-[#5f5851]">
              <p data-pdp-description>{product.description}</p>
              <p class="mt-2">
                Hand-curated for daily wear — a coffee run, a work meeting, or an evening celebration.
