---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductReviews from '../../components/ProductReviews';
import { PRODUCTS, formatPrice } from '../../data/products';
import type { Product } from '../../types/ecommerce';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const discountPercent = product.compareAtPricePaise
  ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
  : 0;

// Curate 2 complementary pieces for the "Complete the Look" Bundle Engine
const complementaryProducts = PRODUCTS.filter((p) => p.id !== product.id).slice(0, 2);
const bundleItems = [product, ...complementaryProducts];
const bundleRawSumPaise = bundleItems.reduce((acc, p) => acc + p.pricePaise, 0);
const bundleDiscountPaise = Math.round(bundleRawSumPaise * 0.15); // 15% Bundle Savings
const bundleFinalPaise = bundleRawSumPaise - bundleDiscountPaise;

// Recommendations
const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id && p.category === product.category).slice(0, 4);
const fallbackRelated = relatedProducts.length >= 2 ? relatedProducts : PRODUCTS.filter((p) => p.id !== product.id).slice(0, 4);

const productBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: '/shop' },
  { name: product.category, url: `/collections/${product.category}` },
  { name: product.name, url: `/products/${product.slug}` }
];

const productSchema: Record<string, any> = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.name,
  image: product.images.map((i) => i.url),
  description: `${product.description} Handcrafted with waterproof 316L surgical stainless steel and 18K gold vacuum PVD coating. Hand-inspected and dispatched from our Vapi atelier in 24–48 hours.`,
  sku: product.sku,
  mpn: product.sku,
  material: '316L Surgical Stainless Steel, 18K Gold Vacuum PVD Coating',
  countryOfOrigin: {
    '@type': 'Country',
    'name': 'India'
  },
  brand: {
    '@type': 'Brand',
    name: 'Satvastones'
  },
  offers: {
    '@type': 'Offer',
    url: Astro.url.href.replace('satvastonesjewellery.in', 'www.satvastones.in').split('?')[0],
    priceCurrency: 'INR',
    price: (product.pricePaise / 100).toFixed(2),
    priceValidUntil: '2026-12-31',
    availability: product.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'JewelryStore',
      name: 'Satvastones Jewellery'
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: product.pricePaise >= 49900 ? '0.00' : '49.00',
        currency: 'INR'
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'IN'
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 1,
          maxValue: 2,
          unitCode: 'd'
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 2,
          maxValue: 4,
          unitCode: 'd'
        }
      }
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'IN',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 7,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn'
    }
  }
};

if (product.reviewCount && product.reviewCount > 0) {
  productSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
    bestRating: '5',
    worstRating: '1'
  };
}
const productMetaDescription = `Buy ${product.name} online in India for ₹${(product.pricePaise / 100).toLocaleString('en-IN')}. Waterproof 18K gold PVD steel. Free PAN-India delivery > ₹499 & 7-day returns.`;
---

<BaseLayout
  title={`${product.name} – 18K Gold PVD | Buy Online at Satvastones India`}
  description={productMetaDescription}
  schema={productSchema}
  breadcrumbs={productBreadcrumbs}
>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
    
    <!-- Breadcrumbs in Jewelsmars clean style -->
    <nav class="flex items-center gap-1.5 text-xs text-gray-500 mb-4 sm:mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-black">Home</a>
      <span>/</span>
      <a href="/shop" class="hover:text-black">Shop</a>
      <span>/</span>
      <a href={`/collections/${product.category}`} class="capitalize hover:text-black">{product.category}</a>
      <span>/</span>
      <span class="text-gray-900 font-medium truncate max-w-[180px] sm:max-w-xs">{product.name}</span>
    </nav>

    <!-- Main PDP Grid: Mobile-first Stack -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12" id="pdp-hero-box">
      
      <!-- Left Column: Gallery (Jewelsmars 3:4 Portrait style) -->
      <div class="lg:col-span-7 space-y-3 sm:space-y-4">
        <!-- Main Image Container -->
        <div class="aspect-[3/4] bg-[#f9f9f9] rounded-[22px] overflow-hidden border border-gray-100 relative group shadow-sm">
          <img
            id="pdp-main-image"
            src={product.images[0]?.url}
            alt={product.images[0]?.alt || `${product.name} - Anti Tarnish Waterproof 18K Gold Jewellery India`}
            width="800"
            height="1066"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover transition-opacity duration-300"
          />

          <!-- Atelier Discount Tag -->
          {discountPercent > 0 && (
            <span class="absolute top-3.5 left-3.5 bg-[#9f4553] text-white text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
              SAVE {discountPercent}%
            </span>
          )}

          <!-- 18K Anti-Tarnish Pill -->
          <span class="absolute top-3.5 right-3.5 bg-white/95 backdrop-blur-xs text-[#171513] text-[10px] font-bold px-2.5 py-1 rounded-full border border-[#eae4dc] shadow-2xs">
            ✦ Waterproof 18K Gold
          </span>

          <!-- Floating Wishlist Heart -->
          <button
            id="pdp-wishlist-heart"
            type="button"
            class="absolute bottom-3.5 right-3.5 w-10 h-10 rounded-full bg-white/95 backdrop-blur-xs shadow-md border border-[#eae4dc] flex items-center justify-center text-[#99918b] hover:text-[#9f4553] transition-all cursor-pointer"
            aria-label="Save to Wishlist"
          >
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </button>
        </div>

        <!-- Thumbnails Strip -->
        <div class="grid grid-cols-4 sm:grid-cols-5 gap-2.5 sm:gap-3">
          {product.images.map((img, idx) => (
            <button
              type="button"
              data-img-src={img.url}
              data-img-alt={img.alt}
              class={`aspect-[3/4] rounded-[14px] overflow-hidden border-2 transition-all pdp-thumb-btn ${idx === 0 ? 'border-[#171513] shadow-xs' : 'border-[#eae4dc] hover:border-[#c5a059]'}`}
            >
              <img
                src={img.url}
                alt={img.alt || `${product.name} thumbnail`}
                width="160"
                height="213"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </button>
          ))}
        </div>
      </div>

      <!-- Right Column: Buy Box & Product Info -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-5">
        <div class="space-y-4">
          
          <!-- Category & Title -->
          <div class="space-y-1">
            <span class="text-[11px] uppercase font-bold tracking-[0.14em] text-[#9f4553] flex items-center gap-1.5">
              <span class="text-[#c5a059]">✦</span>
              <span>Anti-Tarnish Daily Atelier</span>
            </span>
            <h1 class="font-serif text-2xl sm:text-4xl font-normal text-[#171513] tracking-tight leading-tight">
              {product.name}
            </h1>
            <p class="text-[11px] text-[#99918b]">SKU: {product.sku}</p>
          </div>

          <!-- Review Stars Rating -->
          <div class="flex items-center gap-2 text-xs">
            <div class="flex text-[#c5a059] gap-0.5">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-3.5 h-3.5 ${i < Math.round(product.rating) ? 'fill-current' : 'text-gray-200 fill-current'}`} viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="font-bold text-[#171513]">{product.rating}</span>
            <span class="text-[#6e6863]">({product.reviewCount} verified reviews)</span>
          </div>

          <!-- Price Display (Atelier Obsidian + MRP Strikethrough) -->
          <div class="flex items-baseline gap-3 pt-1 border-y border-[#eae4dc] py-3">
            <span class="text-3xl sm:text-4xl font-bold text-[#171513]">
              {formatPrice(product.pricePaise)}
            </span>
            {product.compareAtPricePaise && (
              <span class="text-base text-[#99918b] line-through">
                {formatPrice(product.compareAtPricePaise)}
              </span>
            )}
            {discountPercent > 0 && (
              <span class="text-xs bg-[#171513] text-[#fbf8f5] font-bold px-2.5 py-1 rounded-full shadow-2xs">
                {discountPercent}% OFF
              </span>
            )}
            <span class="text-xs text-[#6e6863] ml-auto font-medium">
              Inclusive of all taxes
            </span>
          </div>

          <!-- Atelier Urgency Pill -->
          <div class="flex items-center gap-2.5 py-2.5 px-3.5 bg-[#eef8f3] border border-[#c4e8d3] rounded-xl text-xs text-[#1b6d48] font-semibold">
            <span class="w-2 h-2 rounded-full bg-[#1b6d48] animate-pulse shrink-0"></span>
            <span>
              Direct Atelier Pricing • Only <strong>3 pieces remaining</strong> for today's Vapi dispatch
            </span>
          </div>

          <!-- Dynamic Live Dispatch Countdown -->
          <div class="flex items-center justify-between text-xs text-[#171513] bg-[#faf8f5] border border-[#eae4dc] px-3.5 py-2 rounded-xl">
            <span class="flex items-center gap-1.5">
              <span class="text-[#c5a059]">✦</span>
              <span>Order in next <strong id="pdp-dispatch-countdown" class="text-[#9f4553] font-bold">3h 14m 20s</strong> for today's dispatch!</span>
            </span>
            <span class="text-[10px] text-[#6e6863] font-bold uppercase tracking-wider">Vapi Atelier Hub</span>
          </div>

          <!-- Headline Description -->
          <p class="text-xs sm:text-sm text-[#4a443f] leading-relaxed">
            {product.headline}
          </p>

          <!-- Interactive Size Guide Trigger -->
          <div class="flex items-center justify-between text-xs py-1.5 border-y border-[#eae4dc]">
            <span class="text-[#6e6863]">Unsure about your ring or bangle measurements?</span>
            <button
              id="pdp-ring-sizer-trigger"
              type="button"
              class="text-[#9f4553] font-bold underline flex items-center gap-1.5 hover:text-[#171513] cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m-3-3h6" />
              </svg>
              <span>Open Size Calculator</span>
            </button>
          </div>

          <!-- Stacked Luxury Privilege Cards -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center gap-3 p-3 bg-[#faf8f5] border border-[#eae4dc] rounded-[14px] text-xs text-[#171513]">
              <span class="text-[#c5a059] text-base shrink-0">✦</span>
              <div>
                <p class="font-bold text-[#171513]">FREE Pan-India Express Delivery on orders above ₹499</p>
                <p class="text-[11px] text-[#6e6863]">Hand-inspected & dispatched from Vapi atelier (Gujarat) in 24–48 hours</p>
              </div>
            </div>

            <div class="flex items-center gap-3 p-3 bg-[#faf8f5] border border-[#eae4dc] rounded-[14px] text-xs text-[#171513]">
              <span class="text-[#c5a059] text-base shrink-0">✦</span>
              <div>
                <p class="font-bold text-[#171513]">Complimentary Velvet Keepsake Pouch Included</p>
                <p class="text-[11px] text-[#6e6863]">Anti-tarnish packaging & care certificate with every single order</p>
              </div>
            </div>

            <div class="flex items-center gap-3 p-3 bg-[#faf8f5] border border-[#eae4dc] rounded-[14px] text-xs text-[#171513]">
              <span class="text-[#c5a059] text-base shrink-0">✦</span>
              <div>
                <p class="font-bold text-[#171513]">Extra ₹200 OFF on orders above ₹2,499</p>
                <p class="text-[11px] text-[#6e6863]">Use privilege code <span class="font-bold text-[#9f4553]">FIRSTBUY</span> at checkout</p>
              </div>
            </div>
          </div>

          <!-- Quantity Stepper & Add to Bag -->
          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-3">
              <!-- Quantity Stepper -->
              <div class="flex items-center border border-[#eae4dc] rounded-xl bg-[#faf8f5] p-1">
                <button
                  id="pdp-qty-minus"
                  type="button"
                  class="w-9 h-9 rounded-lg bg-white border border-[#eae4dc] flex items-center justify-center font-bold text-[#171513] hover:bg-[#eae4dc] transition-colors cursor-pointer"
                  aria-label="Decrease quantity"
                >
                  −
                </button>
                <span id="pdp-qty-val" class="w-10 text-center font-bold text-sm text-[#171513]">1</span>
                <button
                  id="pdp-qty-plus"
                  type="button"
                  class="w-9 h-9 rounded-lg bg-white border border-[#eae4dc] flex items-center justify-center font-bold text-[#171513] hover:bg-[#eae4dc] transition-colors cursor-pointer"
                  aria-label="Increase quantity"
                >
                  +
                </button>
              </div>

              <!-- Primary Obsidian ADD TO CART Button -->
              <button
                id="pdp-add-to-cart"
                data-product-id={product.id}
                data-product-name={product.name}
                data-product-slug={product.slug}
                data-product-price={product.pricePaise}
                data-product-image={product.images[0]?.url}
                class="flex-1 bg-[#171513] hover:bg-[#9f4553] text-white py-3.5 sm:py-4 px-6 text-xs sm:text-sm font-bold uppercase tracking-[0.1em] rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span>Add to Shopping Bag</span>
              </button>
            </div>

            <!-- Instant BUY NOW Button -->
            <a
              id="pdp-buy-now"
              href="/checkout"
              class="block w-full text-center bg-[#faf8f5] hover:bg-[#171513] text-[#171513] hover:text-white border-2 border-[#171513] py-3.5 sm:py-4 text-xs sm:text-sm font-bold uppercase tracking-[0.1em] rounded-xl shadow-xs transition-all cursor-pointer"
            >
              Instant 1-Click Checkout →
            </a>
          </div>

          <!-- Mandatory Consumer Protection (E-Commerce) Rules Badges -->
          <div class="p-3.5 bg-gray-50 border border-gray-200 rounded-2xl space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 font-bold text-gray-900">
                <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                <span>Country of Origin: India</span>
              </span>
              <span class="text-[10px] font-bold bg-white text-gray-700 px-2.5 py-0.5 rounded-full border border-gray-200 uppercase tracking-wider">
                Vapi Atelier
              </span>
            </div>
            
            <div class="flex items-start gap-2 pt-1 border-t border-gray-200/80 text-[11px] text-gray-600">
              <svg class="w-4 h-4 text-[#a1505a] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286zm0 13.036h.008v.008H12v-.008z" />
              </svg>
              <div>
                <strong class="text-gray-900 block font-semibold">Return & Replacement Eligibility:</strong>
                <span>100% Free replacement against transit damages with continuous 360° unboxing video proof submitted within 48h of delivery. Sealed hygienic packaging.</span>
              </div>
            </div>
          </div>

          <!-- PIN Code Delivery Checker -->
          <div class="pt-2">
            <label class="block text-xs font-bold text-gray-800 mb-1.5 uppercase tracking-wide">
              Check Express Delivery to PIN Code
            </label>
            <div class="flex gap-2">
              <input
                id="pincode-input"
                type="text"
                maxlength="6"
                placeholder="Enter 6-digit Indian PIN code"
                class="bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs rounded-xl flex-1 focus:outline-none focus:border-[#f2707f]"
              />
              <button
                id="check-pincode-btn"
                type="button"
                class="bg-gray-900 hover:bg-black text-white px-5 py-2.5 text-xs font-bold rounded-xl uppercase tracking-wider transition-colors cursor-pointer"
              >
                Check
              </button>
            </div>
            <p id="pincode-msg" class="text-xs mt-1.5 hidden font-medium"></p>
          </div>

          <!-- Trust Badges Strip -->
          <div class="grid grid-cols-3 gap-2 pt-3 border-t border-gray-100 text-center">
            <div class="p-2 bg-gray-50 rounded-xl flex flex-col items-center">
              <svg class="w-4 h-4 text-[#a1505a] mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
              </svg>
              <span class="text-[10px] font-bold text-gray-800">18K PVD Gold</span>
              <p class="text-[9px] text-gray-500">Waterproof Daily</p>
            </div>
            <div class="p-2 bg-gray-50 rounded-xl flex flex-col items-center">
              <svg class="w-4 h-4 text-[#a1505a] mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span class="text-[10px] font-bold text-gray-800">Hypoallergenic</span>
              <p class="text-[9px] text-gray-500">Nickel-Free 316L</p>
            </div>
            <div class="p-2 bg-gray-50 rounded-xl flex flex-col items-center">
              <svg class="w-4 h-4 text-[#a1505a] mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              <span class="text-[10px] font-bold text-gray-800">Vapi Store</span>
              <p class="text-[9px] text-gray-500">24–48h Dispatch</p>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Complete The Look / Frequently Bought Together Bundle Builder (High AOV Engine) -->
    <div class="mt-14 sm:mt-16 bg-[#faf8f5] border border-[#eae4dc] rounded-[24px] p-5 sm:p-8 shadow-2xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-5 border-b border-[#eae4dc] gap-2">
        <div>
          <span class="text-xs uppercase tracking-[0.14em] text-[#9f4553] font-bold flex items-center gap-1.5">
            <span class="text-[#c5a059]">✦</span>
            <span>CURATED ATELIER PAIRINGS</span>
          </span>
          <h2 class="font-serif text-xl sm:text-3xl font-normal text-[#171513] tracking-tight mt-0.5">
            Frequently Stacked Together
          </h2>
        </div>
        <span class="bg-[#171513] text-[#fbf8f5] text-xs font-bold px-3.5 py-1.5 rounded-full self-start sm:self-auto shadow-2xs">
          Automatic 15% Bundle Savings
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- Bundle Products Selection -->
        <div class="lg:col-span-8 flex flex-col sm:flex-row items-center gap-3">
          {bundleItems.map((item, idx) => (
            <div class="flex items-center gap-3 w-full sm:w-auto">
              <div class="bg-white border border-[#eae4dc] p-3 rounded-[16px] flex items-center gap-3 w-full sm:w-56 shadow-2xs">
                <input
                  type="checkbox"
                  checked
                  disabled={idx === 0}
                  class="bundle-item-check accent-[#171513] w-4 h-4 rounded cursor-pointer"
                  data-item-id={item.id}
                  data-item-name={item.name}
                  data-item-slug={item.slug}
                  data-item-price={item.pricePaise}
                  data-item-image={item.images[0]?.url}
                />
                <img
                  src={item.images[0]?.url}
                  alt={item.name}
                  class="w-14 h-18 object-cover rounded-[10px] bg-[#faf8f5] border border-[#eae4dc]"
                />
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-bold text-[#171513] truncate">{item.name}</p>
                  <p class="font-bold text-xs text-[#171513] mt-0.5">{formatPrice(item.pricePaise)}</p>
                  {idx === 0 && <span class="text-[9px] text-[#9f4553] font-bold uppercase tracking-wider">Active Piece</span>}
                </div>
              </div>
              {idx < bundleItems.length - 1 && (
                <span class="text-[#c5a059] font-bold text-lg hidden sm:inline">+</span>
              )}
            </div>
          ))}
        </div>

        <!-- Bundle Pricing & 1-Click CTA -->
        <div class="lg:col-span-4 bg-white p-5 rounded-[20px] border border-[#eae4dc] space-y-3 shadow-2xs">
          <div class="space-y-1">
            <div id="bundle-raw-row" class="flex justify-between items-baseline text-xs text-[#6e6863]">
              <span>Combined Value:</span>
              <span id="bundle-raw-val" class="line-through">{formatPrice(bundleRawSumPaise)}</span>
            </div>
            <div id="bundle-savings-row" class="flex justify-between items-baseline text-xs text-[#1b6d48] font-bold">
              <span id="bundle-savings-label">Bundle Savings (15% OFF):</span>
              <span id="bundle-savings-val">− {formatPrice(bundleDiscountPaise)}</span>
            </div>
            <div class="flex justify-between items-baseline text-base font-bold text-[#171513] pt-1 border-t border-[#eae4dc]">
              <span id="bundle-price-label">Suite Price:</span>
              <span id="bundle-final-val" class="text-xl font-bold text-[#171513]">{formatPrice(bundleFinalPaise)}</span>
            </div>
          </div>

          <button
            id="bundle-add-btn"
            type="button"
            class="w-full bg-[#171513] hover:bg-[#9f4553] text-white py-3 px-4 text-xs font-bold uppercase tracking-[0.08em] rounded-xl shadow-md transition-all cursor-pointer"
          >
            Add Full Suite to Bag (15% OFF) →
          </button>
          <p class="text-[10px] text-[#6e6863] text-center font-medium">
            Free Express Delivery &amp; Complimentary Keepsake Velvet Box Included
          </p>
        </div>
      </div>
    </div>

    <!-- Jewelsmars Clean Accordions (Product Details & Policies) -->
    <div class="mt-14 max-w-3xl mx-auto space-y-3">
      
      <!-- Accordion 1: Description & Styling -->
      <details class="group bg-white border border-gray-200 rounded-[18px] p-5 [&_summary::-webkit-details-marker]:hidden open:border-[#f9d8dc] open:bg-[#fffafb] transition-colors">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-900 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <span>Product Description & Styling Guide</span>
          </span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-4 text-xs sm:text-sm text-gray-600 leading-relaxed border-t border-gray-100 mt-4 space-y-2">
          <p>{product.description}</p>
          <p class="text-gray-500 text-xs">
            Hand-curated for daily wear, whether you are dressing up for a coffee run, work meeting, or evening celebration.
          </p>
        </div>
      </details>

      <!-- Accordion 2: Materials & Craftsmanship -->
      <details class="group bg-white border border-gray-200 rounded-[18px] p-5 [&_summary::-webkit-details-marker]:hidden open:border-[#f9d8dc] open:bg-[#fffafb] transition-colors">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-900 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            <span>Material & Craftsmanship Specifications</span>
          </span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-4 text-xs sm:text-sm text-gray-600 border-t border-gray-100 mt-4 space-y-2">
          <ul class="space-y-1.5">
            <li><strong class="text-gray-900">Core Metal:</strong> {product.material}</li>
            <li><strong class="text-gray-900">Finish:</strong> {product.finish}</li>
            {product.dimensions && <li><strong class="text-gray-900">Dimensions:</strong> {product.dimensions}</li>}
            {product.weightGrams && <li><strong class="text-gray-900">Weight:</strong> {product.weightGrams} grams</li>}
            <li><strong class="text-gray-900">Skin Compatibility:</strong> 100% Nickel-free, Lead-free, Hypoallergenic</li>
          </ul>
          <div class="p-3 bg-[#ffe7e9]/50 rounded-xl mt-3 text-xs text-gray-700">
            <strong>Honest Shine Policy:</strong> While our 316L Stainless Steel and 18K PVD Gold plating are highly water and sweat resistant, we do not promise permanent infinite shine under harsh chemicals or bleach. Following basic care preserves its brilliant luster for years.
          </div>
        </div>
      </details>

      <!-- Accordion 3: Shipping & Vapi Dispatch Policy -->
      <details class="group bg-white border border-gray-200 rounded-[18px] p-5 [&_summary::-webkit-details-marker]:hidden open:border-[#f9d8dc] open:bg-[#fffafb] transition-colors">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-900 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Vapi Store Shipping & Replacement Policy</span>
          </span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-4 text-xs sm:text-sm text-gray-600 border-t border-gray-100 mt-4 space-y-2.5 leading-relaxed">
          <p>
            <strong>Dispatch from Vapi Store:</strong> All orders are received, quality-inspected, and dispatched directly from our <strong>Vapi store location (Gujarat, India)</strong> within <strong>24–48 hours</strong> via BlueDart, Delhivery, or Xpressbees.
          </p>
          <p>
            <strong>Free Shipping:</strong> Shipping is completely free on all orders above <strong>₹499</strong> (nominal flat ₹49 on orders below ₹499).
          </p>
          <p>
            <strong>Cancellation Policy:</strong> You can cancel your order anytime before dispatch happens from our Vapi store. Once dispatched, cancellation is strictly not possible.
          </p>
          <p>
            <strong>No Cash Refunds & Damaged Goods Proof:</strong> We do not offer cash refunds. If your jewellery arrives in a damaged condition, you must provide an <strong>unedited 360-degree unboxing video proof</strong> showing the sealed parcel opening. This allows our team to promptly verify and send you a free replacement.
          </p>
          <p class="text-xs text-gray-500">
            Customer Support: <a href="mailto:support@satvastones.in" class="text-[#f2707f] font-semibold underline">support@satvastones.in</a>
          </p>
        </div>
      </details>

      <!-- Accordion 4: Jewellery Care Guide -->
      <details class="group bg-white border border-gray-200 rounded-[18px] p-5 [&_summary::-webkit-details-marker]:hidden open:border-[#f9d8dc] open:bg-[#fffafb] transition-colors">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-900 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
            <span>Jewellery Care Tips</span>
          </span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-4 text-xs sm:text-sm text-gray-600 border-t border-gray-100 mt-4 space-y-2">
          <ul class="list-disc list-inside space-y-1">
            {product.careInstructions.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </div>
      </details>

      <!-- Accordion 5: Mandatory Statutory Disclosures (Consumer Protection Rules, 2020) -->
      <details class="group bg-white border border-gray-200 rounded-[18px] p-5 [&_summary::-webkit-details-marker]:hidden open:border-[#f9d8dc] open:bg-[#fffafb] transition-colors">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-900 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Mandatory Statutory Disclosures (Consumer Protection Act)</span>
          </span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-4 text-xs text-gray-600 border-t border-gray-100 mt-4 space-y-2">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            <p><strong class="text-gray-900">Country of Origin:</strong> India</p>
            <p><strong class="text-gray-900">Commodity:</strong> Anti-Tarnish Fashion Jewellery</p>
            <p><strong class="text-gray-900">Net Quantity:</strong> 1 Unit (Includes Jewellery Piece, Velvet Pouch &amp; Authenticity Card)</p>
            <p><strong class="text-gray-900">Shelf Life / Expiry:</strong> N/A (Non-perishable surgical steel / vacuum PVD gold)</p>
            <p><strong class="text-gray-900">Manufactured, Packed &amp; Marketed by:</strong> Anirudh A Verma (SatvaStones Jewellery), Chala, Vapi, Gujarat - 396191, India</p>
            <p><strong class="text-gray-900">GSTIN:</strong> 24DDAPV4074H1ZF</p>
            <p class="sm:col-span-2"><strong class="text-gray-900">Consumer Care &amp; Grievance Redressal:</strong> Anirudh A Verma (Grievance Officer), Email: support@satvastones.in / grievance@satvastonesjewellery.in, Helpline: +91 98201 44521</p>
          </div>
        </div>
      </details>

    </div>

    <!-- Verified Customer Reviews & Real Review Submission Box -->
    <ProductReviews
      client:visible
      productId={product.id}
      productName={product.name}
      averageRating={product.rating}
      totalReviewCount={product.reviewCount}
    />

    <!-- Related Products Grid (Atelier Pairings) -->
    <div class="mt-16 sm:mt-20">
      <div class="text-center mb-8">
        <span class="text-xs font-bold uppercase tracking-[0.14em] text-[#9f4553]">
          <span class="text-[#c5a059]">✦</span> MORE TO ADORN
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#171513] mt-1">You May Also Love</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6">
        {fallbackRelated.map((rel) => (
          <ProductCard product={rel} />
        ))}
      </div>
    </div>

  </div>

  <!-- Floating Mobile Sticky Add to Cart Bar (Atelier High-Conversion UX) -->
  <div
    id="pdp-sticky-bar"
    class="fixed bottom-14 lg:bottom-0 inset-x-0 bg-[#fcfbf9]/95 backdrop-blur-md border-t border-[#eae4dc] p-3 z-40 transform translate-y-full transition-transform duration-300 shadow-xl"
  >
    <div class="max-w-[1240px] mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <img
          src={product.images[0]?.url}
          alt={product.name}
          class="w-10 h-12 object-cover rounded-[10px] bg-[#faf8f5] border border-[#eae4dc] shrink-0"
        />
        <div class="min-w-0">
          <h4 class="text-xs font-semibold text-[#171513] truncate">{product.name}</h4>
          <p class="text-xs font-bold text-[#171513]">{formatPrice(product.pricePaise)}</p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          id="sticky-add-btn"
          type="button"
          class="bg-[#171513] hover:bg-[#9f4553] text-white px-5 sm:px-7 py-2.5 text-xs font-bold uppercase tracking-[0.08em] rounded-xl shadow-md transition-all cursor-pointer whitespace-nowrap"
        >
          Add to Bag
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { addToCart, addMultipleToCart } from '../../stores/cartStore';
  import { toggleWishlist, isInWishlist } from '../../stores/wishlistStore';
  import { getSiteSettings } from '../../stores/adminStore';

  // Thumbnail Switcher
  const mainImage = document.getElementById('pdp-main-image') as HTMLImageElement;
  const thumbBtns = document.querySelectorAll('.pdp-thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const src = el.dataset.imgSrc;
      const alt = el.dataset.imgAlt;
      if (mainImage && src) {
        mainImage.src = src;
        if (alt) mainImage.alt = alt;
      }
      thumbBtns.forEach((b) => b.classList.remove('border-[#171513]', 'shadow-xs'));
      thumbBtns.forEach((b) => b.classList.add('border-[#eae4dc]'));
      el.classList.remove('border-[#eae4dc]');
      el.classList.add('border-[#171513]', 'shadow-xs');
    });
  });

  // Quantity Stepper
  let currentQty = 1;
  const qtyVal = document.getElementById('pdp-qty-val');
  const qtyMinus = document.getElementById('pdp-qty-minus');
  const qtyPlus = document.getElementById('pdp-qty-plus');

  qtyMinus?.addEventListener('click', () => {
    if (currentQty > 1) {
      currentQty -= 1;
      if (qtyVal) qtyVal.textContent = String(currentQty);
    }
  });

  qtyPlus?.addEventListener('click', () => {
    if (currentQty < 10) {
      currentQty += 1;
      if (qtyVal) qtyVal.textContent = String(currentQty);
    }
  });

  // Add to Cart
  const addBtn = document.getElementById('pdp-add-to-cart');
  const stickyAddBtn = document.getElementById('sticky-add-btn');

  const handleAddCurrent = () => {
    addToCart({
      productId: addBtn?.dataset.productId || '',
      name: addBtn?.dataset.productName || '',
      slug: addBtn?.dataset.productSlug || '',
      pricePaise: parseInt(addBtn?.dataset.productPrice || '0', 10),
      image: addBtn?.dataset.productImage || '',
      quantity: currentQty
    });
  };

  addBtn?.addEventListener('click', handleAddCurrent);
  stickyAddBtn?.addEventListener('click', handleAddCurrent);

  // Buy Now Button
  const buyBtn = document.getElementById('pdp-buy-now');
  buyBtn?.addEventListener('click', handleAddCurrent);

  // ==========================================
  // Frequently Paired Together Dynamic Bundle Engine
  // ==========================================
  const bundleCheckboxes = document.querySelectorAll('.bundle-item-check') as NodeListOf<HTMLInputElement>;
  const bundleAddBtn = document.getElementById('bundle-add-btn') as HTMLButtonElement | null;
  const bundleRawRow = document.getElementById('bundle-raw-row');
  const bundleRawVal = document.getElementById('bundle-raw-val');
  const bundleSavingsRow = document.getElementById('bundle-savings-row');
  const bundleSavingsLabel = document.getElementById('bundle-savings-label');
  const bundleSavingsVal = document.getElementById('bundle-savings-val');
  const bundlePriceLabel = document.getElementById('bundle-price-label');
  const bundleFinalVal = document.getElementById('bundle-final-val');

  const formatBundleINR = (paise: number) => {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  };

  const getActiveBundleDiscount = () => {
    try {
      const settings = getSiteSettings();
      return typeof settings.stackDiscountPercent === 'number' ? settings.stackDiscountPercent : 15;
    } catch {
      return 15;
    }
  };

  function updateBundleCalculation() {
    const checked = Array.from(document.querySelectorAll('.bundle-item-check:checked') as NodeListOf<HTMLInputElement>);
    const count = checked.length;
    const settingsDiscount = getActiveBundleDiscount();
    const discountRate = settingsDiscount / 100;
    const rawSumPaise = checked.reduce((acc, cb) => acc + parseInt(cb.dataset.itemPrice || '0', 10), 0);

    if (count >= 2) {
      // 2 or more items: bundle discount applies!
      const discountPaise = Math.round(rawSumPaise * discountRate);
      const finalPaise = rawSumPaise - discountPaise;

      if (bundleRawRow) bundleRawRow.classList.remove('hidden');
      if (bundleRawVal) bundleRawVal.textContent = formatBundleINR(rawSumPaise);

      if (bundleSavingsRow) bundleSavingsRow.classList.remove('hidden');
      if (bundleSavingsLabel) bundleSavingsLabel.textContent = `Bundle Savings (${settingsDiscount}% OFF):`;
      if (bundleSavingsVal) bundleSavingsVal.textContent = `− ${formatBundleINR(discountPaise)}`;

      if (bundlePriceLabel) bundlePriceLabel.textContent = 'Bundle Price:';
      if (bundleFinalVal) bundleFinalVal.textContent = formatBundleINR(finalPaise);

      if (bundleAddBtn) {
        bundleAddBtn.disabled = false;
        bundleAddBtn.textContent = `Add All ${count} to Cart (${settingsDiscount}% OFF) →`;
        bundleAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    } else if (count === 1) {
      // Only 1 item selected: no bundle discount
      if (bundleRawRow) bundleRawRow.classList.add('hidden');
      if (bundleSavingsRow) bundleSavingsRow.classList.add('hidden');
      if (bundlePriceLabel) bundlePriceLabel.textContent = 'Single Item Price:';
      if (bundleFinalVal) bundleFinalVal.textContent = formatBundleINR(rawSumPaise);

      if (bundleAddBtn) {
        bundleAddBtn.disabled = false;
        bundleAddBtn.textContent = 'Add 1 Item to Cart →';
        bundleAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    } else {
      // 0 items
      if (bundleFinalVal) bundleFinalVal.textContent = '₹0';
      if (bundleAddBtn) {
        bundleAddBtn.disabled = true;
        bundleAddBtn.textContent = 'Select an item to add';
        bundleAddBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    }
  }

  bundleCheckboxes.forEach((cb) => {
    cb.addEventListener('change', updateBundleCalculation);
  });

  bundleAddBtn?.addEventListener('click', () => {
    const checked = Array.from(document.querySelectorAll('.bundle-item-check:checked') as NodeListOf<HTMLInputElement>);
    if (checked.length === 0) return;

    const settingsDiscount = getActiveBundleDiscount();
    const isBundle = checked.length >= 2;
    const discountMultiplier = isBundle ? (1 - settingsDiscount / 100) : 1;

    // Calculate discounted prices so the sum of items in cart matches the bundle price exactly
    const itemsToAdd = checked.map((cb) => {
      const originalPrice = parseInt(cb.dataset.itemPrice || '0', 10);
      const discountedPrice = Math.round(originalPrice * discountMultiplier);
      const originalName = cb.dataset.itemName || '';

      return {
        productId: cb.dataset.itemId || '',
        variantId: isBundle ? `bundle-${settingsDiscount}off` : undefined,
        name: isBundle ? `${originalName} (Bundle ${settingsDiscount}% OFF)` : originalName,
        slug: cb.dataset.itemSlug || '',
        pricePaise: discountedPrice,
        image: cb.dataset.itemImage || '',
        quantity: 1
      };
    });

    addMultipleToCart(itemsToAdd);
  });

  // Wishlist Button
  const wishlistHeart = document.getElementById('pdp-wishlist-heart');
  const prodId = addBtn?.dataset.productId || '';
  if (wishlistHeart && prodId) {
    if (isInWishlist(prodId)) {
      wishlistHeart.classList.add('text-[#9f4553]');
      wishlistHeart.querySelector('svg')?.classList.add('fill-[#9f4553]');
    }
    wishlistHeart.addEventListener('click', () => {
      const isSaved = toggleWishlist({
        id: addBtn?.dataset.productId || '',
        name: addBtn?.dataset.productName || '',
        slug: addBtn?.dataset.productSlug || '',
        sku: '',
        category: '',
        headline: '',
        description: '',
        material: '',
        finish: '',
        careInstructions: [],
        warranty: '',
        pricePaise: parseInt(addBtn?.dataset.productPrice || '0', 10),
        rating: 5,
        reviewCount: 0,
        images: [{ url: addBtn?.dataset.productImage || '', alt: addBtn?.dataset.productName || '' }],
        inStock: true
      });
      if (isSaved) {
        wishlistHeart.classList.add('text-[#9f4553]');
        wishlistHeart.querySelector('svg')?.classList.add('fill-[#9f4553]');
      } else {
        wishlistHeart.classList.remove('text-[#9f4553]');
        wishlistHeart.querySelector('svg')?.classList.remove('fill-[#9f4553]');
      }
    });
  }

  // PIN Code Checker
  const pinBtn = document.getElementById('check-pincode-btn');
  const pinInput = document.getElementById('pincode-input') as HTMLInputElement;
  const pinMsg = document.getElementById('pincode-msg');

  pinBtn?.addEventListener('click', () => {
    const code = pinInput?.value.trim();
    if (code && code.length === 6 && /^\d+$/.test(code)) {
      if (pinMsg) {
        pinMsg.textContent = `Express Delivery available to PIN ${code} (2-4 business days from Vapi dispatch)`;
        pinMsg.className = 'text-xs mt-2 text-emerald-700 font-medium block';
      }
    } else {
      if (pinMsg) {
        pinMsg.textContent = 'Please enter a valid 6-digit Indian PIN code.';
        pinMsg.className = 'text-xs mt-2 text-red-600 font-medium block';
      }
    }
  });

  // Ring Sizer Modal Trigger
  const ringSizerPdpBtn = document.getElementById('pdp-ring-sizer-trigger');
  ringSizerPdpBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('satvastones:open_ring_sizer'));
  });

  // Dynamic Vapi Dispatch Countdown Timer
  const countdownEl = document.getElementById('pdp-dispatch-countdown');
  if (countdownEl) {
    const updateCountdown = () => {
      const now = new Date();
      // Target: 4:00 PM Vapi dispatch cutoff
      const cutoff = new Date();
      cutoff.setHours(16, 0, 0, 0);
      if (now > cutoff) {
        cutoff.setDate(cutoff.getDate() + 1);
      }
      const diffMs = cutoff.getTime() - now.getTime();
      const hrs = Math.floor(diffMs / (1000 * 60 * 60));
      const mins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diffMs % (1000 * 60)) / 1000);
      countdownEl.textContent = `${hrs}h ${mins}m ${secs}s`;
    };
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  // Sticky Bar Scroll Observer
  const heroBox = document.getElementById('pdp-hero-box');
  const stickyBar = document.getElementById('pdp-sticky-bar');

  if (heroBox && stickyBar) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          stickyBar.classList.remove('translate-y-full');
        } else {
          stickyBar.classList.add('translate-y-full');
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(heroBox);
  }
</script>
