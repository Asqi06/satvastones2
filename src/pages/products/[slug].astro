            </div>
          </details>

          <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <h3 class="font-display text-[1.15rem] leading-snug text-[#14110f]">Material &amp; craftsmanship</h3>
              <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="pt-3 text-[13px] leading-relaxed text-[#5f5851]">
              <ul data-pdp-specs class="space-y-1.5">
                <li><strong class="font-medium text-[#14110f]">Core metal:</strong> {product.material}</li>
                <li><strong class="font-medium text-[#14110f]">Finish:</strong> {product.finish}</li>
                {product.dimensions && <li><strong class="font-medium text-[#14110f]">Dimensions:</strong> {product.dimensions}</li>}
                {product.weightGrams && <li><strong class="font-medium text-[#14110f]">Weight:</strong> {product.weightGrams} grams</li>}
                <li><strong class="font-medium text-[#14110f]">Skin compatibility:</strong> Nickel-free, lead-free, hypoallergenic</li>
                <li><strong class="font-medium text-[#14110f]">Country of origin:</strong> India</li>
                <li><strong class="font-medium text-[#14110f]">Packed &amp; marketed by:</strong> Satvastones Jewellery (Anirudh A Verma), Chala, Vapi, Gujarat – 396191</li>
              </ul>
              <p class="mt-3 border-l-2 border-[#e0d7c9] pl-3 text-[11px] text-[#6f675f]">
                <strong class="font-medium text-[#14110f]">Our honest shine policy:</strong> 316L steel and 18K PVD gold resist water and sweat, but no plated piece is invincible against harsh chemicals. Basic care keeps its lustre for years.
              </p>
            </div>
          </details>

          <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <h3 class="font-display text-[1.15rem] leading-snug text-[#14110f]">Shipping &amp; Vapi dispatch</h3>
              <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="space-y-2.5 pt-3 text-[13px] leading-relaxed text-[#5f5851]">
              <p>
                <strong class="font-medium text-[#14110f]">Dispatch:</strong> Every order is quality-inspected and dispatched from our Vapi atelier (Gujarat, India) within 24–48 hours via BlueDart, Delhivery, or Xpressbees.
              </p>
              <p>
                <strong class="font-medium text-[#14110f]">Free shipping:</strong> Free on orders above ₹499; a flat ₹49 applies below that.
              </p>
              <p>
                <strong class="font-medium text-[#14110f]">Cancellation:</strong> Cancel any time before dispatch. Once dispatched, cancellation is not possible.
              </p>
              <p>
                <strong class="font-medium text-[#14110f]">Damaged goods:</strong> We do not offer cash refunds. If a piece arrives damaged, share an unedited 360° unboxing video within 48 hours and we will verify and replace it free of charge.
              </p>
              <p class="text-[11px]">
                Support: <a href="mailto:support@satvastones.in" class="underline decoration-[#d8c3a6] underline-offset-4">support@satvastones.in</a>
              </p>
            </div>
          </details>

          <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <h3 class="font-display text-[1.15rem] leading-snug text-[#14110f]">Jewellery care</h3>
              <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <ul data-pdp-care class="list-disc space-y-1.5 pt-3 pl-4 text-[13px] leading-relaxed text-[#5f5851]">
              {product.careInstructions.map((tip) => (
                <li>{tip}</li>
              ))}
            </ul>
          </details>

          <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <h3 class="font-display text-[1.15rem] leading-snug text-[#14110f]">Statutory disclosures</h3>
              <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="grid grid-cols-1 gap-2 pt-3 text-[12px] leading-relaxed text-[#5f5851] sm:grid-cols-2">
              <p><strong class="font-medium text-[#14110f]">Country of origin:</strong> India</p>
              <p><strong class="font-medium text-[#14110f]">Commodity:</strong> Anti-tarnish fashion jewellery</p>
              <p><strong class="font-medium text-[#14110f]">Net quantity:</strong> 1 unit (piece, velvet pouch &amp; authenticity card)</p>
              <p><strong class="font-medium text-[#14110f]">Shelf life:</strong> Not applicable</p>
              <p class="sm:col-span-2"><strong class="font-medium text-[#14110f]">Manufactured, packed &amp; marketed by:</strong> Anirudh A Verma (SatvaStones Jewellery), Chala, Vapi, Gujarat – 396191, India</p>
              <p><strong class="font-medium text-[#14110f]">GSTIN:</strong> 24DDAPV4074H1ZF</p>
              <p class="sm:col-span-2"><strong class="font-medium text-[#14110f]">Consumer care:</strong> Anirudh A Verma (Grievance Officer) · support@satvastones.in · grievance@satvastonesjewellery.in · +91 98201 44521</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="border-y border-[#e5ded3] bg-[#14110f] text-[#f6f1e8]" aria-label="The Satvastones promise">
      <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-px bg-white/10 sm:grid-cols-3">
        {[
          { kicker: '01', title: 'Waterproof by design', copy: 'Wear it in the shower, the gym, the sea. 18K PVD over 316L steel.' },
          { kicker: '02', title: 'Skin-safe, always', copy: 'Nickel-free and lead-free. Made for sensitive ears and everyday wrists.' },
          { kicker: '03', title: 'Direct from the atelier', copy: 'Hand-inspected in Vapi and dispatched within 24–48 hours.' }
        ].map((item) => (
          <div class="bg-[#14110f] px-6 py-8 sm:px-8 sm:py-10">
            <span class="text-[9px] uppercase tracking-[0.24em] text-[#c5a059]">{item.kicker}</span>
            <h2 class="font-display mt-2 text-[1.35rem] leading-tight">{item.title}</h2>
            <p class="mt-2 max-w-xs text-[12px] leading-relaxed text-[#b9b1a7]">{item.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Reviews -->
    <div id="reviews" class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10">
      <ProductReviews
        client:visible
        productId={product.id}
        productName={product.name}
        averageRating={product.rating}
        totalReviewCount={product.reviewCount}
      />
    </div>

    <!-- Related -->
    <section class="mx-auto max-w-[1440px] px-5 pb-20 sm:px-8 lg:px-10" aria-labelledby="related-title" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4 border-t border-[#e5ded3] pt-8">
        <div>
          <p class="eyebrow text-[#8d3f3d]">Continue the collection</p>
          <h2 id="related-title" class="font-display mt-2 text-[2rem] leading-tight sm:text-[2.6rem]">You may also love.</h2>
        </div>
        <a href={`/collections/${product.category}`} class="link-line text-[10px] uppercase tracking-[0.16em] text-[#14110f]">
          View all
        </a>
      </div>

      <div
        class="mt-8 grid grid-cols-2 gap-x-3 gap-y-8 md:grid-cols-4 md:gap-6"
        data-catalog-grid={product.category}
        data-catalog-limit="4"
        data-catalog-exclude={product.id}
      >
        {fallbackRelated.map((rel) => (
          <ProductCard product={rel} />
        ))}
      </div>
    </section>
  </div>

  <!-- Mobile sticky buy bar -->
  <div
    id="pdp-sticky-bar"
    class="fixed inset-x-0 bottom-14 z-40 border-t border-[#e5ded3] bg-[#fbf9f5]/95 p-3 shadow-[0_-10px_30px_rgba(20,17,15,0.08)] backdrop-blur-md transition-transform duration-300 lg:bottom-0"
    aria-hidden="true"
  >
    <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <img
          src={product.images[0]?.url}
          alt={product.name}
          width="40"
          height="50"
          class="h-[50px] w-10 shrink-0 object-cover"
        />
        <div class="min-w-0">
          <p class="truncate text-[12px] text-[#14110f]">{product.name}</p>
          <p class="text-[12px] font-medium text-[#14110f]">{formatPrice(product.pricePaise)}</p>
        </div>
      </div>

      <button
        id="sticky-add-btn"
        type="button"
        class="shrink-0 cursor-pointer bg-[#14110f] px-5 py-3 text-[10px] font-medium uppercase tracking-[0.14em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d] sm:px-7"
      >
        Add to bag
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  /* The bar stays out of the way until consent is resolved, then mobile shows it immediately. */
  #pdp-sticky-bar {
    transform: translateY(100%);
  }

  #pdp-sticky-bar.is-shown {
    transform: translateY(0);
  }

  .pdp-thumb[data-active='true'] {
    border-color: #14110f;
  }

  .pdp-wishlist[data-saved='true'] {
    color: #8d3f3d;
  }

  .pdp-wishlist[data-saved='true'] svg {
    fill: currentColor;
  }
</style>

<script>
  import { addToCart, addMultipleToCart } from '../../stores/cartStore';
  import { toggleWishlist, isInWishlist } from '../../stores/wishlistStore';
  import { getSiteSettings } from '../../stores/adminStore';

  // Thumbnail switcher
  const mainImage = document.getElementById('pdp-main-image') as HTMLImageElement;
  const thumbBtns = document.querySelectorAll('.pdp-thumb');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const src = el.dataset.imgSrc;
      const alt = el.dataset.imgAlt;
      if (mainImage && src) {
        mainImage.src = src;
        if (alt) mainImage.alt = alt;
      }
      thumbBtns.forEach((b) => b.setAttribute('data-active', 'false'));
      el.setAttribute('data-active', 'true');
    });
  });

  // Quantity stepper
  let currentQty = 1;
  const qtyVal = document.getElementById('pdp-qty-val');
  const qtyMinus = document.getElementById('pdp-qty-minus');
  const qtyPlus = document.getElementById('pdp-qty-plus');

  qtyMinus?.addEventListener('click', () => {
    if (currentQty > 1) {
      currentQty -= 1;
      if (qtyVal) qtyVal.textContent = String(currentQty);
    }
  });

  qtyPlus?.addEventListener('click', () => {
    if (currentQty < 10) {
      currentQty += 1;
      if (qtyVal) qtyVal.textContent = String(currentQty);
    }
  });

  // Add to cart
  const addBtn = document.getElementById('pdp-add-to-cart');
  const stickyAddBtn = document.getElementById('sticky-add-btn');

  const handleAddCurrent = () => {
    addToCart({
      productId: addBtn?.dataset.productId || '',
      name: addBtn?.dataset.productName || '',
      slug: addBtn?.dataset.productSlug || '',
      pricePaise: parseInt(addBtn?.dataset.productPrice || '0', 10),
      image: addBtn?.dataset.productImage || '',
      quantity: currentQty
    });
  };

  addBtn?.addEventListener('click', handleAddCurrent);
  stickyAddBtn?.addEventListener('click', handleAddCurrent);

  // Buy now
  const buyBtn = document.getElementById('pdp-buy-now');
  buyBtn?.addEventListener('click', handleAddCurrent);

  // Bundle engine
  const bundleCheckboxes = document.querySelectorAll('.bundle-item-check') as NodeListOf<HTMLInputElement>;
  const bundleAddBtn = document.getElementById('bundle-add-btn') as HTMLButtonElement | null;
  const bundleRawRow = document.getElementById('bundle-raw-row');
  const bundleRawVal = document.getElementById('bundle-raw-val');
  const bundleSavingsRow = document.getElementById('bundle-savings-row');
  const bundleSavingsLabel = document.getElementById('bundle-savings-label');
  const bundleSavingsVal = document.getElementById('bundle-savings-val');
  const bundlePriceLabel = document.getElementById('bundle-price-label');
  const bundleFinalVal = document.getElementById('bundle-final-val');

  const formatBundleINR = (paise: number) => {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  };

  const getActiveBundleDiscount = () => {
    try {
      const settings = getSiteSettings();
      return typeof settings.stackDiscountPercent === 'number' ? settings.stackDiscountPercent : 15;
    } catch {
      return 15;
    }
  };

  function updateBundleCalculation() {
    const checked = Array.from(document.querySelectorAll('.bundle-item-check:checked') as NodeListOf<HTMLInputElement>);
    const count = checked.length;
    const settingsDiscount = getActiveBundleDiscount();
    const discountRate = settingsDiscount / 100;
    const rawSumPaise = checked.reduce((acc, cb) => acc + parseInt(cb.dataset.itemPrice || '0', 10), 0);

    if (count >= 2) {
      const discountPaise = Math.round(rawSumPaise * discountRate);
      const finalPaise = rawSumPaise - discountPaise;

      if (bundleRawRow) bundleRawRow.classList.remove('hidden');
      if (bundleRawVal) bundleRawVal.textContent = formatBundleINR(rawSumPaise);

      if (bundleSavingsRow) bundleSavingsRow.classList.remove('hidden');
      if (bundleSavingsLabel) bundleSavingsLabel.textContent = `Bundle savings (${settingsDiscount}% off)`;
      if (bundleSavingsVal) bundleSavingsVal.textContent = `− ${formatBundleINR(discountPaise)}`;

      if (bundlePriceLabel) bundlePriceLabel.textContent = 'Suite price';
      if (bundleFinalVal) bundleFinalVal.textContent = formatBundleINR(finalPaise);

      if (bundleAddBtn) {
        bundleAddBtn.disabled = false;
        bundleAddBtn.textContent = `Add all ${count} to bag — ${settingsDiscount}% off`;
        bundleAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    } else if (count === 1) {
      if (bundleRawRow) bundleRawRow.classList.add('hidden');
      if (bundleSavingsRow) bundleSavingsRow.classList.add('hidden');
      if (bundlePriceLabel) bundlePriceLabel.textContent = 'Single piece';
      if (bundleFinalVal) bundleFinalVal.textContent = formatBundleINR(rawSumPaise);

      if (bundleAddBtn) {
        bundleAddBtn.disabled = false;
        bundleAddBtn.textContent = 'Add 1 piece to bag';
        bundleAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    } else {
      if (bundleFinalVal) bundleFinalVal.textContent = '₹0';
      if (bundleAddBtn) {
        bundleAddBtn.disabled = true;
        bundleAddBtn.textContent = 'Select a piece to add';
        bundleAddBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    }
  }

  bundleCheckboxes.forEach((cb) => {
    cb.addEventListener('change', updateBundleCalculation);
  });

  bundleAddBtn?.addEventListener('click', () => {
    const checked = Array.from(document.querySelectorAll('.bundle-item-check:checked') as NodeListOf<HTMLInputElement>);
    if (checked.length === 0) return;

    const settingsDiscount = getActiveBundleDiscount();
    const isBundle = checked.length >= 2;
    const discountMultiplier = isBundle ? 1 - settingsDiscount / 100 : 1;

    const itemsToAdd = checked.map((cb) => {
      const originalPrice = parseInt(cb.dataset.itemPrice || '0', 10);
      const discountedPrice = Math.round(originalPrice * discountMultiplier);
      const originalName = cb.dataset.itemName || '';

      return {
        productId: cb.dataset.itemId || '',
        variantId: isBundle ? `bundle-${settingsDiscount}off` : undefined,
        name: isBundle ? `${originalName} (Bundle ${settingsDiscount}% OFF)` : originalName,
        slug: cb.dataset.itemSlug || '',
        pricePaise: discountedPrice,
        image: cb.dataset.itemImage || '',
        quantity: 1
      };
    });

    addMultipleToCart(itemsToAdd);
  });

  // Wishlist
  const wishlistHeart = document.getElementById('pdp-wishlist-heart');
  const prodId = addBtn?.dataset.productId || '';

  if (wishlistHeart && prodId) {
    const setSaved = (saved: boolean) => {
      wishlistHeart.setAttribute('data-saved', String(saved));
      wishlistHeart.setAttribute('aria-pressed', String(saved));
      wishlistHeart.setAttribute('aria-label', saved ? 'Remove from wishlist' : 'Save to wishlist');
    };

    setSaved(isInWishlist(prodId));

    wishlistHeart.addEventListener('click', () => {
      const isSaved = toggleWishlist({
        id: prodId,
        name: addBtn?.dataset.productName || '',
        slug: addBtn?.dataset.productSlug || '',
        sku: '',
        category: '',
        headline: '',
        description: '',
        material: '',
        finish: '',
        careInstructions: [],
        warranty: '',
        pricePaise: parseInt(addBtn?.dataset.productPrice || '0', 10),
        rating: 5,
        reviewCount: 0,
        images: [{ url: addBtn?.dataset.productImage || '', alt: addBtn?.dataset.productName || '' }],
        inStock: true
      });
      setSaved(isSaved);
    });
  }

  // PIN code checker
  const pinBtn = document.getElementById('check-pincode-btn');
  const pinInput = document.getElementById('pincode-input') as HTMLInputElement | null;
  const pinMsg = document.getElementById('pincode-msg');

  const checkPincode = () => {
    const code = pinInput?.value.trim();
    if (pinMsg) {
      if (code && code.length === 6 && /^\d+$/.test(code)) {
        pinMsg.textContent = `Express delivery available to PIN ${code} — 2–4 business days from Vapi.`;
        pinMsg.className = 'mt-2 block text-[11px] font-medium text-[#2f7d5a]';
      } else {
        pinMsg.textContent = 'Please enter a valid 6-digit Indian PIN code.';
        pinMsg.className = 'mt-2 block text-[11px] font-medium text-[#8d3f3d]';
      }
    }
  };

  pinBtn?.addEventListener('click', checkPincode);
  pinInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      checkPincode();
    }
  });

  // Size calculator
  const ringSizerPdpBtn = document.getElementById('pdp-ring-sizer-trigger');
  ringSizerPdpBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('satvastones:open_ring_sizer'));
  });

  // Dispatch countdown (4 PM IST cutoff)
  const countdownEl = document.getElementById('pdp-dispatch-countdown');
  if (countdownEl) {
    const updateCountdown = () => {
      const now = new Date();
      const cutoff = new Date();
      cutoff.setHours(16, 0, 0, 0);
      if (now > cutoff) {
        cutoff.setDate(cutoff.getDate() + 1);
      }
      const diffMs = cutoff.getTime() - now.getTime();
      const hrs = Math.floor(diffMs / (1000 * 60 * 60));
      const mins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diffMs % (1000 * 60)) / 1000);
      countdownEl.textContent = `${hrs}h ${mins}m ${secs}s`;
    };
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  // Sticky bar: mobile keeps a buy action within reach; desktop reveals it after the buy box.
  const heroBox = document.getElementById('pdp-hero-box');
  const stickyBar = document.getElementById('pdp-sticky-bar');

  if (heroBox && stickyBar) {
    let heroPassed = false;

    const consentResolved = () => {
      try {
        return Boolean(localStorage.getItem('satvastones_dpdp_consent'));
      } catch {
        return true;
      }
    };

    const syncStickyBar = () => {
      const isMobile = window.matchMedia('(max-width: 1023px)').matches;
      const show = consentResolved() && (heroPassed || isMobile);
      stickyBar.classList.toggle('is-shown', show);
      stickyBar.setAttribute('aria-hidden', String(!show));
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        heroPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        syncStickyBar();
      },
      { threshold: 0.1 }
    );

    observer.observe(heroBox);
    window.addEventListener('satvastones:consent_changed', syncStickyBar);
    window.addEventListener('resize', syncStickyBar);
    syncStickyBar();
  }
</script>
