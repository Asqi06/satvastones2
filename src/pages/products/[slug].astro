    <!-- Jewelsmars Clean Accordions (Product Details & Policies) -->
    <div class="mt-14 max-w-3xl mx-auto space-y-3">
      
      <!-- Accordion 1: Description & Styling -->
      <details class="group bg-white border border-gray-200 rounded-[18px] p-5 [&_summary::-webkit-details-marker]:hidden open:border-[#f9d8dc] open:bg-[#fffafb] transition-colors">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-900 select-none">
