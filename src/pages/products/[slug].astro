---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductReviews from '../../components/ProductReviews';
import { PRODUCTS, formatPrice } from '../../data/products';
import type { Product } from '../../types/ecommerce';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const discountPercent = product.compareAtPricePaise
  ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
  : 0;

// Curate two complementary pieces from different categories so the bundle
// actually reads as a stack rather than three variations of the same thing.
const bundleCandidates = PRODUCTS.filter((p) => p.id !== product.id);
const usedCategories = new Set<string>([product.category]);
const complementaryProducts: Product[] = [];

for (const candidate of bundleCandidates) {
  if (complementaryProducts.length >= 2) break;
  if (usedCategories.has(candidate.category)) continue;
  usedCategories.add(candidate.category);
  complementaryProducts.push(candidate);
}

for (const candidate of bundleCandidates) {
  if (complementaryProducts.length >= 2) break;
  if (complementaryProducts.some((p) => p.id === candidate.id)) continue;
  complementaryProducts.push(candidate);
}

const bundleItems = [product, ...complementaryProducts];
const bundleRawSumPaise = bundleItems.reduce((acc, p) => acc + p.pricePaise, 0);
const bundleDiscountPaise = Math.round(bundleRawSumPaise * 0.15);
const bundleFinalPaise = bundleRawSumPaise - bundleDiscountPaise;

const stackPartner = complementaryProducts[0];

// Recommendations
const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id && p.category === product.category).slice(0, 4);
const fallbackRelated = relatedProducts.length >= 2 ? relatedProducts : PRODUCTS.filter((p) => p.id !== product.id).slice(0, 4);

const showSizeGuide = ['rings', 'bangles', 'bracelets'].includes(product.category);

const freeShippingThresholdPaise = 49900;
const freeShippingRemainingPaise = Math.max(0, freeShippingThresholdPaise - product.pricePaise);

const productBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: '/shop' },
  { name: product.category, url: `/collections/${product.category}` },
  { name: product.name, url: `/products/${product.slug}` }
];

const productSchema: Record<string, any> = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.name,
  image: product.images.map((i) => i.url),
  description: `${product.description} Handcrafted with waterproof 316L surgical stainless steel and 18K gold vacuum PVD coating. Hand-inspected and dispatched from our Vapi atelier in 24–48 hours.`,
  sku: product.sku,
  mpn: product.sku,
  material: '316L Surgical Stainless Steel, 18K Gold Vacuum PVD Coating',
  countryOfOrigin: {
    '@type': 'Country',
    'name': 'India'
  },
  brand: {
    '@type': 'Brand',
    name: 'Satvastones'
  },
  offers: {
    '@type': 'Offer',
    url: Astro.url.href.replace('satvastonesjewellery.in', 'www.satvastones.in').split('?')[0],
    priceCurrency: 'INR',
    price: (product.pricePaise / 100).toFixed(2),
    priceValidUntil: '2026-12-31',
    availability: product.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'JewelryStore',
      name: 'Satvastones Jewellery'
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: product.pricePaise >= 49900 ? '0.00' : '49.00',
        currency: 'INR'
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'IN'
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 1,
          maxValue: 2,
          unitCode: 'd'
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 2,
          maxValue: 4,
          unitCode: 'd'
        }
      }
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'IN',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 7,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn'
    }
  }
};

if (product.reviewCount && product.reviewCount > 0) {
  productSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
    bestRating: '5',
    worstRating: '1'
  };
}
const productMetaDescription = `Buy ${product.name} online in India for ₹${(product.pricePaise / 100).toLocaleString('en-IN')}. Waterproof 18K gold PVD steel. Free PAN-India delivery > ₹499 & 7-day returns.`;
---

<BaseLayout
  title={`${product.name} – 18K Gold PVD | Buy Online at Satvastones India`}
  description={productMetaDescription}
  schema={productSchema}
  breadcrumbs={productBreadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <!-- Breadcrumb rail -->
    <div class="mx-auto max-w-[1440px] px-5 pt-5 sm:px-8 sm:pt-7 lg:px-10">
      <nav aria-label="Breadcrumb" class="overflow-x-auto scrollbar-none">
        <ol class="flex items-center gap-2 whitespace-nowrap text-[10px] uppercase tracking-[0.16em] text-[#8a8279]">
          <li><a href="/" class="transition-colors hover:text-[#14110f]">Home</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li><a href="/shop" class="transition-colors hover:text-[#14110f]">Shop</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li>
            <a href={`/collections/${product.category}`} class="capitalize transition-colors hover:text-[#14110f]">
              {product.category.replace(/-/g, ' ')}
            </a>
          </li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li aria-current="page" class="max-w-[180px] truncate text-[#14110f] sm:max-w-xs">{product.name}</li>
        </ol>
      </nav>
    </div>

    <!-- Product hero -->
    <section
      id="pdp-hero-box"
      class="mx-auto grid max-w-[1440px] grid-cols-1 gap-10 px-5 pb-16 pt-6 sm:px-8 sm:pt-8 lg:grid-cols-12 lg:gap-16 lg:px-10 lg:pb-24"
      aria-labelledby="pdp-title"
    >
      <!-- Gallery -->
      <div class="lg:col-span-7">
        <div class="lg:sticky lg:top-24">
          <div class="media-frame relative aspect-square overflow-hidden bg-[#f1ece3] sm:aspect-[4/5]">
            <img
              id="pdp-main-image"
              src={product.images[0]?.url}
              alt={product.images[0]?.alt || `${product.name} — anti-tarnish waterproof 18K gold jewellery India`}
              width="1000"
              height="1250"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              onerror="this.onerror=null;this.src='/satvastones-logo.png';"
              class="h-full w-full object-cover"
            />

            {/* Sale label — editorial, not a sticker */}
            {discountPercent > 0 && (
              <span class="absolute left-4 top-4 z-10 bg-[#14110f] px-3 py-1.5 text-[9px] font-medium uppercase tracking-[0.18em] text-[#f6f1e8]">
                Save {discountPercent}%
              </span>
            )}

            <button
              id="pdp-wishlist-heart"
              type="button"
              data-saved="false"
              class="pdp-wishlist absolute right-4 top-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[#14110f]/10 bg-[#fbf9f5]/90 text-[#14110f] backdrop-blur-sm transition-all hover:bg-white hover:text-[#8d3f3d]"
              aria-label={`Save ${product.name} to wishlist`}
              aria-pressed="false"
            >
              <svg class="h-[18px] w-[18px] stroke-[1.4]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
            </button>

            <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between bg-gradient-to-t from-black/45 to-transparent p-4 pt-16">
              <span class="text-[9px] uppercase tracking-[0.2em] text-white/85">Waterproof 18K PVD</span>
              <span data-pdp-counter class="text-[9px] uppercase tracking-[0.2em] text-white/60">
                {String(1).padStart(2, '0')} / {String(product.images.length).padStart(2, '0')}
              </span>
            </div>
          </div>

          {/* Thumbnails */}
          <div data-pdp-thumbs class="mt-3 grid grid-cols-4 gap-3 sm:grid-cols-5">
            {product.images.map((img, idx) => (
              <button
                type="button"
                data-img-src={img.url}
                data-img-alt={img.alt}
                data-active={idx === 0 ? 'true' : 'false'}
                class="pdp-thumb aspect-[4/5] cursor-pointer overflow-hidden border border-transparent bg-[#f1ece3] transition-opacity hover:opacity-80"
                aria-label={`View image ${idx + 1} of ${product.name}`}
              >
                <img
                  src={img.url}
                  alt={img.alt || `${product.name} thumbnail`}
                  width="200"
                  height="250"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </button>
            ))}
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-[#e5ded3] pt-4 text-[10px] uppercase tracking-[0.16em] text-[#8a8279]">
            <span>Hand-inspected in Vapi, Gujarat</span>
            <a href="/materials" class="link-line text-[#14110f]">Our materials</a>
          </div>
        </div>
      </div>

      <!-- Buy box -->
      <div class="lg:col-span-5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="bg-[#f4efe7] px-2.5 py-1 text-[9px] uppercase tracking-[0.18em] text-[#8d3f3d]">
            ✦ Anti-tarnish atelier
          </span>
          {product.isBestseller && (
            <span class="border border-[#e5ded3] px-2.5 py-1 text-[9px] uppercase tracking-[0.18em] text-[#5f5851]">
              Bestseller
            </span>
          )}
        </div>

        <h1 id="pdp-title" class="font-display mt-4 text-[2.35rem] leading-[1.02] tracking-[-0.03em] text-[#14110f] sm:text-[3rem]">
          {product.name}
        </h1>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-[#6f675f]">
          <a href="#reviews" class="flex items-center gap-1.5" aria-label="Read verified customer reviews">
            <span class="flex gap-0.5 text-[#c5a059]">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`h-3 w-3 ${i < Math.round(product.rating) ? 'fill-current' : 'fill-[#ddd5c9]'}`} viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </span>
            <span class="font-medium text-[#14110f]">{product.rating}</span>
            <span class="underline decoration-[#d8d0c4] underline-offset-2">({product.reviewCount} reviews)</span>
          </a>
          <span class="hidden h-3 w-px bg-[#d8d0c4] sm:block" aria-hidden="true"></span>
          <span class="text-[10px] uppercase tracking-[0.14em]">SKU {product.sku}</span>
        </div>

        <div class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-y border-[#e5ded3] py-4">
          <span class="text-[1.75rem] font-medium tracking-tight text-[#14110f] sm:text-[2rem]">
            {formatPrice(product.pricePaise)}
          </span>
          {product.compareAtPricePaise && (
            <span class="text-sm text-[#9a938b] line-through">{formatPrice(product.compareAtPricePaise)}</span>
          )}
          {discountPercent > 0 && (
            <span class="text-[11px] font-medium uppercase tracking-[0.12em] text-[#8d3f3d]">{discountPercent}% off</span>
          )}
          <span class="ml-auto text-[10px] uppercase tracking-[0.12em] text-[#8a8279]">Incl. all taxes</span>
        </div>

        <p class="mt-5 text-[14px] leading-relaxed text-[#4a443f]">{product.headline}</p>

        <!-- Honest dispatch urgency -->
        <div class="mt-5 flex items-start gap-2.5 border-l-2 border-[#c5a059] pl-3.5 text-[11px] leading-relaxed text-[#5f5851]">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-[#2f7d5a]" aria-hidden="true"></span>
          <p>
            Order within <strong id="pdp-dispatch-countdown" class="font-semibold text-[#8d3f3d]">3h 14m 20s</strong>
            for same-day dispatch from our Vapi atelier.{' '}
            <span class="text-[#8a8279]">Delivered in 2–4 business days.</span>
          </p>
        </div>

        <!-- Stacking nudge -->
        {stackPartner && (
          <a
            href="#complete-the-stack"
            class="group mt-6 flex items-center gap-4 border border-[#e0d7c9] bg-[#f4efe7] p-3 transition-colors hover:border-[#c5a059]"
          >
            <img
              src={stackPartner.images[0]?.url}
              alt={stackPartner.name}
              width="64"
              height="80"
              loading="lazy"
              class="h-16 w-14 shrink-0 object-cover"
            />
            <div class="min-w-0 flex-1">
              <p class="text-[9px] uppercase tracking-[0.2em] text-[#8d3f3d]">The stacking edit</p>
              <p class="mt-0.5 truncate text-[13px] text-[#14110f]">Add {stackPartner.name}</p>
              <p class="text-[11px] text-[#6f675f]">Stack any two pieces and save 15%</p>
            </div>
            <span class="text-[#14110f] transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        )}

        {showSizeGuide && (
          <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-y border-[#e5ded3] py-3 text-[11px]">
            <span class="text-[#6f675f]">Not sure of your size?</span>
            <button
              id="pdp-ring-sizer-trigger"
              type="button"
              class="flex cursor-pointer items-center gap-1.5 font-medium text-[#8d3f3d] underline decoration-[#d8c3a6] underline-offset-4 transition-colors hover:text-[#14110f]"
            >
              Open size calculator
              <span aria-hidden="true">↗</span>
            </button>
          </div>
        )}

        <!-- Quantity + add -->
        <div class="mt-6">
          <div class="flex items-stretch gap-3">
            <div class="flex items-center border border-[#d8d0c4] bg-[#fbf9f5]">
              <button
                id="pdp-qty-minus"
                type="button"
                class="flex h-12 w-10 cursor-pointer items-center justify-center text-lg text-[#14110f] transition-colors hover:bg-[#f1ece3]"
                aria-label="Decrease quantity"
              >−</button>
              <span id="pdp-qty-val" class="w-8 text-center text-sm font-medium text-[#14110f]" aria-live="polite">1</span>
              <button
                id="pdp-qty-plus"
                type="button"
                class="flex h-12 w-10 cursor-pointer items-center justify-center text-lg text-[#14110f] transition-colors hover:bg-[#f1ece3]"
                aria-label="Increase quantity"
              >+</button>
            </div>

            <button
              id="pdp-add-to-cart"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-product-price={product.pricePaise}
              data-product-image={product.images[0]?.url}
              class="flex h-12 flex-1 cursor-pointer items-center justify-center gap-2.5 bg-[#14110f] px-4 text-[11px] font-medium uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d] sm:text-xs"
            >
              <svg class="h-4 w-4 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
              </svg>
              Add to bag
            </button>
          </div>

          <a
            id="pdp-buy-now"
            href="/checkout"
            class="mt-3 flex h-12 w-full items-center justify-center border border-[#14110f] px-4 text-[11px] font-medium uppercase tracking-[0.16em] text-[#14110f] transition-colors hover:bg-[#f1ece3]"
          >
            Buy it now — express checkout
          </a>

          <p class="mt-3 text-center text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
            {freeShippingRemainingPaise === 0
              ? 'Free express shipping unlocked'
              : `Add ${formatPrice(freeShippingRemainingPaise)} for free express shipping`}
            <span class="mx-1.5 text-[#c5a059]">·</span>
            7-day returns
            <span class="mx-1.5 text-[#c5a059]">·</span>
            Gift pouch included
          </p>
        </div>

        <!-- Trust list -->
        <ul class="mt-7 grid grid-cols-2 gap-x-5 gap-y-4 border-y border-[#e5ded3] py-5 text-[11px]">
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c5a059]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            <span><strong class="block font-medium text-[#14110f]">18K PVD gold</strong>Waterproof daily shine</span>
          </li>
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c5a059]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <span><strong class="block font-medium text-[#14110f]">Hypoallergenic 316L</strong>Nickel &amp; lead free</span>
          </li>
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c5a059]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
            <span><strong class="block font-medium text-[#14110f]">Free express shipping</strong>On orders over ₹499</span>
          </li>
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c5a059]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
            <span><strong class="block font-medium text-[#14110f]">7-day returns</strong>Easy size exchanges</span>
          </li>
        </ul>

        <!-- PIN checker -->
        <div class="mt-6">
          <label for="pincode-input" class="mb-2 block text-[10px] uppercase tracking-[0.16em] text-[#6f675f]">
            Check delivery to your PIN code
          </label>
          <div class="flex gap-2">
            <input
              id="pincode-input"
              type="text"
              inputmode="numeric"
              maxlength="6"
              placeholder="6-digit PIN code"
              class="h-11 flex-1 border border-[#d8d0c4] bg-transparent px-3.5 text-xs text-[#14110f] placeholder:text-[#9a938b] focus:border-[#14110f] focus:outline-none"
            />
            <button
              id="check-pincode-btn"
              type="button"
              class="h-11 cursor-pointer border border-[#14110f] px-5 text-[10px] font-medium uppercase tracking-[0.14em] text-[#14110f] transition-colors hover:bg-[#14110f] hover:text-[#f6f1e8]"
            >
              Check
            </button>
          </div>
          <p id="pincode-msg" class="mt-2 hidden text-[11px] font-medium" role="status"></p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[#e5ded3] pt-4 text-[10px] uppercase tracking-[0.12em] text-[#8a8279]">
          <span>Secure checkout</span>
          <span aria-hidden="true" class="text-[#c5a059]">✦</span>
          <span>UPI · Cards · Netbanking</span>
          <span aria-hidden="true" class="text-[#c5a059]">✦</span>
          <span>GST invoice available</span>
        </div>
      </div>
    </section>

    <!-- Complete the stack -->
    <section id="complete-the-stack" class="border-y border-[#e5ded3] bg-[#f1ece3]" aria-labelledby="stack-title">
      <div class="mx-auto max-w-[1440px] px-5 py-14 sm:px-8 sm:py-16 lg:px-10">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow text-[#8d3f3d]">The stacking edit</p>
            <h2 id="stack-title" class="font-display mt-2 text-[2rem] leading-tight sm:text-[2.6rem]">Complete the stack.</h2>
            <p class="mt-2 max-w-md text-[13px] leading-relaxed text-[#5f5851]">
              Three pieces, one considered look. Choose any two or all three and we take 15% off the set — automatically.
            </p>
          </div>
          <span class="self-start bg-[#14110f] px-3.5 py-2 text-[9px] uppercase tracking-[0.18em] text-[#f6f1e8] sm:self-auto">
            Save 15% on 2+ pieces
          </span>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
          {bundleItems.map((item, idx) => (
            <label class="group relative flex cursor-pointer items-center gap-4 border border-[#ded5c7] bg-[#fbf9f5] p-3 transition-colors has-[:checked]:border-[#14110f]">
              <input
                type="checkbox"
                checked
                disabled={idx === 0}
                class="bundle-item-check h-4 w-4 shrink-0 accent-[#14110f]"
                data-item-id={item.id}
                data-item-name={item.name}
                data-item-slug={item.slug}
                data-item-price={item.pricePaise}
                data-item-image={item.images[0]?.url}
                aria-label={`Include ${item.name} in the bundle`}
              />
              <img
                src={item.images[0]?.url}
                alt={item.name}
                width="80"
                height="100"
                loading="lazy"
                class="h-[84px] w-[68px] shrink-0 object-cover"
              />
              <div class="min-w-0 flex-1">
                <p class="text-[9px] uppercase tracking-[0.16em] text-[#8d3f3d]">
                  {idx === 0 ? 'This piece' : 'Pairs with'}
                </p>
                <p class="mt-0.5 line-clamp-2 text-[12px] leading-snug text-[#14110f]">{item.name}</p>
                <p class="mt-1 text-[12px] font-medium">{formatPrice(item.pricePaise)}</p>
              </div>
            </label>
          ))}
        </div>

        <div class="mt-6 flex flex-col items-start justify-between gap-5 border-t border-[#ded5c7] pt-6 sm:flex-row sm:items-center">
          <div class="text-[12px]">
            <div id="bundle-raw-row" class="flex gap-3 text-[#6f675f]">
              <span>Combined value</span>
              <span id="bundle-raw-val" class="line-through">{formatPrice(bundleRawSumPaise)}</span>
            </div>
            <div id="bundle-savings-row" class="mt-1 flex gap-3 font-medium text-[#2f7d5a]">
              <span id="bundle-savings-label">Bundle savings (15% off)</span>
              <span id="bundle-savings-val">− {formatPrice(bundleDiscountPaise)}</span>
            </div>
            <div class="mt-2 flex items-baseline gap-3 border-t border-[#ded5c7] pt-2 text-[#14110f]">
              <span id="bundle-price-label" class="text-[11px] uppercase tracking-[0.14em]">Suite price</span>
              <span id="bundle-final-val" class="font-display text-[1.8rem] leading-none">{formatPrice(bundleFinalPaise)}</span>
            </div>
          </div>

          <div class="w-full sm:w-auto">
            <button
              id="bundle-add-btn"
              type="button"
              class="w-full cursor-pointer bg-[#14110f] px-8 py-4 text-[11px] font-medium uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d] sm:w-auto"
            >
              Add all 3 to bag — 15% off
            </button>
            <p class="mt-2 text-center text-[10px] uppercase tracking-[0.12em] text-[#8a8279] sm:text-left">
              Free express shipping · Gift pouch included
