---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: "Shipping Policy", url: '/shipping-policy' }
];
---

<BaseLayout
  title="Shipping & Delivery Policy | SatvaStones Jewellery"
  description="Pan-India shipping terms for SatvaStones anti-tarnish jewellery. Dispatched from Vapi, Gujarat within 24-48 hours. Free delivery above ₹499."
  breadcrumbs={breadcrumbs}
>
  <PageIntro
    eyebrow="Vapi atelier · Pan-India express"
    title="Shipping & delivery."
    lede="Free express delivery across India above ₹499. Every order is hand-inspected in Vapi and dispatched within 24–48 hours."
    crumbs={breadcrumbs}
  >
    <p class="mt-6 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">Last updated November 2026 · Free over ₹499 · ₹49 below</p>
  </PageIntro>

  <div class="bg-[#fbf9f5] pb-20 pt-4 sm:pt-8">
    <div class="policy-body mx-auto max-w-3xl space-y-8 px-5 sm:px-8">

      <!-- Section 1: Dispatch Timeline from Vapi -->
      <section class="space-y-3 bg-[#f4efe7] p-5 border border-[#e5ded3]">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#14110f] flex items-center gap-2">
          <span class="w-2 h-2 bg-[#8d3f3d]"></span>
          <span>1. Dispatch Schedule &amp; Origin Atelier</span>
        </h2>
        <p>
          Every SatvaStones jewelry parcel is individually hand-inspected, wrapped in a protective anti-tarnish velvet suede pouch, accompanied by an authenticity care card, and dispatched directly from our atelier in <strong>Chala, Vapi, Gujarat - 396191, India</strong>.
        </p>
        <p>
          Orders placed before 2:00 PM IST on business days are typically processed and dispatched within <strong>24 to 48 hours</strong> (excluding national holidays and Sundays).
        </p>
      </section>

      <!-- Section 2: Delivery Windows Across India -->
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#14110f] border-b border-[#e5ded3] pb-2">
          2. Estimated Delivery Timelines Across India
        </h2>
        <p>
          We partner with premium air express courier services (BlueDart Air Express, Delhivery Prime, Xpressbees) to ensure speedy delivery across India:
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
          <div class="p-3.5 bg-white border border-[#e5ded3] space-y-1">
            <span class="font-bold text-[#14110f] block text-xs">Gujarat &amp; Western India</span>
            <span class="text-[#8d3f3d] font-extrabold text-sm block">1 to 3 Business Days</span>
            <p class="text-[11px] text-[#6f675f]">Ahmedabad, Surat, Mumbai, Pune, Vadodara, Rajkot, Vapi &amp; nearby zones.</p>
          </div>
          <div class="p-3.5 bg-white border border-[#e5ded3] space-y-1">
            <span class="font-bold text-[#14110f] block text-xs">Major Metros</span>
            <span class="text-[#8d3f3d] font-extrabold text-sm block">2 to 4 Business Days</span>
            <p class="text-[11px] text-[#6f675f]">Delhi-NCR, Bengaluru, Hyderabad, Chennai, Kolkata, Jaipur, Chandigarh.</p>
          </div>
          <div class="p-3.5 bg-white border border-[#e5ded3] space-y-1">
            <span class="font-bold text-[#14110f] block text-xs">Rest of India &amp; North East</span>
            <span class="text-[#8d3f3d] font-extrabold text-sm block">3 to 6 Business Days</span>
            <p class="text-[11px] text-[#6f675f]">Tier-2/Tier-3 towns, Assam, Jammu &amp; Kashmir, Kerala interior, and remote pincodes.</p>
          </div>
        </div>
      </section>

      <!-- Section 3: Shipping Fees & Free Shipping Threshold -->
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#14110f] border-b border-[#e5ded3] pb-2">
          3. Shipping Fees &amp; Free Shipping Threshold
        </h2>
        <ul class="list-disc list-inside space-y-1.5 pl-2">
          <li><strong>Orders of ₹499 and above:</strong> <strong class="text-emerald-700">100% Free Express Shipping</strong> across all serviceable pincodes in India.</li>
          <li><strong>Orders below ₹499:</strong> A nominal flat shipping and protective packaging fee of <strong>₹49</strong> is applied at checkout.</li>
          <li><strong>Prepaid Orders via Razorpay (UPI, GPay, Cards):</strong> Enjoy <strong>₹0 handling fees</strong> with instant payment verification and priority same-day dispatch.</li>
          <li><strong>Cash on Delivery (COD):</strong> Available across 19,000+ Indian pincodes. A flat <strong>₹25 COD handling &amp; doorstep collection fee</strong> applies. <em>Tip: Pay online via Razorpay (UPI / Google Pay) at checkout to save ₹25!</em></li>
          <li><strong>Zero Hidden Taxes:</strong> All product prices include 3% statutory GST (GSTIN: 24DDAPV4074H1ZF).</li>
        </ul>
      </section>

      <!-- Section 4: Live Tracking -->
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#14110f] border-b border-[#e5ded3] pb-2">
          4. Real-Time Tracking &amp; Notifications
        </h2>
        <p>
          As soon as your package is scanned by our courier partner in Vapi:
        </p>
        <ul class="list-disc list-inside space-y-1 pl-2">
          <li>You will receive an automated SMS and Email with your unique <strong>Air Waybill (AWB) number</strong> and direct tracking URL.</li>
          <li>You can track the live transit status at any time on our website at <a href="/track-order" class="text-[#8d3f3d] font-bold underline">www.satvastones.in/track-order</a> using your Order Number or Mobile Number.</li>
        </ul>
      </section>

      <!-- Section 5: Undelivered / Lost Shipments -->
      <section class="space-y-3 bg-[#f4efe7] p-5 border border-[#e5ded3]">
        <h2 class="text-base font-bold text-[#14110f]">
          5. Undelivered &amp; Lost Shipments Guarantee
        </h2>
        <p>
          Our courier partners make up to <strong>3 delivery attempts</strong> to your specified address. If a delivery attempt fails due to customer unavailability or incorrect address:
        </p>
        <ul class="list-disc list-inside space-y-1 pl-2 text-xs">
          <li>You will receive an alert to reschedule the delivery slot.</li>
          <li>In the rare event that a package is declared lost or damaged in transit by the carrier, SatvaStones will immediately issue a <strong>free replacement piece</strong> or provide a <strong>100% full refund</strong> without hassle.</li>
        </ul>
        <p class="text-xs pt-1">
          For shipping queries or address corrections before dispatch, contact: <a href="mailto:support@satvastones.in" class="text-[#8d3f3d] font-bold underline">support@satvastones.in</a> or Call/WhatsApp: <a href="https://wa.me/919016703180" class="text-[#8d3f3d] font-bold underline">+91 90167 03180</a>.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
