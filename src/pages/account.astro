---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="My Account | Satvastones Anti-Tarnish Jewellery"
  description="Manage your Satvastones orders, delivery addresses, and account details."
>
  <!-- Jewelsmars Clean Header -->
  <div class="bg-white border-b border-gray-100 py-6 sm:py-10">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-1">
      <span class="text-xs font-bold uppercase tracking-widest text-[#a1505a]">Member Hub</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">My Account</h1>
      <p class="text-xs text-gray-500">Manage orders, track Vapi store dispatches, and access saved pieces</p>
    </div>
  </div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="max-w-4xl mx-auto space-y-6">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Sidebar Navigation -->
        <div class="space-y-2 text-xs">
          <div class="p-4 bg-white border border-gray-200 rounded-[18px] space-y-1 mb-4 shadow-xs">
            <p class="text-[10px] uppercase font-bold text-gray-400">Welcome Back</p>
            <h3 class="text-base font-extrabold text-gray-900">Satvastones Member</h3>
            <p class="text-[11px] text-[#f2707f] font-bold">VIP Tier • Free Shipping Unlocked</p>
          </div>

          <a href="/account" class="w-full p-3.5 bg-[#111111] text-white font-bold rounded-xl shadow-sm transition-colors flex items-center gap-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
            <span>My Orders & Tracking</span>
          </a>
          <a href="/wishlist" class="w-full p-3.5 bg-white border border-gray-200 text-gray-800 hover:border-[#f9d8dc] hover:text-[#f2707f] font-bold rounded-xl transition-colors flex items-center gap-2.5">
            <svg class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            <span>Saved Wishlist</span>
          </a>
          <a href="/track-order" class="w-full p-3.5 bg-white border border-gray-200 text-gray-800 hover:border-[#f9d8dc] hover:text-[#f2707f] font-bold rounded-xl transition-colors flex items-center gap-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375" />
            </svg>
            <span>Track Vapi Shipment</span>
          </a>
          <a href="/jewellery-care" class="w-full p-3.5 bg-white border border-gray-200 text-gray-800 hover:border-[#f9d8dc] hover:text-[#f2707f] font-bold rounded-xl transition-colors flex items-center gap-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <span>Jewellery Care Guide</span>
          </a>
          <a href="/faqs" class="w-full p-3.5 bg-white border border-gray-200 text-gray-800 hover:border-[#f9d8dc] hover:text-[#f2707f] font-bold rounded-xl transition-colors flex items-center gap-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
            </svg>
            <span>FAQs & Support</span>
          </a>
        </div>

        <!-- Main Account Content -->
        <div class="md:col-span-2 space-y-5">
          
          <!-- Recent Orders Card -->
          <div class="bg-white p-5 sm:p-7 border border-gray-200 rounded-[22px] space-y-4 shadow-xs">
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
              <div>
                <span class="text-[10px] text-[#a1505a] font-bold uppercase tracking-wider">Live Fulfillment</span>
                <h2 class="text-lg font-bold text-gray-900">Recent Orders</h2>
              </div>
              <span class="text-xs text-gray-500">Dispatched from Vapi</span>
            </div>
            
            <div class="border border-gray-200 rounded-[16px] p-4 bg-gray-50 space-y-3">
              <div class="flex justify-between items-start text-xs border-b border-gray-200 pb-3">
                <div>
                  <span class="font-extrabold text-sm text-gray-900">Order #SAT-2026-000108</span>
                  <p class="text-[11px] text-gray-500">Confirmed on 14 Nov 2026 • Express Courier</p>
                </div>
                <span class="bg-[#e6f9f0] text-[#007c52] text-[10px] font-bold px-2.5 py-0.5 rounded-full">
                  Dispatched from Vapi
                </span>
              </div>

              <div class="flex items-center gap-3.5 text-xs">
                <img
                  src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=200&q=80"
                  alt="Aura Snake Chain"
                  class="w-14 h-18 object-cover rounded-[10px] bg-white border border-gray-200 shrink-0"
                />
                <div class="flex-1 space-y-0.5 min-w-0">
                  <h4 class="text-sm font-bold text-gray-900 truncate">Aura Herringbone Snake Chain</h4>
                  <p class="text-[11px] text-gray-500">18K PVD Gold • Surgical 316L</p>
                  <p class="font-extrabold text-xs text-[#f2707f] pt-0.5">₹1,699</p>
                </div>
                <div>
                  <a
                    href="/track-order"
                    class="text-xs font-bold text-[#f2707f] hover:underline"
                  >
                    Track →
                  </a>
                </div>
              </div>
            </div>

            <!-- Shipping Policy Notice -->
            <div class="p-3.5 bg-[#fffafb] border border-[#f9d8dc] rounded-xl text-xs text-gray-600 space-y-1">
              <p class="font-bold text-gray-900">Order & Shipping Reminders:</p>
              <p>• Orders leave our Vapi store within 24–48 hours.</p>
              <p>• Cancellations are only permitted prior to courier handover.</p>
              <p>• 360° unedited unboxing video is mandatory for any transit damage verification.</p>
            </div>
          </div>

          <!-- Customer Care Card -->
          <div class="bg-white p-5 sm:p-6 border border-gray-200 rounded-[22px] flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xs">
            <div>
              <h3 class="text-sm font-bold text-gray-900">Need Help with Your Order?</h3>
              <p class="text-xs text-gray-500">Our Vapi concierge team is here to assist you.</p>
            </div>
            <a
              href="mailto:support@satvastones.in"
              class="bg-[#f2707f] hover:bg-[#e05e6d] text-white px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-xl shadow-xs transition-colors whitespace-nowrap"
            >
              Email Support
            </a>
          </div>

        </div>

      </div>

    </div>
  </div>
</BaseLayout>
