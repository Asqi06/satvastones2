---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Wishlist', url: '/wishlist' }
];
---

<BaseLayout
  title="My Wishlist | Satvastones Anti-Tarnish Jewellery"
  description="Your saved anti-tarnish jewellery pieces. Move anything straight to the bag, or build a stack of three and save 15%."
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <PageIntro
      eyebrow="Saved pieces"
      title="Your wishlist."
      lede="Pieces you set aside. When you're ready, move them to the bag — or take three and the stack discount applies automatically."
      crumbs={breadcrumbs}
    />

    <div class="mx-auto max-w-[1440px] px-5 pb-16 sm:px-8 sm:pb-24 lg:px-10">
      <div id="wishlist-container">
        <!-- Empty state -->
        <div id="wishlist-empty" class="border border-[#e5ded3] bg-white px-6 py-14 text-center sm:py-20">
          <span class="mx-auto flex h-12 w-12 items-center justify-center border border-[#e5ded3] text-[#c5a059]" aria-hidden="true">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </span>
          <h2 class="font-display mt-5 text-[1.9rem] leading-tight sm:text-[2.4rem]">Nothing saved yet.</h2>
          <p class="mx-auto mt-2 max-w-sm text-[12.5px] leading-relaxed text-[#5f5851]">
            Tap the heart on any piece to keep it here. Your list stays on this device — no account needed.
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-2.5 sm:flex-row">
            <a href="/shop" class="inline-flex items-center justify-center gap-2 bg-[#14110f] px-7 py-3.5 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]">
              Shop all pieces <span aria-hidden="true">→</span>
            </a>
            <a href="/collections/bestsellers" class="inline-flex items-center justify-center gap-2 border border-[#14110f] px-7 py-3.5 text-[10px] uppercase tracking-[0.16em] text-[#14110f] transition-colors hover:bg-[#f4efe7]">
              Shop bestsellers
            </a>
          </div>
        </div>

        <!-- Grid -->
        <div id="wishlist-grid" class="hidden grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4"></div>

        <!-- Stack nudge -->
        <div class="mt-10 flex flex-col items-start justify-between gap-4 border border-[#e0d7c9] bg-[#f4efe7] px-6 py-5 sm:flex-row sm:items-center">
          <div>
            <p class="eyebrow text-[#8d3f3d]">Save 15%</p>
            <p class="font-display mt-1.5 text-[1.35rem] leading-tight">Three pieces make a stack.</p>
            <p class="mt-1 text-[12px] leading-relaxed text-[#5f5851]">
              Any two or more pieces take 15% off automatically in the bag. Build it deliberately in the stack studio.
            </p>
          </div>
          <a href="/stack-builder" class="link-line shrink-0 text-[10px] uppercase tracking-[0.14em] text-[#14110f]">
            Open the stack studio
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getWishlistItems, saveWishlistItems } from '../stores/wishlistStore';
  import { addToCart } from '../stores/cartStore';

  function formatINR(paise: number) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  }

  function renderWishlist() {
    const items = getWishlistItems();
    const emptyEl = document.getElementById('wishlist-empty');
    const gridEl = document.getElementById('wishlist-grid');

    if (!items || items.length === 0) {
      emptyEl?.classList.remove('hidden');
      if (gridEl) {
        gridEl.classList.add('hidden');
        gridEl.classList.remove('grid');
      }
      return;
    }

    emptyEl?.classList.add('hidden');

    if (gridEl) {
      gridEl.classList.remove('hidden');
      gridEl.classList.add('grid');
      gridEl.innerHTML = items
        .map(
          (p) => `
        <article class="group flex flex-col border border-[#e5ded3] bg-white transition-colors hover:border-[#c5a059]">
          <div class="relative aspect-[3/4] overflow-hidden bg-[#f1ece3]">
            <a href="/products/${p.slug}" class="block h-full w-full" tabindex="-1" aria-hidden="true">
              <img src="${p.images[0]?.url}" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
            </a>
            <span class="absolute left-2.5 top-2.5 bg-[#fbf9f5]/95 px-2 py-0.5 text-[8px] uppercase tracking-[0.14em] text-[#6f675f]">
              18K PVD
            </span>
            <button
              class="remove-wishlist-btn absolute right-2.5 top-2.5 flex h-8 w-8 cursor-pointer items-center justify-center border border-[#e5ded3] bg-white/95 text-[#6f675f] transition-colors hover:border-[#14110f] hover:text-[#14110f]"
              data-id="${p.id}"
              title="Remove from wishlist"
              aria-label="Remove ${p.name} from wishlist"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="flex flex-1 flex-col justify-between gap-3 p-3 sm:p-4">
            <div>
              <a href="/products/${p.slug}" class="block">
                <h3 class="line-clamp-2 text-[12px] leading-snug text-[#14110f] transition-colors hover:text-[#8d3f3d] sm:text-[12.5px]">${p.name}</h3>
              </a>
              <p class="mt-1.5 text-[12px] font-medium text-[#8d3f3d]">${formatINR(p.pricePaise)}</p>
            </div>

            <button
              class="move-to-bag-btn w-full cursor-pointer bg-[#14110f] px-3 py-2.5 text-[9px] uppercase tracking-[0.14em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]"
              data-id="${p.id}"
              data-name="${p.name}"
              data-slug="${p.slug}"
              data-price="${p.pricePaise}"
              data-image="${p.images[0]?.url}"
            >
              Add to bag
            </button>
          </div>
        </article>
      `
        )
        .join('');

      gridEl.querySelectorAll('.remove-wishlist-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          const current = getWishlistItems();
          saveWishlistItems(current.filter((i) => i.id !== id));
          renderWishlist();
        });
      });

      gridEl.querySelectorAll('.move-to-bag-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLElement;
          addToCart({
            productId: el.dataset.id || '',
            name: el.dataset.name || '',
            slug: el.dataset.slug || '',
            pricePaise: parseInt(el.dataset.price || '0', 10),
            image: el.dataset.image || '',
            quantity: 1
          });
          el.textContent = 'Added to bag';
          setTimeout(() => {
            el.textContent = 'Add to bag';
          }, 1500);
        });
      });
    }
  }

  renderWishlist();
  window.addEventListener('satvastones:wishlist_updated', renderWishlist);
</script>
