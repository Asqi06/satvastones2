---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="My Wishlist | Satvastones Anti-Tarnish Jewellery"
  description="View and manage your curated anti-tarnish jewellery wishlist. Transfer items directly to your shopping bag."
>
  <!-- Jewelsmars Clean Header -->
  <div class="bg-white border-b border-gray-100 py-6 sm:py-10">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-1">
      <span class="text-xs font-bold uppercase tracking-widest text-[#a1505a]">Saved Pieces</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">My Wishlist</h1>
      <p class="text-xs text-gray-500">Your curated collection of waterproof 18K gold everyday pieces</p>
    </div>
  </div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="max-w-4xl mx-auto space-y-6">
      
      <!-- Wishlist Container -->
      <div id="wishlist-container">
        <!-- Empty State -->
        <div id="wishlist-empty" class="text-center py-16 space-y-4 bg-white border border-gray-200 rounded-[22px] p-8 shadow-xs">
          <div class="w-16 h-16 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f] mx-auto">
            <svg class="w-8 h-8 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900">Your wishlist is empty</h2>
          <p class="text-xs text-gray-500 max-w-sm mx-auto leading-relaxed">
            Save your favourite anti-tarnish necklaces, rings, bracelets, and earrings to revisit or transfer to your bag anytime.
          </p>
          <div class="pt-2">
            <a
              href="/shop"
              class="inline-block bg-[#f2707f] hover:bg-[#e05e6d] text-white px-8 py-3 text-xs uppercase font-bold tracking-wider rounded-xl shadow-lg shadow-[#f2707f]/25 transition-all"
            >
              Explore Bestsellers →
            </a>
          </div>
        </div>

        <!-- 2-Column Mobile Grid for Wishlist Items -->
        <div id="wishlist-grid" class="hidden grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6"></div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { getWishlistItems, saveWishlistItems } from '../stores/wishlistStore';
  import { addToCart } from '../stores/cartStore';

  function formatINR(paise: number) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Math.round(paise / 100));
  }

  function renderWishlist() {
    const items = getWishlistItems();
    const emptyEl = document.getElementById('wishlist-empty');
    const gridEl = document.getElementById('wishlist-grid');

    if (!items || items.length === 0) {
      if (emptyEl) emptyEl.classList.remove('hidden');
      if (gridEl) gridEl.classList.add('hidden');
      return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');
    if (gridEl) {
      gridEl.classList.remove('hidden');
      gridEl.innerHTML = items
        .map(
          (p) => `
        <div class="bg-white border border-gray-200 rounded-[18px] overflow-hidden flex flex-col justify-between hover:border-[#f9d8dc] hover:shadow-md transition-all group">
          <div class="relative aspect-[3/4] overflow-hidden bg-gray-50">
            <a href="/products/${p.slug}" class="block w-full h-full">
              <img src="${p.images[0]?.url}" alt="${p.name}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </a>
            <span class="absolute top-2.5 left-2.5 bg-black/75 text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">
              18K PVD
            </span>
            <button
              class="remove-wishlist-btn absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-white/90 backdrop-blur-xs flex items-center justify-center text-gray-500 hover:text-red-600 shadow-xs cursor-pointer"
              data-id="${p.id}"
              title="Remove from wishlist"
              aria-label="Remove"
            >
              <svg class="w-4 h-4 stroke-[2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="p-3 sm:p-4 flex flex-col justify-between flex-1 space-y-2">
            <div>
              <a href="/products/${p.slug}">
                <h3 class="text-xs sm:text-sm font-bold text-gray-900 truncate hover:text-[#f2707f] transition-colors">${p.name}</h3>
              </a>
              <p class="text-xs sm:text-sm font-extrabold text-[#f2707f] mt-1">${formatINR(p.pricePaise)}</p>
            </div>

            <button
              class="move-to-bag-btn w-full bg-[#f2707f] hover:bg-[#e05e6d] text-white py-2 px-3 text-xs uppercase font-bold tracking-wider rounded-xl shadow-xs transition-all cursor-pointer"
              data-id="${p.id}"
              data-name="${p.name}"
              data-slug="${p.slug}"
              data-price="${p.pricePaise}"
              data-image="${p.images[0]?.url}"
            >
              Add to Bag
            </button>
          </div>
        </div>
      `
        )
        .join('');

      // Attach remove handlers
      gridEl.querySelectorAll('.remove-wishlist-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          const current = getWishlistItems();
          const filtered = current.filter((i) => i.id !== id);
          saveWishlistItems(filtered);
          renderWishlist();
        });
      });

      // Attach move to bag handlers
      gridEl.querySelectorAll('.move-to-bag-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLElement;
          addToCart({
            productId: el.dataset.id || '',
            name: el.dataset.name || '',
            slug: el.dataset.slug || '',
            pricePaise: parseInt(el.dataset.price || '0', 10),
            image: el.dataset.image || '',
            quantity: 1
          });
          el.textContent = 'Added to Bag';
          setTimeout(() => {
            el.textContent = 'Add to Bag';
          }, 1500);
        });
      });
    }
  }

  renderWishlist();
  window.addEventListener('satvastones:wishlist_updated', renderWishlist);
</script>
