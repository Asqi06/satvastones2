---
// Redirect alias to canonical /terms-and-conditions
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to SatvaStones Terms & Conditions...</title>
    <link rel="canonical" href="/terms-and-conditions" />
    <meta http-equiv="refresh" content="0;url=/terms-and-conditions" />
  </head>
  <body class="p-8 text-center font-sans text-sm text-gray-600">
    <p>Redirecting to <a href="/terms-and-conditions" class="text-[#f2707f] underline font-bold">Terms & Conditions</a>...</p>
    <script>
      window.location.replace('/terms-and-conditions');
    </script>
  </body>
</html>
