---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Reviews from '../components/Reviews.astro';
import Newsletter from '../components/Newsletter.astro';
import { PRODUCTS } from '../data/products';
import { CATEGORIES } from '../data/categories';

const bestsellers = PRODUCTS.filter((p) => p.isBestseller).slice(0, 4);
const newArrivals = PRODUCTS.filter((p) => p.isNewArrival).slice(0, 4);
---

<BaseLayout
  title="Satvastones – Anti Tarnish Jewellery Online India"
  description="Shop waterproof anti tarnish jewellery in India from ₹499. Everyday 18K gold PVD & 316L steel necklaces, rings, sets. Free PAN-India delivery & 7-day returns."
>
  <!-- Section 1: Jewelsmars-Style Category Story Squircles Strip (Mobile-First) -->
  <section class="py-4 sm:py-6 bg-white border-b border-[#f0f0f0]">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto pb-2 scrollbar-none justify-start sm:justify-center">
        {CATEGORIES.map((cat) => (
          <a
            href={`/collections/${cat.slug}`}
            class="group flex flex-col items-center shrink-0 w-20 sm:w-24"
            data-category-slug={cat.slug}
          >
            <!-- Squircle Bubble with Soft Blush Tint (#ffe7e9) -->
            <div class="w-18 h-18 sm:w-22 sm:h-22 rounded-[20px] bg-[#ffe7e9] p-1.5 border-2 border-transparent group-hover:border-[#f2707f] transition-all duration-300 shadow-xs flex items-center justify-center overflow-hidden">
              <img
                src={cat.image}
                alt={`${cat.name} Collection`}
                width="88"
                height="88"
                loading="eager"
                decoding="async"
                class="category-squircle-img w-full h-full object-cover rounded-[16px] group-hover:scale-108 transition-transform duration-300"
              />
            </div>
            <span class="category-squircle-name mt-2 text-xs font-bold text-[#111111] group-hover:text-[#f2707f] transition-colors text-center tracking-tight truncate max-w-full">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Jewelsmars Full-Width Editorial Hero Banner -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <div class="relative min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[22px] overflow-hidden flex items-center bg-[#fafafa] shadow-sm">
      <img
        id="hero-banner-img"
        src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1200&fm=webp&q=80"
        srcset="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=640&fm=webp&q=80 640w, https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1024&fm=webp&q=80 1024w, https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1440&fm=webp&q=80 1440w"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 1440px"
        alt="Satvastones Fine Anti-Tarnish Jewellery Editorial Collection"
        width="1440"
        height="580"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <!-- Soft Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/45 to-transparent sm:w-2/3"></div>

      <!-- Hero Content -->
      <div class="relative z-10 p-6 sm:p-12 lg:p-16 max-w-lg space-y-4 text-white">
        <span class="inline-block bg-[#f2707f] text-white text-[11px] font-extrabold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">
          100% Anti-Tarnish • 18K Gold PVD
        </span>

        <h1 id="hero-banner-heading" class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
          Anti Tarnish Jewellery That Feels Like <span class="text-[#f2707f]">You.</span>
        </h1>

        <p id="hero-banner-tagline" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
          Designed for showers, gym workouts, and everyday moments. Hand-inspected and dispatched from our Vapi atelier in 24–48 hours.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="/shop"
            class="bg-[#f2707f] hover:bg-[#e05e6d] text-white px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all shadow-md hover:shadow-lg inline-block text-center"
          >
            SHOP COLLECTION
          </a>
          <a
            href="/collections/bestsellers"
            class="bg-white/90 hover:bg-white text-[#111111] px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all shadow-md inline-block text-center"
          >
            EXPLORE BESTSELLERS
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Trust Strip with Clean Minimalist Line SVGs -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="bg-[#fafafa] border border-[#eeeeee] rounded-2xl py-4 px-6 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center">
      <div class="flex flex-col items-center gap-1.5">
        <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        </div>
        <span class="text-xs font-bold text-[#111111]">100% Waterproof</span>
        <span class="text-[11px] text-[#666666]">Shower & sweat resistant</span>
      </div>
      <div class="flex flex-col items-center gap-1.5">
        <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375" />
          </svg>
        </div>
        <span class="text-xs font-bold text-[#111111]">Free Shipping &gt; ₹499</span>
        <span class="text-[11px] text-[#666666]">Express Pan-India air courier</span>
      </div>
      <div class="flex flex-col items-center gap-1.5">
        <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
        <span class="text-xs font-bold text-[#111111]">Dispatched in 24–48h</span>
        <span class="text-[11px] text-[#666666]">Direct from Vapi Store</span>
      </div>
      <div class="flex flex-col items-center gap-1.5">
        <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <span class="text-xs font-bold text-[#111111]">Zero Green Skin</span>
        <span class="text-[11px] text-[#666666]">316L Surgical steel core</span>
      </div>
    </div>
  </section>

  <!-- Section 4: Bestsellers (2-Column Mobile Grid) -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="flex items-end justify-between mb-6 pb-2 border-b border-[#eeeeee]">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-wider text-[#f2707f]">
          PATRON FAVOURITES
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#111111] tracking-tight">
          Trending Anti-Tarnish
        </h2>
      </div>
      <a
        href="/collections/bestsellers"
        class="text-xs font-bold uppercase tracking-wider text-[#111111] hover:text-[#f2707f] transition-colors"
      >
        View All →
      </a>
    </div>

    <!-- 2-Column Mobile / 4-Column Desktop -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
      {bestsellers.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <!-- Section 5: Jewelsmars Dual Aesthetic Promo Banners -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <!-- Card 1 -->
      <div class="relative h-72 sm:h-84 rounded-[22px] overflow-hidden bg-gray-100 group shadow-xs">
        <img
          src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1000&q=80"
          alt="Molten Baroque Pearl Collection"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-6 sm:p-8 flex flex-col justify-end text-white">
          <span class="text-xs font-extrabold text-[#f2707f] uppercase tracking-wider">
            FEATURED CAPSULE
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold mt-1">Coastal Molten Baroque Suite</h3>
          <p class="text-xs text-gray-200 mt-1 max-w-sm line-clamp-2">
            Natural freshwater pearls sealed in 18K gold PVD bezels. Resistant to humidity and moisture.
          </p>
          <div class="pt-3">
            <a
              href="/collections/necklaces"
              class="inline-block bg-[#f2707f] hover:bg-[#e05e6d] text-white px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all"
            >
              EXPLORE CAPSULE
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="relative h-72 sm:h-84 rounded-[22px] overflow-hidden bg-gray-100 group shadow-xs">
        <img
          src="https://images.unsplash.com/photo-1611591475152-47eac9c5bdfa?auto=format&fit=crop&w=1000&q=80"
          alt="Liquid Gold Chains"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-6 sm:p-8 flex flex-col justify-end text-white">
          <span class="text-xs font-extrabold text-[#f2707f] uppercase tracking-wider">
            EVERYDAY STACKING
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold mt-1">Surgical Steel Liquid Chains</h3>
          <p class="text-xs text-gray-200 mt-1 max-w-sm line-clamp-2">
            No green marks, no flaking. Wear it 24/7 without taking it off.
          </p>
          <div class="pt-3">
            <a
              href="/collections/bracelets"
              class="inline-block bg-white text-[#111111] hover:bg-[#f2707f] hover:text-white px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all"
            >
              SHOP CHAINS
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Fresh Atelier Drops (2-Column Mobile Grid) -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="flex items-end justify-between mb-6 pb-2 border-b border-[#eeeeee]">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-wider text-[#a1505a]">
          JUST RELEASED
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#111111] tracking-tight">
          New Atelier Arrivals
        </h2>
      </div>
      <a
        href="/collections/new-arrivals"
        class="text-xs font-bold uppercase tracking-wider text-[#111111] hover:text-[#f2707f] transition-colors"
      >
        Shop All New →
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
      {newArrivals.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <!-- Section 6.5: Interactive Features Exclusive to SatvaStones (Stack Studio & Ring Sizer) -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="bg-gradient-to-br from-[#fffafb] to-[#ffe7e9]/60 border border-[#f9d8dc] rounded-[24px] p-6 sm:p-10 shadow-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#a1505a] bg-white px-3 py-1 rounded-full border border-[#f9d8dc]">
            <svg class="w-3.5 h-3.5 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            <span>EXCLUSIVE SATVASTONES STUDIO</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Curate Your Signature Stack & Save 15%
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            Choose your favourite chain, everyday ring, and waterproof huggies in our interactive Mix & Match Studio. Automatic 15% VIP bundle discount applied with complimentary luxury velvet gift packaging!
          </p>
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="/stack-builder"
              class="bg-[#f2707f] hover:bg-[#e05e6d] text-white px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-wider shadow-lg shadow-[#f2707f]/25 transition-all"
            >
              Open Stack Studio →
            </a>
            <button
              id="home-open-ring-sizer-btn"
              type="button"
              class="bg-white hover:bg-gray-50 text-gray-800 border border-gray-200 px-5 py-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 text-[#f2707f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m-3-3h6" />
              </svg>
              <span>Try Ring Sizer</span>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
            </div>
            <h4 class="font-bold text-xs text-gray-900">Screen Ring Placement</h4>
            <p class="text-[11px] text-gray-500">Match your existing ring against your phone screen for instant Indian size.</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375" />
              </svg>
            </div>
            <h4 class="font-bold text-xs text-gray-900">24–48h Vapi Dispatch</h4>
            <p class="text-[11px] text-gray-500">Every piece hand-inspected in Gujarat with live courier SMS/WhatsApp tracking.</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
            <h4 class="font-bold text-xs text-gray-900">Instant GST Invoices</h4>
            <p class="text-[11px] text-gray-500">Transparent GST invoices with legal entity Anirudh A Verma (GSTIN: 24DDAPV4074H1ZF) and HSN code 7117.</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-[#f2707f]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
              </svg>
            </div>
            <h4 class="font-bold text-xs text-gray-900">Shower & Sweat Proof</h4>
            <p class="text-[11px] text-gray-500">316L medical stainless steel with 18K vacuum gold PVD. Zero green skin.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const homeSizerBtn = document.getElementById('home-open-ring-sizer-btn');
    homeSizerBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('satvastones:open_ring_sizer'));
    });
  </script>

  <!-- Section 7: Customer Reviews & Social UGC -->
  <Reviews />

  <!-- Section 7.5: SEO Authority & Knowledge Foundation -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 border-t border-gray-100 bg-[#fffdfd]/80 rounded-[28px] my-6">
    <div class="max-w-4xl mx-auto space-y-10">
      
      <!-- Main SEO Header -->
      <div class="text-center space-y-2">
        <span class="inline-block bg-[#ffe7e9] text-[#a1505a] text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full">
          The SatvaStones Standard
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gray-900 tracking-tight">
          India's Destination for Anti Tarnish Jewellery
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 max-w-2xl mx-auto leading-relaxed">
          Discover why thousands of modern Indian women choose Satvastones for tarnish free jewellery that withstands daily showers, gym sweat, and humid monsoon weather.
        </p>
      </div>

      <!-- 2-Column SEO Content Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-gray-600 leading-relaxed">
        
        <!-- Card 1: Waterproof & Tarnish Free Daily Wear -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200/80 shadow-2xs space-y-3">
          <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#f2707f]"></span>
            <span>Waterproof and Tarnish Free Jewellery for Daily Use</span>
