---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import HeroVideo from '../components/HeroVideo.astro';
import CraftScene from '../components/CraftScene.astro';
import { PRODUCTS } from '../data/products';
import { CATEGORIES } from '../data/categories';

const bestsellers = [
  ...PRODUCTS.filter((product) => product.isBestseller),
  ...PRODUCTS.filter((product) => !product.isBestseller)
].slice(0, 4);

const featuredCategories = ['necklaces', 'rings', 'earrings', 'bracelets', 'bangles']
  .map((slug) => CATEGORIES.find((category) => category.slug === slug))
  .filter((category) => category !== undefined);

const upgradeImage = (url: string, width = 800) =>
  url.replace(/w=\d+/, `w=${width}`).replace(/q=\d+/, 'q=80');

const stackImages = [
  {
    src: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=700&q=80&fm=webp',
    alt: 'Sculptural gold ring from the Satvastones atelier'
  },
  {
    src: 'https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=700&q=80&fm=webp',
    alt: 'Pair of gold huggie hoop earrings'
  },
  {
    src: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=700&q=80&fm=webp',
    alt: 'Pearl and gold jewellery styling detail'
  }
];

const FAQS = [
  {
    q: 'Will Satvastones jewellery really never turn my skin green or black?',
    a: 'Yes. Traditional fashion jewellery turns skin green because brass and copper alloys react with sweat. Satvastones uses hypoallergenic 316L medical stainless steel with a molecular 18K vacuum gold PVD coating — nickel-free, lead-free and biologically inert.'
  },
  {
    q: 'Can I wear it in the shower, gym or swimming pool?',
    a: 'Yes. Every piece is engineered for everyday Indian living: hot showers, gym sweat and monsoon humidity are all fine. After a chlorinated pool or the sea, simply rinse with fresh water and pat dry.'
  },
  {
    q: 'How fast is delivery, and does Cash on Delivery work?',
    a: 'Orders are hand-inspected and dispatched from our Vapi atelier within 24–48 hours via express air couriers. Delivery usually takes 2–4 business days. We accept secure online payment via Razorpay and Cash on Delivery with a nominal ₹25 handling fee.'
  },
  {
    q: 'What if my ring or bracelet size is not right?',
    a: 'Use our interactive on-screen ring sizer before ordering. If your size is still off, we offer a hassle-free 7-day size exchange — message the concierge on WhatsApp at +91 90167 03180 and we will arrange it.'
  },
  {
    q: 'Is Satvastones an affordable anti-tarnish jewellery brand in India?',
    a: 'Yes. Satvastones offers direct-to-consumer, affordable anti-tarnish and waterproof jewellery for women starting from ₹179, with 15% automatic bundle savings in Stack Studio and free pan-India shipping above ₹499. Unlike cheap brass imitation jewellery that loses color in weeks, our 316L stainless steel with 18K gold vacuum PVD stays lustrous for years.'
  },
  {
    q: 'Where is Satvastones located in Vapi, and do you deliver across India?',
    a: 'Our design and dispatch atelier is in Chala, Vapi, Gujarat (396191). Customers in Vapi, Daman, Silvassa, Valsad, and Surat receive express local delivery, and we ship pan-India across 19,000+ pincodes within 2–4 business days.'
  },
  {
    q: 'Is this a registered brand with official GST invoices?',
    a: 'Yes. Satvastones operates under proprietor Anirudh A Verma (GSTIN: 24DDAPV4074H1ZF). Every order includes an official GST tax invoice under HSN 7117 with the applicable 3% GST declared.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<BaseLayout
  title="Satvastones — Affordable Anti-Tarnish & Waterproof Jewellery for Women (From ₹179)"
  description="Shop affordable anti-tarnish & waterproof jewellery for women in India from ₹179. Minimal 18K gold plated rings, nickel-free Korean earrings, bracelets & gifts for girlfriend under ₹500. Vapi, Gujarat atelier · Free shipping above ₹499."
  schema={[faqSchema]}
>
  <HeroVideo />

  <!-- Trust marquee -->
  <div class="marquee overflow-hidden border-b border-[#14110f]/10 bg-[#f4efe7] py-4 text-[#3b3631] sm:py-5" aria-hidden="true">
    <div class="marquee-track items-center">
      {[0, 1].map(() => (
        <div class="flex items-center gap-8 pr-8 text-[9px] uppercase tracking-[0.24em] sm:gap-12 sm:pr-12 sm:text-[10px]">
          <span>18K gold PVD</span>
          <span class="text-[#c5a059]">✦</span>
          <span>316L surgical steel</span>
          <span class="text-[#c5a059]">✦</span>
          <span>100% waterproof</span>
          <span class="text-[#c5a059]">✦</span>
          <span>Nickel-free</span>
          <span class="text-[#c5a059]">✦</span>
          <span>24–48h dispatch</span>
          <span class="text-[#c5a059]">✦</span>
          <span>Free shipping above ₹499</span>
          <span class="text-[#c5a059]">✦</span>
          <span>7-day size exchange</span>
          <span class="text-[#c5a059]">✦</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Editorial statement -->
  <section id="story" class="bg-[#f4efe7] pb-20 pt-16 sm:pb-28 sm:pt-24 lg:pt-28">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
      <div class="grid items-start gap-8 lg:grid-cols-12">
        <p class="eyebrow text-[#8b837a] lg:col-span-3" data-reveal>The Satvastones standard</p>
        <div class="lg:col-span-8">
          <h2 class="max-w-3xl font-display text-[2.15rem] leading-[1.04] text-[#14110f] sm:text-5xl lg:text-[4rem]" data-split>
            Jewellery you never have to take off.
          </h2>
        </div>
      </div>

      <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-12">
        <div class="max-w-lg space-y-4 text-sm leading-relaxed text-[#5a524a] lg:col-start-4 lg:col-span-5" data-reveal>
          <p data-speakable>
            Satvastones crafts affordable waterproof and anti-tarnish everyday jewellery in 316L surgical stainless steel with molecular 18K gold PVD — starting at ₹179. No plating that flakes, no green wrists, and no taking it off before a shower.
          </p>
          <p>
            Designed in India, hand-inspected in Vapi, and made to be worn through real life — work, workouts, weddings and everything after.
          </p>
          <a href="/materials" class="link-line pt-2 text-[10px] uppercase tracking-[0.2em] text-[#14110f]">
            How we make it
          </a>
        </div>

        <dl class="grid grid-cols-3 gap-6 border-t border-[#14110f]/10 pt-6 lg:col-span-3 lg:ml-auto lg:grid-cols-1 lg:border-t-0 lg:pt-0" data-reveal style="--reveal-delay: 120ms">
          <div>
            <dt class="text-[9px] uppercase tracking-[0.2em] text-[#8b837a]">The finish</dt>
            <dd class="mt-1.5 font-serif text-lg text-[#14110f]">18K gold PVD</dd>
          </div>
          <div>
            <dt class="text-[9px] uppercase tracking-[0.2em] text-[#8b837a]">The promise</dt>
            <dd class="mt-1.5 font-serif text-lg text-[#14110f]">Waterproof</dd>
          </div>
          <div>
            <dt class="text-[9px] uppercase tracking-[0.2em] text-[#8b837a]">The atelier</dt>
            <dd class="mt-1.5 font-serif text-lg text-[#14110f]">Vapi, India</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Category index -->
  <section class="paper border-y border-[#e8e1d6] bg-[#fcfbf9] py-20 sm:py-28">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
      <div class="flex items-end justify-between gap-6 border-b border-[#14110f]/10 pb-6" data-reveal>
        <div>
          <p class="eyebrow text-[#8b837a]">Shop by form</p>
          <h2 class="mt-3 font-display text-3xl text-[#14110f] sm:text-5xl">Find your everyday.</h2>
        </div>
        <a href="/shop" class="link-line hidden shrink-0 text-[10px] uppercase tracking-[0.2em] text-[#14110f] sm:inline-flex">
          All jewellery
        </a>
      </div>

      <div class="mt-8 grid snap-x snap-mandatory auto-cols-[72%] grid-flow-col gap-3 overflow-x-auto pb-2 [scrollbar-width:none] sm:auto-cols-[38%] sm:gap-4 lg:grid-flow-row lg:auto-cols-auto lg:grid-cols-5 lg:overflow-visible lg:pb-0">
        {featuredCategories.map((category, index) => (
          <a
            href={`/collections/${category.slug}`}
            class="group snap-start"
            data-reveal
            style={`--reveal-delay:${index * 80}ms`}
          >
            <div class="relative aspect-[3/4] overflow-hidden bg-[#ebe4d8]">
              <img
                src={upgradeImage(category.image, 700)}
                alt={`${category.name} — ${category.tagline}`}
                width="700"
                height="933"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
              />
              <span class="absolute bottom-3 left-3 flex h-8 w-8 items-center justify-center rounded-full bg-[#f6f1e8]/90 text-[#14110f] backdrop-blur-sm transition-transform duration-500 group-hover:-translate-y-1">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
            <div class="mt-3.5 flex items-baseline justify-between gap-2">
              <span class="font-serif text-base text-[#14110f] sm:text-lg">{category.name}</span>
              <span class="text-[9px] uppercase tracking-[0.16em] text-[#8b837a]">{category.itemCount} pieces</span>
            </div>
          </a>
        ))}
      </div>

      <a href="/shop" class="link-line mt-8 inline-flex text-[10px] uppercase tracking-[0.2em] text-[#14110f] sm:hidden">
        All jewellery
      </a>

      <!-- Curated SEO & High-Intent Edits -->
      <div class="mt-10 grid grid-cols-2 gap-3 border-t border-[#14110f]/10 pt-8 lg:grid-cols-4" data-reveal>
        <a href="/collections/rings-under-100" class="group border border-[#e5ded3] bg-[#fbf9f5] p-4 transition-colors hover:border-[#c5a059]">
          <p class="text-[9px] uppercase tracking-[0.18em] text-[#8d3f3d]">Budget Edit</p>
          <p class="mt-1 font-serif text-base text-[#14110f] group-hover:text-[#8d3f3d]">Rings Under ₹100 →</p>
        </a>
        <a href="/collections/gifts-for-girlfriend-under-500" class="group border border-[#e5ded3] bg-[#fbf9f5] p-4 transition-colors hover:border-[#c5a059]">
          <p class="text-[9px] uppercase tracking-[0.18em] text-[#8d3f3d]">Gifting</p>
          <p class="mt-1 font-serif text-base text-[#14110f] group-hover:text-[#8d3f3d]">Gifts for Girlfriend Under ₹500 →</p>
        </a>
        <a href="/collections/anti-tarnish-minimal-rings" class="group border border-[#e5ded3] bg-[#fbf9f5] p-4 transition-colors hover:border-[#c5a059]">
          <p class="text-[9px] uppercase tracking-[0.18em] text-[#8d3f3d]">18K Gold PVD</p>
          <p class="mt-1 font-serif text-base text-[#14110f] group-hover:text-[#8d3f3d]">Anti-Tarnish Minimal Rings →</p>
        </a>
        <a href="/collections/mystery-jewellery-jar" class="group border border-[#e5ded3] bg-[#fbf9f5] p-4 transition-colors hover:border-[#c5a059]">
          <p class="text-[9px] uppercase tracking-[0.18em] text-[#8d3f3d]">Viral Unboxing</p>
          <p class="mt-1 font-serif text-base text-[#14110f] group-hover:text-[#8d3f3d]">Mystery Jewellery Jar →</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Bestsellers -->
  <section class="bg-[#f8f4ed] py-20 sm:py-28">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow text-[#8b837a]">Most loved</p>
          <h2 class="mt-3 max-w-xl font-display text-3xl text-[#14110f] sm:text-5xl">The pieces you keep coming back to.</h2>
        </div>
        <a href="/collections/bestsellers" class="link-line hidden shrink-0 text-[10px] uppercase tracking-[0.2em] text-[#14110f] md:inline-flex">
          Shop all bestsellers
        </a>
      </div>

      <div
        class="mt-10 grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 lg:grid-cols-4 lg:gap-x-6"
        data-catalog-grid="bestsellers"
        data-catalog-limit="8"
      >
        {bestsellers.map((product, index) => (
          <div data-reveal style={`--reveal-delay:${(index % 4) * 70}ms`}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <div class="mt-10 flex justify-center md:hidden">
        <a href="/collections/bestsellers" class="link-line text-[10px] uppercase tracking-[0.2em] text-[#14110f]">
          Shop all bestsellers
        </a>
      </div>
    </div>
  </section>

  <!-- Lifestyle split -->
  <section class="bg-[#f4efe7]">
    <div class="grid lg:grid-cols-12">
      <div class="relative min-h-[62svh] overflow-hidden bg-[#e6ded1] lg:col-span-7 lg:min-h-[46rem]">
        <img
          src="https://images.unsplash.com/photo-1611085583191-a3b181a88401?auto=format&fit=crop&w=1400&q=80&fm=webp"
          alt="Gold jewellery worn every day, styled against warm skin"
          width="1400"
          height="1750"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          data-parallax
        />
        <div class="grain absolute inset-0" aria-hidden="true"></div>
      </div>

      <div class="flex flex-col justify-center px-5 py-16 sm:px-10 sm:py-20 lg:col-span-5 lg:px-14 lg:py-24 xl:px-20">
        <p class="eyebrow text-[#8b837a]" data-reveal>The everyday promise</p>
        <h2 class="mt-5 font-display text-[2.6rem] leading-[0.98] text-[#14110f] sm:text-5xl lg:text-6xl" data-split>
          Shower. Sweat. Repeat.
        </h2>
        <p class="mt-6 max-w-md text-sm leading-relaxed text-[#5a524a]" data-reveal>
          Our 18K vacuum gold PVD is bonded at a molecular level, not painted on. It is made for Indian humidity, long workdays and spontaneous plans.
        </p>

        <ul class="mt-8 max-w-md space-y-3 border-t border-[#14110f]/10 pt-6 text-sm text-[#3b3631]" data-reveal style="--reveal-delay: 100ms">
          <li class="flex items-start gap-3">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[#c5a059]"></span>
            <span>Waterproof, not just water-resistant.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[#c5a059]"></span>
            <span>Nickel-free 316L steel for sensitive skin.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[#c5a059]"></span>
            <span>Hand-inspected and sealed in Vapi, Gujarat.</span>
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4" data-reveal style="--reveal-delay: 160ms">
          <a href="/collections/necklaces" class="link-line text-[10px] uppercase tracking-[0.2em] text-[#14110f]">
            Shop waterproof icons
          </a>
          <a href="/jewellery-care" class="link-line text-[10px] uppercase tracking-[0.2em] text-[#8b837a]">
            The care guide
          </a>
        </div>
      </div>
    </div>
  </section>

  <CraftScene />

  <!-- Stack Studio -->
  <section class="overflow-hidden bg-[#ebe4d8]">
    <div class="mx-auto grid max-w-[1440px] items-center gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:gap-16 lg:px-10">
      <div data-reveal>
        <p class="eyebrow text-[#8b837a]">The Stack Studio</p>
        <h2 class="mt-4 max-w-lg font-display text-[2.6rem] leading-[0.98] text-[#14110f] sm:text-5xl lg:text-6xl" data-split>
          Build a stack that's yours.
        </h2>
        <p class="mt-6 max-w-md text-sm leading-relaxed text-[#5a524a]">
          Pick a chain, a ring and a pair of huggies. Your edit saves 15% automatically and arrives gift-boxed — no code needed.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/stack-builder" class="group inline-flex items-center gap-3 bg-[#14110f] px-6 py-3.5 text-[10px] uppercase tracking-[0.2em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]">
            <span>Open Stack Studio</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <button
            id="home-open-ring-sizer-btn"
            type="button"
            class="link-line cursor-pointer text-[10px] uppercase tracking-[0.2em] text-[#14110f]"
          >
            Find your ring size
          </button>
        </div>
      </div>

      <div class="grid grid-cols-3 items-end gap-2.5 sm:gap-3" data-reveal style="--reveal-delay: 120ms">
        {stackImages.map((image, index) => (
          <div
            class:list={[
              'relative overflow-hidden bg-[#d9cfbf]',
              index === 0 ? 'aspect-[3/4]' : '',
              index === 1 ? 'aspect-[3/4] -translate-y-6 sm:-translate-y-8' : '',
              index === 2 ? 'aspect-square translate-y-2' : ''
            ]}
          >
            <img
              src={image.src}
              alt={image.alt}
              width="700"
              height="900"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-[1.04]"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-[#14110f]/10 bg-[#fcfbf9] py-20 sm:py-28">
    <div class="mx-auto grid max-w-[1440px] gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:px-10">
      <div class="lg:col-span-4">
        <p class="eyebrow text-[#8b837a]" data-reveal>Good to know</p>
        <h2 class="mt-4 font-display text-3xl text-[#14110f] sm:text-5xl" data-split>Questions, answered.</h2>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-[#5a524a]" data-reveal>
          Still unsure about sizing, delivery or care? Our Vapi concierge is on WhatsApp daily, 10am–8pm IST.
        </p>
        <a
          href="https://wa.me/919016703180?text=Hi%20Satvastones,%20I%20have%20a%20question%20about%20your%20jewellery"
          target="_blank"
          rel="noopener noreferrer"
          class="link-line mt-6 text-[10px] uppercase tracking-[0.2em] text-[#14110f]"
          data-reveal
        >
          WhatsApp the atelier
        </a>
      </div>

      <div class="lg:col-span-8" data-reveal>
        <div class="border-t border-[#14110f]/10">
          {FAQS.map((faq) => (
            <details class="group border-b border-[#14110f]/10 py-5 sm:py-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
                <span class="font-serif text-lg leading-snug text-[#14110f] sm:text-2xl">{faq.q}</span>
                <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#14110f]/20 text-[#14110f] transition-transform duration-300 group-open:rotate-45">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </span>
              </summary>
              <p class="max-w-2xl pt-4 text-sm leading-relaxed text-[#5a524a]">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Condensed SEO / materials copy -->
  <section class="border-t border-[#e3dcd1] bg-[#f4efe7] py-16 sm:py-24">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
      <div class="grid gap-8 border-t border-[#14110f]/10 pt-10 lg:grid-cols-3 lg:gap-12" data-reveal>
        <div>
          <h3 class="text-[10px] uppercase tracking-[0.2em] text-[#8b837a]">Waterproof, no-color-fade gold</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#5a524a]">
            Our <a href="/affordable-anti-tarnish-jewellery-india" class="underline decoration-[#c5a059]/50 underline-offset-4 hover:decoration-[#14110f]">affordable anti-tarnish jewellery in India</a> uses 316L surgical stainless steel and 18K vacuum gold PVD — waterproof, non-tarnish rings, bracelets, and chains for women that survive showers, sweat, and monsoon humidity without losing color.
          </p>
        </div>
        <div>
          <h3 class="text-[10px] uppercase tracking-[0.2em] text-[#8b837a]">Made for Indian skin</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#5a524a]">
            Every piece is nickel-free and hypoallergenic — kind to sensitive ears and wrists. Build a complete look with a matching <a href="/collections/jewellery-set" class="underline decoration-[#c5a059]/50 underline-offset-4 hover:decoration-[#14110f]">anti-tarnish jewellery set</a>, or layer our <a href="/collections/rings" class="underline decoration-[#c5a059]/50 underline-offset-4 hover:decoration-[#14110f]">18K gold plated rings</a> and <a href="/collections/bracelets" class="underline decoration-[#c5a059]/50 underline-offset-4 hover:decoration-[#14110f]">waterproof bracelets</a>.
          </p>
        </div>
        <div>
          <h3 class="text-[10px] uppercase tracking-[0.2em] text-[#8b837a]">Vapi atelier, pan-India delivery</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#5a524a]">
