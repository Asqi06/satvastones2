---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Reviews from '../components/Reviews.astro';
import Newsletter from '../components/Newsletter.astro';
import HomeCuratedTabs from '../components/HomeCuratedTabs';
import AntiTarnishProof from '../components/AntiTarnishProof.astro';
import HomeFAQAccordion from '../components/HomeFAQAccordion';
import { PRODUCTS } from '../data/products';
import { CATEGORIES } from '../data/categories';
---

<BaseLayout
  title="Satvastones – Anti Tarnish Jewellery Online India"
  description="Shop waterproof anti tarnish jewellery in India from ₹499. Everyday 18K gold PVD & 316L steel necklaces, rings, sets. Free PAN-India delivery & 7-day returns."
>
  <!-- Section 1: Jewelsmars-Style Category Story Squircles Strip (Mobile-First) -->
  <section class="py-4 sm:py-6 bg-white border-b border-[#f0f0f0]">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto pb-2 scrollbar-none justify-start sm:justify-center">
        {CATEGORIES.map((cat) => (
          <a
            href={`/collections/${cat.slug}`}
            class="group flex flex-col items-center shrink-0 w-20 sm:w-24"
            data-category-slug={cat.slug}
          >
            <!-- Squircle Bubble with Soft Blush Tint (#ffe7e9) -->
            <div class="w-18 h-18 sm:w-22 sm:h-22 rounded-[20px] bg-[#faf4f2] p-1.5 border border-[#eae4dc] group-hover:border-[#c5a059] transition-all duration-300 shadow-2xs flex items-center justify-center overflow-hidden">
              <img
                src={cat.image}
                alt={`${cat.name} Collection`}
                width="88"
                height="88"
                loading="eager"
                decoding="async"
                class="category-squircle-img w-full h-full object-cover rounded-[16px] group-hover:scale-108 transition-transform duration-300"
              />
            </div>
            <span class="category-squircle-name mt-2 text-xs font-medium text-[#171513] group-hover:text-[#9f4553] transition-colors text-center tracking-tight truncate max-w-full">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Jewelsmars Full-Width Editorial Hero Banner -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <div class="relative min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[22px] overflow-hidden flex items-center bg-[#fafafa] shadow-sm">
      <img
        id="hero-banner-img"
        src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1200&fm=webp&q=80"
        srcset="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=640&fm=webp&q=80 640w, https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1024&fm=webp&q=80 1024w, https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1440&fm=webp&q=80 1440w"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 1440px"
        alt="Satvastones Fine Anti-Tarnish Jewellery Editorial Collection"
        width="1440"
        height="580"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <!-- Soft Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/45 to-transparent sm:w-2/3"></div>

      <!-- Hero Content -->
      <div class="relative z-10 p-6 sm:p-12 lg:p-16 max-w-xl space-y-4 text-white">
        <span class="shimmer-badge inline-flex items-center gap-2 bg-black/45 backdrop-blur-md border border-white/20 text-white/95 text-[10px] font-bold uppercase tracking-[0.14em] px-3.5 py-1.5 rounded-full shadow-md">
          <span class="text-[#c5a059]">✦</span>
          <span>100% Anti-Tarnish · 18K Gold PVD</span>
        </span>

        <h1 id="hero-banner-heading" class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal tracking-tight leading-[1.12]">
          Anti-Tarnish Fine Jewellery That Feels Like <span class="italic font-normal text-[#f4dcd9]">You.</span>
        </h1>

        <p id="hero-banner-tagline" class="text-xs sm:text-sm text-white/85 leading-relaxed font-normal max-w-md">
          Crafted with 316L surgical stainless steel & authentic 18K vacuum gold PVD. Water, sweat, and perfume resistant. Hand-inspected and dispatched from our Vapi atelier in 24–48 hours.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="/shop"
            class="bg-white hover:bg-[#faf6f0] text-[#171513] px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-[0.12em] transition-all shadow-md hover:shadow-lg inline-block text-center hover:scale-[1.02] active:scale-[0.98]"
          >
            EXPLORE ATELIER
          </a>
          <a
            href="/collections/bestsellers"
            class="bg-black/30 hover:bg-white/15 text-white border border-white/35 hover:border-white px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-[0.12em] transition-all inline-block text-center backdrop-blur-xs hover:scale-[1.02] active:scale-[0.98]"
          >
            BESTSELLER SUITES
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Atelier Hallmark & Quality Assurance Suite -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-5" aria-label="Satvastones Atelier Hallmarks">
    <div class="relative bg-gradient-to-b from-white via-[#fcfbf9] to-[#f8f5ee] border border-[#e5ded3] rounded-[22px] sm:rounded-[26px] p-4 sm:p-6 lg:p-7 shadow-[0_12px_36px_-10px_rgba(23,21,19,0.06),0_2px_8px_rgba(23,21,19,0.02)] overflow-hidden">
      <!-- Ambient Atelier Glow -->
      <div class="absolute -right-12 -top-12 w-48 h-48 bg-[#c5a059]/5 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -left-12 -bottom-12 w-48 h-48 bg-[#9f4553]/5 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 divide-y sm:divide-y-0 lg:divide-x divide-[#ece5db]">
        
        <!-- Pillar 1: Waterproof -->
        <div class="group flex items-start gap-3.5 pt-3 first:pt-0 sm:pt-0 lg:px-4 first:lg:pl-0">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#f8f3ec] via-[#f1e6d7] to-[#e4d4bf] border border-[#d8c8b4] shadow-[inset_0_1px_1px_rgba(255,255,255,0.9),0_4px_12px_rgba(23,21,19,0.05)] flex items-center justify-center text-[#844c20] shrink-0 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25c-3.75 4.5-6.75 8.25-6.75 12a6.75 6.75 0 0013.5 0c0-3.75-3-7.5-6.75-12z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0l1.5-1.5M12 12l-1.5-1.5" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-[0.16em] text-[#9f4553]">
              <span class="text-[#c5a059]">✦</span> 18K VACUUM GOLD PVD
            </span>
            <h3 class="font-serif text-base sm:text-lg font-bold text-[#171513] tracking-tight mt-0.5">
              100% Waterproof
            </h3>
            <p class="text-xs text-[#5e5750] leading-snug mt-1">
              Shower, sweat & perfume proof. Never turns black or peels.
            </p>
            <span class="inline-flex items-center gap-1 mt-2 text-[10px] font-semibold text-[#844c20] bg-[#f7f0e5] px-2.5 py-0.5 rounded-full border border-[#e6d8c4]">
              365-Day Shine Guarantee
            </span>
          </div>
        </div>

        <!-- Pillar 2: Complimentary Air Express -->
        <div class="group flex items-start gap-3.5 pt-3 sm:pt-0 lg:px-4">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#f8f3ec] via-[#f1e6d7] to-[#e4d4bf] border border-[#d8c8b4] shadow-[inset_0_1px_1px_rgba(255,255,255,0.9),0_4px_12px_rgba(23,21,19,0.05)] flex items-center justify-center text-[#844c20] shrink-0 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-[0.16em] text-[#9f4553]">
              <span class="text-[#c5a059]">✦</span> PAN-INDIA AIR EXPRESS
            </span>
            <h3 class="font-serif text-base sm:text-lg font-bold text-[#171513] tracking-tight mt-0.5">
              Complimentary Delivery
            </h3>
            <p class="text-xs text-[#5e5750] leading-snug mt-1">
              Free express priority delivery on all orders above ₹499.
            </p>
            <span class="inline-flex items-center gap-1 mt-2 text-[10px] font-semibold text-[#844c20] bg-[#f7f0e5] px-2.5 py-0.5 rounded-full border border-[#e6d8c4]">
              BlueDart &amp; Delhivery Priority
            </span>
          </div>
        </div>

        <!-- Pillar 3: Vapi Atelier Dispatch -->
        <div class="group flex items-start gap-3.5 pt-3 sm:pt-0 lg:px-4">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#f8f3ec] via-[#f1e6d7] to-[#e4d4bf] border border-[#d8c8b4] shadow-[inset_0_1px_1px_rgba(255,255,255,0.9),0_4px_12px_rgba(23,21,19,0.05)] flex items-center justify-center text-[#844c20] shrink-0 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-[0.16em] text-[#9f4553]">
              <span class="text-[#c5a059]">✦</span> DIRECT GUJARAT ATELIER
            </span>
            <h3 class="font-serif text-base sm:text-lg font-bold text-[#171513] tracking-tight mt-0.5">
              Dispatched in 24–48h
            </h3>
            <p class="text-xs text-[#5e5750] leading-snug mt-1">
              Hand-inspected, ultrasonic-cleaned & sealed in Vapi, Gujarat.
            </p>
            <span class="inline-flex items-center gap-1 mt-2 text-[10px] font-semibold text-[#844c20] bg-[#f7f0e5] px-2.5 py-0.5 rounded-full border border-[#e6d8c4]">
              Signature Velvet Pouch Box
            </span>
          </div>
        </div>

        <!-- Pillar 4: Zero Green Skin -->
        <div class="group flex items-start gap-3.5 pt-3 sm:pt-0 lg:px-4 last:lg:pr-0">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#f8f3ec] via-[#f1e6d7] to-[#e4d4bf] border border-[#d8c8b4] shadow-[inset_0_1px_1px_rgba(255,255,255,0.9),0_4px_12px_rgba(23,21,19,0.05)] flex items-center justify-center text-[#844c20] shrink-0 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-[0.16em] text-[#9f4553]">
              <span class="text-[#c5a059]">✦</span> 316L SURGICAL STEEL
            </span>
            <h3 class="font-serif text-base sm:text-lg font-bold text-[#171513] tracking-tight mt-0.5">
              Zero Green Skin
            </h3>
            <p class="text-xs text-[#5e5750] leading-snug mt-1">
              Pure hypoallergenic core. 100% nickel, cadmium & lead-free.
            </p>
            <span class="inline-flex items-center gap-1 mt-2 text-[10px] font-semibold text-[#844c20] bg-[#f7f0e5] px-2.5 py-0.5 rounded-full border border-[#e6d8c4]">
              Dermatologically Tested
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 4: Interactive Curated Discovery Tabs (Zero-Reload Surfing) -->
  <HomeCuratedTabs client:idle />

  <!-- Section 5: Jewelsmars Dual Aesthetic Promo Banners -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <!-- Card 1 -->
      <div class="relative h-72 sm:h-84 rounded-[22px] overflow-hidden bg-gray-100 group shadow-xs">
        <img
          src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1000&q=80"
          alt="Molten Baroque Pearl Collection"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-6 sm:p-8 flex flex-col justify-end text-white">
          <span class="text-[10px] font-bold text-[#c5a059] uppercase tracking-[0.16em]">
            FEATURED CAPSULE
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-normal mt-1">Coastal Molten Baroque Suite</h3>
          <p class="text-xs text-white/85 mt-1 max-w-sm line-clamp-2">
            Natural freshwater pearls sealed in 18K gold PVD bezels. Resistant to humidity and moisture.
          </p>
          <div class="pt-3">
            <a
              href="/collections/necklaces"
              class="inline-block bg-white hover:bg-[#faf6f0] text-[#171513] px-6 py-2.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] transition-all shadow-sm"
            >
              EXPLORE CAPSULE
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="relative h-72 sm:h-84 rounded-[22px] overflow-hidden bg-gray-100 group shadow-xs">
        <img
          src="https://images.unsplash.com/photo-1611591475152-47eac9c5bdfa?auto=format&fit=crop&w=1000&q=80"
          alt="Liquid Gold Chains"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-6 sm:p-8 flex flex-col justify-end text-white">
          <span class="text-[10px] font-bold text-[#c5a059] uppercase tracking-[0.16em]">
            EVERYDAY STACKING
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-normal mt-1">Surgical Steel Liquid Chains</h3>
          <p class="text-xs text-white/85 mt-1 max-w-sm line-clamp-2">
            No green marks, no flaking. Wear it 24/7 without taking it off.
          </p>
          <div class="pt-3">
            <a
              href="/collections/bracelets"
              class="inline-block bg-white hover:bg-[#faf6f0] text-[#171513] px-6 py-2.5 rounded-full text-xs font-bold uppercase tracking-[0.1em] transition-all shadow-sm"
            >
              SHOP CHAINS
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6.5: Interactive Features Exclusive to SatvaStones (Stack Studio & Ring Sizer) -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="bg-gradient-to-br from-[#faf8f5] to-[#f4eee6]/80 border border-[#eae4dc] rounded-[24px] p-6 sm:p-10 shadow-2xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.14em] text-[#9f4553] bg-white px-3.5 py-1 rounded-full border border-[#eae4dc]">
            <span class="text-[#c5a059]">✦</span>
            <span>EXCLUSIVE SATVASTONES ATELIER</span>
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#171513] tracking-tight leading-tight">
            Curate Your Signature Stack & Save 15%
          </h2>
          <p class="text-xs sm:text-sm text-[#6e6863] leading-relaxed">
            Pair your favourite liquid chain, everyday signet ring, and waterproof huggies in our interactive Mix & Match Studio. Automatic 15% bundle discount applied with complimentary luxury gift packaging.
          </p>
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="/stack-builder"
              class="bg-[#171513] hover:bg-[#9f4553] text-white px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-[0.08em] shadow-sm transition-all"
            >
              Open Stack Studio →
            </a>
            <button
              id="home-open-ring-sizer-btn"
              type="button"
              class="bg-white hover:bg-[#faf8f5] text-[#171513] border border-[#eae4dc] px-5 py-3 rounded-xl text-xs font-semibold uppercase tracking-[0.08em] transition-colors cursor-pointer flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 text-[#9f4553]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m-3-3h6" />
              </svg>
              <span>Try Ring Sizer</span>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white/90 p-4 rounded-2xl border border-[#eae4dc] shadow-2xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-[#faf4f2] border border-[#eae4dc] flex items-center justify-center text-[#9f4553]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
            </div>
            <h4 class="font-bold text-xs text-[#171513]">Screen Ring Placement</h4>
            <p class="text-[11px] text-[#6e6863]">Match your existing ring against your phone screen for instant Indian size.</p>
          </div>
          <div class="bg-white/90 p-4 rounded-2xl border border-[#eae4dc] shadow-2xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-[#faf4f2] border border-[#eae4dc] flex items-center justify-center text-[#9f4553]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V4.875A1.125 1.125 0 0013.125 3.75H4.5A1.125 1.125 0 003.375 4.875v9.375" />
              </svg>
            </div>
            <h4 class="font-bold text-xs text-[#171513]">24–48h Vapi Dispatch</h4>
            <p class="text-[11px] text-[#6e6863]">Every piece hand-inspected in Gujarat with live courier SMS/WhatsApp tracking.</p>
          </div>
          <div class="bg-white/90 p-4 rounded-2xl border border-[#eae4dc] shadow-2xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-[#faf4f2] border border-[#eae4dc] flex items-center justify-center text-[#9f4553]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
