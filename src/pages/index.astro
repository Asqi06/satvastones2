  <script>
    import { getSiteSettings } from '../stores/adminStore';
    import { optimizeCloudinaryUrl } from '../utils/cloudinary';

    // Client-side rehydration for live admin updates (Categories & Hero)
    try {
      const settings = getSiteSettings();

      // 1. Rehydrate Hero Banner if customized
      if (settings.heroImage) {
        const heroImg = document.getElementById('hero-banner-img') as HTMLImageElement;
        if (heroImg) {
          heroImg.src = optimizeCloudinaryUrl(settings.heroImage, { width: 1920, quality: 'auto', format: 'auto' });
        }
      }
      if (settings.heroHeadline) {
        const heroHeading = document.getElementById('hero-banner-heading');
        if (heroHeading) {
          if (settings.heroHeadline.includes('<span')) {
            heroHeading.innerHTML = settings.heroHeadline;
          } else if (settings.heroHeadline.toLowerCase().endsWith('you.') || settings.heroHeadline.toLowerCase().endsWith('you')) {
            const base = settings.heroHeadline.replace(/you\.?$/i, '').trim();
            heroHeading.innerHTML = `${base} <span class="text-[#f2707f]">you.</span>`;
          } else {
            heroHeading.innerHTML = `${settings.heroHeadline} <span class="text-[#f2707f]">you.</span>`;
          }
        }
      }
      if (settings.heroTagline) {
        const heroTag = document.getElementById('hero-banner-tagline');
        if (heroTag) {
          heroTag.textContent = settings.heroTagline;
        }
      }

      // 2. Rehydrate Category Squircles
      if (settings.categories && settings.categories.length > 0) {
        const categoryMap = new Map(settings.categories.map((c) => [c.slug, c]));
        document.querySelectorAll('[data-category-slug]').forEach((el) => {
          const slug = el.getAttribute('data-category-slug');
          if (!slug) return;
          const catData = categoryMap.get(slug);
          if (catData) {
            const imgEl = el.querySelector('.category-squircle-img') as HTMLImageElement;
            const nameEl = el.querySelector('.category-squircle-name');
            if (imgEl && catData.image) {
              imgEl.src = optimizeCloudinaryUrl(catData.image, { width: 200, height: 200, quality: 'auto', format: 'auto' });
            }
            if (nameEl && catData.name) {
              nameEl.textContent = catData.name;
            }
          }
        });
      }
    } catch (e) {
      console.warn('Live settings rehydration error:', e);
    }
  </script>
