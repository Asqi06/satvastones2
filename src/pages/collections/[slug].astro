---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import { CATEGORIES } from '../../data/categories';
import type { Category, Product } from '../../types/ecommerce';

export function getStaticPaths() {
  const categoryPaths = CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: {
      category: cat,
      products: PRODUCTS.filter((p) => p.category === cat.slug)
    }
  }));

  const bestsellers = {
    params: { slug: 'bestsellers' },
    props: {
      category: {
        id: 'bestsellers',
        name: 'Bestsellers',
        slug: 'bestsellers',
        tagline: 'Most Loved Pieces',
        description: 'Our most coveted anti-tarnish jewellery, adored across thousands of Indian homes for daily wear.',
        image: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80',
        itemCount: PRODUCTS.filter((p) => p.isBestseller).length
      },
      products: PRODUCTS.filter((p) => p.isBestseller)
    }
  };

  const newArrivals = {
    params: { slug: 'new-arrivals' },
    props: {
      category: {
        id: 'new-arrivals',
        name: 'New Arrivals',
        slug: 'new-arrivals',
        tagline: 'Fresh Drops from Atelier',
        description: 'Discover the newest additions to our permanent anti-tarnish collection, hand-inspected in Vapi.',
        image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
        itemCount: PRODUCTS.filter((p) => p.isNewArrival).length
      },
      products: PRODUCTS.filter((p) => p.isNewArrival)
    }
  };

  const seoVirtualCollections = [
    {
      params: { slug: 'rings-under-100' },
      props: {
        category: {
          id: 'rings-under-100',
          name: 'Rings Under ₹100',
          slug: 'rings-under-100',
          tagline: 'Starting ₹49–₹99 · Budget Aesthetic & Anti-Tarnish Rings',
          description:
            'Explore budget aesthetic rings under ₹100 alongside long-lasting waterproof 18K gold plated anti-tarnish rings for women in India. Free shipping above ₹499 & COD available.',
          image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
          itemCount: 0
        },
        products: []
      }
    },
    {
      params: { slug: 'gifts-for-girlfriend-under-500' },
      props: {
        category: {
          id: 'gifts-for-girlfriend-under-500',
          name: 'Gifts for Girlfriend Under ₹500',
          slug: 'gifts-for-girlfriend-under-500',
          tagline: 'Birthday & Anniversary Picks · Starting ₹179',
          description:
            'Shop the best waterproof & anti-tarnish jewellery gifts for your girlfriend under ₹500 — 18K gold plated necklaces, minimal rings, bracelets & nickel-free earrings with fast India delivery and COD.',
          image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80',
          itemCount: 0
        },
        products: []
      }
    },
    {
      params: { slug: 'anti-tarnish-minimal-rings' },
      props: {
        category: {
          id: 'anti-tarnish-minimal-rings',
          name: 'Anti-Tarnish Minimal Rings',
          slug: 'anti-tarnish-minimal-rings',
          tagline: '18K Gold PVD · Waterproof & Nickel-Free',
          description:
            'Minimalist anti-tarnish rings crafted in 316L surgical stainless steel with 18K gold vacuum PVD. Shower-safe, sweat-proof daily rings for women that never turn fingers green.',
          image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
          itemCount: 0
        },
        products: []
      }
    }
  ];

  return [...categoryPaths, bestsellers, newArrivals, ...seoVirtualCollections];
}

interface Props {
  category: Category;
  products: Product[];
}

const { category, products } = Astro.props;

// Keyword-targeted high-CTR SEO titles & meta descriptions (aligned with live Search Console demand)
const seoTitles: Record<string, string> = {
  'rings-under-100': 'Rings Under ₹99 & Budget Anti-Tarnish Rings (Starting ₹49–₹99) | Satvastones',
  'gifts-for-girlfriend-under-500': 'Best Gifts for Girlfriend Under ₹500 — Necklaces, Rings & Earrings | Satvastones',
  'anti-tarnish-minimal-rings': 'Anti-Tarnish Minimal Rings for Women — 18K Gold Plated & Waterproof | Satvastones',
  'mystery-jewellery-jar': 'Mystery Jewellery Jar Online India — Waterproof 18K Gold Pieces | Satvastones',
  'bracelets': 'Waterproof & Anti-Tarnish Bracelets for Women (From ₹179) | Satvastones India',
  'jewellery-set': 'Affordable Anti-Tarnish & Traditional Jewellery Sets Online India | Satvastones',
  'necklaces': 'Waterproof Anti-Tarnish Necklaces, Oval & Clover Pendants India | Satvastones',
  'rings': 'Minimal Anti-Tarnish & 18K Gold Plated Rings for Women Under ₹500 | Satvastones',
  'earrings': 'Nickel-Free & Hypoallergenic Korean Crystal Earrings for Sensitive Ears (From ₹199) | Satvastones',
  'bangles': 'Anti-Tarnish & 18K Gold Plated Kada Bangles for Women (From ₹179) | Satvastones',
  'gift-sets': 'Best Jewellery Gifts for Girlfriend Under ₹500 & Gift Sets India | Satvastones',
  'bestsellers': 'Best Affordable Anti-Tarnish & Waterproof Jewellery Under ₹500 India | Satvastones',
  'new-arrivals': 'New Korean Aesthetic & Waterproof Anti-Tarnish Jewellery India | Satvastones'
};

const seoDescriptions: Record<string, string> = {
  'rings-under-100': 'Looking for aesthetic rings under ₹100 or ₹50? Compare budget rings & shop waterproof 18K gold plated anti-tarnish rings for women in India. Free shipping above ₹499 & COD available.',
  'gifts-for-girlfriend-under-500': 'Shop the best birthday & anniversary gifts for girlfriend under ₹500 in India. 18K gold plated waterproof & anti-tarnish necklaces, minimal rings & earrings from ₹179. Free shipping > ₹499 & COD.',
  'anti-tarnish-minimal-rings': 'Shop anti-tarnish minimal rings for women in India. 18K gold plated 316L surgical steel rings — 100% waterproof, sweat-proof & nickel-free. Free shipping above ₹499 & COD available.',
  'mystery-jewellery-jar': 'Unbox the viral Satvastones Mystery Jewellery Jar in India. Surprise waterproof & anti-tarnish 18K gold plated rings, necklaces & earrings in a keepsake jar. Free shipping & COD available.',
  'bracelets': 'Shop bracelets that don’t tarnish from ₹179. Waterproof 18K gold plated bracelets, daisy cuffs & link chains for women in India. Sweat-proof 316L steel, COD & free delivery above ₹499.',
  'jewellery-set': 'Explore affordable anti-tarnish & traditional Indian jewellery sets for women. Waterproof 18K gold PVD necklaces, bracelets & earrings for sarees, weddings & daily wear.',
  'necklaces': 'Shop waterproof, non-tarnish necklaces for women in India — oval pendants, viral clover chains, herringbone snakes & necklace gifts for girlfriend under ₹500. Free delivery above ₹499.',
  'rings': 'Shop minimal anti-tarnish & budget 18K gold plated rings for women under ₹500. Aesthetic, non-tarnish daisy & dome rings in 316L steel that never turn fingers green. Fast India delivery.',
  'earrings': 'Shop nickel-free & hypoallergenic earrings for sensitive ears in India from ₹199. Korean crystal fringe earrings, floral drop earrings, pavé studs & non-tarnish gold hoops.',
  'bangles': 'Shop waterproof anti-tarnish kada bangles & daisy solitaire cuffs for women from ₹179. 18K gold PVD 316L steel bangles that never lose color in Indian humidity.',
  'gift-sets': 'Find the best birthday & anniversary jewellery gifts for girlfriend under ₹500 in India. Waterproof, anti-tarnish rings, earrings, necklaces & curated gift boxes with fast delivery.',
  'bestsellers': 'Shop India’s most loved affordable anti-tarnish & waterproof jewellery for women starting ₹179. Non-tarnish rings, bracelets, Korean crystal earrings & gift sets.',
  'new-arrivals': 'Explore new Korean aesthetic & waterproof anti-tarnish jewellery drops from ₹179. Hand-inspected and dispatched in 24–48 hours from Vapi, Gujarat across India.'
};

const pageTitle = seoTitles[category.slug] || `Buy ${category.name} Online in India at Best Prices | Satvastones`;
const pageDescription = seoDescriptions[category.slug] || category.description;

const siteUrl = 'https://www.satvastones.in';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: '/shop' },
  { name: category.name, url: `/collections/${category.slug}` }
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': `${category.name} Collection`,
  'description': pageDescription,
  'numberOfItems': products.length,
  'itemListElement': products.map((product, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'url': `${siteUrl}/products/${product.slug}`,
    'name': product.name,
    'image': product.images[0]?.url
  }))
};

const defaultLowPrice =
  category.slug === 'rings-under-100'
    ? '99'
    : category.slug === 'gifts-for-girlfriend-under-500'
      ? '179'
      : '179';
const defaultHighPrice =
  category.slug === 'gifts-for-girlfriend-under-500' ? '499' : '2499';

const aggregateOfferSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Satvastones ${category.name}`,
  description: pageDescription,
  image: [category.image],
  brand: {
    '@type': 'Brand',
    name: 'Satvastones Jewellery'
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'INR',
    lowPrice: defaultLowPrice,
    highPrice: defaultHighPrice,
    offerCount: Math.max(1, products.length),
    availability: 'https://schema.org/InStock',
    url: `${siteUrl}/collections/${category.slug}`
  }
};

const collectionBuyingGuides: Record<string, string[]> = {
  'rings-under-100': [
    'Searching for aesthetic rings under ₹100 or ₹50 in India usually leads to street-market brass or zinc alloy bands that look shiny on day one and turn your finger green within a week of handwashing, sanitizer, or monsoon humidity. If you buy five ₹80 fashion rings in a year, you still spend ₹400 while dealing with skin irritation and peeling color.',
    'At Satvastones, we design affordable everyday jewellery for women that bridges budget pricing with real longevity. Our waterproof, anti-tarnish collection uses medical-grade 316L surgical stainless steel bonded with 18K gold vacuum PVD—so whether you pick a budget ring, an everyday daisy cuff, or a minimal band, it stays sweat-proof, shower-safe, and nickel-free.',
    'Every order is hand-inspected at our Vapi, Gujarat atelier and dispatched within 24–48 hours across 19,000+ Indian pin codes with Cash on Delivery and free express shipping above ₹499. Combine 2+ pieces in Stack Studio to unlock an automatic 15% discount and bring your per-piece cost even lower.'
  ],
  'gifts-for-girlfriend-under-500': [
    'Finding the best birthday or anniversary gift for your girlfriend under ₹500 in India does not have to mean settling for generic keychains or imitation jewellery that blackens in two weeks. Everyday waterproof jewellery is personal, wearable from college to office to festive dinners, and reminds her of you every single day.',
    'Satvastones curates waterproof 18K gold plated gifts under ₹500—including Korean crystal fringe earrings, floral drop studs, daisy solitaire cuffs, minimal anti-tarnish rings, and delicate necklace gifts for girlfriends. Every piece is built on hypoallergenic, nickel-free 316L surgical stainless steel so it is completely safe for sensitive ears and skin.',
    'Want to elevate your gift? Pair any two pieces under ₹500 in our Stack Studio for an automatic 15% bundle discount plus free pan-India express shipping above ₹499. Every parcel is hand-inspected in Vapi, Gujarat, dispatched in 24–48 hours, and available with both UPI and Cash on Delivery.'
  ],
  'anti-tarnish-minimal-rings': [
    'Minimalist gold rings take more daily abuse than any other piece of jewellery—constant handwashing, soap, alcohol sanitizers, desk friction, and Indian summer sweat quickly strip conventional flash-plated brass rings down to dull copper.',
    'Satvastones anti-tarnish minimal rings for women are engineered specifically for continuous, 24/7 Indian wear. Beneath the warm 18K gold vacuum PVD plasma finish sits solid 316L surgical stainless steel—the same corrosion-resistant, biocompatible alloy used in medical implants. Because PVD bonds gold at the atomic level inside a vacuum chamber, it is roughly 10 times more durable than standard electroplating and never leaves green marks on your fingers.',
    'Style a single sleek band for office wear, stack sculpted dome and solitaire rings for weekends, or pair them with our waterproof bracelets and necklaces. Use our built-in Ring Size Finder before ordering, enjoy 7-day easy size exchanges, Cash on Delivery, and free pan-India shipping above ₹499.'
  ],
  'mystery-jewellery-jar': [
    'The Satvastones Mystery Jewellery Jar brings the thrill of luxury unboxing to everyday waterproof jewellery in India. Instead of cheap novelty trinkets that tarnish after one outing, every surprise piece inside our keepsake jar is crafted from genuine 316L surgical stainless steel with 18K gold vacuum PVD coating.',
    'Designed for birthdays, bridesmaid hampers, college gifting, and self-care treats, each mystery box experience delivers curated everyday staples—a mix of waterproof necklaces, minimal rings, hypoallergenic earrings, or stackable bracelets—that pair effortlessly with both western outfits and Indian festive sarees.',
    'Every jar is hand-packed, inspected for finish quality, and sealed at our Chala, Vapi atelier in Gujarat before being dispatched within 24–48 hours via express air couriers. Orders above ₹499 qualify for free pan-India delivery, Cash on Delivery, and official GST tax invoicing.'
  ]
};

const extraFaqsBySlug: Record<string, Array<{ q: string; a: string }>> = {
  'rings-under-100': [
    {
      q: 'Can you get genuinely waterproof anti-tarnish rings under ₹50 or ₹100 in India?',
      a: 'Honest answer: ₹50–₹99 rings are typically thin electroplated brass that loses color in 1–2 weeks. True 316L surgical stainless steel with 18K gold vacuum PVD starts slightly higher (around ₹179–₹499), lasts years through showers and sweat, and costs less per wear than repeatedly replacing cheap rings.'
    },
    {
      q: 'How can I get the lowest price on Satvastones rings & jewellery?',
      a: 'Browse our lowest-priced pieces right here, use Stack Studio to save 15% automatically when bundling 2+ pieces, and get free express shipping across India on orders above ₹499 with Cash on Delivery available.'
    }
  ],
  'gifts-for-girlfriend-under-500': [
    {
      q: 'What is the best birthday or necklace gift for a girlfriend under ₹500?',
      a: 'Waterproof 18K gold plated jewellery—such as Korean crystal drop earrings, daisy cuff bracelets, minimal rings, and delicate pendants starting at ₹179—is one of the best gifts for a girlfriend under ₹500 because it is nickel-free, sweat-proof, and stays bright every day.'
    },
    {
      q: 'Is Cash on Delivery and fast pan-India shipping available for gifts?',
      a: 'Yes! Orders are dispatched from our Vapi, Gujarat atelier within 24–48 hours, arrive in 2–4 business days across India, and support both UPI/Razorpay and Cash on Delivery (free shipping above ₹499).'
    }
  ],
  'anti-tarnish-minimal-rings': [
    {
      q: 'Will anti-tarnish minimal rings turn my finger green after washing hands?',
      a: 'Never. Satvastones minimal rings use biocompatible 316L surgical stainless steel with 18K vacuum gold PVD—zero copper, zero brass, zero nickel leaching, and 100% safe for daily handwashing and showers.'
    },
    {
      q: 'What if the ring size I order does not fit?',
      a: 'You can check your exact size using our on-screen Ring Sizer, and every ring order includes a hassle-free 7-day size exchange via our WhatsApp concierge (+91 90167 03180).'
    }
  ],
  rings: [
    {
      q: 'How much does a good quality anti-tarnish gold plated ring cost in India?',
      a: 'Cheap ₹50–₹100 brass rings usually oxidize and turn your finger green within a week. Genuine 316L surgical stainless steel + 18K gold vacuum PVD minimal anti-tarnish rings cost between ₹199 and ₹1,299 — giving you years of waterproof, non-tarnish daily wear at a fraction of solid gold ring prices.'
    },
    {
      q: 'Are minimal aesthetic rings from Satvastones safe for daily handwashing?',
      a: 'Yes. Every minimal ring, dome band, and solitaire ring in our collection is 100% waterproof, sweat-proof, and nickel-free so you never have to take it off while washing hands or commuting.'
    }
  ],
  earrings: [
    {
      q: 'Are Satvastones Korean crystal, floral drop & pavé stud earrings nickel-free for sensitive ears?',
      a: 'Yes. All Satvastones earrings — including Korean aesthetic crystal fringe earrings, floral drops, pavé studs, and huggies — are built on medical-grade 316L surgical stainless steel that is 100% nickel-safe, hypoallergenic, and comfortable for sensitive ears all day.'
    }
  ],
  'gift-sets': [
    {
      q: 'What are the best jewellery gifts for a girlfriend under ₹500 in India?',
      a: 'Waterproof anti-tarnish earrings, daisy cuff bracelets, minimal rings, and pendants starting from ₹179–₹325 make the best birthday and anniversary gifts for a girlfriend under ₹500 because they never lose color. You can also explore our dedicated Gifts Under ₹500 page or build a 15%-off combo in Stack Studio.'
    }
  ],
  'mystery-jewellery-jar': [
    {
      q: 'What is inside the Satvastones Mystery Jewellery Jar / Mystery Box?',
      a: 'Each Satvastones Mystery Jewellery Jar contains 3 curated, 100% waterproof anti-tarnish 18K gold PVD pieces (such as necklaces, rings, bracelets, or earrings) packed in a keepsake jar — ideal as a surprise gift or self-treat.'
    }
  ],
  bracelets: [
    {
      q: 'Do Satvastones waterproof bracelets tarnish with daily sweat or showers?',
      a: 'No. Our bracelets that don’t tarnish — including daisy solitaire cuffs, link chains, and paperclip bracelets starting at ₹179 — use 316L stainless steel with 18K vacuum gold PVD coating so they stay bright through showers, workouts, and Indian summers.'
    }
  ],
  necklaces: [
    {
      q: 'Do you have waterproof oval pendants, clover necklaces & necklace gifts for girlfriend?',
      a: 'Yes. Our waterproof necklace collection includes minimal oval pendants, pearl drops, herringbone snake chains, and layering chains crafted in non-tarnish 18K gold PVD — ideal for daily wear and gifting.'
    }
  ]
};

const categoryFaqs = [
  ...(extraFaqsBySlug[category.slug] || []),
  {
    q: `Are Satvastones ${category.name.toLowerCase()} genuinely 100% waterproof and anti-tarnish?`,
    a: `Yes. Every piece in our ${category.name.toLowerCase()} collection is engineered from solid 316L surgical-grade stainless steel with genuine 18-karat gold vacuum PVD (Physical Vapor Deposition) coating. It resists sweat, gym workouts, tap water, perfumes, and tropical humidity without tarnishing or turning skin green.`
  },
  {
    q: `How do I style these ${category.name.toLowerCase()} with sarees or everyday outfits?`,
    a: `Our minimalist and sculptural designs blend seamlessly with traditional Indian sarees (Banarasi, silk, organza, linen) as well as western office and casual wear. Layer them for a high-impact festive look or wear single pieces for everyday effortless elegance.`
  },
  {
    q: `How fast is dispatch and delivery across India?`,
    a: `Every piece is hand-inspected, cleaned, and dispatched from our Vapi atelier in Gujarat within 24 to 48 hours. Express air delivery takes 2–3 business days for major Indian metro cities and 3–5 days for tier-2/3 pin codes. Shipping is free on orders above ₹499.`
  }
];

const categoryFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': categoryFaqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: `https://www.satvastones.in/collections/${category.slug}`
};

const heroImage = category.image.replace(/w=\d+/, 'w=900');
const staticSignature = products.map((p) => `${p.id}:${p.pricePaise}`).join('|');
const siblingCollections = CATEGORIES.filter((cat) => cat.slug !== category.slug).slice(0, 4);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[collectionPageSchema, itemListSchema, aggregateOfferSchema, categoryFaqSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <!-- Editorial collection header -->
    <header class="mx-auto max-w-[1440px] px-5 pt-6 sm:px-8 sm:pt-8 lg:px-10">
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol class="flex items-center gap-2 overflow-x-auto whitespace-nowrap text-[10px] uppercase tracking-[0.16em] text-[#8a8279] scrollbar-none">
          <li><a href="/" class="transition-colors hover:text-[#14110f]">Home</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li><a href="/shop" class="transition-colors hover:text-[#14110f]">Shop</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li aria-current="page" class="text-[#14110f]">{category.name}</li>
        </ol>
      </nav>

      <div class="grid items-center gap-8 pb-9 lg:grid-cols-12 lg:gap-12 lg:pb-12">
        <div class="lg:col-span-7">
          <p id="collection-tagline" class="eyebrow text-[#8d3f3d]">✦ {category.tagline}</p>
          <h1 id="collection-title" class="font-display mt-3 text-[2.75rem] leading-[0.95] tracking-[-0.035em] sm:text-[4.25rem] lg:text-[5rem]">
            {category.name}
          </h1>
          <p id="collection-desc" data-speakable class="mt-5 max-w-xl text-[13px] leading-relaxed text-[#5f5851]">
            {category.description}
          </p>
          <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
            <span>{products.length} pieces</span>
            <span aria-hidden="true" class="text-[#c5a059]">✦</span>
            <span>Free delivery over ₹499</span>
            <span aria-hidden="true" class="text-[#c5a059]">✦</span>
            <span>24–48h dispatch</span>
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="media-frame aspect-[16/10] overflow-hidden bg-[#f1ece3] sm:aspect-[16/9] lg:aspect-[4/3]">
            <img
              src={heroImage}
              alt={`${category.name} — anti-tarnish waterproof 18K gold jewellery by Satvastones`}
              width="900"
              height="675"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- Category rail -->
    <div class="border-y border-[#e5ded3]">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
        <div class="scrollbar-none flex items-center gap-7 overflow-x-auto py-4 text-[10px] uppercase tracking-[0.16em]">
          <a href="/shop" class="whitespace-nowrap pb-0.5 text-[#7d756c] transition-colors hover:text-[#14110f]">
            All pieces
          </a>
          {CATEGORIES.map((cat) => (
            <a
              href={`/collections/${cat.slug}`}
              aria-current={cat.slug === category.slug ? 'page' : undefined}
              class={`whitespace-nowrap pb-0.5 transition-colors hover:text-[#14110f] ${
                cat.slug === category.slug
                  ? 'border-b border-[#14110f] text-[#14110f]'
                  : 'text-[#7d756c]'
              }`}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-[1440px] px-5 pb-16 pt-8 sm:px-8 lg:px-10">
      <!-- Toolbar -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <p id="collection-count-badge" class="text-[10px] uppercase tracking-[0.16em] text-[#8a8279]">
          {products.length > 0 ? `Showing ${products.length} pieces` : 'Live collection'}
        </p>
        <label class="flex items-center gap-2 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
          <span>Sort</span>
          <select
            id="collection-sort"
            class="cursor-pointer border border-[#d8d0c4] bg-transparent py-2 pl-2 pr-6 text-[10px] uppercase tracking-[0.12em] text-[#14110f] focus:border-[#14110f] focus:outline-none"
          >
            <option value="curated">Editor's pick</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="name">Name: A–Z</option>
          </select>
        </label>
      </div>

      <div
        id="collection-products-grid"
        data-live-products="collection"
        data-static-signature={staticSignature}
        class="grid grid-cols-2 gap-x-3 gap-y-9 md:grid-cols-3 md:gap-x-5 lg:grid-cols-4 lg:gap-6"
      >
        {products.map((product) => (
          <div class="shop-item" data-price={product.pricePaise} data-name={product.name}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <!-- Stacking nudge -->
      <a
        href="/stack-builder"
        class="group mt-12 flex flex-col justify-between gap-3 border border-[#e0d7c9] bg-[#f4efe7] px-5 py-4 transition-colors hover:border-[#c5a059] sm:flex-row sm:items-center"
      >
        <div class="flex flex-wrap items-baseline gap-3">
          <span class="text-[9px] uppercase tracking-[0.2em] text-[#8d3f3d]">The stacking edit</span>
          <span class="text-[13px] text-[#14110f]">Pair this collection with another — save 15% on two or more.</span>
        </div>
        <span class="flex items-center gap-2 text-[10px] uppercase tracking-[0.16em] text-[#14110f]">
          Build your stack
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      </a>

      <!-- Buying guide + FAQ -->
      <section class="mt-16 grid gap-10 border-t border-[#e5ded3] pt-10 lg:grid-cols-12 lg:gap-14" aria-labelledby="collection-guide-title">
        <div class="lg:col-span-5">
          <p class="eyebrow text-[#8d3f3d]">The buying guide</p>
          <h2 id="collection-guide-title" class="font-display mt-2 text-[1.9rem] leading-tight sm:text-[2.4rem]">
            {category.name},<br class="hidden sm:block" /> explained.
          </h2>
          <div class="mt-4 space-y-3 text-[13px] leading-relaxed text-[#5f5851]">
            {(collectionBuyingGuides[category.slug] || [
              `Every piece in our ${category.name.toLowerCase()} collection is engineered from solid 316L surgical stainless steel with authentic 18K gold vacuum PVD coating. 100% waterproof, sweat-resistant, shower-safe, and guaranteed never to leave green skin marks. All orders are hand-inspected and dispatched from our Vapi store in Gujarat within 24–48 hours.`
            ]).map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.14em]">
            <a href="/materials" class="link-line text-[#14110f]">316L surgical steel</a>
            <a href="/jewellery-care" class="link-line text-[#14110f]">Care guide</a>
            <a href="/faqs" class="link-line text-[#14110f]">Styling FAQ</a>
          </div>

          <div class="mt-8 border-t border-[#e5ded3] pt-5">
            <p class="text-[9px] uppercase tracking-[0.2em] text-[#8a8279]">Continue browsing</p>
            <ul class="mt-3 space-y-2">
              {siblingCollections.map((cat) => (
                <li>
                  <a href={`/collections/${cat.slug}`} class="group flex items-center justify-between gap-3 text-[12px] text-[#14110f]">
                    <span>{cat.name}</span>
                    <span class="text-[#8a8279] transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="border-t border-[#e5ded3] lg:col-span-7">
          {categoryFaqs.map((faq) => (
            <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                <h3 class="font-display text-[1.1rem] leading-snug text-[#14110f]">{faq.q}</h3>
                <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="pt-3 text-[13px] leading-relaxed text-[#5f5851]">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script>
    import { getSiteSettings } from '../../stores/adminStore';
    import { getAllCatalogProducts, syncCatalogFromCloudflare } from '../../stores/catalogStore';

    const grid = document.getElementById('collection-products-grid') as HTMLElement | null;
    const staticSignature = grid?.dataset.staticSignature || '';
    let lastSignature = '';

    const buildSignature = (items: { id: string; pricePaise: number }[]) =>
      items.map((p) => `${p.id}:${p.pricePaise}`).join('|');

    function renderCollectionProducts() {
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (!slug || !grid) return;

      const all = getAllCatalogProducts();
      let matched: typeof all = [];
      if (slug === 'bestsellers') {
        matched = all.filter((p) => p.isBestseller);
      } else if (slug === 'new-arrivals') {
        matched = all.filter((p) => p.isNewArrival);
      } else if (slug === 'gifts-for-girlfriend-under-500') {
        const under500 = all.filter((p) => p.pricePaise <= 50000).sort((a, b) => a.pricePaise - b.pricePaise);
        matched = under500.length ? under500 : all.sort((a, b) => a.pricePaise - b.pricePaise);
      } else if (slug === 'rings-under-100') {
        const rings = all.filter((p) => p.category === 'rings').sort((a, b) => a.pricePaise - b.pricePaise);
        matched = rings.length ? rings : all.filter((p) => p.pricePaise <= 50000).sort((a, b) => a.pricePaise - b.pricePaise);
      } else if (slug === 'anti-tarnish-minimal-rings') {
        const rings = all.filter((p) => p.category === 'rings');
        matched = rings.length ? rings : all;
      } else {
        matched = all.filter((p) => p.category === slug);
      }

      const countBadge = document.getElementById('collection-count-badge');
      if (countBadge) countBadge.textContent = `Showing ${matched.length} pieces`;

      const signature = buildSignature(matched);
      if (signature === lastSignature) return;
      lastSignature = signature;

      // Keep the server-rendered editorial cards when the catalogue is unchanged.
      if (signature === staticSignature) return;

      if (matched.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center">
            <p class="font-display text-2xl text-[#14110f]">No pieces in this collection right now.</p>
            <p class="mt-2 text-xs text-[#8a8279]">Explore the full permanent collection in the atelier shop.</p>
            <a href="/shop" class="mt-5 inline-block bg-[#14110f] px-6 py-3 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8]">Explore shop</a>
          </div>`;
        return;
      }

      grid.innerHTML = matched
        .map((product) => {
          const discountPercent = product.compareAtPricePaise
            ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
            : 0;
          const primaryImage =
            product.images?.[0]?.url ||
            'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=450&q=80';
          const priceRupees = Math.round(product.pricePaise / 100);
          const compareRupees = product.compareAtPricePaise ? Math.round(product.compareAtPricePaise / 100) : null;

          return `
            <div class="shop-item" data-price="${product.pricePaise}" data-name="${product.name}">
              <div class="product-card group relative flex flex-col">
                <a href="/products/${product.slug}" class="relative block aspect-[3/4] overflow-hidden bg-[#f1ece3]" aria-label="${product.name}">
                  <div class="absolute left-3 top-3 z-10 flex flex-col items-start gap-1.5">
                    ${product.isBestseller ? `<span class="bg-[#14110f] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#f6f1e8]">Bestseller</span>` : ''}
                    ${product.isNewArrival && !product.isBestseller ? `<span class="bg-[#f6f1e8] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#14110f]">New</span>` : ''}
                    ${discountPercent > 0 ? `<span class="bg-[#c5a059] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-white">−${discountPercent}%</span>` : ''}
                  </div>
                  <img src="${primaryImage}" alt="${product.name}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </a>
                <div class="flex flex-1 flex-col gap-2.5 pt-3.5">
                  <div class="min-w-0">
                    <h3 class="font-serif text-[15px] leading-snug text-[#14110f] sm:text-base">
                      <a href="/products/${product.slug}">${product.name}</a>
                    </h3>
                    <p class="mt-1 line-clamp-1 text-[9px] uppercase tracking-[0.14em] text-[#8b837a]">${product.material || product.category || '18K gold PVD'}</p>
                  </div>
                  <div class="mt-auto space-y-2.5">
                    <div class="flex items-baseline gap-2">
                      <span class="text-sm font-medium text-[#14110f] sm:text-[15px]">₹${priceRupees.toLocaleString('en-IN')}</span>
                      ${compareRupees ? `<span class="text-[11px] text-[#a39a91] line-through">₹${compareRupees.toLocaleString('en-IN')}</span>` : ''}
                    </div>
                    <button
                      type="button"
                      data-add-to-bag="${product.id}"
                      data-name="${product.name}"
                      data-slug="${product.slug}"
                      data-price="${product.pricePaise}"
                      data-image="${primaryImage}"
                      class="custom-add-to-bag w-full cursor-pointer border border-[#14110f]/25 py-2.5 text-[9px] font-medium uppercase tracking-[0.2em] text-[#14110f] transition-colors duration-300 hover:border-[#14110f] hover:bg-[#14110f] hover:text-[#f6f1e8]"
                    >
                      Add to bag
                    </button>
                  </div>
                </div>
              </div>
            </div>`;
        })
        .join('');

      grid.querySelectorAll('.custom-add-to-bag').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const target = btn as HTMLElement;
          import('../../stores/cartStore').then(({ addToCart }) => {
            addToCart({
              productId: target.dataset.addToBag || '',
              name: target.dataset.name || '',
              slug: target.dataset.slug || '',
              pricePaise: Number(target.dataset.price || 0),
              image: target.dataset.image || '',
              quantity: 1
            });
          });
        });
      });
    }

    try {
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (slug) {
        const settings = getSiteSettings();
        const customCat = settings.categories?.find((c) => c.slug === slug);
        if (customCat) {
          const titleEl = document.getElementById('collection-title');
          const taglineEl = document.getElementById('collection-tagline');
          const descEl = document.getElementById('collection-desc');

          if (titleEl && customCat.name) titleEl.textContent = customCat.name;
          if (taglineEl && customCat.tagline) taglineEl.textContent = `✦ ${customCat.tagline}`;
          if (descEl && customCat.description) descEl.textContent = customCat.description;
        }
      }
    } catch (e) {
      console.warn('Collection rehydration error:', e);
    }

    renderCollectionProducts();
    syncCatalogFromCloudflare().then(() => renderCollectionProducts());
    window.addEventListener('satvastones:products_updated', renderCollectionProducts);
    document.addEventListener('astro:page-load', () => {
      renderCollectionProducts();
      syncCatalogFromCloudflare().then(() => renderCollectionProducts());
    });

    // Sorting
    const sortSelect = document.getElementById('collection-sort') as HTMLSelectElement | null;
    sortSelect?.addEventListener('change', () => {
      if (!grid) return;
      const items = Array.from(grid.querySelectorAll<HTMLElement>('.shop-item'));
      const mode = sortSelect.value;
      const priceOf = (el: HTMLElement) => Number(el.dataset.price || 0);
      const nameOf = (el: HTMLElement) => (el.dataset.name || '').toLowerCase();

      items.sort((a, b) => {
        if (mode === 'price-asc') return priceOf(a) - priceOf(b);
        if (mode === 'price-desc') return priceOf(b) - priceOf(a);
        if (mode === 'name') return nameOf(a).localeCompare(nameOf(b));
        return 0;
      });
      items.forEach((item) => grid.appendChild(item));
    });
  </script>
</BaseLayout>
