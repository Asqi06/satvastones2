---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import { CATEGORIES } from '../../data/categories';
import type { Category, Product } from '../../types/ecommerce';

export function getStaticPaths() {
  const categoryPaths = CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: {
      category: cat,
      products: PRODUCTS.filter((p) => p.category === cat.slug)
    }
  }));

  const bestsellers = {
    params: { slug: 'bestsellers' },
    props: {
      category: {
        id: 'bestsellers',
        name: 'Bestsellers',
        slug: 'bestsellers',
        tagline: 'Most Loved Pieces',
        description: 'Our most coveted anti-tarnish jewellery, adored across thousands of Indian homes for daily wear.',
        image: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80',
        itemCount: PRODUCTS.filter((p) => p.isBestseller).length
      },
      products: PRODUCTS.filter((p) => p.isBestseller)
    }
  };

  const newArrivals = {
    params: { slug: 'new-arrivals' },
    props: {
      category: {
        id: 'new-arrivals',
        name: 'New Arrivals',
        slug: 'new-arrivals',
        tagline: 'Fresh Drops from Atelier',
        description: 'Discover the newest additions to our permanent anti-tarnish collection, hand-inspected in Vapi.',
        image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
        itemCount: PRODUCTS.filter((p) => p.isNewArrival).length
      },
      products: PRODUCTS.filter((p) => p.isNewArrival)
    }
  };

  const seoVirtualCollections = [
    {
      params: { slug: 'rings-under-100' },
      props: {
        category: {
          id: 'rings-under-100',
          name: 'Rings Under ₹100',
          slug: 'rings-under-100',
          tagline: 'Starting ₹49–₹99 · Budget Aesthetic & Anti-Tarnish Rings',
          description:
            'Explore budget aesthetic rings under ₹100 alongside long-lasting waterproof 18K gold plated anti-tarnish rings for women in India. Free shipping above ₹499 & COD available.',
          image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
          itemCount: 0
        },
        products: []
      }
    },
    {
      params: { slug: 'gifts-for-girlfriend-under-500' },
      props: {
        category: {
          id: 'gifts-for-girlfriend-under-500',
          name: 'Best Jewelry Gifts for Girlfriend Under ₹500',
          slug: 'gifts-for-girlfriend-under-500',
          tagline: 'Birthday & Anniversary Picks · Starting at ₹149 · Anti-Tarnish & Waterproof',
          description:
            'Looking for the best gift for your girlfriend under ₹500 or a thoughtful birthday gift under ₹500? Explore our waterproof, 18K gold-plated anti-tarnish jewellery and everyday jewelry gifts for your girlfriend starting at ₹149—nickel-free earrings, bracelets, minimal rings & pendants with COD and fast India delivery.',
          image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80',
          itemCount: 0
        },
        products: []
      }
    },
    {
      params: { slug: 'anti-tarnish-minimal-rings' },
      props: {
        category: {
          id: 'anti-tarnish-minimal-rings',
          name: 'Anti-Tarnish Minimal Rings',
          slug: 'anti-tarnish-minimal-rings',
          tagline: '18K Gold PVD · Waterproof & Nickel-Free',
          description:
            'Minimalist anti-tarnish rings crafted in 316L surgical stainless steel with 18K gold vacuum PVD. Shower-safe, sweat-proof daily rings for women that never turn fingers green.',
          image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
          itemCount: 0
        },
        products: []
      }
    }
  ];

  return [...categoryPaths, bestsellers, newArrivals, ...seoVirtualCollections];
}

interface Props {
  category: Category;
  products: Product[];
}

const { category, products } = Astro.props;

// Keyword-targeted high-CTR SEO titles (<= 60 chars) & meta descriptions (<= 155 chars)
const seoTitles: Record<string, string> = {
  'rings-under-100': 'Rings Under ₹100 & Affordable 18K Gold Rings | Satvastones',
  'gifts-for-girlfriend-under-500': 'Jewellery Gifts for Girlfriend Under ₹500 | Satvastones',
  'anti-tarnish-minimal-rings': 'Anti-Tarnish Minimal 18K Gold Plated Rings | Satvastones',
  'mystery-jewellery-jar': 'Mystery Jewellery Jar Online India | Satvastones',
  'bracelets': 'Waterproof Anti-Tarnish Bracelets for Women | Satvastones',
  'jewellery-set': 'Anti-Tarnish & Traditional Jewellery Sets | Satvastones',
  'necklaces': 'Waterproof Anti-Tarnish Necklaces & Pendants | Satvastones',
  'rings': '18K Gold Plated Anti-Tarnish Rings for Women | Satvastones',
  'earrings': 'Nickel-Free Hypoallergenic & Bali Earrings | Satvastones',
  'bangles': 'Anti-Tarnish 18K Gold Plated Kada Bangles | Satvastones',
  'gift-sets': 'Anti-Tarnish Jewellery Gift Sets for Women | Satvastones',
  'bestsellers': 'Bestselling Anti-Tarnish Jewellery Under ₹500 | Satvastones',
  'new-arrivals': 'New Korean & Waterproof Jewellery Drops | Satvastones'
};

const seoDescriptions: Record<string, string> = {
  'rings-under-100': 'Compare rings under ₹100 with waterproof 18K gold-plated anti-tarnish rings from ₹149. 316L surgical steel that never turns fingers green. COD available.',
  'gifts-for-girlfriend-under-500': 'Shop the best birthday & everyday jewellery gifts for girlfriend under ₹500 from ₹149. Waterproof 18K gold PVD rings, earrings & bracelets. Free COD.',
  'anti-tarnish-minimal-rings': 'Shop simple low-price 18K gold-plated minimal rings in waterproof 316L steel from ₹149. Anti-tarnish daily rings that never turn fingers green. COD.',
  'mystery-jewellery-jar': 'Unbox the Satvastones Mystery Jewellery Jar in India. Waterproof anti-tarnish 18K gold PVD rings, necklaces & earrings in a keepsake jar. COD available.',
  'bracelets': 'Shop waterproof 18K gold plated bracelets & daisy cuffs for women from ₹179. Sweat-proof 316L surgical steel that never tarnishes. Free delivery > ₹499.',
  'jewellery-set': 'Explore affordable anti-tarnish & traditional Indian jewellery sets for women. Waterproof 18K gold PVD necklaces, bracelets & earrings for festive wear.',
  'necklaces': 'Shop waterproof non-tarnish necklaces for women in India — clover chains, oval pendants & herringbone chains from ₹179. Free pan-India delivery > ₹499.',
  'rings': 'Shop simple gold-look anti-tarnish rings for women from ₹149. Waterproof 18K gold PVD on 316L steel that never turns fingers green. 7-day size exchange.',
  'earrings': 'Shop nickel-free hypoallergenic earrings for sensitive ears from ₹149 — 18K gold-plated Bali hoops, Korean crystal drops & waterproof daily studs. COD.',
  'bangles': 'Shop waterproof anti-tarnish kada bangles & daisy solitaire cuffs for women from ₹179. 18K gold PVD 316L steel bangles built for Indian humidity. COD.',
  'gift-sets': 'Shop curated anti-tarnish jewellery gift sets for birthdays, anniversaries & festive gifting in India. Waterproof 18K gold PVD with Vapi dispatch & COD.',
  'bestsellers': 'Shop India’s most loved waterproof anti-tarnish jewellery for women from ₹149. Non-tarnish rings, bracelets, nickel-free earrings & gifts under ₹500.',
  'new-arrivals': 'Explore new Korean aesthetic & waterproof anti-tarnish jewellery drops from ₹149. Hand-inspected and dispatched in 24–48h from Vapi, Gujarat across India.'
};

const pageTitle = seoTitles[category.slug] || `Buy ${category.name} Online India | Satvastones`;
const pageDescription = seoDescriptions[category.slug] || category.description;

const siteUrl = 'https://www.satvastones.in';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: '/shop' },
  { name: category.name, url: `/collections/${category.slug}` }
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': `${category.name} Collection`,
  'description': pageDescription,
  'numberOfItems': products.length,
  'itemListElement': products.map((product, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'url': `${siteUrl}/products/${product.slug}`,
    'name': product.name,
    'image': product.images[0]?.url
  }))
};

const defaultLowPrice =
  category.slug === 'rings-under-100'
    ? '99'
    : '149';
const defaultHighPrice =
  category.slug === 'gifts-for-girlfriend-under-500' ? '499' : '2499';

const aggregateOfferSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Satvastones ${category.name}`,
  description: pageDescription,
  image: [category.image],
  brand: {
    '@type': 'Brand',
    name: 'Satvastones Jewellery'
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'INR',
    lowPrice: defaultLowPrice,
    highPrice: defaultHighPrice,
    offerCount: Math.max(1, products.length),
    availability: 'https://schema.org/InStock',
    url: `${siteUrl}/collections/${category.slug}`
  }
};

const collectionBuyingGuides: Record<string, string[]> = {
