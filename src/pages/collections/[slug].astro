---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import { CATEGORIES } from '../../data/categories';
import type { Category, Product } from '../../types/ecommerce';

export function getStaticPaths() {
  const categoryPaths = CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: {
      category: cat,
      products: PRODUCTS.filter((p) => p.category === cat.slug)
    }
  }));

  const bestsellers = {
    params: { slug: 'bestsellers' },
    props: {
      category: {
        id: 'bestsellers',
        name: 'Bestsellers',
        slug: 'bestsellers',
        tagline: 'Most Loved Pieces',
        description: 'Our most coveted anti-tarnish jewellery, adored across thousands of Indian homes for daily wear.',
        image: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80',
        itemCount: PRODUCTS.filter((p) => p.isBestseller).length
      },
      products: PRODUCTS.filter((p) => p.isBestseller)
    }
  };

  const newArrivals = {
    params: { slug: 'new-arrivals' },
    props: {
      category: {
        id: 'new-arrivals',
        name: 'New Arrivals',
        slug: 'new-arrivals',
        tagline: 'Fresh Drops from Atelier',
        description: 'Discover the newest additions to our permanent anti-tarnish collection, hand-inspected in Vapi.',
        image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=80',
        itemCount: PRODUCTS.filter((p) => p.isNewArrival).length
      },
      products: PRODUCTS.filter((p) => p.isNewArrival)
    }
  };

  return [...categoryPaths, bestsellers, newArrivals];
}

interface Props {
  category: Category;
  products: Product[];
}

const { category, products } = Astro.props;

// Keyword-targeted SEO Titles & Meta descriptions following Google Best Practices
const seoTitles: Record<string, string> = {
  'bracelets': 'Buy Anti Tarnish Jewellery Bracelets Online in India at Best Prices | Satvastones',
  'jewellery-set': 'Buy Anti Tarnish Jewellery Sets Online in India at Best Prices | Satvastones',
  'mystery-jewellery-jar': 'Buy Mystery Jewellery Jar Online in India at Best Prices | Satvastones',
  'necklaces': 'Buy Waterproof Anti Tarnish Necklaces Online in India at Best Prices | Satvastones',
  'rings': 'Buy Anti Tarnish Rings Online in India at Best Prices | Satvastones',
  'earrings': 'Buy Hypoallergenic Anti Tarnish Earrings Online in India at Best Prices | Satvastones',
  'bangles': 'Buy Anti Tarnish Kada Bangles Online in India at Best Prices | Satvastones',
  'gift-sets': 'Buy Anti Tarnish Jewellery Gift Sets Online in India at Best Prices | Satvastones',
  'bestsellers': 'Buy Bestselling Anti Tarnish Jewellery in India at Best Prices | Satvastones',
  'new-arrivals': 'Buy New Arrival Anti Tarnish Jewellery Online in India | Satvastones'
};

const seoDescriptions: Record<string, string> = {
  'bracelets': 'Shop waterproof anti tarnish jewellery bracelet styles in India. Chunky link chains, delicate paperclips, and kada cuffs in 18K gold PVD and 316L steel. Free delivery > ₹499.',
  'jewellery-set': 'Explore coordinated anti tarnish jewellery set collections for women. Perfectly matching necklaces, bracelets, and earrings for sarees, weddings, and daily wear.',
  'mystery-jewellery-jar': 'Unbox 3 surprise handcrafted waterproof pieces worth ₹4,999+ in the SatvaStones Mystery Jewellery Jar. 100% anti-tarnish, dispatched from our Vapi atelier.',
  'necklaces': 'Discover waterproof and tarnish free necklaces in India. From herringbone snake chains to baroque molten pearl pendants engineered for showers and workouts.',
  'rings': 'Browse waterproof, anti tarnish rings for women. 316L surgical steel with 18K gold vacuum PVD that never leaves green skin marks. Free ring sizer available.',
  'earrings': 'Explore featherlight, 100% hypoallergenic anti-tarnish earrings and huggies. Nickel-free 316L surgical stainless steel safe for sensitive ears.',
  'bangles': 'Shop everyday anti tarnish kada bangles and structured torque cuffs. Contemporary Indian designs that never lose their golden luster in humidity.',
  'gift-sets': 'Curated anti tarnish jewellery gift sets in luxury keepsake boxes. Ideal gifts for birthdays, anniversaries, and festive celebrations in India.',
  'bestsellers': 'Discover the highest rated anti tarnish jewellery pieces in India. Adored by thousands for daily shower-safe, gym-safe durability.',
  'new-arrivals': 'The latest drops in women’s anti tarnish jewellery. Hand-inspected and dispatched in 24–48 hours from our Vapi store location in Gujarat.'
};

const pageTitle = seoTitles[category.slug] || `Buy ${category.name} Online in India at Best Prices | Satvastones`;
const pageDescription = seoDescriptions[category.slug] || category.description;

const siteUrl = 'https://www.satvastones.in';

// Structured Data: ItemList Schema & Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: '/shop' },
  { name: category.name, url: `/collections/${category.slug}` }
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': `${category.name} Collection`,
  'description': pageDescription,
  'numberOfItems': products.length,
  'itemListElement': products.map((product, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'url': `${siteUrl}/products/${product.slug}`,
    'name': product.name,
    'image': product.images[0]?.url
  }))
};

// Category Buying Guide & FAQ structured data
const categoryFaqs = [
  {
    q: `Are Satvastones ${category.name.toLowerCase()} genuinely 100% waterproof and anti-tarnish?`,
    a: `Yes. Every piece in our ${category.name.toLowerCase()} collection is engineered from solid 316L surgical-grade stainless steel with genuine 18-karat gold vacuum PVD (Physical Vapor Deposition) coating. It resists sweat, gym workouts, tap water, perfumes, and tropical humidity without tarnishing or turning skin green.`
  },
  {
    q: `How do I style these ${category.name.toLowerCase()} with sarees or everyday outfits?`,
    a: `Our minimalist and sculptural designs blend seamlessly with traditional Indian sarees (Banarasi, silk, organza, linen) as well as western office and casual wear. Layer them for a high-impact festive look or wear single pieces for everyday effortless elegance.`
  },
  {
    q: `How fast is dispatch and delivery across India?`,
    a: `Every piece is hand-inspected, cleaned, and dispatched from our Vapi atelier in Gujarat within 24 to 48 hours. Express air delivery takes 2–3 business days for major Indian metro cities and 3–5 days for tier-2/3 pin codes. Shipping is free on orders above ₹499.`
  }
];

const categoryFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': categoryFaqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[itemListSchema, categoryFaqSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- Atelier Header Banner -->
  <div class="bg-[#faf8f5] border-b border-[#eae4dc] py-8 sm:py-14">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <span id="collection-tagline" class="inline-flex items-center gap-1.5 bg-white text-[#9f4553] text-[11px] font-bold uppercase tracking-[0.16em] px-4 py-1.5 rounded-full border border-[#eae4dc] shadow-2xs">
        <span class="text-[#c5a059]">✦</span>
        <span>{category.tagline}</span>
      </span>
      <h1 id="collection-title" class="font-serif text-3xl sm:text-5xl font-normal text-[#171513] tracking-tight">
        {category.name}
      </h1>
      <p id="collection-desc" class="text-xs sm:text-sm text-[#6e6863] max-w-xl mx-auto leading-relaxed">
        {category.description}
      </p>
    </div>
  </div>

  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-[#888888] mb-5">
      <a href="/" class="hover:text-[#171513] transition-colors">Home</a>
      <span>/</span>
      <a href="/shop" class="hover:text-[#171513] transition-colors">Shop</a>
      <span>/</span>
      <span class="text-[#171513] font-semibold">{category.name}</span>
    </nav>

    <!-- Quick Navigation Category Pills Strip -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 scrollbar-none">
      <a
        href="/shop"
        class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-colors bg-[#faf8f5] text-[#332f2c] border border-[#eae4dc] hover:bg-[#f2ece4]"
      >
        All Suites ({PRODUCTS.length})
      </a>
      {CATEGORIES.map((cat) => {
        const isCurrent = cat.slug === category.slug;
        return (
          <a
            href={`/collections/${cat.slug}`}
            class={`px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
              isCurrent
                ? 'bg-[#171513] text-white shadow-sm'
                : 'bg-[#faf8f5] text-[#332f2c] border border-[#eae4dc] hover:bg-[#f2ece4]'
            }`}
          >
            {cat.name} ({cat.itemCount})
          </a>
        );
      })}
    </div>

    {products.length === 0 ? (
      <div class="text-center py-16 space-y-3 bg-[#faf8f5] rounded-[24px] p-8 border border-[#eae4dc]">
        <h2 class="font-serif text-2xl font-normal text-[#171513]">New Designs In Production</h2>
        <p class="text-xs sm:text-sm text-[#6e6863] max-w-md mx-auto">
          Our Vapi atelier is hand-crafting new pieces for this collection. Explore other trending suites in the meantime.
        </p>
        <div class="pt-2">
          <a
            href="/shop"
            class="inline-block bg-[#171513] hover:bg-[#9f4553] text-white px-7 py-3 rounded-full text-xs font-bold uppercase tracking-wider transition-colors shadow-sm"
          >
            Browse All Jewellery →
          </a>
        </div>
      </div>
    ) : (
      <div>
        <div class="flex items-center justify-between pb-3 mb-6 border-b border-[#eae4dc]">
          <span id="collection-count-badge" class="text-xs text-[#6e6863] font-medium">
            Showing {products.length} {category.name} Pieces
          </span>
          <span class="text-xs font-semibold text-[#171513] flex items-center gap-1.5">
            <span class="text-[#c5a059]">✦</span>
            <span>Free Express Delivery &gt; ₹499 • 24–48h Dispatch</span>
          </span>
        </div>

        <!-- 2-Column Mobile Grid / 4-Column Desktop -->
        <div id="collection-products-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
    )}

    <!-- Category Informational SEO, Buying Guide & FAQ Section -->
    <div class="mt-14 pt-8 bg-[#faf8f5] border border-[#eae4dc] rounded-[24px] p-6 sm:p-10 space-y-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-[#9f4553] font-bold text-xs uppercase tracking-[0.14em]">
          <span class="text-[#c5a059]">✦</span>
          <span>Atelier Buying Guide: Satvastones {category.name} in India</span>
        </div>
        <p class="text-xs sm:text-sm text-[#4a443f] leading-relaxed">
          Every piece in our {category.name.toLowerCase()} collection is engineered from solid 316L surgical stainless steel with authentic 18K gold vacuum PVD coating. They are 100% waterproof, sweat-resistant, shower-safe, and guaranteed never to leave green skin marks. All orders are hand-inspected and dispatched directly from our Vapi store location in Gujarat within 24 to 48 hours.
        </p>
      </div>

      <!-- FAQ Accordion for Category -->
      <div class="space-y-3 pt-2 border-t border-[#eae4dc]">
        <h3 class="text-xs font-bold text-[#171513] uppercase tracking-wider">
          Frequently Asked Questions About {category.name}
        </h3>
        {categoryFaqs.map((faq, idx) => (
          <details class="group bg-white rounded-xl border border-[#eae4dc] p-4 [&_summary::-webkit-details-marker]:hidden open:shadow-2xs transition-all">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-xs sm:text-sm text-[#171513] select-none">
              <span class="pr-2">{faq.q}</span>
              <span class="text-[#99918b] group-open:rotate-180 group-open:text-[#171513] transition-transform duration-200 shrink-0 text-xs">
                ▼
              </span>
            </summary>
            <p class="pt-2 text-xs sm:text-sm text-[#4a443f] leading-relaxed border-t border-[#eae4dc] mt-2">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

      <div class="pt-2 flex flex-wrap gap-4 text-xs font-semibold">
        <a href="/materials" class="text-[#9f4553] hover:text-[#171513] underline transition-colors">
          Learn about 316L Surgical Steel &rarr;
        </a>
        <a href="/faqs#styling-guide" class="text-[#9f4553] hover:text-[#171513] underline transition-colors">
          How to Style with Saree &rarr;
        </a>
        <a href="/track-order" class="text-[#9f4553] hover:text-[#171513] underline transition-colors">
          Track Your Delivery &rarr;
        </a>
      </div>
    </div>
  </div>

  <script>
    import { getSiteSettings } from '../../stores/adminStore';
    import { getAllCatalogProducts, syncCatalogFromCloudflare } from '../../stores/catalogStore';

    function renderCollectionProducts() {
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (!slug) return;

      const grid = document.getElementById('collection-products-grid');
      if (!grid) return;

      const all = getAllCatalogProducts();
      let matched = [];
      if (slug === 'bestsellers') {
        matched = all.filter((p) => p.isBestseller);
      } else if (slug === 'new-arrivals') {
        matched = all.filter((p) => p.isNewArrival);
      } else {
        matched = all.filter((p) => p.category === slug);
      }

      const countBadge = document.getElementById('collection-count-badge');
      if (countBadge) countBadge.textContent = `Showing ${matched.length} Pieces`;

      if (matched.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center space-y-3">
            <p class="font-serif text-xl sm:text-2xl text-[#171513]">No suites currently in this collection.</p>
            <p class="text-xs text-[#8c827a]">Explore our full permanent collection in the Atelier Shop.</p>
            <a href="/shop" class="inline-block mt-3 px-6 py-2.5 bg-[#171513] text-white rounded-full text-xs font-bold uppercase tracking-wider">Explore Shop</a>
          </div>
        `;
        return;
      }

      grid.innerHTML = matched.map((product) => {
        const discountPercent = product.compareAtPricePaise
          ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
          : 0;

        const primaryImage = product.images?.[0]?.url || 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=450&q=80';
        const priceRupees = Math.round(product.pricePaise / 100);
        const compareRupees = product.compareAtPricePaise ? Math.round(product.compareAtPricePaise / 100) : null;

        return `
          <div class="product-card group relative flex flex-col bg-white border border-[#eae4dc] rounded-[18px] overflow-hidden transition-all duration-300 hover:shadow-[0_12px_28px_rgba(23,21,19,0.06)] hover:border-[#c5a059]/40">
            <a href="/products/${product.slug}" class="relative block aspect-[3/4] overflow-hidden bg-[#faf8f5] rounded-t-[18px]" aria-label="${product.name}">
              <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1">
                ${product.isBestseller ? `<span class="bg-[#9f4553] text-white text-[9px] font-bold uppercase tracking-[0.08em] px-2.5 py-0.5 rounded-full shadow-2xs">Bestseller</span>` : ''}
                ${product.isNewArrival && !product.isBestseller ? `<span class="bg-[#c5a059] text-white text-[9px] font-bold uppercase tracking-[0.08em] px-2.5 py-0.5 rounded-full shadow-2xs">New</span>` : ''}
                ${discountPercent > 0 ? `<span class="bg-[#171513] text-[#fbf8f5] text-[9px] font-bold px-2 py-0.5 rounded-full shadow-2xs">-${discountPercent}%</span>` : ''}
              </div>
              <img
                src="${primaryImage}"
                alt="${product.name}"
                class="product-card-image absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </a>

            <div class="p-3 sm:p-4 flex flex-col flex-1 justify-between bg-white space-y-2.5">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-[#9f4553]">
                  ${product.category || 'Atelier Fine Suite'}
                </p>
                <h3 class="font-serif text-xs sm:text-sm font-semibold text-[#171513] mt-0.5 line-clamp-1 hover:text-[#9f4553]">
                  <a href="/products/${product.slug}">${product.name}</a>
                </h3>
              </div>

              <div class="pt-2 border-t border-[#f0eae1] flex items-center justify-between">
                <div class="flex items-baseline gap-1.5">
                  <span class="font-serif font-bold text-sm sm:text-base text-[#171513]">
                    ₹${priceRupees.toLocaleString('en-IN')}
                  </span>
                  ${compareRupees ? `<span class="text-[11px] text-[#8c827a] line-through">₹${compareRupees.toLocaleString('en-IN')}</span>` : ''}
                </div>
                <button
                  type="button"
                  data-add-to-bag="${product.id}"
                  data-name="${product.name}"
                  data-slug="${product.slug}"
                  data-price="${product.pricePaise}"
                  data-image="${primaryImage}"
                  class="custom-add-to-bag w-8 h-8 rounded-full bg-[#171513] hover:bg-[#9f4553] text-white flex items-center justify-center transition-transform hover:scale-110 active:scale-95 shadow-xs cursor-pointer"
                  title="Add to shopping bag"
                >
                  <svg class="w-3.5 h-3.5 stroke-[2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Wire Add to Bag buttons
      grid.querySelectorAll('.custom-add-to-bag').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const target = btn as HTMLElement;
          import('../../stores/cartStore').then(({ addToCart }) => {
            addToCart({
              productId: target.dataset.addToBag || '',
              name: target.dataset.name || '',
              slug: target.dataset.slug || '',
              pricePaise: Number(target.dataset.price || 0),
              image: target.dataset.image || '',
              quantity: 1
            });
          });
        });
      });
    }

    try {
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (slug) {
        const settings = getSiteSettings();
        const customCat = settings.categories?.find((c) => c.slug === slug);
        if (customCat) {
          const titleEl = document.getElementById('collection-title');
          const taglineEl = document.getElementById('collection-tagline');
          const descEl = document.getElementById('collection-desc');

          if (titleEl && customCat.name) titleEl.textContent = customCat.name;
          if (taglineEl && customCat.tagline) taglineEl.textContent = customCat.tagline;
          if (descEl && customCat.description) descEl.textContent = customCat.description;
        }
      }
    } catch (e) {
      console.warn('Collection rehydration error:', e);
    }

    renderCollectionProducts();
    syncCatalogFromCloudflare().then(() => renderCollectionProducts());
    window.addEventListener('satvastones:products_updated', renderCollectionProducts);
    document.addEventListener('astro:page-load', () => {
      renderCollectionProducts();
      syncCatalogFromCloudflare().then(() => renderCollectionProducts());
    });
  </script>
</BaseLayout>
