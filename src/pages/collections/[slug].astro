const categoryFaqs = [
  ...(extraFaqsBySlug[category.slug] || []),
  {
    q: `Are Satvastones ${category.name.toLowerCase()} genuinely 100% waterproof and anti-tarnish?`,
    a: `Yes. Every piece in our ${category.name.toLowerCase()} collection is engineered from solid 316L surgical-grade stainless steel with genuine 18-karat gold vacuum PVD (Physical Vapor Deposition) coating. It resists sweat, gym workouts, tap water, perfumes, and tropical humidity without tarnishing or turning skin green.`
  },
  {
    q: `How do I style these ${category.name.toLowerCase()} with sarees or everyday outfits?`,
    a: `Our minimalist and sculptural designs blend seamlessly with traditional Indian sarees (Banarasi, silk, organza, linen) as well as western office and casual wear. Layer them for a high-impact festive look or wear single pieces for everyday effortless elegance.`
  },
  {
    q: `How fast is dispatch and delivery across India?`,
    a: `Every piece is hand-inspected, cleaned, and dispatched from our Vapi atelier in Gujarat within 24 to 48 hours. Express air delivery takes 2–3 business days for major Indian metro cities and 3–5 days for tier-2/3 pin codes. Shipping is free on orders above ₹499.`
  }
];

const categoryFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': categoryFaqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: `https://www.satvastones.in/collections/${category.slug}`
};

const collectionH1s: Record<string, string> = {
  'gifts-for-girlfriend-under-500': 'Best Jewelry Gifts for Girlfriend Under ₹500',
  'rings': '18K Gold Plated & Anti-Tarnish Rings for Women',
  'anti-tarnish-minimal-rings': 'Simple 18K Gold Plated Minimal Rings for Women',
  'rings-under-100': 'Budget Aesthetic & 18K Gold Plated Rings',
  'earrings': 'Nickel-Free & Hypoallergenic Gold-Plated Earrings'
};

const collectionHighlightPills: Record<string, string[]> = {
  'gifts-for-girlfriend-under-500': ['Priced ₹149–₹499', '18K Gold Plated', 'Waterproof & Anti-Tarnish', 'COD Available'],
  'rings': ['18K Gold Plated', 'Anti-Tarnish', 'Starting at ₹149', 'Real-Gold Daily Look'],
  'anti-tarnish-minimal-rings': ['18K Gold Plated', 'Anti-Tarnish', 'Starting at ₹149', 'Zero Green Marks'],
  'rings-under-100': ['18K Gold Plated', 'Anti-Tarnish', 'Starting at ₹149', '15% Off 2+ Stack'],
  'earrings': ['Nickel-Free & Hypoallergenic (Safe for Sensitive Ears)', 'Gold-Plated Bali Hoop & Stud Styles', 'Starting at ₹149']
};

const displayH1 = collectionH1s[category.slug] || category.name;
const highlightPills = collectionHighlightPills[category.slug] || [];
const isRingCluster = ['rings', 'anti-tarnish-minimal-rings', 'rings-under-100'].includes(category.slug);
const isEarringCluster = category.slug === 'earrings';

const heroImage = category.image.replace(/w=\d+/, 'w=900');
const staticSignature = products.map((p) => `${p.id}:${p.pricePaise}`).join('|');
const siblingCollections = CATEGORIES.filter((cat) => cat.slug !== category.slug).slice(0, 4);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[collectionPageSchema, itemListSchema, aggregateOfferSchema, categoryFaqSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <!-- Editorial collection header -->
    <header class="mx-auto max-w-[1440px] px-5 pt-6 sm:px-8 sm:pt-8 lg:px-10">
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol class="flex items-center gap-2 overflow-x-auto whitespace-nowrap text-[10px] uppercase tracking-[0.16em] text-[#8a8279] scrollbar-none">
          <li><a href="/" class="transition-colors hover:text-[#14110f]">Home</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li><a href="/shop" class="transition-colors hover:text-[#14110f]">Shop</a></li>
          <li aria-hidden="true" class="text-[#c5a059]">/</li>
          <li aria-current="page" class="text-[#14110f]">{category.name}</li>
        </ol>
      </nav>

      <div class="grid items-center gap-8 pb-9 lg:grid-cols-12 lg:gap-12 lg:pb-12">
        <div class="lg:col-span-7">
          <p id="collection-tagline" class="eyebrow text-[#8d3f3d]">✦ {category.tagline}</p>
          <h1 id="collection-title" class="font-display mt-3 text-[2.65rem] leading-[0.96] tracking-[-0.035em] sm:text-[4rem] lg:text-[4.65rem]">
            {displayH1}
          </h1>
          <p id="collection-desc" data-speakable class="mt-5 max-w-xl text-[13.5px] leading-relaxed text-[#5f5851]">
            {category.description}
          </p>
          {highlightPills.length > 0 && (
            <div data-collection-pills class="mt-4 flex flex-wrap gap-2">
              {highlightPills.map((pill) => (
                <span class="border border-[#d8c3a6] bg-[#f4efe7] px-3 py-1 text-[10px] font-medium uppercase tracking-[0.14em] text-[#14110f]">
                  {pill}
                </span>
              ))}
            </div>
          )}
          <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
            <span data-collection-starting-price>Starting at ₹149</span>
            <span aria-hidden="true" class="text-[#c5a059]">✦</span>
            <span>Free delivery over ₹499</span>
            <span aria-hidden="true" class="text-[#c5a059]">✦</span>
            <span>24–48h dispatch · COD</span>
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="media-frame aspect-[16/10] overflow-hidden bg-[#f1ece3] sm:aspect-[16/9] lg:aspect-[4/3]">
            <img
              src={heroImage}
              alt={`${category.name} — anti-tarnish waterproof 18K gold jewellery by Satvastones`}
              width="900"
              height="675"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- Category rail -->
    <div class="border-y border-[#e5ded3]">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
        <div class="scrollbar-none flex items-center gap-7 overflow-x-auto py-4 text-[10px] uppercase tracking-[0.16em]">
          <a href="/shop" class="whitespace-nowrap pb-0.5 text-[#7d756c] transition-colors hover:text-[#14110f]">
            All pieces
          </a>
          {CATEGORIES.map((cat) => (
            <a
              href={`/collections/${cat.slug}`}
              aria-current={cat.slug === category.slug ? 'page' : undefined}
              class={`whitespace-nowrap pb-0.5 transition-colors hover:text-[#14110f] ${
                cat.slug === category.slug
                  ? 'border-b border-[#14110f] text-[#14110f]'
                  : 'text-[#7d756c]'
              }`}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-[1440px] px-5 pb-16 pt-8 sm:px-8 lg:px-10">
      {isRingCluster && (
        <aside class="mb-8 border border-[#e0d7c9] bg-[#f4efe7] p-5 sm:p-6" aria-label="Gold ring price transparency guide">
          <div class="grid gap-5 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-7">
              <p class="text-[9px] uppercase tracking-[0.2em] text-[#8d3f3d]">Smart real-gold alternative · Price transparency</p>
              <h2 class="font-display mt-1.5 text-xl text-[#14110f] sm:text-2xl">
                Simple gold ring look for everyday wear — without ₹25,000+ bullion prices.
              </h2>
              <p class="mt-2 text-[12.5px] leading-relaxed text-[#5f5851]">
                Looking for a <strong>simple gold ring for women at a low price</strong>? Our <strong>18K Gold Plated</strong>, <strong>Anti-Tarnish</strong> rings start at <strong data-collection-low-inline>₹149</strong>—crafted on waterproof, skin-safe 316L steel so you get warm real-gold brilliance through showers and handwashing without green finger marks.
              </p>
            </div>
            <div class="overflow-x-auto lg:col-span-5">
              <table class="w-full border-collapse border border-[#ded5c7] bg-white text-left text-[11px]">
                <thead>
                  <tr class="border-b border-[#ded5c7] bg-[#fbf9f5] text-[9px] uppercase tracking-[0.14em] text-[#6f675f]">
                    <th scope="col" class="px-3 py-2">Ring Type</th>
                    <th scope="col" class="px-3 py-2">Typical Price</th>
                    <th scope="col" class="px-3 py-2">Daily Wear</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#ded5c7]">
                  <tr class="font-medium text-[#14110f]">
                    <td class="px-3 py-2 text-[#8d3f3d]">Satvastones 18K PVD</td>
                    <td class="px-3 py-2">₹149 – ₹499</td>
                    <td class="px-3 py-2">Waterproof · Anti-tarnish</td>
                  </tr>
                  <tr class="text-[#5f5851]">
                    <td class="px-3 py-2">Solid 18K/22K Gold</td>
                    <td class="px-3 py-2">₹18,000 – ₹45,000+</td>
                    <td class="px-3 py-2">High theft/loss risk</td>
                  </tr>
                  <tr class="text-[#5f5851]">
                    <td class="px-3 py-2">Local Brass Ring</td>
                    <td class="px-3 py-2">₹50 – ₹99</td>
                    <td class="px-3 py-2">Turns finger green</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </aside>
      )}

      {isEarringCluster && (
        <aside class="mb-8 border border-[#e0d7c9] bg-[#f4efe7] p-5 sm:p-6" aria-label="Sensitive ears and Sona Bali hoop guide">
          <div class="grid gap-4 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-8">
              <p class="text-[9px] uppercase tracking-[0.2em] text-[#8d3f3d]">Sensitive-ear certified · Daily hoop &amp; stud edit</p>
              <h2 class="font-display mt-1.5 text-xl text-[#14110f] sm:text-2xl">
                Nickel-Free &amp; Hypoallergenic (Safe for Sensitive Ears) + Gold-Plated Bali Hoop Earrings.
              </h2>
              <p class="mt-2 text-[12.5px] leading-relaxed text-[#5f5851]">
                Every pair—from featherlight Korean crystal studs to classic <strong>Gold-Plated Bali Hoop Earrings</strong> (the smart everyday alternative to ₹10,000+ traditional <em>sona bali price</em>)—is 100% nickel-free, waterproof, and comfortable for all-day wear starting at <strong data-collection-low-inline>₹149</strong>.
              </p>
            </div>
            <ul class="space-y-1.5 border-t border-[#ded5c7] pt-3 text-[11px] text-[#14110f] lg:col-span-4 lg:border-l lg:border-t-0 lg:pl-5 lg:pt-0">
              <li>✓ <strong>Nickel-Free &amp; Hypoallergenic</strong> (Zero ear redness)</li>
              <li>✓ <strong>18K Gold-Plated Bali Hoops</strong> &amp; Crystal Drops</li>
              <li>✓ <strong>Featherlight (&lt;6g)</strong> · Waterproof &amp; Sweat-Proof</li>
            </ul>
          </div>
        </aside>
      )}

      <!-- Toolbar -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <p id="collection-count-badge" class="text-[10px] uppercase tracking-[0.16em] text-[#8a8279]">
          {products.length > 0 ? `Showing ${products.length} pieces` : 'Live collection'}
        </p>
        <label class="flex items-center gap-2 text-[10px] uppercase tracking-[0.14em] text-[#8a8279]">
          <span>Sort</span>
          <select
            id="collection-sort"
            class="cursor-pointer border border-[#d8d0c4] bg-transparent py-2 pl-2 pr-6 text-[10px] uppercase tracking-[0.12em] text-[#14110f] focus:border-[#14110f] focus:outline-none"
          >
            <option value="curated">Editor's pick</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="name">Name: A–Z</option>
          </select>
        </label>
      </div>

      <div
        id="collection-products-grid"
        data-live-products="collection"
        data-static-signature={staticSignature}
        class="grid grid-cols-2 gap-x-3 gap-y-9 md:grid-cols-3 md:gap-x-5 lg:grid-cols-4 lg:gap-6"
      >
        {products.map((product) => (
          <div class="shop-item" data-price={product.pricePaise} data-name={product.name}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <!-- Stacking nudge -->
      <a
        href="/stack-builder"
        class="group mt-12 flex flex-col justify-between gap-3 border border-[#e0d7c9] bg-[#f4efe7] px-5 py-4 transition-colors hover:border-[#c5a059] sm:flex-row sm:items-center"
      >
        <div class="flex flex-wrap items-baseline gap-3">
          <span class="text-[9px] uppercase tracking-[0.2em] text-[#8d3f3d]">The stacking edit</span>
          <span class="text-[13px] text-[#14110f]">Pair this collection with another — save 15% on two or more.</span>
        </div>
        <span class="flex items-center gap-2 text-[10px] uppercase tracking-[0.16em] text-[#14110f]">
          Build your stack
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      </a>

      <!-- Buying guide + FAQ -->
      <section class="mt-16 grid gap-10 border-t border-[#e5ded3] pt-10 lg:grid-cols-12 lg:gap-14" aria-labelledby="collection-guide-title">
        <div class="lg:col-span-5">
          <p class="eyebrow text-[#8d3f3d]">The buying guide</p>
          <h2 id="collection-guide-title" class="font-display mt-2 text-[1.9rem] leading-tight sm:text-[2.4rem]">
            {category.name},<br class="hidden sm:block" /> explained.
          </h2>
          <div class="mt-4 space-y-3 text-[13px] leading-relaxed text-[#5f5851]">
            {(collectionBuyingGuides[category.slug] || [
              `Every piece in our ${category.name.toLowerCase()} collection is engineered from solid 316L surgical stainless steel with authentic 18K gold vacuum PVD coating. 100% waterproof, sweat-resistant, shower-safe, and guaranteed never to leave green skin marks. All orders are hand-inspected and dispatched from our Vapi store in Gujarat within 24–48 hours.`
            ]).map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.14em]">
            <a href="/materials" class="link-line text-[#14110f]">316L surgical steel</a>
            <a href="/jewellery-care" class="link-line text-[#14110f]">Care guide</a>
            <a href="/faqs" class="link-line text-[#14110f]">Styling FAQ</a>
          </div>

          <div class="mt-8 border-t border-[#e5ded3] pt-5">
            <p class="text-[9px] uppercase tracking-[0.2em] text-[#8a8279]">Continue browsing</p>
            <ul class="mt-3 space-y-2">
              {siblingCollections.map((cat) => (
                <li>
                  <a href={`/collections/${cat.slug}`} class="group flex items-center justify-between gap-3 text-[12px] text-[#14110f]">
                    <span>{cat.name}</span>
                    <span class="text-[#8a8279] transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="border-t border-[#e5ded3] lg:col-span-7">
          {categoryFaqs.map((faq) => (
            <details class="group border-b border-[#e5ded3] py-5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                <h3 class="font-display text-[1.1rem] leading-snug text-[#14110f]">{faq.q}</h3>
                <span class="text-lg text-[#8a8279] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="pt-3 text-[13px] leading-relaxed text-[#5f5851]">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script>
    import { getSiteSettings } from '../../stores/adminStore';
    import { getAllCatalogProducts, syncCatalogFromCloudflare } from '../../stores/catalogStore';

    const grid = document.getElementById('collection-products-grid') as HTMLElement | null;
    const staticSignature = grid?.dataset.staticSignature || '';
    let lastSignature = '';

    const buildSignature = (items: { id: string; pricePaise: number }[]) =>
      items.map((p) => `${p.id}:${p.pricePaise}`).join('|');

    function renderCollectionProducts() {
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (!slug || !grid) return;

      const all = getAllCatalogProducts();
      let matched: typeof all = [];
      if (slug === 'bestsellers') {
        matched = all.filter((p) => p.isBestseller);
      } else if (slug === 'new-arrivals') {
        matched = all.filter((p) => p.isNewArrival);
      } else if (slug === 'gifts-for-girlfriend-under-500') {
        const under500 = all.filter((p) => p.pricePaise <= 50000).sort((a, b) => a.pricePaise - b.pricePaise);
        matched = under500.length ? under500 : all.sort((a, b) => a.pricePaise - b.pricePaise);
      } else if (slug === 'rings-under-100') {
        const rings = all.filter((p) => p.category === 'rings').sort((a, b) => a.pricePaise - b.pricePaise);
        matched = rings.length ? rings : all.filter((p) => p.pricePaise <= 50000).sort((a, b) => a.pricePaise - b.pricePaise);
      } else if (slug === 'anti-tarnish-minimal-rings') {
        const rings = all.filter((p) => p.category === 'rings');
        matched = rings.length ? rings : all;
      } else {
        matched = all.filter((p) => p.category === slug);
      }

      const countBadge = document.getElementById('collection-count-badge');
      if (countBadge) countBadge.textContent = `Showing ${matched.length} pieces`;

      const signature = buildSignature(matched);
      if (signature === lastSignature) return;
      lastSignature = signature;

      // Keep the server-rendered editorial cards when the catalogue is unchanged.
      if (signature === staticSignature) return;

      if (matched.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center">
            <p class="font-display text-2xl text-[#14110f]">No pieces in this collection right now.</p>
            <p class="mt-2 text-xs text-[#8a8279]">Explore the full permanent collection in the atelier shop.</p>
            <a href="/shop" class="mt-5 inline-block bg-[#14110f] px-6 py-3 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8]">Explore shop</a>
          </div>`;
        return;
      }

      grid.innerHTML = matched
        .map((product) => {
          const discountPercent = product.compareAtPricePaise
            ? Math.round(((product.compareAtPricePaise - product.pricePaise) / product.compareAtPricePaise) * 100)
            : 0;
          const primaryImage =
            product.images?.[0]?.url ||
            'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=450&q=80';
          const priceRupees = Math.round(product.pricePaise / 100);
          const compareRupees = product.compareAtPricePaise ? Math.round(product.compareAtPricePaise / 100) : null;

          return `
            <div class="shop-item" data-price="${product.pricePaise}" data-name="${product.name}">
              <div class="product-card group relative flex flex-col">
                <a href="/products/${product.slug}" class="relative block aspect-[3/4] overflow-hidden bg-[#f1ece3]" aria-label="${product.name}">
                  <div class="absolute left-3 top-3 z-10 flex flex-col items-start gap-1.5">
                    ${product.isBestseller ? `<span class="bg-[#14110f] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#f6f1e8]">Bestseller</span>` : ''}
                    ${product.isNewArrival && !product.isBestseller ? `<span class="bg-[#f6f1e8] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-[#14110f]">New</span>` : ''}
                    ${discountPercent > 0 ? `<span class="bg-[#c5a059] px-2.5 py-1 text-[8px] font-medium uppercase tracking-[0.18em] text-white">−${discountPercent}%</span>` : ''}
                  </div>
                  <img src="${primaryImage}" alt="${product.name}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </a>
                <div class="flex flex-1 flex-col gap-2.5 pt-3.5">
                  <div class="min-w-0">
                    <h3 class="font-serif text-[15px] leading-snug text-[#14110f] sm:text-base">
                      <a href="/products/${product.slug}">${product.name}</a>
                    </h3>
                    <p class="mt-1 line-clamp-1 text-[9px] uppercase tracking-[0.14em] text-[#8b837a]">${product.material || product.category || '18K gold PVD'}</p>
                  </div>
                  <div class="mt-auto space-y-2.5">
                    <div class="flex items-baseline gap-2">
                      <span class="text-sm font-medium text-[#14110f] sm:text-[15px]">₹${priceRupees.toLocaleString('en-IN')}</span>
                      ${compareRupees ? `<span class="text-[11px] text-[#a39a91] line-through">₹${compareRupees.toLocaleString('en-IN')}</span>` : ''}
                    </div>
                    <button
                      type="button"
                      data-add-to-bag="${product.id}"
                      data-name="${product.name}"
                      data-slug="${product.slug}"
                      data-price="${product.pricePaise}"
                      data-image="${primaryImage}"
                      class="custom-add-to-bag w-full cursor-pointer border border-[#14110f]/25 py-2.5 text-[9px] font-medium uppercase tracking-[0.2em] text-[#14110f] transition-colors duration-300 hover:border-[#14110f] hover:bg-[#14110f] hover:text-[#f6f1e8]"
                    >
                      Add to bag
                    </button>
                  </div>
                </div>
              </div>
            </div>`;
        })
        .join('');

      grid.querySelectorAll('.custom-add-to-bag').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const target = btn as HTMLElement;
          import('../../stores/cartStore').then(({ addToCart }) => {
            addToCart({
              productId: target.dataset.addToBag || '',
              name: target.dataset.name || '',
              slug: target.dataset.slug || '',
              pricePaise: Number(target.dataset.price || 0),
              image: target.dataset.image || '',
              quantity: 1
            });
          });
        });
      });
    }

    try {
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (slug) {
        const settings = getSiteSettings();
        const customCat = settings.categories?.find((c) => c.slug === slug);
        if (customCat) {
          const titleEl = document.getElementById('collection-title');
          const taglineEl = document.getElementById('collection-tagline');
          const descEl = document.getElementById('collection-desc');

          if (titleEl && customCat.name) titleEl.textContent = customCat.name;
          if (taglineEl && customCat.tagline) taglineEl.textContent = `✦ ${customCat.tagline}`;
          if (descEl && customCat.description) descEl.textContent = customCat.description;
        }
      }
    } catch (e) {
      console.warn('Collection rehydration error:', e);
    }

    renderCollectionProducts();
    syncCatalogFromCloudflare().then(() => renderCollectionProducts());
    window.addEventListener('satvastones:products_updated', renderCollectionProducts);
    document.addEventListener('astro:page-load', () => {
      renderCollectionProducts();
      syncCatalogFromCloudflare().then(() => renderCollectionProducts());
    });

    // Sorting
    const sortSelect = document.getElementById('collection-sort') as HTMLSelectElement | null;
    sortSelect?.addEventListener('change', () => {
      if (!grid) return;
      const items = Array.from(grid.querySelectorAll<HTMLElement>('.shop-item'));
      const mode = sortSelect.value;
      const priceOf = (el: HTMLElement) => Number(el.dataset.price || 0);
      const nameOf = (el: HTMLElement) => (el.dataset.name || '').toLowerCase();

      items.sort((a, b) => {
        if (mode === 'price-asc') return priceOf(a) - priceOf(b);
        if (mode === 'price-desc') return priceOf(b) - priceOf(a);
        if (mode === 'name') return nameOf(a).localeCompare(nameOf(b));
        return 0;
      });
      items.forEach((item) => grid.appendChild(item));
    });
  </script>
</BaseLayout>
