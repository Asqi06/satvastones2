---
import BaseLayout from '../layouts/BaseLayout.astro';
import DPDPNotice from '../components/DPDPNotice';
---

<BaseLayout
  title="Contact Us | Satvastones Anti-Tarnish Jewellery"
  description="Contact Satvastones Customer Support. Dispatched from Vapi, Gujarat. Email: support@satvastones.in."
>
  <!-- Jewelsmars Clean Header -->
  <div class="bg-white border-b border-gray-100 py-8 sm:py-12">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-1">
      <span class="text-xs font-bold uppercase tracking-widest text-[#a1505a]">Get in Touch</span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">Customer Support</h1>
      <p class="text-xs sm:text-sm text-gray-500 max-w-md mx-auto">
        Have questions regarding your order, Vapi dispatch, or jewellery sizing? We're here to assist.
      </p>
    </div>
  </div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16">
    <div class="max-w-3xl mx-auto space-y-8">
      
      <!-- Contact Information Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="bg-white p-6 border border-gray-200 rounded-[22px] space-y-3 shadow-xs">
          <div class="w-10 h-10 rounded-full bg-rose-50 text-[#f2707f] flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-gray-900">Direct Support Concierge</h2>
          <div class="space-y-1.5 text-xs text-gray-600">
            <p><strong class="text-gray-900">Email:</strong> <a href="mailto:support@satvastones.in" class="text-[#f2707f] font-bold underline">support@satvastones.in</a></p>
            <p><strong class="text-gray-900">Customer Helpline:</strong> <a href="tel:+919016703180" class="text-[#f2707f] font-bold underline">+91 90167 03180</a></p>
            <p><strong class="text-gray-900">WhatsApp Support:</strong> <a href="https://wa.me/919016703180" target="_blank" rel="noopener noreferrer" class="text-[#25D366] font-bold underline">+91 90167 03180 (Live Chat)</a></p>
            <p><strong class="text-gray-900">Support Hours:</strong> Mon – Sat (10:00 AM – 7:00 PM IST)</p>
            <p><strong class="text-gray-900">Response Window:</strong> Instant on WhatsApp / 12–24h by Email</p>
          </div>
        </div>

        <div class="bg-white p-6 border border-gray-200 rounded-[22px] space-y-3 shadow-xs">
          <div class="w-10 h-10 rounded-full bg-rose-50 text-[#f2707f] flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-gray-900">Vapi Store & Legal Entity</h2>
          <div class="space-y-1.5 text-xs text-gray-600">
            <p><strong class="text-gray-900">Brand:</strong> Satvastones Fine Jewellery</p>
            <p><strong class="text-gray-900">Legal Entity:</strong> Sole Proprietorship of <strong>Anirudh A Verma</strong></p>
            <p><strong class="text-gray-900">GSTIN:</strong> 24DDAPV4074H1ZF</p>
            <p><strong class="text-gray-900">Address & Atelier:</strong> Chala, Vapi, Gujarat - 396191, India</p>
            <p><strong class="text-gray-900">Dispatch Window:</strong> Hand-inspected in 24–48 hours</p>
          </div>
        </div>
      </div>

      <!-- Quick Message Form -->
      <div class="bg-white p-6 sm:p-8 border border-gray-200 rounded-[22px] space-y-4 shadow-xs">
        <h3 class="text-lg font-bold text-gray-900">Send Us a Direct Message</h3>
        <form class="space-y-3.5" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received by our Vapi team.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Your Name *</label>
              <input
                type="text"
                required
                placeholder="Priya Sharma"
                class="w-full bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Your Email *</label>
              <input
                type="email"
                required
                placeholder="priya@example.com"
                class="w-full bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Order Reference (If Applicable)</label>
            <input
              type="text"
              placeholder="e.g. SAT-2026-102948"
              class="w-full bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs uppercase tracking-wider rounded-xl focus:outline-none focus:border-[#f2707f]"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Your Message *</label>
            <textarea
              rows="4"
              required
              placeholder="How can we assist you today?"
              class="w-full bg-gray-50 border border-gray-200 px-4 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
            ></textarea>
          </div>

          <!-- DPDP Statutory Collection Notice with Hindi / English Switcher -->
          <DPDPNotice client:load context="contact" />

          <button
            type="submit"
            class="w-full sm:w-auto bg-[#f2707f] hover:bg-[#e05e6d] text-white px-8 py-3 text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg shadow-[#f2707f]/25 transition-all cursor-pointer"
          >
            Submit Enquiry →
          </button>
        </form>
      </div>

      <!-- Policy Transparency Strip -->
      <div class="p-4 bg-[#fffafb] border border-[#f9d8dc] rounded-[18px] text-xs text-gray-600 space-y-1">
        <p class="font-bold text-gray-900">Helpful Reminders:</p>
        <p>• Orders are dispatched from Vapi (Gujarat) in 24–48 hours.</p>
        <p>• Order cancellation is accepted anytime prior to courier dispatch.</p>
        <p>• No cash refunds; transit damage claims require an unedited 360° unboxing video proof.</p>
      </div>

    </div>
  </div>
</BaseLayout>
