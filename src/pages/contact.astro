---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import DPDPNotice from '../components/DPDPNotice';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact' }
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Satvastones Jewellery',
  description:
    'Reach the Satvastones support team in Vapi, Gujarat. WhatsApp, email and phone support for orders, sizing and dispatch questions.',
  url: 'https://www.satvastones.in/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'Satvastones Fine Jewellery',
    email: 'support@satvastones.in',
    telephone: '+91-90167-03180',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Chala',
      addressLocality: 'Vapi',
      addressRegion: 'Gujarat',
      postalCode: '396191',
      addressCountry: 'IN'
    }
  }
};
---

<BaseLayout
  title="Contact Us | Satvastones Anti-Tarnish Jewellery"
  description="Contact Satvastones customer support in Vapi, Gujarat. WhatsApp for instant replies, email for order, sizing and dispatch questions. Mon–Sat, 10 AM–7 PM IST."
  schema={contactSchema}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-[#fbf9f5] text-[#14110f]">
    <PageIntro
      eyebrow="Get in touch"
      title="A real person answers."
      lede="Order questions, sizing help, dispatch updates or a repair — WhatsApp is fastest, email reaches the same small team in Vapi."
      crumbs={breadcrumbs}
    >
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://wa.me/919016703180"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#14110f] px-6 py-3.5 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#2f7d5a]"
        >
          WhatsApp us <span aria-hidden="true">→</span>
        </a>
        <a
          href="mailto:support@satvastones.in"
          class="inline-flex items-center justify-center gap-2 border border-[#14110f] px-6 py-3.5 text-[10px] uppercase tracking-[0.16em] text-[#14110f] transition-colors hover:bg-[#f4efe7]"
        >
          support@satvastones.in
        </a>
      </div>
    </PageIntro>

    <!-- Contact details -->
    <section class="mx-auto max-w-[1440px] px-5 pb-16 sm:px-8 sm:pb-20 lg:px-10" aria-labelledby="contact-details-title">
      <h2 id="contact-details-title" class="sr-only">How to reach us</h2>

      <div class="grid grid-cols-1 gap-px bg-[#ded5c7] lg:grid-cols-3">
        <!-- Channel -->
        <div class="bg-[#fbf9f5] px-6 py-7">
          <span class="text-[9px] uppercase tracking-[0.24em] text-[#c5a059]">01 · Channels</span>
          <h3 class="font-display mt-2 text-[1.35rem] leading-tight">Talk to support</h3>
          <dl class="mt-4 space-y-3 text-[12px] leading-relaxed">
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">WhatsApp</dt>
              <dd class="mt-0.5">
                <a href="https://wa.me/919016703180" target="_blank" rel="noopener noreferrer" class="text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4 hover:text-[#2f7d5a]">
                  +91 90167 03180
                </a>
                <span class="text-[#8a8279]"> · fastest</span>
              </dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Email</dt>
              <dd class="mt-0.5">
                <a href="mailto:support@satvastones.in" class="text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4 hover:text-[#8d3f3d]">
                  support@satvastones.in
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Phone</dt>
              <dd class="mt-0.5">
                <a href="tel:+919016703180" class="text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4 hover:text-[#8d3f3d]">
                  +91 90167 03180
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Hours</dt>
              <dd class="mt-0.5 text-[#4a443f]">Mon–Sat · 10:00–19:00 IST</dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Reply window</dt>
              <dd class="mt-0.5 text-[#4a443f]">Instant on WhatsApp · 12–24h by email</dd>
            </div>
          </dl>
        </div>

        <!-- Entity -->
        <div class="bg-[#fbf9f5] px-6 py-7">
          <span class="text-[9px] uppercase tracking-[0.24em] text-[#c5a059]">02 · Entity</span>
          <h3 class="font-display mt-2 text-[1.35rem] leading-tight">Vapi atelier</h3>
          <dl class="mt-4 space-y-3 text-[12px] leading-relaxed">
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Brand</dt>
              <dd class="mt-0.5 text-[#4a443f]">Satvastones Fine Jewellery</dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Legal entity</dt>
              <dd class="mt-0.5 text-[#4a443f]">Sole proprietorship — Anirudh A Verma</dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">GSTIN</dt>
              <dd class="mt-0.5 text-[#4a443f]">24DDAPV4074H1ZF</dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Address</dt>
              <dd class="mt-0.5 text-[#4a443f]">Chala, Vapi, Gujarat 396191, India</dd>
            </div>
            <div>
              <dt class="text-[9px] uppercase tracking-[0.16em] text-[#8a8279]">Dispatch</dt>
              <dd class="mt-0.5 text-[#4a443f]">Hand-inspected in 24–48 hours</dd>
            </div>
          </dl>
        </div>

        <!-- Helpful -->
        <div class="bg-[#fbf9f5] px-6 py-7">
          <span class="text-[9px] uppercase tracking-[0.24em] text-[#c5a059]">03 · Before you write</span>
          <h3 class="font-display mt-2 text-[1.35rem] leading-tight">Quick answers</h3>
          <ul class="mt-4 space-y-3 text-[12px] leading-relaxed text-[#4a443f]">
            <li class="flex gap-2.5">
              <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
              <span>Orders dispatch from Vapi in 24–48 hours. <a href="/track-order" class="underline decoration-[#d8c3a6] underline-offset-4 hover:text-[#8d3f3d]">Track yours</a>.</span>
            </li>
            <li class="flex gap-2.5">
              <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
              <span>Cancellations are free before dispatch; no cash refunds. <a href="/refund-policy" class="underline decoration-[#d8c3a6] underline-offset-4 hover:text-[#8d3f3d]">Read the policy</a>.</span>
            </li>
            <li class="flex gap-2.5">
              <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
              <span>Transit damage needs an uncut 360° unboxing video. <a href="/faqs" class="underline decoration-[#d8c3a6] underline-offset-4 hover:text-[#8d3f3d]">See the FAQ</a>.</span>
            </li>
            <li class="flex gap-2.5">
              <span class="mt-1 text-[#c5a059]" aria-hidden="true">✦</span>
              <span>Sizing charts and ring sizes sit on every product page.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section class="border-y border-[#e5ded3] bg-[#f4efe7]" aria-labelledby="contact-form-title">
      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:px-10">
        <div class="lg:col-span-4">
          <p class="eyebrow text-[#8d3f3d]">Write to us</p>
          <h2 id="contact-form-title" class="font-display mt-2 text-[2.1rem] leading-[1.02] sm:text-[2.9rem]">
            Send the details.<br />We'll take it from there.
          </h2>
          <p class="mt-3 max-w-xs text-[12.5px] leading-relaxed text-[#5f5851]">
            The form opens your email app with everything filled in, so your message reaches a real inbox. Nothing is stored on this page.
          </p>
          <p class="mt-5 text-[10px] uppercase tracking-[0.16em] text-[#8a8279]">Include if you can</p>
          <ul class="mt-2 space-y-1.5 text-[12px] leading-relaxed text-[#4a443f]">
            <li>Your order reference (SAT-2026-…)</li>
            <li>The piece name or product link</li>
            <li>A photo for damage or fault claims</li>
          </ul>
        </div>

        <div class="lg:col-span-8">
          <form id="contact-form" class="border border-[#e0d7c9] bg-[#fbf9f5] p-5 sm:p-8" novalidate>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="contact-name" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Your name *</label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Priya Sharma"
                  class="contact-input"
                />
              </div>
              <div>
                <label for="contact-email" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Your email *</label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="priya@example.com"
                  class="contact-input"
                />
              </div>
            </div>

            <div class="mt-4">
              <label for="contact-order" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Order reference (optional)</label>
              <input
                id="contact-order"
                name="order"
                type="text"
                placeholder="e.g. SAT-2026-102948"
                class="contact-input uppercase tracking-[0.08em]"
              />
            </div>

            <div class="mt-4">
              <label for="contact-message" class="mb-1.5 block text-[10px] uppercase tracking-[0.14em] text-[#6f675f]">Your message *</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="How can we help?"
                class="contact-input resize-y leading-relaxed"
              ></textarea>
            </div>

            <p id="contact-form-error" class="mt-3 hidden border-l-2 border-[#8d3f3d] bg-[#f8eeee] px-3 py-2 text-[11px] leading-relaxed text-[#8d3f3d]" role="alert"></p>

            <div class="mt-5">
              <DPDPNotice client:load context="contact" />
            </div>

            <button
              type="submit"
              class="mt-4 flex w-full cursor-pointer items-center justify-center gap-2 bg-[#14110f] px-8 py-4 text-[10px] font-medium uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d] sm:w-auto"
            >
              Open email draft <span aria-hidden="true">→</span>
            </button>

            <p id="contact-form-status" class="mt-3 hidden text-[11px] leading-relaxed text-[#2f7d5a]"></p>
            <p class="mt-3 text-[10px] leading-relaxed text-[#8a8279]">
              Prefer not to use email? <a href="https://wa.me/919016703180" target="_blank" rel="noopener noreferrer" class="text-[#14110f] underline decoration-[#d8c3a6] underline-offset-4">WhatsApp</a> gets a reply fastest.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10" aria-labelledby="contact-cta-title">
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow text-[#8d3f3d]">Keep browsing</p>
          <h2 id="contact-cta-title" class="font-display mt-2 text-[2.1rem] leading-[1.02] sm:text-[3rem]">
            The answer might<br class="hidden sm:block" /> already be here.
          </h2>
          <p class="mt-3 max-w-md text-[13px] leading-relaxed text-[#5f5851]">
            Materials science, the care ritual, and every dispatch and returns rule are written out in full.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <a href="/faqs" class="inline-flex items-center justify-center gap-2 bg-[#14110f] px-7 py-4 text-[10px] uppercase tracking-[0.16em] text-[#f6f1e8] transition-colors hover:bg-[#8d3f3d]">
            Read the FAQs <span aria-hidden="true">→</span>
          </a>
          <a href="/shop" class="inline-flex items-center justify-center gap-2 border border-[#14110f] px-7 py-4 text-[10px] uppercase tracking-[0.16em] text-[#14110f] transition-colors hover:bg-[#f4efe7]">
            Shop all pieces
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-input {
    display: block;
    width: 100%;
    border: 1px solid #d8d0c4;
    background-color: #ffffff;
    padding: 0.7rem 0.875rem;
    font-size: 12px;
    color: #14110f;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .contact-input::placeholder {
    color: #9a938b;
  }

  .contact-input:focus {
    border-color: #14110f;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('contact-form-error');
  const statusEl = document.getElementById('contact-form-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim() || '';
    const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim() || '';
    const order = (document.getElementById('contact-order') as HTMLInputElement)?.value.trim() || '';
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim() || '';

    const fail = (text: string, fieldId: string) => {
      if (errorEl) {
        errorEl.textContent = text;
        errorEl.classList.remove('hidden');
      }
      if (statusEl) statusEl.classList.add('hidden');
      document.getElementById(fieldId)?.focus();
    };

    if (!name) return fail('Please add your name so we know who we are replying to.', 'contact-name');
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return fail('Please add a valid email address for our reply.', 'contact-email');
    }
    if (!message) return fail('Please write a short message so we can help.', 'contact-message');

    errorEl?.classList.add('hidden');

    const subject = `Website enquiry${order ? ` · ${order}` : ''} · ${name}`;
    const body = [
      `Name: ${name}`,
      `Email: ${email}`,
      order ? `Order reference: ${order}` : '',
      '',
      message
    ]
      .filter(Boolean)
      .join('\n');

    window.location.href = `mailto:support@satvastones.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    if (statusEl) {
      statusEl.textContent = 'Your email app should open with the message ready to send. If it does not, write to support@satvastones.in directly.';
      statusEl.classList.remove('hidden');
    }
  });
</script>
