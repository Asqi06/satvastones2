---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Care Guide', url: '/jewellery-care' }
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'How to Clean Gold and Anti-Tarnish Jewellery at Home',
  'description': 'A safe, step-by-step DIY cleaning ritual for solid gold, 18K gold PVD, and 316L stainless steel jewellery without abrasive scratching.',
  'totalTime': 'PT15M',
  'supply': [
    { '@type': 'HowToSupply', 'name': 'Lukewarm water' },
    { '@type': 'HowToSupply', 'name': 'Mild liquid dish soap or baby shampoo' },
    { '@type': 'HowToSupply', 'name': 'Microfiber polishing cloth or velvet pouch' }
  ],
  'tool': [
    { '@type': 'HowToTool', 'name': 'Ultra-soft baby toothbrush' }
  ],
  'step': [
    {
      '@type': 'HowToStep',
      'name': 'Warm Soapy Soak',
      'text': 'Submerge jewellery in a bowl of lukewarm water with 2-3 drops of mild baby shampoo or dish soap for 10-15 minutes.',
      'position': 1
    },
    {
      '@type': 'HowToStep',
      'name': 'Gentle Soft-Bristle Clean',
      'text': 'Use an ultra-soft baby toothbrush to gently remove lotion and sweat buildup around crevices and clasps without scrubbing harshly.',
      'position': 2
    },
    {
      '@type': 'HowToStep',
      'name': 'Fresh Water Rinse',
      'text': 'Rinse thoroughly under running lukewarm water to eliminate all soap residue.',
      'position': 3
    },
    {
      '@type': 'HowToStep',
      'name': 'Microfiber Pat Dry',
      'text': 'Gently pat dry with a lint-free microfiber cloth or your Satvastones velvet pouch before wearing or storing.',
      'position': 4
    }
  ]
};
---

<BaseLayout
  title="How to Clean Gold Jewellery at Home & Care Ritual | Satvastones"
  description="Learn how to clean gold and anti-tarnish jewellery safely at home using mild soap and microfiber. Understand why 316L PVD gold resists fading."
  schema={howToSchema}
  breadcrumbs={breadcrumbs}
>
  <!-- Jewelsmars Clean Header -->
  <div class="bg-white border-b border-gray-100 py-8 sm:py-12">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-2">
      <span class="inline-block bg-[#ffe7e9] text-[#a1505a] text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full">
        Longevity &amp; Care Ritual
      </span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        How to Clean Gold Jewellery at Home
      </h1>
      <p class="text-xs sm:text-sm text-gray-500 max-w-lg mx-auto leading-relaxed">
        Satvastones jewellery is engineered with 316L surgical stainless steel and 18K Gold PVD coating. Follow this simple ritual to maintain brilliant golden luster for years.
      </p>
    </div>
  </div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16">
    <div class="max-w-3xl mx-auto space-y-12">
      
      <!-- Visual Banner -->
      <div class="aspect-[16/9] bg-gray-50 rounded-[24px] overflow-hidden border border-gray-100 shadow-sm">
        <img
          src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1200&q=80"
          alt="Satvastones jewellery care and cleaning at home"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Step-by-Step DIY Cleaning Guide -->
      <div class="bg-white p-6 sm:p-8 border border-gray-200 rounded-[22px] space-y-6 shadow-2xs">
        <div class="border-b border-gray-100 pb-3">
          <span class="text-xs font-bold text-[#a1505a] uppercase tracking-wider">Step-by-Step DIY Guide</span>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
            4 Simple Steps to Clean Gold &amp; Anti-Tarnish Jewellery
          </h2>
          <p class="text-xs text-gray-500 mt-1">
            Safe for 18K gold PVD, solid gold, cubic zirconia, and stainless steel.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-gray-50 rounded-xl space-y-2 border border-gray-100">
            <span class="w-7 h-7 rounded-full bg-[#ffe7e9] text-[#a1505a] flex items-center justify-center font-bold text-xs">
              1
            </span>
            <h3 class="font-bold text-sm text-gray-900">Lukewarm Soapy Soak</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Mix lukewarm water with 2–3 drops of mild, ammonia-free liquid dish soap or baby shampoo. Soak for 10–15 minutes to loosen daily oils, sweat, and cosmetics.
            </p>
          </div>

          <div class="p-4 bg-gray-50 rounded-xl space-y-2 border border-gray-100">
            <span class="w-7 h-7 rounded-full bg-[#ffe7e9] text-[#a1505a] flex items-center justify-center font-bold text-xs">
              2
            </span>
            <h3 class="font-bold text-sm text-gray-900">Soft-Bristle Gentle Cleaning</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Use an ultra-soft baby toothbrush or gentle cosmetic brush to delicately clean around prong settings, clasps, and chain links without harsh scrubbing.
            </p>
          </div>

          <div class="p-4 bg-gray-50 rounded-xl space-y-2 border border-gray-100">
            <span class="w-7 h-7 rounded-full bg-[#ffe7e9] text-[#a1505a] flex items-center justify-center font-bold text-xs">
              3
            </span>
            <h3 class="font-bold text-sm text-gray-900">Warm Running Water Rinse</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Hold your pieces under gentle running lukewarm water to rinse away all loosened soap films. Remember to cover your sink drain with a strainer plug.
            </p>
          </div>

          <div class="p-4 bg-gray-50 rounded-xl space-y-2 border border-gray-100">
            <span class="w-7 h-7 rounded-full bg-[#ffe7e9] text-[#a1505a] flex items-center justify-center font-bold text-xs">
              4
            </span>
            <h3 class="font-bold text-sm text-gray-900">Microfiber Pat Dry</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Gently pat dry using the complimentary Satvastones velvet pouch or a clean lint-free microfiber cloth. Ensure the piece is completely dry before wearing.
            </p>
          </div>
        </div>

        <!-- Warning Callout -->
        <div class="p-4 bg-rose-50/60 rounded-xl border border-rose-100 text-xs text-rose-900 space-y-1">
          <strong class="font-bold flex items-center gap-1.5">
            <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <span>What NOT to use on gold and PVD jewellery:</span>
          </strong>
          <p class="text-rose-800 leading-relaxed pl-5.5">
            Never use toothpaste, baking soda pastes, chemical silver dips, vinegar, or industrial chlorine bleach. These substances contain abrasive micro-granules or acidic chemicals that will abrade and degrade the smooth 18K gold luster.
          </p>
        </div>
      </div>

      <!-- Core Care Rules -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <div class="bg-white p-6 border border-gray-200 rounded-[20px] space-y-2.5 shadow-2xs">
          <div class="w-9 h-9 rounded-full bg-[#ffe7e9] text-[#a1505a] flex items-center justify-center font-bold text-sm">
            1
          </div>
          <h3 class="text-base font-bold text-gray-900">The "Last On, First Off" Rule</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Apply perfumes, moisturizers, hair sprays, and sanitizers <em>before</em> putting on your jewellery. Allow lotions to absorb completely so propellant chemicals do not leave surface residue.
          </p>
        </div>

        <div class="bg-white p-6 border border-gray-200 rounded-[20px] space-y-2.5 shadow-2xs">
          <div class="w-9 h-9 rounded-full bg-[#ffe7e9] text-[#a1505a] flex items-center justify-center font-bold text-sm">
            2
          </div>
          <h3 class="text-base font-bold text-gray-900">Post-Pool &amp; Ocean Fresh Rinse</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            While our 316L steel handles regular shower water and sweat with ease, pool chlorine and ocean salt can leave dried mineral deposits. Rinse with fresh water and pat dry.
          </p>
        </div>
      </div>

      <!-- Honest Shine Disclosure Card -->
      <div class="p-6 bg-rose-50/40 border border-rose-100 rounded-2xl space-y-2">
        <h4 class="text-sm font-bold text-gray-900 flex items-center gap-2">
          <svg class="w-4 h-4 text-[#a1505a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
          <span>Does Anti-Tarnish Jewellery Fade? Our Honest Policy</span>
        </h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          We pride ourselves on 100% transparency. Medical-grade 316L surgical stainless steel itself will never rust, turn black, or oxidize green. Our 18K vacuum PVD coating is atom-bonded and up to 10 times more durable than conventional flash plating, resisting showers, sweat, and daily wear for years. While no physical object is immune to heavy chemical scrubbing or abrasive sanding, standard mindful wear guarantees years of radiant golden luster.
        </p>
      </div>

      <div class="text-center pt-2">
        <a
          href="/shop"
          class="inline-block bg-[#f2707f] hover:bg-[#e05e6d] text-white px-8 py-3.5 text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg shadow-[#f2707f]/25 transition-all"
        >
          Shop Waterproof Jewellery &rarr;
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
