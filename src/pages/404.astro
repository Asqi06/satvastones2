---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Satvastones Anti-Tarnish Jewellery"
  description="The page you are looking for does not exist."
>
  <!-- Standard 404 Display -->
  <div id="default-404-view" class="min-h-[70vh] flex items-center justify-center py-16 px-4 text-center bg-white">
    <div class="max-w-md space-y-5 bg-white p-8 sm:p-10 border border-gray-200 rounded-[24px] shadow-xs">
      <div class="w-14 h-14 rounded-full bg-rose-50 text-[#f2707f] flex items-center justify-center mx-auto">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
      </div>
      <h2 class="text-6xl font-extrabold text-gray-900 tracking-tight">404</h2>
      
      <div class="space-y-2">
        <h1 class="text-xl font-bold text-gray-900">Piece Not Found</h1>
        <p class="text-xs text-gray-500 leading-relaxed">
          The piece or suite you are searching for may have been moved or is currently being restocked in our Vapi atelier.
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/shop"
          class="inline-block bg-[#171513] hover:bg-[#9f4553] text-white px-8 py-3.5 text-xs font-bold uppercase tracking-wider rounded-xl shadow-md transition-all"
        >
          Explore All Jewellery →
        </a>
      </div>
    </div>
  </div>

  <!-- Dynamic Fallback Product Container (Activated for custom Admin Products) -->
  <div id="dynamic-product-view" class="hidden min-h-screen py-10 px-4 sm:px-6 lg:px-8 max-w-[1440px] mx-auto">
    <!-- Populated dynamically via script below -->
  </div>
</BaseLayout>

<script>
  import { getAllCatalogProducts, syncCatalogFromCloudflare } from '../stores/catalogStore';
  import { addToCart } from '../stores/cartStore';

  async function checkAndRenderDynamicProduct() {
    const path = window.location.pathname;
    if (!path.startsWith('/products/')) return;

    const slug = path.replace('/products/', '').replace(/\/$/, '');
    if (!slug) return;

    // Check catalog products
    let all = getAllCatalogProducts();
    let product = all.find((p) => p.slug === slug);

    if (!product) {
      try {
        const res = await fetch(`/api/products?slug=${encodeURIComponent(slug)}`);
        const data = await res.json();
        if (data?.success && data?.products?.length > 0) {
          product = data.products[0];
        }
      } catch (_) {}
    }

    if (!product) return;

    // Found dynamic product: hide 404 and render product detail page
    const defaultView = document.getElementById('default-404-view');
    const dynamicView = document.getElementById('dynamic-product-view');

    if (defaultView) defaultView.classList.add('hidden');
    if (dynamicView) {
      document.title = `${product.name} | Satvastones Atelier`;
      const priceRupees = Math.round(product.pricePaise / 100);
      const compareRupees = product.compareAtPricePaise ? Math.round(product.compareAtPricePaise / 100) : null;
      const primaryImage = product.images?.[0]?.url || 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1000&q=80';

      dynamicView.innerHTML = `
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14">
          <!-- Image Gallery -->
          <div class="space-y-4">
            <div class="aspect-[3/4] bg-[#faf8f5] rounded-[24px] overflow-hidden border border-[#eae4dc]">
              <img src="${primaryImage}" alt="${product.name}" class="w-full h-full object-cover" />
            </div>
          </div>

          <!-- Product Buy Box -->
          <div class="space-y-6">
            <div>
              <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] text-[#9f4553]">
                <span class="text-[#c5a059]">✦</span> ${product.category?.toUpperCase() || 'ATELIER SUITE'}
              </span>
              <h1 class="font-serif text-3xl sm:text-4xl font-normal text-[#171513] mt-1 tracking-tight">
                ${product.name}
              </h1>
              <p class="text-xs text-[#6e6863] mt-1">${product.headline || ''}</p>
            </div>

            <!-- Price -->
            <div class="flex items-baseline gap-3 pb-4 border-b border-[#eae4dc]">
              <span class="font-serif font-bold text-2xl sm:text-3xl text-[#171513]">
                ₹${priceRupees.toLocaleString('en-IN')}
              </span>
              ${
                compareRupees
                  ? `<span class="text-sm text-[#8c827a] line-through">₹${compareRupees.toLocaleString('en-IN')}</span>`
                  : ''
              }
              <span class="text-[11px] font-bold text-[#1b6d48] bg-[#eef8f3] px-2.5 py-0.5 rounded-full border border-[#c4e8d3]">
                Inclusive of all taxes &amp; GST
              </span>
            </div>

            <!-- Hallmarks -->
            <div class="grid grid-cols-3 gap-2 py-3 bg-[#faf8f5] p-3 rounded-2xl border border-[#eae4dc] text-center text-xs">
              <div>
                <span class="block text-base">💧</span>
                <span class="font-bold text-[#171513] text-[11px]">100% Waterproof</span>
              </div>
              <div>
                <span class="block text-base">🛡️</span>
                <span class="font-bold text-[#171513] text-[11px]">316L Surgical Steel</span>
              </div>
              <div>
                <span class="block text-base">⚡</span>
                <span class="font-bold text-[#171513] text-[11px]">24-48h Vapi Dispatch</span>
              </div>
            </div>

            <!-- CTAs -->
            <div class="space-y-3 pt-2">
              <button
                id="dynamic-add-to-bag-btn"
                class="w-full bg-[#171513] hover:bg-black text-white py-4 rounded-full font-bold text-xs uppercase tracking-widest transition-all shadow-md active:scale-98"
              >
                Add to Shopping Bag
              </button>
              <button
                id="dynamic-buy-now-btn"
                class="w-full bg-[#9f4553] hover:bg-[#853844] text-white py-4 rounded-full font-bold text-xs uppercase tracking-widest transition-all shadow-md active:scale-98"
              >
                Instant 1-Click Checkout
              </button>
            </div>
          </div>
        </div>
      `;

      dynamicView.classList.remove('hidden');

      // Wire Dynamic CTAs
      document.getElementById('dynamic-add-to-bag-btn')?.addEventListener('click', () => {
        addToCart({
          productId: product.id,
          name: product.name,
          slug: product.slug,
          pricePaise: product.pricePaise,
          image: primaryImage,
          quantity: 1
        });
        window.dispatchEvent(new CustomEvent('satvastones:open_cart'));
      });

      document.getElementById('dynamic-buy-now-btn')?.addEventListener('click', () => {
        addToCart({
          productId: product.id,
          name: product.name,
          slug: product.slug,
          pricePaise: product.pricePaise,
          image: primaryImage,
          quantity: 1
        });
        window.location.href = '/checkout';
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAndRenderDynamicProduct);
  } else {
    checkAndRenderDynamicProduct();
  }
</script>
