---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Satvastones Anti-Tarnish Jewellery"
  description="The page you are looking for does not exist."
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 text-center bg-white">
    <div class="max-w-md space-y-5 bg-white p-8 sm:p-10 border border-gray-200 rounded-[24px] shadow-xs">
      <div class="w-14 h-14 rounded-full bg-rose-50 text-[#f2707f] flex items-center justify-center mx-auto">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
      </div>
      <h2 class="text-6xl font-extrabold text-gray-900 tracking-tight">404</h2>
      
      <div class="space-y-2">
        <h1 class="text-xl font-bold text-gray-900">Page Not Found</h1>
        <p class="text-xs text-gray-500 leading-relaxed">
          The piece or collection you are looking for may have been moved or is currently being restocked in our Vapi store.
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/shop"
          class="inline-block bg-[#f2707f] hover:bg-[#e05e6d] text-white px-8 py-3.5 text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg shadow-[#f2707f]/25 transition-all"
        >
          Explore All Jewellery →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
