    dynamicView.classList.remove('hidden');

    // ==========================================
    // Interactive Event Listeners for Dynamic PDP
    // ==========================================

    // 1. Gallery Thumbnails
    const mainImgEl = document.getElementById('pdp-main-image') as HTMLImageElement;
    const thumbBtns = document.querySelectorAll('.pdp-thumb-btn');
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        const src = el.dataset.imgSrc;
        const alt = el.dataset.imgAlt;
        if (mainImgEl && src) {
          mainImgEl.src = src;
          if (alt) mainImgEl.alt = alt;
        }
        thumbBtns.forEach((b) => b.classList.remove('border-[#171513]', 'shadow-xs'));
        thumbBtns.forEach((b) => b.classList.add('border-[#eae4dc]'));
        el.classList.remove('border-[#eae4dc]');
        el.classList.add('border-[#171513]', 'shadow-xs');
      });
    });

    // 2. Quantity Stepper
    let currentQty = 1;
    const qtyVal = document.getElementById('pdp-qty-val');
    document.getElementById('pdp-qty-minus')?.addEventListener('click', () => {
      if (currentQty > 1) {
        currentQty -= 1;
        if (qtyVal) qtyVal.textContent = String(currentQty);
      }
    });
    document.getElementById('pdp-qty-plus')?.addEventListener('click', () => {
      if (currentQty < 10) {
        currentQty += 1;
        if (qtyVal) qtyVal.textContent = String(currentQty);
      }
    });

    // 3. Add to Bag & Buy Now
    const handleAddToCartAction = () => {
      addToCart({
        productId: product!.id,
        name: product!.name,
        slug: product!.slug,
        pricePaise: product!.pricePaise,
        image: primaryImage,
        quantity: currentQty
      });
      window.dispatchEvent(new CustomEvent('satvastones:open_cart'));
    };

    document.getElementById('pdp-add-to-cart')?.addEventListener('click', handleAddToCartAction);
    document.getElementById('sticky-add-btn')?.addEventListener('click', handleAddToCartAction);

    document.getElementById('pdp-buy-now')?.addEventListener('click', () => {
      addToCart({
        productId: product!.id,
        name: product!.name,
        slug: product!.slug,
        pricePaise: product!.pricePaise,
        image: primaryImage,
        quantity: currentQty
      });
    });

    // 4. Wishlist Button
    const wishlistHeart = document.getElementById('pdp-wishlist-heart');
    if (wishlistHeart) {
      if (isInWishlist(product.id)) {
        wishlistHeart.classList.add('text-[#9f4553]');
        wishlistHeart.querySelector('svg')?.classList.add('fill-[#9f4553]');
      }
      wishlistHeart.addEventListener('click', () => {
        const isSaved = toggleWishlist(product!);
        if (isSaved) {
          wishlistHeart.classList.add('text-[#9f4553]');
          wishlistHeart.querySelector('svg')?.classList.add('fill-[#9f4553]');
        } else {
          wishlistHeart.classList.remove('text-[#9f4553]');
          wishlistHeart.querySelector('svg')?.classList.remove('fill-[#9f4553]');
        }
      });
    }

    // 5. PIN Code Delivery Checker
    document.getElementById('check-pincode-btn')?.addEventListener('click', () => {
      const pinInput = document.getElementById('pincode-input') as HTMLInputElement;
      const pinMsg = document.getElementById('pincode-msg');
      const code = pinInput?.value.trim();
      if (code && code.length === 6 && /^\d+$/.test(code)) {
        if (pinMsg) {
          pinMsg.textContent = `Express Delivery available to PIN ${code} (2-4 business days from Vapi dispatch)`;
          pinMsg.className = 'text-xs mt-2 text-emerald-700 font-medium block';
        }
      } else {
        if (pinMsg) {
          pinMsg.textContent = 'Please enter a valid 6-digit Indian PIN code.';
          pinMsg.className = 'text-xs mt-2 text-red-600 font-medium block';
        }
      }
    });

    // 6. Ring Sizer Trigger
    document.getElementById('pdp-ring-sizer-trigger')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('satvastones:open_ring_sizer'));
    });

    // 7. Bundle Engine
    const bundleCheckboxes = document.querySelectorAll('.bundle-item-check') as NodeListOf<HTMLInputElement>;
    const bundleAddBtn = document.getElementById('bundle-add-btn') as HTMLButtonElement | null;
    const bundleRawRow = document.getElementById('bundle-raw-row');
    const bundleRawVal = document.getElementById('bundle-raw-val');
    const bundleSavingsRow = document.getElementById('bundle-savings-row');
    const bundleSavingsVal = document.getElementById('bundle-savings-val');
    const bundleFinalVal = document.getElementById('bundle-final-val');

    const updateBundleCalc = () => {
      const checked = Array.from(document.querySelectorAll('.bundle-item-check:checked') as NodeListOf<HTMLInputElement>);
      const count = checked.length;
      const rawSumPaise = checked.reduce((acc, cb) => acc + parseInt(cb.dataset.itemPrice || '0', 10), 0);

      if (count >= 2) {
        const discountPaise = Math.round(rawSumPaise * 0.15);
        const finalPaise = rawSumPaise - discountPaise;
        if (bundleRawRow) bundleRawRow.classList.remove('hidden');
        if (bundleRawVal) bundleRawVal.textContent = formatPrice(rawSumPaise);
        if (bundleSavingsRow) bundleSavingsRow.classList.remove('hidden');
        if (bundleSavingsVal) bundleSavingsVal.textContent = `− ${formatPrice(discountPaise)}`;
        if (bundleFinalVal) bundleFinalVal.textContent = formatPrice(finalPaise);
        if (bundleAddBtn) {
          bundleAddBtn.disabled = false;
          bundleAddBtn.textContent = `Add All ${count} to Cart (15% OFF) →`;
          bundleAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      } else if (count === 1) {
        if (bundleRawRow) bundleRawRow.classList.add('hidden');
        if (bundleSavingsRow) bundleSavingsRow.classList.add('hidden');
        if (bundleFinalVal) bundleFinalVal.textContent = formatPrice(rawSumPaise);
        if (bundleAddBtn) {
          bundleAddBtn.disabled = false;
          bundleAddBtn.textContent = 'Add 1 Item to Cart →';
          bundleAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      } else {
        if (bundleFinalVal) bundleFinalVal.textContent = '₹0';
        if (bundleAddBtn) {
          bundleAddBtn.disabled = true;
          bundleAddBtn.textContent = 'Select an item to add';
          bundleAddBtn.classList.add('opacity-50', 'cursor-not-allowed');
        }
      }
    };

    bundleCheckboxes.forEach((cb) => cb.addEventListener('change', updateBundleCalc));

    bundleAddBtn?.addEventListener('click', () => {
      const checked = Array.from(document.querySelectorAll('.bundle-item-check:checked') as NodeListOf<HTMLInputElement>);
      if (checked.length === 0) return;
      const isBundle = checked.length >= 2;
      const discountMult = isBundle ? 0.85 : 1;

      const itemsToAdd = checked.map((cb) => {
        const origPrice = parseInt(cb.dataset.itemPrice || '0', 10);
        return {
          productId: cb.dataset.itemId || '',
          variantId: isBundle ? 'bundle-15off' : undefined,
          name: isBundle ? `${cb.dataset.itemName} (Bundle 15% OFF)` : (cb.dataset.itemName || ''),
          slug: cb.dataset.itemSlug || '',
          pricePaise: Math.round(origPrice * discountMult),
          image: cb.dataset.itemImage || '',
          quantity: 1
        };
      });

      addMultipleToCart(itemsToAdd);
      window.dispatchEvent(new CustomEvent('satvastones:open_cart'));
    });

    // 8. Sticky Bar Scroll Observer
    const heroBox = document.getElementById('pdp-hero-box');
    const stickyBar = document.getElementById('pdp-sticky-bar');
    if (heroBox && stickyBar) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            stickyBar.classList.remove('translate-y-full');
          } else {
            stickyBar.classList.add('translate-y-full');
          }
        },
        { threshold: 0.1 }
      );
      observer.observe(heroBox);
    }

    // 9. Load Authentic Reviews & Submission Form
    renderReviewsSection(product);
  }

  // Load and render authentic customer reviews for the product
  async function renderReviewsSection(product: Product) {
    const root = document.getElementById('dynamic-reviews-root');
    if (!root) return;

    let reviews: any[] = [];
    try {
      const res = await fetch(`/api/reviews?productId=${encodeURIComponent(product.id)}`);
      const data = await res.json();
      if (data?.success && Array.isArray(data.reviews)) {
        reviews = data.reviews;
      }
    } catch (_) {}

    root.innerHTML = `
      <section class="border-t border-[#eae4dc] pt-12 sm:pt-16">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.14em] text-[#9f4553] flex items-center gap-1.5">
              <span class="text-[#c5a059]">✦</span>
              <span>AUTHENTIC PATRON FEEDBACK</span>
            </span>
            <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#171513] mt-1">
              Customer Reviews (${reviews.length})
            </h2>
          </div>

          <button
            id="write-review-toggle-btn"
            type="button"
            class="bg-[#171513] hover:bg-[#9f4553] text-white px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-xl transition-all self-start md:self-auto cursor-pointer shadow-xs"
          >
            Write a Review ✍️
          </button>
        </div>

        <!-- Review Submission Form (Collapsible) -->
        <div id="review-form-container" class="hidden mb-10 bg-[#faf8f5] border border-[#eae4dc] rounded-[20px] p-5 sm:p-7 shadow-xs">
          <h3 class="font-serif text-lg font-normal text-[#171513] mb-3">Share Your Experience with ${product.name}</h3>
          <form id="dynamic-review-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#171513] mb-1">Your Full Name *</label>
                <input type="text" id="review-author" required placeholder="e.g. Priya Sharma" class="w-full bg-white border border-[#eae4dc] rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:border-[#9f4553]" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-[#171513] mb-1">City / Location *</label>
                <input type="text" id="review-city" required placeholder="e.g. Mumbai, Maharashtra" class="w-full bg-white border border-[#eae4dc] rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:border-[#9f4553]" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#171513] mb-1">Rating *</label>
              <div class="flex items-center gap-1" id="star-rating-selector">
                ${[1, 2, 3, 4, 5].map((s) => `
                  <button type="button" data-star="${s}" class="star-rating-btn text-2xl text-amber-400 hover:scale-110 transition-transform cursor-pointer">★</button>
                `).join('')}
                <span id="star-rating-label" class="text-xs text-[#6e6863] ml-2 font-medium">5 out of 5 stars</span>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#171513] mb-1">Your Review *</label>
              <textarea id="review-comment" required rows="3" placeholder="Tell other patrons about the finish, weight, waterproof quality, and feel..." class="w-full bg-white border border-[#eae4dc] rounded-xl p-3 text-xs focus:outline-none focus:border-[#9f4553]"></textarea>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span id="review-submit-status" class="text-xs font-medium text-emerald-700 hidden"></span>
              <button type="submit" id="submit-review-btn" class="bg-[#171513] hover:bg-[#9f4553] text-white px-6 py-2.5 text-xs font-bold uppercase tracking-wider rounded-xl transition-all shadow-xs ml-auto cursor-pointer">
                Submit Review
              </button>
            </div>
          </form>
        </div>

        <!-- Reviews List -->
        <div id="reviews-list-container" class="space-y-4">
          ${reviews.length > 0 ? reviews.map((r: any) => `
            <div class="bg-white border border-[#eae4dc] rounded-[18px] p-5 shadow-2xs space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-[#faf4f2] text-[#9f4553] font-bold text-xs flex items-center justify-center border border-[#eae4dc]">
                    ${(r.authorName || r.author || 'P').charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-[#171513]">${r.authorName || r.author}</h4>
                    <p class="text-[10px] text-[#8c827a]">${r.location || 'Verified Buyer'}</p>
                  </div>
                </div>
                <div class="flex text-[#c5a059] text-xs">
                  ${'★'.repeat(r.rating || 5)}${'☆'.repeat(5 - (r.rating || 5))}
                </div>
              </div>
              <p class="text-xs text-[#4a443f] leading-relaxed">${r.comment || r.text}</p>
              <span class="inline-flex items-center gap-1 text-[10px] text-emerald-700 font-medium">
                ✓ Verified Satvastones Patron
              </span>
            </div>
          `).join('') : `
            <div class="bg-[#faf8f5] border border-[#eae4dc] rounded-[18px] p-8 text-center space-y-2">
              <p class="font-serif text-lg text-[#171513]">Be the first patron to review ${product.name}</p>
              <p class="text-xs text-[#6e6863] max-w-md mx-auto">Have you adorned this piece? Share your authentic experience regarding its waterproof durability and everyday shine.</p>
              <button id="be-first-review-btn" type="button" class="mt-2 text-xs font-bold text-[#9f4553] underline cursor-pointer">
                Write a Review Now →
              </button>
            </div>
          `}
        </div>
      </section>
    `;

    // Toggle Review Form
    const toggleBtn = document.getElementById('write-review-toggle-btn');
    const beFirstBtn = document.getElementById('be-first-review-btn');
    const formContainer = document.getElementById('review-form-container');
    const showForm = () => {
      formContainer?.classList.toggle('hidden');
      formContainer?.scrollIntoView({ behavior: 'smooth' });
    };
    toggleBtn?.addEventListener('click', showForm);
    beFirstBtn?.addEventListener('click', showForm);

    // Star Selector
    let selectedRating = 5;
    const starBtns = document.querySelectorAll('.star-rating-btn');
    const starLabel = document.getElementById('star-rating-label');
    starBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        selectedRating = parseInt(el.dataset.star || '5', 10);
        if (starLabel) starLabel.textContent = `${selectedRating} out of 5 stars`;
        starBtns.forEach((b) => {
          const s = parseInt((b as HTMLElement).dataset.star || '0', 10);
          (b as HTMLElement).textContent = s <= selectedRating ? '★' : '☆';
        });
      });
    });

    // Form Submission
    const form = document.getElementById('dynamic-review-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const author = (document.getElementById('review-author') as HTMLInputElement)?.value.trim();
      const location = (document.getElementById('review-city') as HTMLInputElement)?.value.trim();
      const comment = (document.getElementById('review-comment') as HTMLTextAreaElement)?.value.trim();
      const statusEl = document.getElementById('review-submit-status');
      const submitBtn = document.getElementById('submit-review-btn') as HTMLButtonElement;

      if (!author || !comment) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: product.id,
            authorName: author,
            location: location || 'India',
            rating: selectedRating,
            comment,
            verified: true
          })
        });

        if (statusEl) {
          statusEl.textContent = '✓ Thank you! Your authentic review has been published.';
          statusEl.classList.remove('hidden');
        }

        setTimeout(() => {
          renderReviewsSection(product);
        }, 1200);
      } catch {
        if (statusEl) {
          statusEl.textContent = '✓ Review received and saved.';
          statusEl.classList.remove('hidden');
        }
      }
    });
  }

  // Execute on load & Astro page-load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAndRenderDynamicProduct);
  } else {
    checkAndRenderDynamicProduct();
  }
  document.addEventListener('astro:page-load', checkAndRenderDynamicProduct);
</script>