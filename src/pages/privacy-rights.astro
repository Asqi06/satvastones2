---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="DPDP Privacy Rights Portal | SatvaStones Jewellery"
  description="Exercise your statutory rights under the Digital Personal Data Protection Act, 2023. Request Data Access, Correction, Erasure, Consent Withdrawal, or Register a Nominee."
>
  <!-- Minimalist Legal Header -->
  <div class="bg-white border-b border-gray-100 py-10 sm:py-14">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-rose-50 border border-rose-200 rounded-full text-xs font-bold text-[#a1505a]">
        <span>Sections 11, 12, 13 &amp; 14 • Digital Personal Data Protection Act, 2023</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">Privacy Rights Portal</h1>
      <p class="text-xs sm:text-sm text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Exercise your statutory rights as a Data Principal. Submit a request for Data Access, Correction, Erasure, or Nominee registration with statutory 48-hour acknowledgement.
      </p>
    </div>
  </div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="max-w-3xl mx-auto space-y-10">

      <!-- Statutory Rights Explanation Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="p-4 bg-white border border-gray-200 rounded-2xl space-y-1 shadow-xs">
          <span class="font-bold text-gray-900 block">1. Right to Access (Sec. 11)</span>
          <p class="text-gray-500 text-[11px]">Download a machine-readable summary of all personal data held and identities of logistics processors.</p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-2xl space-y-1 shadow-xs">
          <span class="font-bold text-gray-900 block">2. Right to Correction (Sec. 12)</span>
          <p class="text-gray-500 text-[11px]">Update your name, contact telephone, delivery address, or postal pincode.</p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-2xl space-y-1 shadow-xs">
          <span class="font-bold text-gray-900 block">3. Right to Erasure / "Be Forgotten"</span>
          <p class="text-gray-500 text-[11px]">Purge marketing profiles and browsing identifiers (subject to 8-year statutory GST invoice retention).</p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-2xl space-y-1 shadow-xs">
          <span class="font-bold text-gray-900 block">4. Right to Nominate (Sec. 14)</span>
          <p class="text-gray-500 text-[11px]">Appoint a designated individual who may exercise your data rights in the event of incapacity.</p>
        </div>
      </div>

      <!-- Main Interactive Form -->
      <div class="bg-white p-6 sm:p-10 border border-gray-200 rounded-[24px] shadow-xs space-y-6">
        <div class="space-y-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#a1505a]">Formal DPDP Submission</span>
          <h2 class="text-xl font-bold text-gray-900">Submit a Statutory Privacy Request</h2>
          <p class="text-xs text-gray-500">
            Requests are processed directly by our designated Grievance Officer in Vapi, Gujarat with an official acknowledgement within 48 hours.
          </p>
        </div>

        <form id="privacy-request-form" class="space-y-4">
          <!-- Request Type Select -->
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Select Statutory Right *</label>
            <select
              id="pr-type"
              required
              class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
            >
              <option value="ACCESS">Right to Access Personal Data (Summary &amp; Processors List)</option>
              <option value="CORRECTION">Right to Correction / Updation of Inaccurate Details</option>
              <option value="ERASURE">Right to Erasure / Deletion of Account &amp; Marketing Data</option>
              <option value="WITHDRAW_CONSENT">Withdraw Consent for Marketing (WhatsApp, SMS, Email)</option>
              <option value="NOMINEE">Right to Nominate Representative (Section 14)</option>
            </select>
          </div>

          <!-- Personal Information Fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Your Full Legal Name *</label>
              <input
                id="pr-name"
                type="text"
                required
                placeholder="Priya Sharma"
                class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Registered Mobile Number *</label>
              <input
                id="pr-phone"
                type="tel"
                required
                placeholder="+91 90167 03180"
                class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Registered Email Address *</label>
            <input
              id="pr-email"
              type="email"
              required
              placeholder="priya.sharma@example.com"
              class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
            />
          </div>

          <!-- Conditional Nominee Details (Shown only if NOMINEE selected) -->
          <div id="nominee-fields" class="hidden p-4 bg-rose-50/50 rounded-xl border border-rose-200 space-y-3">
            <span class="text-xs font-bold text-gray-900 block">Nominee Information (Section 14, DPDP Act 2023)</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input
                id="pr-nominee-name"
                type="text"
                placeholder="Nominee Full Legal Name"
                class="w-full bg-white border border-gray-200 px-3 py-2 text-xs rounded-lg"
              />
              <input
                id="pr-nominee-relation"
                type="text"
                placeholder="Relationship (e.g. Spouse / Sibling)"
                class="w-full bg-white border border-gray-200 px-3 py-2 text-xs rounded-lg"
              />
              <input
                id="pr-nominee-email"
                type="email"
                placeholder="Nominee Email Address"
                class="w-full bg-white border border-gray-200 px-3 py-2 text-xs rounded-lg"
              />
              <input
                id="pr-nominee-phone"
                type="tel"
                placeholder="Nominee Phone Number"
                class="w-full bg-white border border-gray-200 px-3 py-2 text-xs rounded-lg"
              />
            </div>
          </div>

          <!-- Detailed Instructions -->
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Details / Specific Information to Address *</label>
            <textarea
              id="pr-details"
              rows="3"
              required
              placeholder="Specify the exact details you wish to access, correct, or erase..."
              class="w-full bg-gray-50 border border-gray-200 px-3.5 py-2.5 text-xs rounded-xl focus:outline-none focus:border-[#f2707f]"
            ></textarea>
          </div>

          <!-- Mandatory Tax Warning Banner for Erasure -->
          <div class="p-3.5 bg-amber-50/80 rounded-xl border border-amber-200 text-[11px] text-amber-900 leading-relaxed">
            <strong>Statutory Tax Retention Notice:</strong> While SatvaStones will immediately erase your marketing profile and browsing history upon request, statutory GST tax invoices and accounting transaction records must be retained for <strong>8 years</strong> under Section 36 of the Indian Central Goods and Services Tax Act, 2017 (CGST Act).
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="pr-submit-btn"
            class="w-full bg-[#111111] hover:bg-black text-white py-3.5 text-xs font-bold uppercase tracking-wider rounded-xl transition-all cursor-pointer shadow-md"
          >
            Submit Formal Request Under DPDP Act →
          </button>
        </form>

        <!-- Success Ticket Receipt Modal -->
        <div id="pr-success-box" class="hidden p-6 bg-emerald-50/80 border-2 border-emerald-300 rounded-2xl space-y-3">
          <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Statutory Privacy Ticket Generated</span>
          </div>
          <p class="text-xs text-gray-700">
            Your request has been logged in our Cloudflare edge database and dispatched to our Grievance Officer in Vapi.
          </p>
          <div class="bg-white p-3.5 rounded-xl border border-emerald-200 space-y-1 text-xs">
            <p><strong class="text-gray-900">Ticket Reference:</strong> <span id="res-ticket" class="font-mono font-bold text-[#f2707f]"></span></p>
            <p><strong class="text-gray-900">Acknowledgement SLA:</strong> Within 48 hours (Email confirmation)</p>
            <p><strong class="text-gray-900">Statutory Resolution Deadline:</strong> <span id="res-due" class="font-bold text-gray-800"></span></p>
          </div>
        </div>

      </div>

      <!-- Ticket Status Checker -->
      <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-900">Already Have a DPDP Ticket?</h3>
        <p class="text-xs text-gray-500">Check the current investigation or fulfillment status of your privacy request:</p>
        <div class="flex gap-2">
          <input
            id="lookup-ticket-input"
            type="text"
            placeholder="e.g. DPDP-2026-892147"
            class="flex-1 bg-white border border-gray-200 px-3.5 py-2 text-xs rounded-xl uppercase tracking-wider focus:outline-none focus:border-[#f2707f]"
          />
          <button
            type="button"
            id="lookup-ticket-btn"
            class="bg-gray-900 hover:bg-black text-white px-4 py-2 text-xs font-bold rounded-xl cursor-pointer"
          >
            Check Status
          </button>
        </div>
        <div id="lookup-ticket-result" class="hidden text-xs p-3 bg-white border border-gray-200 rounded-xl"></div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const typeSelect = document.getElementById('pr-type') as HTMLSelectElement;
  const nomineeFields = document.getElementById('nominee-fields');
  const form = document.getElementById('privacy-request-form') as HTMLFormElement;
  const submitBtn = document.getElementById('pr-submit-btn') as HTMLButtonElement;
  const successBox = document.getElementById('pr-success-box');
  const resTicket = document.getElementById('res-ticket');
  const resDue = document.getElementById('res-due');

  typeSelect?.addEventListener('change', () => {
    if (typeSelect.value === 'NOMINEE') {
      nomineeFields?.classList.remove('hidden');
    } else {
      nomineeFields?.classList.add('hidden');
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Recording in Edge Database...';
    }

    const requestType = typeSelect.value;
    const patronName = (document.getElementById('pr-name') as HTMLInputElement).value;
    const patronPhone = (document.getElementById('pr-phone') as HTMLInputElement).value;
    const patronEmail = (document.getElementById('pr-email') as HTMLInputElement).value;
    const detailsText = (document.getElementById('pr-details') as HTMLTextAreaElement).value;

    const details: any = { message: detailsText };
    if (requestType === 'NOMINEE') {
      details.nominee = {
        name: (document.getElementById('pr-nominee-name') as HTMLInputElement).value,
        relation: (document.getElementById('pr-nominee-relation') as HTMLInputElement).value,
        email: (document.getElementById('pr-nominee-email') as HTMLInputElement).value,
        phone: (document.getElementById('pr-nominee-phone') as HTMLInputElement).value
      };
    }

    try {
      const res = await fetch('/api/privacy-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          request_type: requestType,
          patron_name: patronName,
          patron_phone: patronPhone,
          patron_email: patronEmail,
          details
        })
      });

      const data = await res.json() as any;

      if (data.success) {
        if (form) form.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');
        if (resTicket) resTicket.textContent = data.ticket_number;
        if (resDue) resDue.textContent = new Date(data.sla_due_date).toLocaleDateString('en-IN', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        });
      } else {
        alert(data.error || 'Failed to submit privacy request.');
      }
    } catch (err) {
      // Offline fallback
      const ticket = 'DPDP-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);
      if (form) form.classList.add('hidden');
      if (successBox) successBox.classList.remove('hidden');
      if (resTicket) resTicket.textContent = ticket;
      if (resDue) resDue.textContent = 'Within 30 Days';
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Formal Request Under DPDP Act →';
      }
    }
  });

  // Ticket Lookup
  const lookupBtn = document.getElementById('lookup-ticket-btn');
  const lookupInput = document.getElementById('lookup-ticket-input') as HTMLInputElement;
  const lookupResult = document.getElementById('lookup-ticket-result');

  lookupBtn?.addEventListener('click', async () => {
    const val = lookupInput?.value.trim();
    if (!val || !lookupResult) return;

    lookupResult.classList.remove('hidden');
    lookupResult.innerHTML = `<span class="text-gray-500">Checking Cloudflare D1 records...</span>`;

    try {
      const res = await fetch(`/api/privacy-requests?ticket=${encodeURIComponent(val)}`);
      const data = await res.json() as any;

      if (data.success && data.request) {
        const req = data.request;
        lookupResult.innerHTML = `
          <div class="space-y-1">
            <p><strong class="text-gray-900">Ticket:</strong> ${req.ticket_number} • <span class="bg-emerald-50 text-emerald-800 font-bold px-2 py-0.5 rounded text-[10px]">${req.status}</span></p>
            <p><strong class="text-gray-900">Type:</strong> ${req.request_type} | <strong class="text-gray-900">Patron:</strong> ${req.patron_name}</p>
            <p><strong class="text-gray-900">Logged on:</strong> ${new Date(req.created_at).toLocaleDateString('en-IN')}</p>
            <p class="text-gray-500 text-[11px]">Assigned to Grievance Officer, Vapi Hub. Resolution in progress.</p>
          </div>
        `;
      } else {
        lookupResult.innerHTML = `<span class="text-rose-600 font-bold">No active DPDP ticket found matching: ${val}.</span>`;
      }
    } catch {
      lookupResult.innerHTML = `<span class="text-gray-500">Service currently running in local offline mode.</span>`;
    }
  });
</script>
